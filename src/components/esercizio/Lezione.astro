---
// LEZIONE ALL'INIZIO DI UN ESERCIZIO
// Si legge come una pagina: cosa fa il ruolo, i concetti (spiegazione a sinistra, esempio a destra),
// cosa farai (ogni voce porta alla parte corrispondente). Usata dagli esercizi generici e da quello SEO.
import type { Lezione } from "../../scripts/esercizi";
interface Props { lezione: Lezione; parti: string[] } // parti: gli id delle parti, nell'ordine
const { lezione, parti } = Astro.props;
---
<section class="pannello lezione" id="lezione" aria-labelledby="t-lezione">
  <h2 id="t-lezione" class="lezione-titolo">Prima di iniziare: cosa devi sapere</h2>
  <p class="lezione-intro">{lezione.intro}</p>
  <ol class="concetti">
    {lezione.concetti.map((c) => (
      <li class="concetto">
        <div>
          <h3>{c.nome}</h3>
          <p>{c.spiegazione}</p>
        </div>
        {c.esempio && <p class="esempio"><strong>Per esempio</strong>{c.esempio}</p>}
      </li>
    ))}
  </ol>
  <div class="cosa-farai">
    <h3>Cosa farai</h3>
    <ol>{lezione.cosaFarai.map((f, i) => <li>{parti[i] ? <a href={`#parte-${parti[i]}`}>{f}</a> : f}</li>)}</ol>
  </div>
  <a class="bottone-app inizia" href={`#parte-${parti[0]}`}>Ho letto, inizia la parte 1</a>
</section>

<style>
  .lezione { --linea-l: #e3e1dc; padding: 28px 32px; display: flex; flex-direction: column; gap: 18px; scroll-margin-top: 84px; }
  .lezione-titolo { font-family: var(--font-titoli); font-size: 1.5rem; font-weight: 800; }
  .lezione-intro { font-size: 1.05rem; line-height: 1.7; margin: 0; max-width: 64ch; }
  .concetti { list-style: none; counter-reset: concetto; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .concetto { counter-increment: concetto; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 20px; padding: 18px 0; border-top: 1px solid var(--linea-l); }
  .concetto h3 { font-family: var(--font-testo); font-size: 1.02rem; font-weight: 800; display: flex; gap: 10px; align-items: baseline; margin-bottom: 6px; }
  .concetto h3::before { content: counter(concetto); flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--arancio); color: var(--inchiostro); font-size: .78rem; display: grid; place-items: center; transform: translateY(-2px); }
  .concetto p { margin: 0; font-size: .95rem; line-height: 1.65; }
  .esempio { font-size: .9rem !important; line-height: 1.6; background: #f4f4f2; border-radius: 12px; padding: 12px 14px; margin: 0; align-self: start; }
  .esempio strong { display: block; font-size: .8rem; color: #55514c; margin-bottom: 2px; }
  .cosa-farai { border-top: 1px solid var(--linea-l); padding-top: 16px; font-size: .95rem; line-height: 1.6; }
  .cosa-farai h3 { font-family: var(--font-testo); font-size: 1rem; font-weight: 800; }
  .cosa-farai ol { margin: 6px 0 0; padding-left: 20px; }
  .cosa-farai a { color: var(--inchiostro); }
  .inizia { align-self: flex-start; }
  @media (max-width: 860px) {
    .lezione { padding: 20px 18px; }
    .concetto { grid-template-columns: 1fr; gap: 10px; }
  }
</style>
