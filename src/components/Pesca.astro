---
// LA MASCOTTE "PESCA" (disegno originale in SVG)
// Si usa così: <Pesca dimensione={120} occhiali saluta etichetta="La pesca che saluta" />
// - occhiali: aggiunge gli occhiali tondi
// - saluta: aggiunge un braccio che saluta
// - animata: la pesca sbatte gli occhi e muove la foglia
// - etichetta: testo per i lettori di schermo; se manca, il disegno è solo decorativo
interface Props {
  dimensione?: number;
  occhiali?: boolean;
  saluta?: boolean;
  animata?: boolean;
  colore?: string;
  etichetta?: string;
  class?: string;
}
const {
  dimensione = 120,
  occhiali = false,
  saluta = false,
  animata = true,
  colore = "#ff8a3d",
  etichetta,
  class: classe = "",
} = Astro.props;
const altezza = Math.round(dimensione * 1.05);
---
<svg
  class:list={["pesca", classe, { animata }]}
  width={dimensione}
  height={altezza}
  viewBox={saluta ? "0 0 240 250" : "0 0 200 210"}
  role={etichetta ? "img" : undefined}
  aria-label={etichetta}
  aria-hidden={etichetta ? undefined : "true"}
>
  {saluta && (
    <g class="braccio">
      <path d="M196 140 C214 128 226 110 222 96" stroke="#2a1d18" stroke-width="22" fill="none" stroke-linecap="round" />
      <path d="M196 140 C214 128 226 110 222 96" stroke={colore} stroke-width="12" fill="none" stroke-linecap="round" />
    </g>
  )}
  <g transform={saluta ? "translate(20 30)" : undefined}>
    <path class="foglia" d="M104 40 C120 10 160 8 172 20 C152 40 126 46 104 40Z" fill="#3a9d5d" />
    <path d="M100 52 C60 40 22 72 22 122 C22 170 58 202 100 202 C142 202 178 170 178 122 C178 72 140 40 100 52Z" fill={colore} stroke="#2a1d18" stroke-width="5" />
    <path d="M102 56 C132 80 142 140 130 194" stroke="#e8661c" stroke-width="6" fill="none" stroke-linecap="round" />
    {occhiali ? (
      <>
        <circle cx="74" cy="114" r="16" fill="#fff" fill-opacity=".35" stroke="#2a1d18" stroke-width="5" />
        <circle cx="114" cy="114" r="16" fill="#fff" fill-opacity=".35" stroke="#2a1d18" stroke-width="5" />
        <path d="M90 114 L98 114" stroke="#2a1d18" stroke-width="5" />
        <ellipse class="occhio" cx="74" cy="115" rx="5" ry="7" fill="#2a1d18" />
        <ellipse class="occhio" cx="114" cy="115" rx="5" ry="7" fill="#2a1d18" />
      </>
    ) : (
      <>
        <ellipse class="occhio" cx="76" cy="114" rx="8" ry="10" fill="#2a1d18" />
        <ellipse class="occhio" cx="110" cy="114" rx="8" ry="10" fill="#2a1d18" />
      </>
    )}
    <circle cx="60" cy="142" r="9" fill="#ff5f45" opacity=".4" />
    <circle cx="128" cy="142" r="9" fill="#ff5f45" opacity=".4" />
    <path d="M82 144 Q94 158 106 144" stroke="#2a1d18" stroke-width="6" fill="none" stroke-linecap="round" />
  </g>
</svg>

<style>
  .pesca { display: block; overflow: visible; height: auto; }
  .animata .occhio { transform-box: fill-box; transform-origin: center; animation: sbatti 4.5s infinite; }
  .animata .foglia { transform-box: fill-box; transform-origin: 0% 100%; animation: foglia 2.6s ease-in-out infinite; }
  .animata .braccio { transform-box: fill-box; transform-origin: 20% 90%; animation: saluta 3.2s ease-in-out infinite; }
  @keyframes sbatti { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(.1); } }
  @keyframes foglia { 0%, 100% { transform: rotate(0); } 50% { transform: rotate(-12deg); } }
  @keyframes saluta { 0%, 60%, 100% { transform: rotate(0); } 70% { transform: rotate(-28deg); } 80% { transform: rotate(10deg); } 90% { transform: rotate(-20deg); } }
</style>
