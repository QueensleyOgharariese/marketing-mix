---
// PASS AZIENDALE DI UN RUOLO (disegno approvato sulla tela "Ruoli")
// Tutti i 12 pass sono uguali: stesso colore, stessa azione (scelta di Queen).
// Cordino e clip sono solo decorativi (aria-hidden); il link porta alla pagina del ruolo.
import Icona from "./Icona.astro";

interface Props { id: string; numero: number; nome: string; breve: string; fase?: string; href?: string; }
const { id, numero, nome, breve, fase, href = `/ruoli/${id}/` } = Astro.props;
---
<a href={href} class="pass" data-fase={fase}>
  <span class="cordino" aria-hidden="true"></span>
  <span class="clip" aria-hidden="true"></span>
  <span class="corpo">
    <span class="testa"><span>CINQUE FOGLIE</span><span>N. {String(numero).padStart(3, "0")}</span></span>
    <span class="foto"><span class="icona"><Icona nome={id} dimensione={34} /></span></span>
    <span class="testi"><strong>{nome}</strong><span>{breve}</span></span>
    <span class="piede">
      <span class="codice" aria-hidden="true"></span>
      <span class="azione">Scopri<span class="freccia" aria-hidden="true">→</span></span>
    </span>
  </span>
</a>

<style>
  .pass { position: relative; margin-top: 34px; display: flex; flex-direction: column; text-decoration: none; color: var(--inchiostro); transform-origin: 50% -36px; transition: transform .35s cubic-bezier(.3, 1.6, .5, 1); }
  .cordino { position: absolute; left: 50%; top: -36px; width: 24px; height: 32px; margin-left: -12px; background: repeating-linear-gradient(180deg, #ffd2b3 0 6px, #ffc49e 6px 8px); border: 2px solid var(--inchiostro); border-bottom: 0; border-radius: 5px 5px 0 0; }
  .clip { position: absolute; left: 50%; top: -9px; width: 38px; height: 16px; margin-left: -19px; background: linear-gradient(#efe6df, #cbbdb2); border: 2px solid var(--inchiostro); border-radius: 6px; z-index: 2; }
  .corpo { flex: 1; background: #fff; border: 2px solid var(--inchiostro); border-radius: var(--raggio); box-shadow: 5px 6px 0 var(--pesca-chiaro); overflow: hidden; display: flex; flex-direction: column; transition: box-shadow .3s; }
  .testa { display: flex; justify-content: space-between; padding: 14px 16px 10px; font-size: .65rem; font-weight: 800; letter-spacing: .1em; color: #6f5f57; }
  .foto { margin: 0 14px; aspect-ratio: 4 / 3; border-radius: 16px; border: 2px solid var(--inchiostro); background: radial-gradient(circle, rgba(42, 29, 24, .07) 1.5px, transparent 1.6px) 0 0 / 14px 14px, var(--crema); display: grid; place-items: center; }
  .icona { width: 80px; height: 80px; border-radius: 50%; background: #fff; border: 2px solid var(--inchiostro); box-shadow: 3px 4px 0 rgba(42, 29, 24, .2); display: grid; place-items: center; transition: transform .3s cubic-bezier(.3, 1.6, .5, 1); }
  .testi { padding: 16px 16px 4px; display: flex; flex-direction: column; gap: 4px; text-align: center; }
  .testi strong { font-family: var(--font-titoli); font-weight: 800; font-size: 1.3rem; line-height: 1.1; }
  .testi span { font-size: .875rem; color: var(--testo-3); }
  .piede { margin: auto 16px 16px; padding-top: 12px; border-top: 2px dashed var(--linea); display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .codice { width: 76px; height: 22px; background: repeating-linear-gradient(90deg, var(--inchiostro) 0 2px, transparent 2px 4px, var(--inchiostro) 4px 5px, transparent 5px 8px, var(--inchiostro) 8px 11px, transparent 11px 13px); }
  .azione { display: flex; align-items: center; gap: 8px; font-size: .875rem; font-weight: 700; }
  .freccia { display: inline-grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--crema-2); border: 2px solid var(--inchiostro); font-weight: 800; transition: transform .2s; }
  .pass:hover { transform: rotate(-2.5deg); color: var(--inchiostro); }
  .pass:hover .corpo { box-shadow: 8px 10px 0 var(--pesca-chiaro); }
  .pass:hover .icona { transform: translateY(-4px) scale(1.06); }
  .pass:hover .freccia { transform: translateX(3px); }
  .pass:focus-visible { outline: 3px solid var(--arancio); outline-offset: 6px; border-radius: var(--raggio); }
  @media (prefers-reduced-motion: reduce) { .pass, .icona, .corpo, .freccia { transition: none; } }
  /* Telefono: due pass per riga, più compatti */
  @media (max-width: 560px) {
    .foto { margin: 0 10px; }
    .icona { width: 58px; height: 58px; }
    .testa { padding: 10px 12px 8px; font-size: .55rem; }
    .testi { padding: 12px 10px 2px; }
    .testi strong { font-size: 1.05rem; }
    .piede { margin: auto 12px 12px; }
    .codice { display: none; }
    .azione { margin-left: auto; }
  }
</style>
