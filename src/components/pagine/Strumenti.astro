---
// PAGINA "STRUMENTI" (italiano e inglese; disegno approvato sulla tela "Strumenti")
// 1. Apertura  2. Tutti gli strumenti con filtri (Tutti / Pronti / In arrivo)  3. Come si usano + privacy
// 4. In fondo: lo strumento in azione (scelta di Queen: la demo va prima del footer).
// Schede solo testo, senza immagini (commento di Queen). I filtri funzionano senza JavaScript.
// Se l'articolo di teoria esiste (campo "articoloId") c'è il link; altrimenti è scritto "in arrivo", senza link.
import Base from "../../layouts/Base.astro";
import Pesca from "../Pesca.astro";
import Icona from "../Icona.astro";
import { strumentiDi, link, linkStrumento, type Lingua } from "../../i18n";

interface Props { lang: Lingua; }
const { lang } = Astro.props;
const strumenti = strumentiDi(lang);
const pronti = strumenti.filter((s) => s.pronto).length;
const blog = link(lang, "blog");
const TESTI = {
  it: {
    titolo: "Strumenti gratuiti di marketing",
    descrizione: "Strumenti gratuiti per chi studia o lavora nel marketing: generatore di link UTM, anteprima risultato Google, calcolatore di engagement e altri. Niente registrazione, i dati restano nel tuo browser.",
    etichetta: "Strumenti gratuiti", h1: "Gli attrezzi del mestiere, gratis.",
    sotto: "Uno strumento per ogni ruolo: calcoli, controlli e anteprime che si usano davvero nel lavoro. Ognuno spiega anche la teoria che c'è dietro.",
    pillole: ["Niente registrazione", "I dati restano nel tuo browser", "Sempre gratis"],
    figura: "La pesca circondata dai risultati degli strumenti", esempio: "esempio", titoloW: "TITOLO", sotto580: "sotto i 580 px",
    tutti: "Tutti gli strumenti", mostra: "Mostra gli strumenti", tuttiE: "Tutti e", prontiUsare: "Pronti da usare", inArrivo: "In arrivo", pronto: "Pronto",
    teoria: "Impara la teoria", teoriaArrivo: "Teoria", articoloArrivo: "(articolo in arrivo)", apri: "Apri lo strumento →", presto: "Arriva presto",
    comeTitolo: "Come si usano",
    come: [["Inserisci i dati", "I tuoi, oppure quelli di esempio di Cinque Foglie, l'azienda finta."], ["Guarda il risultato", "Si aggiorna mentre scrivi, senza premere nulla."], ["Capisci il perché", "Sotto ogni strumento c'è la spiegazione, con un esempio."]],
    privacyTitolo: "Perché i tuoi dati non escono dal computer?", privacyTesto: "Tutti i calcoli li fa il tuo browser. Quello che scrivi non viene inviato al nostro sito, quindi non lo salviamo e non lo vediamo.",
    demoTitolo: "Anteprima risultato Google", demoTesto: "Scrivi titolo e descrizione e guarda come appariranno su Google. Lo strumento misura il titolo in pixel e ti avvisa se usi frasi vietate.",
    prova: "Prova lo strumento", finestra: "Esempio con Cinque Foglie, l'azienda finta", titoloCampo: "Titolo", descrizioneCampo: "Descrizione",
    esiti: ["Lunghezza giusta", "Parola chiave presente", "Nessuna frase sulla salute"], comeApparira: "Come apparirà",
    T: "Tè verde Sencha biologico in foglie | Cinque Foglie",
    D: "Sencha bio giapponese a foglie intere, dal gusto fresco ed erbaceo. Ottimo anche freddo. Spedizione in 24 ore.",
    url: "cinquefoglie.example › te-verdi › sencha-bio",
  },
  en: {
    titolo: "Free marketing tools",
    descrizione: "Free tools for people who study or work in marketing: UTM link builder, Google snippet preview, engagement rate calculator and more. No sign-up, your data stays in your browser.",
    etichetta: "Free tools", h1: "The tools of the trade, for free.",
    sotto: "One tool for each role: calculations, checks and previews that are really used at work. Each one also explains the theory behind it.",
    pillole: ["No sign-up", "Your data stays in your browser", "Always free"],
    figura: "The peach surrounded by results from the tools", esempio: "example", titoloW: "TITLE", sotto580: "under 580 px",
    tutti: "All tools", mostra: "Show tools", tuttiE: "All", prontiUsare: "Ready to use", inArrivo: "Coming soon", pronto: "Ready",
    teoria: "Learn the theory", teoriaArrivo: "Theory", articoloArrivo: "(article coming soon)", apri: "Open the tool →", presto: "Coming soon",
    comeTitolo: "How to use them",
    come: [["Enter your data", "Your own, or the sample data from Cinque Foglie, the practice company."], ["See the result", "It updates as you type, no button needed."], ["Understand why", "Below each tool there's an explanation, with an example."]],
    privacyTitolo: "Why does your data never leave your computer?", privacyTesto: "Your browser does all the calculations. What you type is not sent to our website, so we don't store it and we can't see it.",
    demoTitolo: "Google snippet preview", demoTesto: "Write a title and description and see how they will look on Google. The tool measures the title in pixels and warns you about banned claims.",
    prova: "Try the tool", finestra: "Example with Cinque Foglie, the practice company", titoloCampo: "Title", descrizioneCampo: "Description",
    esiti: ["Right length", "Keyword included", "No health claims"], comeApparira: "How it will look",
    T: "Organic Loose Leaf Sencha Green Tea | Cinque Foglie",
    D: "Organic Japanese Sencha with whole leaves and a fresh, grassy taste. Great iced too. 24-hour delivery.",
    url: "cinquefoglie.example › green-tea › organic-sencha",
  },
};
const X = TESTI[lang];
// Esempio della demo: la pagina del Sencha di Cinque Foglie (stesso titolo della soluzione dell'esercizio SEO)
const T = X.T;
const D = X.D;
---
<Base title={X.titolo} description={X.descrizione} traduzione={link(lang === "it" ? "en" : "it", "strumenti")}>
  <!-- 1. APERTURA -->
  <section class="contenitore apertura">
    <div class="apertura-testi">
      <span class="etichetta">{X.etichetta}</span>
      <h1>{X.h1}</h1>
      <p class="grande">{X.sotto}</p>
      <ul class="pillole">
        <li><Icona nome="check" dimensione={18} /> {X.pillole[0]}</li>
        <li><Icona nome="lucchetto" dimensione={18} /> {X.pillole[1]}</li>
        <li><Icona nome="cuore" dimensione={18} /> {X.pillole[2]}</li>
      </ul>
    </div>
    <div class="apertura-figura" role="img" aria-label={X.figura}>
      <span class="cerchio" aria-hidden="true"></span>
      <span class="pesca"><Pesca dimensione={200} /></span>
      <span class="widget w1" aria-hidden="true"><span>ENGAGEMENT</span><strong>4,5%</strong><small>{X.esempio}</small></span>
      <span class="widget w2" aria-hidden="true"><span>{X.titoloW}</span><strong>OK</strong><small>{X.sotto580}</small></span>
      <span class="widget w3" aria-hidden="true"><span>LINK UTM</span><strong>email</strong><small>utm_medium</small></span>
    </div>
  </section>

  <!-- 2. TUTTI GLI STRUMENTI, con filtri -->
  <section class="contenitore blocco filtri" aria-labelledby="t-tutti">
    <div class="filtri-testa">
      <h2 id="t-tutti" class="titolo-grande">{X.tutti}</h2>
      <fieldset class="chips">
        <legend class="sr">{X.mostra}</legend>
        <input class="sr" type="radio" name="stato" id="s-tutti" checked /><label class="chip" for="s-tutti">{X.tuttiE} {strumenti.length}</label>
        <input class="sr" type="radio" name="stato" id="s-pronti" /><label class="chip" for="s-pronti">{X.prontiUsare} ({pronti})</label>
        <input class="sr" type="radio" name="stato" id="s-arrivo" /><label class="chip" for="s-arrivo">{X.inArrivo}</label>
      </fieldset>
    </div>
    <ul class="griglia">
      {strumenti.map((s) => (
        <li class="strumento" data-pronto={s.pronto ? "si" : "no"}>
          <div class="s-testa">
            <span class="etichetta">{s.ruolo}</span>
            {s.pronto ? <span class="stato stato--pronto"><span class="punto" aria-hidden="true"></span>{X.pronto}</span> : <span class="stato">{X.inArrivo}</span>}
          </div>
          <h3>{s.nome}</h3>
          <p>{s.cosa}</p>
          {s.articoloId
            ? <a class="teoria" href={`${blog}${s.articoloId}/`}>{X.teoria}: {s.articolo}</a>
            : <span class="teoria">{X.teoriaArrivo}: {s.articolo} <span class="nota">{X.articoloArrivo}</span></span>}
          <div class="s-piede">
            {s.pronto
              ? <a class="bottone" href={linkStrumento(lang, s.id)}>{X.apri}</a>
              : <span class="presto">{X.presto}</span>}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- 3. COME SI USANO + PRIVACY -->
  <section class="contenitore blocco info">
    <div class="come">
      <h2>{X.comeTitolo}</h2>
      <ol>
        {X.come.map(([t, d], i) => <li><span class="n">{i + 1}</span><strong>{t}</strong><span>{d}</span></li>)}
      </ol>
    </div>
    <div class="privacy">
      <span class="tondo"><Icona nome="lucchetto" dimensione={22} /></span>
      <strong>{X.privacyTitolo}</strong>
      <span>{X.privacyTesto}</span>
    </div>
  </section>

  <!-- 4. STRUMENTO IN AZIONE (in fondo) -->
  <section class="contenitore demo-sezione">
    <div class="demo">
      <div class="demo-testi">
        <span class="stato stato--pronto"><span class="punto" aria-hidden="true"></span>{X.pronto} · SEO</span>
        <h2 class="titolo-grande">{X.demoTitolo}</h2>
        <p>{X.demoTesto}</p>
        <a class="bottone" href={linkStrumento(lang, "anteprima-google")}>{X.prova}</a>
      </div>
      <div class="finestra" aria-label={X.finestra} role="img">
        <div class="finestra-barra" aria-hidden="true"><span></span><span></span><span></span><em>{X.finestra}</em></div>
        <div class="finestra-corpo" aria-hidden="true">
          <div class="d-campo"><span class="d-riga"><span>{X.titoloCampo}</span><span>{X.sotto580}</span></span><span class="d-input"><span class="scrivi" style={`--n: ${T.length}`}>{T}</span><span class="cursore">|</span></span><span class="d-barra"><span></span></span></div>
          <div class="d-campo"><span class="d-riga"><span>{X.descrizioneCampo}</span><span>{D.length} / 160</span></span><span class="d-input d-input--testo">{D}</span></div>
          <ul class="attrezzo-esiti">{X.esiti.map((e) => <li class="ok">✓ {e}</li>)}</ul>
          <div class="d-risultato">
            <span class="d-etichetta">{X.comeApparira}</span>
            <span class="d-url">{X.url}</span>
            <span class="d-titolo">{T}</span>
            <span class="d-desc">{D}</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .apertura { padding-block: 72px 64px; display: flex; flex-wrap: wrap; gap: 40px; align-items: center; }
  .apertura-testi { flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  h1 { font-size: clamp(2.6rem, 7vw, 4.1rem); line-height: .98; max-width: 14ch; }
  .grande { margin: 0; font-size: 1.2rem; line-height: 1.55; color: var(--testo-2); max-width: 46ch; }
  .pillole { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; font-size: .95rem; font-weight: 700; }
  .pillole li { display: flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; border: 2px solid var(--inchiostro); }
  .apertura-figura { flex: 1 1 360px; min-width: 0; position: relative; height: 400px; display: grid; place-items: center; }
  .cerchio { position: absolute; width: min(340px, 86%); aspect-ratio: 1; border-radius: 50%; background: #ffe8d6; }
  .pesca { position: relative; animation: galleggia 5s ease-in-out infinite; }
  .widget { position: absolute; background: #fff; border: 2px solid var(--inchiostro); border-radius: 16px; box-shadow: 4px 4px 0 var(--inchiostro); padding: 10px 14px; display: flex; flex-direction: column; gap: 2px; min-width: 128px; }
  .widget span { font-size: .68rem; font-weight: 800; color: var(--etichetta); letter-spacing: .06em; }
  .widget strong { font-family: var(--font-titoli); font-size: 1.6rem; line-height: 1; }
  .widget small { font-size: .75rem; color: var(--testo-3); }
  .w1 { left: 0; top: 30px; transform: rotate(-6deg); animation: galleggia 6s ease-in-out infinite; }
  .w2 { right: 0; top: 70px; transform: rotate(5deg); }
  .w3 { left: 8%; bottom: 20px; transform: rotate(3deg); }
  @keyframes galleggia { 0%, 100% { translate: 0 0; } 50% { translate: 0 -8px; } }

  .blocco { padding-bottom: 72px; display: flex; flex-direction: column; gap: 24px; }
  .titolo-grande { font-size: clamp(2rem, 5vw, 2.75rem); line-height: 1.05; }
  .filtri-testa { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end; justify-content: space-between; }
  .chips { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { padding: 9px 14px; border-radius: 999px; border: 2px solid var(--inchiostro); font-weight: 700; font-size: .9rem; cursor: pointer; background: #fff; }
  .chip:hover { background: var(--crema-2); }
  .sr:checked + .chip { background: var(--inchiostro); color: #fff; }
  .sr:focus-visible + .chip { outline: 3px solid var(--arancio); outline-offset: 2px; }
  .filtri:has(#s-pronti:checked) .strumento:not([data-pronto="si"]),
  .filtri:has(#s-arrivo:checked) .strumento:not([data-pronto="no"]) { display: none; }
  .griglia { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 20px; align-items: stretch; }
  .strumento { background: #fff; border: 2px solid var(--inchiostro); border-radius: var(--raggio); box-shadow: var(--ombra); padding: 22px; display: flex; flex-direction: column; gap: 12px; }
  .strumento[data-pronto="no"] { box-shadow: none; border-color: #cbbdb2; }
  .s-testa { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .stato { font-size: .75rem; font-weight: 800; background: #f7f1ec; color: var(--testo-3); padding: 4px 10px; border-radius: 999px; display: inline-flex; align-items: center; gap: 6px; }
  .stato--pronto { background: #e3f3e8; color: #1f5c38; align-self: flex-start; }
  .punto { width: 7px; height: 7px; border-radius: 50%; background: var(--verde-ok); }
  .strumento h3 { font-size: 1.35rem; line-height: 1.15; }
  .strumento p { margin: 0; font-size: .95rem; line-height: 1.5; color: #4a3a32; }
  .teoria { font-size: .88rem; color: var(--testo-2); }
  .nota { color: var(--testo-3); }
  .s-piede { margin-top: auto; padding-top: 6px; }
  .presto { font-size: .9rem; font-weight: 700; color: var(--testo-3); }

  .info { flex-direction: row; flex-wrap: wrap; gap: 20px; }
  .come { flex: 2 1 560px; min-width: 0; background: var(--inchiostro); color: #fff; border-radius: 28px; padding: 32px; display: flex; flex-direction: column; gap: 20px; }
  .come h2 { font-size: 2rem; color: #fff; }
  .come ol { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 16px; }
  .come li { display: flex; flex-direction: column; gap: 6px; }
  .come .n { font-family: var(--font-titoli); font-size: 2.5rem; font-weight: 800; color: var(--pesca); line-height: 1; }
  .come strong { font-size: 1.1rem; }
  .come li span:last-child { font-size: .95rem; color: #d9c6ba; line-height: 1.45; }
  .privacy { flex: 1 1 300px; min-width: 0; border: 2px solid var(--inchiostro); border-radius: 28px; padding: 28px; display: flex; flex-direction: column; gap: 10px; }
  .tondo { width: 46px; height: 46px; border-radius: 50%; background: var(--crema); border: 2px solid var(--inchiostro); display: grid; place-items: center; }
  .privacy strong { font-family: var(--font-titoli); font-size: 1.35rem; line-height: 1.15; }
  .privacy > span:last-child { font-size: .95rem; line-height: 1.5; color: #4a3a32; }

  .demo-sezione { padding-block: 40px 32px; }
  .demo { background: var(--crema); border-radius: 32px; padding: clamp(22px, 4vw, 40px); display: flex; flex-wrap: wrap; gap: 40px; align-items: center; }
  .demo-testi { flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .demo-testi p { margin: 0; font-size: 1.05rem; line-height: 1.55; color: var(--testo-2); max-width: 38ch; }
  .demo-testi .bottone { align-self: flex-start; }
  .finestra { flex: 1 1 520px; min-width: 0; background: #fff; border: 2px solid var(--inchiostro); border-radius: var(--raggio); box-shadow: 8px 8px 0 var(--pesca-chiaro); overflow: hidden; }
  .finestra-barra { background: var(--inchiostro); color: #fff; padding: 10px 16px; display: flex; align-items: center; gap: 8px; font-size: .8rem; font-weight: 700; }
  .finestra-barra span { width: 10px; height: 10px; border-radius: 50%; background: var(--arancio); }
  .finestra-barra span:nth-child(2) { background: #ffc06b; } .finestra-barra span:nth-child(3) { background: var(--crema); }
  .finestra-barra em { font-style: normal; margin-left: 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .finestra-corpo { padding: 22px; display: flex; flex-direction: column; gap: 14px; }
  .d-campo { display: flex; flex-direction: column; gap: 6px; }
  .d-riga { display: flex; justify-content: space-between; font-size: .8rem; font-weight: 700; color: var(--testo-3); }
  .d-input { border: 2px solid var(--linea); border-radius: 10px; padding: 10px 12px; font-size: .95rem; font-weight: 600; white-space: nowrap; overflow: hidden; }
  .d-input--testo { white-space: normal; font-weight: 400; font-size: .88rem; line-height: 1.45; }
  .scrivi { display: inline-block; overflow: hidden; vertical-align: bottom; max-width: 100%; animation: scrivi 10s steps(var(--n)) infinite; }
  .cursore { animation: lampeggia 1s steps(1) infinite; }
  .d-barra { height: 6px; background: #f6e6da; border-radius: 99px; overflow: hidden; }
  .d-barra span { display: block; height: 100%; width: 88%; background: var(--verde-ok); transform-origin: left; animation: riempi 10s steps(20) infinite; }
  .d-risultato { border-top: 2px dashed var(--linea); padding-top: 14px; display: flex; flex-direction: column; gap: 4px; }
  .d-etichetta { font-size: .75rem; font-weight: 700; color: var(--testo-3); text-transform: uppercase; letter-spacing: .06em; }
  .d-url { font-size: .8rem; color: #3d6b4a; }
  .d-titolo { font-family: Arial, sans-serif; font-size: 1.15rem; color: #1f45b8; line-height: 1.3; }
  .d-desc { font-size: .88rem; color: #4a4a4a; line-height: 1.45; }
  @keyframes scrivi { 0% { width: 0; } 60%, 100% { width: 100%; } }
  @keyframes riempi { 0% { transform: scaleX(0); } 60%, 100% { transform: scaleX(1); } }
  @keyframes lampeggia { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .pesca, .w1, .scrivi, .cursore, .d-barra span { animation: none; } }
  @media (max-width: 560px) {
    .apertura { padding-block: 40px 32px; }
    .apertura-figura { height: 320px; }
    .widget { min-width: 0; padding: 8px 10px; }
    .widget strong { font-size: 1.25rem; }
    .come, .privacy { padding: 24px 20px; }
  }
</style>
