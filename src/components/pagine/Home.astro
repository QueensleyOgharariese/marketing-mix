---
// HOME PAGE (italiano e inglese)
// Sezioni: 1 apertura · 2 dentro il marketing · 3 i 12 ruoli · 4 esercizi · 5 percorso
//          6 strumenti · 7 strumento in azione · 8 blog · 9 newsletter
// Un solo componente per le due lingue: i testi stanno in TESTI.it e TESTI.en, uno accanto all'altro,
// così è facile tenerli allineati. Le pagine src/pages/index.astro e src/pages/en/index.astro lo usano.
// Tutte le animazioni si fermano se il sistema chiede "riduci movimento" (vedi global.css).
import Base from "../../layouts/Base.astro";
import Pesca from "../Pesca.astro";
import Icona from "../Icona.astro";
import Copertina from "../Copertina.astro";
import { getCollection } from "astro:content";
import impostazioni from "../../data/impostazioni.json";
import { ruoliDi, strumentiDi, link, linkRuolo, linkStrumento, type Lingua } from "../../i18n";

interface Props { lang: Lingua; }
const { lang } = Astro.props;

const TESTI = {
  it: {
    titoloPagina: impostazioni.nomeSito,
    descrizione: "Impara il marketing facendo: prova i ruoli veri dentro un'azienda finta, con dati realistici.",
    etichetta: "Gratis, per studenti",
    h1a: "Il marketing si impara", h1b: "facendolo",
    sotto: "Entra in un'azienda finta, ricevi richieste vere e prova a fare il lavoro di un SEO, di un brand manager, di un CRM.",
    entra: "Entra in azienda", guardaRuoli: "Guarda i 12 ruoli →",
    numeri: [["12", "ruoli da scoprire"], ["1", "azienda finta"], ["0 €", "sempre"]],
    pescaAlt: "Pesca, la mascotte di Marketing Mix, che sorride",
    richieste: "3 richieste per te",
    messaggi: [
      { sigla: "SEO", chi: "Capo", quando: "ora", testo: "Le visite da Google sono calate. Mi aiuti a capire perché?", scuro: false },
      { sigla: "BR", chi: "Brand", quando: "2 min fa", testo: "Serve un tono di voce per i nostri social.", scuro: true },
      { sigla: "CRM", chi: "CRM", quando: "5 min fa", testo: "Ieri tanti carrelli abbandonati. Che email mandiamo?", scuro: false },
    ],
    pescaAperta: "Una pesca tagliata a metà con il nocciolo al centro e i nomi dei ruoli che le girano intorno",
    anello: "SEO · BRAND · SOCIAL · CRM · SEA · INFLUENCER · PR · PRODUCT · TRADE · PARTNERSHIPS · RICERCA · ANALYTICS ·",
    dentroCe: "Dentro c'è", parole: ["la SEO", "il brand", "il CRM", "i social", "la SEA", "gli influencer"],
    dentroTitolo: "Dodici lavori diversi in una sola parola", dentroSotto: "Ogni ruolo segue il cliente in un momento diverso. Ecco chi fa cosa.",
    fasi: [
      { nome: "Farsi conoscere", ruoli: "Brand · Social media · Influencer · PR" },
      { nome: "Farsi trovare", ruoli: "SEO · SEA / PPC" },
      { nome: "Convincere e vendere", ruoli: "Product · Trade marketing · Partnerships" },
      { nome: "Far tornare e misurare", ruoli: "CRM · Ricerca di mercato · Analytics" },
    ],
    apriMappa: "Apri la mappa dei ruoli →",
    ruoliTitolo: "12 ruoli, 12 pass. Quale provi per primo?", ruoliSotto: "Ogni pass apre un ruolo nell'azienda finta, con un esercizio guidato.",
    frasi: ["Scegli il tuo pass e inizia il primo giorno in azienda!", "Ti piace scrivere? Prova la SEO.", "Ami i numeri? Prova la SEA.", "Segui tanti creator? Prova l'influencer marketing.", "Ti piace parlare con le persone? Prova il CRM."],
    leggiRuoli: "Leggi cosa fa ogni ruolo",
    esOcchiello: "Esercizi veri, non quiz", esTitolo: "Una richiesta dal capo. Il tuo lavoro. La soluzione.",
    passi: [["Leggi la richiesta", " di qualcuno dell'azienda finta."], ["Fai il lavoro", " con i dati e gli strumenti che ti servono."], ["Confronta", " il tuo risultato con quello di un professionista."]],
    provaEsercizio: "Prova il primo esercizio",
    pescaStudiosa: "La pesca con gli occhiali che guarda l'esercizio",
    esEtichetta: "Esercizio 1 · SEO", esMinuti: "circa 25 minuti",
    esRichiestaDa: "Da Marta, la fondatrice:", esRichiesta: "la pagina del tè Sencha non compare su Google. Componi il titolo giusto per la ricerca \"tè verde Sencha\".",
    ilTuoTitolo: "Il tuo titolo", sottoPixel: "sotto i 580 px", confronta: "Confronta con la soluzione",
    percorsoTitolo: "Prima provi tutto, poi scegli la tua strada", percorsoSotto: "Lo stesso percorso cresce con te: da studente a junior.",
    tappe: [
      { titolo: "Prova i ruoli", testo: "Fai un esercizio breve per ogni ruolo, in un e-commerce finto." },
      { titolo: "Scegli il tuo", testo: "Guarda dove sei andata o andato meglio e cosa ti è piaciuto." },
      { titolo: "Approfondisci", testo: "Esercizi più lunghi sul ruolo che hai scelto." },
      { titolo: "Livello avanzato", testo: "Gli stessi casi, più difficili. In arrivo." },
    ],
    strTitolo: "Strumenti gratuiti, subito", strSotto: "Funzionano nel tuo browser: quello che scrivi non esce dal tuo computer.",
    pronto: " · pronto", inArrivo: " · in arrivo", tuttiStrumenti: "Tutti i 12 strumenti →",
    demoOcchiello: "Guarda uno strumento in azione", demoTitolo: "Anteprima risultato Google",
    demoTesto: "Scrivi titolo e descrizione di una pagina e vedi subito come appariranno nei risultati: il titolo si misura in pixel, come fa Google.",
    vaiStrumento: "Prova lo strumento", finestra: "Strumento · Anteprima risultato", titolo: "Titolo", descrizioneCampo: "Descrizione", comeApparira: "Come apparirà",
    demoT: "Tè verde Sencha biologico | Cinque Foglie",
    demoD: "Sencha giapponese dal gusto fresco ed erbaceo. Foglie intere, bustine compostabili, spedizione in 24 ore.",
    demoUrl: "cinquefoglie.example › te-verdi › sencha-bio",
    blogTitolo: "Dal blog: le basi, spiegate semplici", tuttiArticoli: "Tutti gli articoli →",
    nlTitolo: "Un ruolo nuovo ogni due settimane", nlTesto: "Esercizi e consigli per entrare nel marketing, nella tua email. La newsletter parte presto.", inArrivoBadge: "In arrivo",
  },
  en: {
    titoloPagina: `${impostazioni.nomeSito}: learn marketing by doing`,
    descrizione: "Learn marketing by doing: try real marketing roles inside a practice company, with realistic data. Free, for students.",
    etichetta: "Free, for students",
    h1a: "You learn marketing", h1b: "by doing it",
    sotto: "Step into a practice company, get real requests and try the work of an SEO, a brand manager, a CRM manager.",
    entra: "Enter the company", guardaRuoli: "See the 12 roles →",
    numeri: [["12", "roles to explore"], ["1", "practice company"], ["€0", "always"]],
    pescaAlt: "Pesca, the Marketing Mix mascot, smiling",
    richieste: "3 requests for you",
    messaggi: [
      { sigla: "SEO", chi: "Boss", quando: "now", testo: "Visits from Google have dropped. Can you help me understand why?", scuro: false },
      { sigla: "BR", chi: "Brand", quando: "2 min ago", testo: "We need a tone of voice for our social media.", scuro: true },
      { sigla: "CRM", chi: "CRM", quando: "5 min ago", testo: "Lots of abandoned carts yesterday. Which email do we send?", scuro: false },
    ],
    pescaAperta: "A peach cut in half with the stone in the middle and the names of the roles turning around it",
    anello: "SEO · BRAND · SOCIAL · CRM · SEA · INFLUENCER · PR · PRODUCT · TRADE · PARTNERSHIPS · RESEARCH · ANALYTICS ·",
    dentroCe: "Inside you'll find", parole: ["SEO", "branding", "CRM", "social media", "SEA", "influencers"],
    dentroTitolo: "Twelve different jobs in a single word", dentroSotto: "Each role follows the customer at a different moment. Here's who does what.",
    fasi: [
      { nome: "Get known", ruoli: "Brand · Social media · Influencer · PR" },
      { nome: "Get found", ruoli: "SEO · SEA / PPC" },
      { nome: "Convince and sell", ruoli: "Product · Trade marketing · Partnerships" },
      { nome: "Bring back and measure", ruoli: "CRM · Market research · Analytics" },
    ],
    apriMappa: "Open the roles map →",
    ruoliTitolo: "12 roles, 12 passes. Which one will you try first?", ruoliSotto: "Each pass opens a role in the practice company, with a guided exercise.",
    frasi: ["Pick your pass and start your first day at work!", "Do you like writing? Try SEO.", "Love numbers? Try SEA.", "Follow lots of creators? Try influencer marketing.", "Enjoy talking to people? Try CRM."],
    leggiRuoli: "Read what each role does",
    esOcchiello: "Real exercises, not quizzes", esTitolo: "A request from the boss. Your work. The solution.",
    passi: [["Read the request", " from someone at the practice company."], ["Do the work", " with the data and tools you need."], ["Compare", " your result with a professional's."]],
    provaEsercizio: "Try the first exercise (in Italian)",
    pescaStudiosa: "The peach with glasses looking at the exercise",
    esEtichetta: "Exercise 1 · SEO", esMinuti: "about 25 minutes",
    esRichiestaDa: "From Marta, the founder:", esRichiesta: "the Sencha tea page doesn't show up on Google. Build the right title for the search \"Sencha green tea\".",
    ilTuoTitolo: "Your title", sottoPixel: "under 580 px", confronta: "Compare with the solution",
    percorsoTitolo: "First try everything, then choose your path", percorsoSotto: "The same path grows with you: from student to junior.",
    tappe: [
      { titolo: "Try the roles", testo: "Do a short exercise for each role, in a practice online shop." },
      { titolo: "Choose yours", testo: "See where you did best and what you enjoyed." },
      { titolo: "Go deeper", testo: "Longer exercises on the role you chose." },
      { titolo: "Advanced level", testo: "The same cases, harder. Coming soon." },
    ],
    strTitolo: "Free tools, right away", strSotto: "They work in your browser: what you type never leaves your computer.",
    pronto: " · ready", inArrivo: " · coming soon", tuttiStrumenti: "All 12 tools →",
    demoOcchiello: "See a tool in action", demoTitolo: "Google snippet preview",
    demoTesto: "Write the title and description of a page and see right away how they will look in the results: the title is measured in pixels, like Google does.",
    vaiStrumento: "Try the tool", finestra: "Tool · Snippet preview", titolo: "Title", descrizioneCampo: "Description", comeApparira: "How it will look",
    demoT: "Organic Sencha Green Tea | Cinque Foglie",
    demoD: "Japanese Sencha with a fresh, grassy taste. Whole leaves, compostable bags, 24-hour delivery.",
    demoUrl: "cinquefoglie.example › green-tea › organic-sencha",
    blogTitolo: "From the blog: the basics, explained simply", tuttiArticoli: "All articles →",
    nlTitolo: "A new role every two weeks", nlTesto: "Exercises and tips to get into marketing, in your inbox. The newsletter starts soon.", inArrivoBadge: "Coming soon",
  },
};
const T = TESTI[lang];
const ruoli = ruoliDi(lang);
const strumentiHome = strumentiDi(lang).filter((s) => s.inHome);

// Ultimi 3 articoli pubblicati nella lingua della pagina
const collezione = lang === "it" ? "blog" : "blogEn";
const articoli = (await getCollection(collezione, ({ data }) => !data.bozza))
  .sort((x, y) => y.data.date.getTime() - x.data.date.getTime() || Number(x.data.inEvidenza) - Number(y.data.inEvidenza))
  .slice(0, 3)
  .map((x) => ({ id: x.id, tema: x.data.tema, categoria: x.data.etichetta, titolo: x.data.title, testo: x.data.description }));
const blog = link(lang, "blog");
---
<Base title={T.titoloPagina} description={T.descrizione} traduzione={link(lang === "it" ? "en" : "it", "home")}>

  <!-- ============ 1. APERTURA ============ -->
  <section class="contenitore apertura">
    <div class="apertura-testi">
      <span class="etichetta">{T.etichetta}</span>
      <h1>{T.h1a} <span class="evidenzia">{T.h1b}</span></h1>
      <p class="grande">{T.sotto}</p>
      <div class="azioni">
        <a class="bottone bottone--grande" href={link(lang, "app")}>{T.entra}</a>
        <a class="link-forte" href={link(lang, "ruoli")}>{T.guardaRuoli}</a>
      </div>
      <ul class="numeri">
        {T.numeri.map(([n, t]) => <li><strong>{n}</strong> {t}</li>)}
      </ul>
    </div>
    <div class="apertura-disegno">
      <div class="pesca-macchia">
        <span class="macchia" aria-hidden="true"></span>
        <div class="rimbalza">
          <Pesca dimensione={230} etichetta={T.pescaAlt} />
          <span class="ombra" aria-hidden="true"></span>
        </div>
      </div>
      <div class="casella">
        <span class="casella-titolo"><span class="pallino" aria-hidden="true"></span>{T.richieste}</span>
        {T.messaggi.map((m) => (
          <div class="messaggio">
            <span class:list={["sigla", { "sigla--scura": m.scuro }]}>{m.sigla}</span>
            <span class="messaggio-testo">
              <span class="messaggio-testa"><strong>{m.chi}</strong><span>{m.quando}</span></span>
              <span>{m.testo}</span>
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 2. DENTRO IL MARKETING ============ -->
  <svg class="onda" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60 C240 0 480 0 720 30 C960 60 1200 60 1440 10 L1440 60Z" fill="#fff4ec" /></svg>
  <section class="crema">
    <div class="contenitore dentro">
      <div class="dentro-disegno">
        <svg viewBox="0 0 640 640" role="img" aria-label={T.pescaAperta} class="pesca-aperta">
          <defs>
            <radialGradient id="polpa" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#e2452a" /><stop offset="26%" stop-color="#ff7a3a" /><stop offset="48%" stop-color="#ffb24d" /><stop offset="100%" stop-color="#ffd27a" /></radialGradient>
            <radialGradient id="seme" cx="40%" cy="35%" r="70%"><stop offset="0%" stop-color="#c06a35" /><stop offset="100%" stop-color="#6e2f10" /></radialGradient>
            <path id="giro" d="M320 320 m -292 0 a 292 292 0 1 1 584 0 a 292 292 0 1 1 -584 0" />
          </defs>
          <g class="anello"><text class="anello-testo" fill="#c4520b"><textPath href="#giro">{T.anello}</textPath></text></g>
          <circle cx="320" cy="320" r="252" fill="#e8551c" />
          <circle cx="320" cy="320" r="236" fill="url(#polpa)" />
          <g stroke="#ffe3a8" stroke-width="3" opacity=".45" stroke-linecap="round">
            <path d="M320 100 L320 180" /><path d="M320 460 L320 540" /><path d="M100 320 L180 320" /><path d="M460 320 L540 320" />
            <path d="M165 165 L222 222" /><path d="M475 165 L418 222" /><path d="M165 475 L222 418" /><path d="M475 475 L418 418" />
          </g>
          <g class="nocciolo">
            <ellipse cx="320" cy="320" rx="92" ry="120" fill="url(#seme)" />
            <path d="M262 262 C280 252 300 270 320 260 M254 308 C282 298 306 318 336 304 M268 354 C292 344 316 366 350 350 M284 396 C302 388 320 404 340 394" stroke="#5a250c" stroke-width="7" fill="none" stroke-linecap="round" />
          </g>
          <path class="goccia" d="M300 566 C300 566 288 582 288 590 A12 12 0 0 0 312 590 C312 582 300 566 300 566Z" fill="#ff9a4d" />
          <path class="goccia goccia-2" d="M352 560 C352 560 343 572 343 578 A9 9 0 0 0 361 578 C361 572 352 560 352 560Z" fill="#ffb24d" />
        </svg>
        <p class="dentro-ce">
          <span class="dentro-label">{T.dentroCe}</span>
          <span class="parole" aria-hidden="true">
            {T.parole.map((p) => <span class="parola">{p}</span>)}
          </span>
          <span class="sr">{T.parole.join(", ")}</span>
        </p>
      </div>
      <div class="dentro-testi">
        <h2 class="titolo-sezione">{T.dentroTitolo}</h2>
        <p class="grande">{T.dentroSotto}</p>
        <div class="fasi">
          {T.fasi.map((f) => (
            <div class="fase"><strong>{f.nome}</strong><span>{f.ruoli}</span></div>
          ))}
        </div>
        <a class="link-forte" href={link(lang, "ruoli")}>{T.apriMappa}</a>
      </div>
    </div>
  </section>
  <svg class="onda" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0 C240 60 480 60 720 30 C960 0 1200 0 1440 50 L1440 0Z" fill="#fff4ec" /></svg>

  <!-- ============ 3. I 12 RUOLI ============ -->
  <section class="contenitore sezione">
    <div class="testa-sezione">
      <h2 class="titolo-sezione">{T.ruoliTitolo}</h2>
      <p class="grande stretto">{T.ruoliSotto}</p>
    </div>
    <div class="ruoli">
      <div class="consiglio">
        <div class="fumetto" aria-live="off">
          {T.frasi.map((f) => <span class="frase">{f}</span>)}
        </div>
        <Pesca dimensione={190} colore="#ffc06b" saluta class="parlante" />
        <a class="bottone bottone--scuro" href={link(lang, "ruoli")}>{T.leggiRuoli}</a>
      </div>
      <ul class="pass-griglia">
        {ruoli.map((r, i) => (
          <li>
            <a href={linkRuolo(lang, r.id)} class="pass" style={`--r: ${[-1.5, 1.2, 1, -1.2][i % 4]}deg`}>
              <span class="pass-fascia"><span class="pass-foro" aria-hidden="true"></span><span>N. {String(r.numero).padStart(3, "0")}</span></span>
              <span class="pass-corpo">
                <span class="pass-icona"><Icona nome={r.icona} /></span>
                <span class="pass-testi"><span class="pass-nome">{r.nome}</span><span class="pass-breve">{r.breve}</span></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ 4. ESERCIZI ============ -->
  <section class="scuro scuro-alto">
    <div class="contenitore esercizi">
      <div class="esercizi-testi">
        <p class="occhiello">{T.esOcchiello}</p>
        <h2 class="titolo-sezione">{T.esTitolo}</h2>
        <ol class="passi">
          {T.passi.map(([forte, resto], i) => <li><span class="numero">{i + 1}</span><span><strong>{forte}</strong>{resto}</span></li>)}
        </ol>
        <a class="bottone" href={link(lang, "app")} hreflang={lang === "en" ? "it" : undefined}>{T.provaEsercizio}</a>
      </div>
      <div class="esercizio-anteprima">
        <Pesca dimensione={140} occhiali class="studiosa" etichetta={T.pescaStudiosa} />
        <div class="esercizio">
          <div class="esercizio-testa"><span class="etichetta">{T.esEtichetta}</span><span class="nota">{T.esMinuti}</span></div>
          <div class="richiesta"><strong>{T.esRichiestaDa}</strong> {T.esRichiesta}</div>
          <span class="nota forte">{T.ilTuoTitolo}</span>
          <div class="campo"><span class="digita">{T.demoT}</span><span class="cursore" aria-hidden="true">|</span></div>
          <div class="esercizio-piede"><span class="ok">{T.sottoPixel}</span><span class="finto-bottone">{T.confronta}</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 5. IL PERCORSO ============ -->
  <section class="scuro percorso-sezione">
    <div class="contenitore percorso">
      <div class="testa-sezione percorso-testa">
        <h2 class="titolo-sezione">{T.percorsoTitolo}</h2>
        <p class="stretto">{T.percorsoSotto}</p>
      </div>
      <ol class="tappe">
        <li class="viandante" aria-hidden="true"><Pesca dimensione={48} animata={false} /></li>
        {T.tappe.map((t, i) => (
          <li class="tappa">
            <span class:list={["tappa-punto", `tappa-punto-${i + 1}`]} aria-hidden="true"></span>
            <strong>{t.titolo}</strong>
            <span>{t.testo}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ 6. STRUMENTI GRATUITI ============ -->
  <section class="contenitore sezione">
    <div class="testa-sezione">
      <h2 class="titolo-sezione titolo-medio">{T.strTitolo}</h2>
      <p class="stretto">{T.strSotto}</p>
    </div>
    <ul class="strumenti">
      {strumentiHome.map((s) => (
        <li><a href={s.pronto ? linkStrumento(lang, s.id) : link(lang, "strumenti")} class="strumento"><span class="etichetta">{s.ruolo}{s.pronto ? T.pronto : T.inArrivo}</span><strong>{s.nome}</strong><span>{s.cosa}</span></a></li>
      ))}
    </ul>
    <a class="link-forte" href={link(lang, "strumenti")}>{T.tuttiStrumenti}</a>
  </section>

  <!-- ============ 7. UNO STRUMENTO IN AZIONE ============ -->
  <section class="contenitore">
    <div class="demo">
      <div class="demo-testi">
        <p class="occhiello occhiello--arancio">{T.demoOcchiello}</p>
        <h2 class="titolo-sezione titolo-medio">{T.demoTitolo}</h2>
        <p>{T.demoTesto}</p>
        <a class="bottone" href={linkStrumento(lang, "anteprima-google")}>{T.vaiStrumento}</a>
      </div>
      <div class="finestra">
        <div class="finestra-barra"><span></span><span></span><span></span><b>{T.finestra}</b></div>
        <div class="finestra-corpo">
          <div class="riga-campo">
            <span class="riga-etichetta"><span>{T.titolo}</span><span>{T.sottoPixel}</span></span>
            <span class="campo-demo"><span class="digita-t" style={`--n: ${T.demoT.length}`}>{T.demoT}</span></span>
            <span class="barra"><span class="barra-t" style="width: 72%"></span></span>
          </div>
          <div class="riga-campo">
            <span class="riga-etichetta"><span>{T.descrizioneCampo}</span><span>{T.demoD.length} / 160</span></span>
            <span class="campo-demo campo-demo--lungo"><span class="appare">{T.demoD}</span></span>
            <span class="barra"><span class="barra-d" style={`width: ${Math.round((T.demoD.length / 160) * 100)}%`}></span></span>
          </div>
          <div class="risultato">
            <span class="riga-etichetta"><span>{T.comeApparira}</span></span>
            <span class="r-url">{T.demoUrl}</span>
            <span class="r-titolo">{T.demoT}</span>
            <span class="r-desc">{T.demoD}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 8. DAL BLOG ============ -->
  {articoli.length > 0 && (
    <section class="contenitore sezione">
      <div class="testa-sezione">
        <h2 class="titolo-sezione titolo-medio">{T.blogTitolo}</h2>
        <a class="link-forte" href={blog}>{T.tuttiArticoli}</a>
      </div>
      <ul class="articoli">
        {articoli.map((a) => (
          <li>
            <a href={`${blog}${a.id}/`} class="articolo">
              <span class="articolo-copertina"><Copertina tema={a.tema} lang={lang} /></span>
