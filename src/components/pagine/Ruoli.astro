---
// PAGINA "RUOLI" (italiano e inglese): la mappa dei 12 ruoli (disegno approvato sulla tela "Ruoli")
// 1. Apertura  2. Le 4 fasi  3. I 12 pass con i filtri per fase  4. Quiz "Non sai da dove partire?"
// Filtri e quiz funzionano SENZA JavaScript: sono pulsanti radio nascosti + il selettore CSS :has().
// Testi della pagina in TESTI.it / TESTI.en; ruoli in src/data/ruoli.json e src/data/en/ruoli.json.
import Base from "../../layouts/Base.astro";
import Pesca from "../Pesca.astro";
import Pass from "../Pass.astro";
import Icona from "../Icona.astro";
import { ruoliDi, link, linkRuolo, linkEsercizio, type Lingua } from "../../i18n";

interface Props { lang: Lingua; }
const { lang } = Astro.props;
const ruoli = ruoliDi(lang);
const TESTI = {
  it: {
    titolo: "I 12 ruoli del marketing",
    descrizione: "Cosa fa un SEO, un brand manager, un CRM manager e gli altri 9 ruoli del marketing, spiegati semplici. Scopri ogni ruolo e provalo gratis in un'azienda finta.",
    etichetta: "Mappa dei ruoli", h1: "12 ruoli del marketing. Trova il tuo.",
    sotto: "Nel marketing non c'è un solo lavoro: c'è chi fa trovare un sito, chi cura il marchio, chi fa tornare i clienti. Leggi cosa fa ogni ruolo, poi provalo nell'azienda finta.",
    pillole: ["12 ruoli", "1 azienda finta", "4 fasi del percorso"],
    figura: "La pesca con gli occhiali e un pass al collo", primoRuolo: "Il tuo primo ruolo",
    perche: "Perché ci sono così tanti ruoli?", percheSotto: "Perché un cliente attraversa 4 fasi prima di comprare e tornare. Ogni ruolo si occupa soprattutto di una fase.",
    fase: "FASE", tuttiPass: "Tutti i pass", mostraFase: "Mostra i ruoli di una fase", tuttiE12: "Tutti e 12",
    quizTitolo: "Non sai da dove partire?", quizSotto: "Scegli cosa ti piace fare di più. Pesca ti consiglia il primo pass.", quizDomanda: "Cosa ti piace fare?",
    vuotoTitolo: "Scegli una risposta…", vuotoTesto: "…e qui compare il ruolo giusto per iniziare.",
    consiglia: "PESCA CONSIGLIA", prova: "Prova questo ruolo →", leggi: "Leggi cosa fa",
    fasi: ["Farsi conoscere", "Farsi trovare", "Convincere e vendere", "Far tornare e misurare"],
  },
  en: {
    titolo: "The 12 marketing roles",
    descrizione: "What an SEO, a brand manager, a CRM manager and 9 other marketing roles do, explained simply. Discover each role and try it for free in a practice company.",
    etichetta: "Roles map", h1: "12 marketing roles. Find yours.",
    sotto: "Marketing isn't one single job: some people get a website found, some look after the brand, some bring customers back. Read what each role does, then try it in the practice company.",
    pillole: ["12 roles", "1 practice company", "4 stages of the journey"],
    figura: "The peach with glasses and a pass around its neck", primoRuolo: "Your first role",
    perche: "Why are there so many roles?", percheSotto: "Because a customer goes through 4 stages before buying and coming back. Each role mostly works on one stage.",
    fase: "STAGE", tuttiPass: "All passes", mostraFase: "Show the roles of a stage", tuttiE12: "All 12",
    quizTitolo: "Not sure where to start?", quizSotto: "Choose what you enjoy most. Pesca will suggest your first pass.", quizDomanda: "What do you enjoy doing?",
    vuotoTitolo: "Pick an answer…", vuotoTesto: "…and the right role to start with appears here.",
    consiglia: "PESCA SUGGESTS", prova: "Try this role →", leggi: "Read what it does",
    fasi: ["Get known", "Get found", "Convince and sell", "Bring back and measure"],
  },
};
const T = TESTI[lang];

// Le 4 fasi del percorso del cliente; "id" serve ai filtri, il nome cambia con la lingua
const FASI = ["conoscere", "trovare", "convincere", "tornare"].map((id, i) => ({ id, nome: T.fasi[i] }));
const idFase = (nome: string) => FASI.find((f) => f.nome === nome)!.id;
const breve = (nome: string) => nome.replace(" specialist", "").replace(" manager", "");

// Regole CSS dei filtri e del quiz, create dai dati (così non vanno scritte a mano 12 volte)
const css = [
  ...FASI.map((f) => `.filtri:has(#f-${f.id}:checked) .pass-voce:not([data-fase="${f.id}"]){display:none}`),
  ...ruoli.map((r) => `.quiz:has(#q-${r.id}:checked) .esito-${r.id}{display:flex}`),
].join("\n");
---
<Base title={T.titolo} description={T.descrizione} traduzione={link(lang === "it" ? "en" : "it", "ruoli")}>
  <!-- 1. APERTURA -->
  <section class="contenitore apertura">
    <div class="apertura-testi">
      <span class="etichetta">{T.etichetta}</span>
      <h1>{T.h1}</h1>
      <p class="grande">{T.sotto}</p>
      <ul class="pillole">
        {T.pillole.map((p) => <li>{p}</li>)}
      </ul>
    </div>
    <div class="apertura-figura" role="img" aria-label={T.figura}>
      <span class="cerchio" aria-hidden="true"></span>
      <div class="figura">
        <Pesca dimensione={210} occhiali />
        <div class="mini-pass" aria-hidden="true">
          <span class="filo"></span>
          <span class="mini-corpo"><span class="mini-testa">PASS · N. 001</span><span class="mini-riga"><span class="mini-icona"><Icona nome="seo" dimensione={16} /></span><strong>{T.primoRuolo}</strong></span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. LE 4 FASI -->
  <section class="contenitore blocco">
    <h2 class="titolo-medio">{T.perche}</h2>
    <p class="testo-2">{T.percheSotto}</p>
    <ol class="fasi">
      {FASI.map((f, n) => (
        <li class={`fase fase-${n + 1}`}>
          <span class="fase-n">{T.fase} {n + 1}</span>
          <strong>{f.nome}</strong>
          <span>{ruoli.filter((r) => r.fase === f.nome).map((r) => breve(r.nome)).join(", ")}</span>
        </li>
      ))}
    </ol>
  </section>

  <!-- 3. I 12 PASS, con filtri per fase -->
  <section class="contenitore blocco filtri" aria-labelledby="t-pass">
    <div class="filtri-testa">
      <h2 id="t-pass" class="titolo-grande">{T.tuttiPass}</h2>
      <fieldset class="chips">
        <legend class="sr">{T.mostraFase}</legend>
        <input class="sr" type="radio" name="fase" id="f-tutti" checked /><label class="chip" for="f-tutti">{T.tuttiE12}</label>
        {FASI.map((f) => (<><input class="sr" type="radio" name="fase" id={`f-${f.id}`} /><label class="chip" for={`f-${f.id}`}>{f.nome}</label></>))}
      </fieldset>
    </div>
    <ul class="griglia">
      {ruoli.map((r) => (
        <li class="pass-voce" data-fase={idFase(r.fase)}><Pass id={r.id} numero={r.numero} nome={r.nome} breve={r.breve} lang={lang} /></li>
      ))}
    </ul>
  </section>

  <!-- 4. QUIZ: da dove parto? -->
  <section class="contenitore blocco">
    <div class="quiz">
      <div class="quiz-domande">
        <h2 class="titolo-grande">{T.quizTitolo}</h2>
        <p>{T.quizSotto}</p>
        <fieldset class="risposte">
          <legend class="sr">{T.quizDomanda}</legend>
          {ruoli.map((r) => (<><input class="sr" type="radio" name="quiz" id={`q-${r.id}`} /><label class="risposta" for={`q-${r.id}`}><span class="r-icona"><Icona nome={r.id} dimensione={16} /></span>{r.quiz}</label></>))}
        </fieldset>
      </div>
      <div class="quiz-esito">
        <span class="adesivo" aria-hidden="true"><Pesca dimensione={86} colore="#ffc06b" animata={false} /></span>
        <div class="esito esito-vuoto"><strong>{T.vuotoTitolo}</strong><span>{T.vuotoTesto}</span></div>
        {ruoli.map((r) => (
          <div class={`esito esito-${r.id}`} role="status">
            <span class="esito-etichetta">{T.consiglia}</span>
            <strong>{r.nome}</strong>
            <span>{r.cosa}</span>
            <span class="esito-azioni">
              <a class="bottone" href={linkEsercizio(r.id, lang)}>{T.prova}</a>
              <a class="link-forte" href={linkRuolo(lang, r.id)}>{T.leggi}</a>
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <style is:inline set:html={css}></style>
</Base>

<script>
  // Sul telefono il risultato del quiz è sotto le 12 risposte: dopo la scelta ci si sposta fino al risultato.
  // Senza JavaScript il quiz funziona lo stesso (basta scorrere).
  document.querySelectorAll<HTMLInputElement>('input[name="quiz"]').forEach((r) => r.addEventListener("change", () => {
    if (!window.matchMedia("(max-width: 860px)").matches) return;
    const fermo = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.querySelector(".quiz-esito")?.scrollIntoView({ behavior: fermo ? "auto" : "smooth", block: "center" });
  }));
</script>

<style>
  .apertura { padding-block: 72px 56px; display: flex; flex-wrap: wrap; gap: 40px; align-items: center; }
  .apertura-testi { flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  .apertura-testi .etichetta { align-self: flex-start; }
  h1 { font-size: clamp(2.6rem, 7vw, 4.25rem); line-height: .98; max-width: 13ch; }
  .grande { margin: 0; font-size: 1.2rem; line-height: 1.55; color: var(--testo-2); max-width: 46ch; }
  .pillole { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; font-size: .95rem; font-weight: 700; }
  .pillole li { padding: 8px 14px; border-radius: 999px; border: 2px solid var(--inchiostro); }
  .apertura-figura { flex: 1 1 340px; min-width: 0; position: relative; display: grid; place-items: center; min-height: 380px; }
  .cerchio { position: absolute; width: min(360px, 90%); aspect-ratio: 1; border-radius: 50%; background: #ffe8d6; }
  .figura { position: relative; display: flex; flex-direction: column; align-items: center; animation: galleggia 5s ease-in-out infinite; }
  .mini-pass { margin-top: -40px; display: flex; flex-direction: column; align-items: center; transform-origin: 50% 0; animation: dondola 4s ease-in-out infinite; }
  .filo { width: 4px; height: 26px; background: var(--inchiostro); }
  .mini-corpo { background: #fff; border: 2px solid var(--inchiostro); border-radius: 14px; box-shadow: 4px 4px 0 var(--pesca-chiaro); overflow: hidden; width: 160px; display: flex; flex-direction: column; }
  .mini-testa { background: var(--inchiostro); color: #fff; font-size: .62rem; font-weight: 700; letter-spacing: .08em; padding: 6px 10px; }
  .mini-riga { display: flex; align-items: center; gap: 8px; padding: 10px; }
  .mini-riga strong { font-family: var(--font-titoli); font-size: .95rem; line-height: 1.1; }
  .mini-icona { flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--crema); border: 2px solid var(--inchiostro); display: grid; place-items: center; }
  @keyframes galleggia { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  @keyframes dondola { 0%, 100% { transform: rotate(-3deg); } 50% { transform: rotate(3deg); } }
  @media (prefers-reduced-motion: reduce) { .figura, .mini-pass { animation: none; } }

  .blocco { padding-bottom: 72px; display: flex; flex-direction: column; gap: 16px; }
  .titolo-medio { font-size: 1.9rem; }
  .titolo-grande { font-size: clamp(2rem, 5vw, 2.75rem); line-height: 1.05; }
  .testo-2 { margin: 0; font-size: 1.05rem; line-height: 1.55; color: var(--testo-2); max-width: 70ch; }
  .fasi { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .fase { display: flex; flex-direction: column; gap: 6px; padding: 18px; border-radius: 20px; }
  .fase-1 { background: #fff4ec; } .fase-2 { background: #ffe8d6; } .fase-3 { background: #ffdcc2; } .fase-4 { background: #ffd0ae; }
  .fase-n { font-size: .8rem; font-weight: 800; color: var(--etichetta); }
  .fase strong { font-family: var(--font-titoli); font-size: 1.3rem; line-height: 1.1; }
  .fase span:last-child { font-size: .9rem; color: #4a3a32; }

  .filtri { gap: 24px; }
  .filtri-testa { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end; justify-content: space-between; }
  .chips { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { padding: 9px 14px; border-radius: 999px; border: 2px solid var(--inchiostro); font-weight: 700; font-size: .9rem; cursor: pointer; background: #fff; transition: background .2s; }
  .chip:hover { background: var(--crema-2); }
  .sr:checked + .chip { background: var(--inchiostro); color: #fff; }
  .sr:focus-visible + .chip, .sr:focus-visible + .risposta { outline: 3px solid var(--arancio); outline-offset: 2px; }
  .griglia { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 30px 22px; align-items: stretch; }
  .pass-voce { display: flex; flex-direction: column; }
  .pass-voce > :global(.pass) { flex: 1; }

  .quiz { background: var(--arancio); border-radius: 32px; padding: 40px; display: flex; flex-wrap: wrap; gap: 32px; align-items: stretch; }
  .quiz-domande { flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .quiz-domande p { margin: 0; font-size: 1.05rem; }
  .risposte { border: 0; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
  .risposta { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 16px; border: 2px solid var(--inchiostro); background: #fff; font-weight: 700; cursor: pointer; transition: transform .15s, background .2s; }
  .risposta:hover { transform: translateY(-2px); background: #fff8f2; }
  .sr:checked + .risposta { background: var(--inchiostro); color: #fff; }
  .r-icona { flex: none; width: 32px; height: 32px; border-radius: 50%; background: var(--crema); border: 2px solid var(--inchiostro); color: var(--inchiostro); display: grid; place-items: center; }
  .quiz-esito { flex: 1 1 320px; min-width: 0; background: #fff; border: 2px solid var(--inchiostro); border-radius: 24px; box-shadow: 6px 6px 0 var(--inchiostro); padding: 28px 24px 24px; display: flex; flex-direction: column; justify-content: center; position: relative; }
  .adesivo { position: absolute; top: -44px; right: 20px; }
  .esito { display: none; flex-direction: column; gap: 6px; }
  .quiz:not(:has(.sr:checked)) .esito-vuoto { display: flex; }
  .esito strong { font-family: var(--font-titoli); font-size: 1.8rem; line-height: 1.1; }
  .esito-vuoto strong { font-size: 1.6rem; }
  .esito > span { font-size: 1rem; line-height: 1.5; color: var(--testo-2); }
  .esito-etichetta { font-size: .8rem !important; font-weight: 800; color: var(--etichetta) !important; }
  .esito-azioni { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 12px; }
  @media (prefers-reduced-motion: reduce) { .risposta, .chip { transition: none; } }
  @media (max-width: 560px) {
    .apertura { padding-block: 40px 32px; }
    .apertura-figura { min-height: 300px; }
    .griglia { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 12px; }
    .quiz { padding: 24px 18px; border-radius: 24px; }
    .quiz-esito { margin-top: 30px; padding-top: 52px; }
  }
</style>
