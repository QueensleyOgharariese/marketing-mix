---
// PAGINA "BLOG" (italiano e inglese; disegno approvato sulla tela "Blog")
// 1. Apertura con ricerca  2. In evidenza ("Inizia da qui")  3. Guide con filtri
// 4. "Hai 5 minuti?": articoli brevi  5. "Leggi, poi prova": articolo → strumento
// Si mostrano solo articoli pronti (niente sezione "in scrittura", scelta di Queen).
// Filtri senza JavaScript; la ricerca è un piccolo script che nasconde le schede che non c'entrano.
import Base from "../../layouts/Base.astro";
import Copertina from "../Copertina.astro";
import Pesca from "../Pesca.astro";
import Icona from "../Icona.astro";
import { getCollection } from "astro:content";
import { strumentiDi, link, linkStrumento, type Lingua } from "../../i18n";

interface Props { lang: Lingua; }
const { lang } = Astro.props;
const strumenti = strumentiDi(lang);
const blog = link(lang, "blog");
const TESTI = {
  it: {
    titolo: "Blog: le basi del marketing", descrizione: "Le basi del marketing spiegate semplici: guide ai ruoli, parole del mestiere e regole da conoscere. Ogni articolo ha uno strumento o un esercizio per provare.",
    h1: "Le basi del marketing, spiegate semplici.", sotto: "Guide ai ruoli, parole del mestiere e regole da conoscere. Ogni articolo finisce con uno strumento o un esercizio per provare subito.",
    cercaEtichetta: "Cerca nel blog", cercaEs: "Es. UTM, title, engagement", cerca: "Cerca", figura: "La pesca con gli occhiali pronta a leggere",
    iniziaQui: "Inizia da qui", lettura: "Lettura", conMappa: "Con la mappa dei ruoli", guide: "Guide", filtra: "Filtra gli articoli", conStrumento: "Con lo strumento",
    filtri: { tutti: "Tutti", ruoli: "Guide ai ruoli", basi: "Basi", carriera: "Carriera", regole: "Regole" },
    cinque: "Hai 5 minuti?", cinqueSotto: "Articoli brevi per capire una parola o un concetto alla volta. Le tacche arancioni dicono quanto dura la lettura.",
    letturaDi: (m: number) => `Lettura di ${m} minuti`, leggi: "Leggi", leggiProva: "Leggi, poi prova.", leggiProvaSotto: "Ogni articolo ha accanto lo strumento per metterlo in pratica.", vediStrumenti: "Vedi gli strumenti",
    nessuno: "Nessun articolo trovato. Prova con un'altra parola, o", guardaTutti: "guarda tutti gli articoli",
    trovato: "articolo trovato", trovati: "articoli trovati",
  },
  en: {
    titolo: "Blog: marketing basics", descrizione: "Marketing basics explained simply: role guides, words of the trade and rules to know. Every article comes with a tool or an exercise to try.",
    h1: "Marketing basics, explained simply.", sotto: "Role guides, words of the trade and rules to know. Every article ends with a tool or an exercise so you can try it right away.",
    cercaEtichetta: "Search the blog", cercaEs: "E.g. UTM, title tag, engagement", cerca: "Search", figura: "The peach with glasses, ready to read",
    iniziaQui: "Start here", lettura: "Reading time", conMappa: "With the roles map", guide: "Guides", filtra: "Filter articles", conStrumento: "With the tool",
    filtri: { tutti: "All", ruoli: "Role guides", basi: "Basics", carriera: "Career", regole: "Rules" },
    cinque: "Got 5 minutes?", cinqueSotto: "Short articles to understand one word or one idea at a time. The orange marks show how long it takes to read.",
    letturaDi: (m: number) => `${m}-minute read`, leggi: "Read", leggiProva: "Read, then try.", leggiProvaSotto: "Each article comes with the tool to put it into practice.", vediStrumenti: "See the tools",
    nessuno: "No articles found. Try another word, or", guardaTutti: "see all articles",
    trovato: "article found", trovati: "articles found",
  },
};
const T = TESTI[lang];

const articoli = (await getCollection(lang === "it" ? "blog" : "blogEn", ({ data }) => import.meta.env.DEV || !data.bozza))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const evidenza = articoli.find((a) => a.data.inEvidenza);
const guide = articoli.filter((a) => a.data.formato === "guida" && a !== evidenza);
const pillole = articoli.filter((a) => a.data.formato === "pillola");
const coppie = articoli
  .map((a) => ({ a, s: strumenti.find((s) => s.id === a.data.strumentoId && s.pronto) }))
  .filter((x) => x.s && x.a.data.formato === "pillola");
const FILTRI = (["tutti", "ruoli", "basi", "carriera", "regole"] as const).map((id) => [id, T.filtri[id]])
  .filter(([id]) => id === "tutti" || guide.some((a) => a.data.categoria === id));
// Testo usato dalla ricerca: titolo, descrizione e argomenti, in minuscolo
const cercabile = (a: (typeof articoli)[number]) => [a.data.title, a.data.description, a.data.etichetta, ...a.data.argomenti].join(" ").toLowerCase();
const css = FILTRI.slice(1).map(([id]) => `.filtri:has(#b-${id}:checked) .articolo:not([data-cat="${id}"]){display:none}`).join("\n");
---
<Base title={T.titolo} description={T.descrizione} traduzione={link(lang === "it" ? "en" : "it", "blog")}>
  <!-- 1. APERTURA con ricerca -->
  <section class="contenitore apertura">
    <div class="apertura-testi">
      <span class="etichetta">Blog</span>
      <h1>{T.h1}</h1>
      <p class="grande">{T.sotto}</p>
      <form class="cerca" role="search" data-cerca data-trovato={T.trovato} data-trovati={T.trovati}>
        <label for="cerca-blog" class="sr">{T.cercaEtichetta}</label>
        <span class="cerca-campo"><Icona nome="cerca" dimensione={20} /><input id="cerca-blog" type="search" placeholder={T.cercaEs} autocomplete="off" /></span>
        <button type="submit">{T.cerca}</button>
      </form>
      <p class="cerca-esito" data-cerca-esito aria-live="polite"></p>
    </div>
    <div class="apertura-figura" role="img" aria-label={T.figura}>
      <span class="cerchio" aria-hidden="true"></span>
      <span class="pesca"><Pesca dimensione={220} occhiali /></span>
    </div>
  </section>

  <!-- 2. IN EVIDENZA -->
  {evidenza && (
    <section class="contenitore blocco" data-sezione>
      <a href={`${blog}${evidenza.id}/`} class="evidenza articolo-cerca" data-testo={cercabile(evidenza)}>
        <span class="evidenza-copertina"><Copertina tema={evidenza.data.tema} altezza={300} lang={lang} /></span>
        <span class="evidenza-testi">
          <span class="badge-arancio">{T.iniziaQui}</span>
          <strong>{evidenza.data.title}</strong>
          <span>{evidenza.data.description}</span>
          <small>{T.lettura} {evidenza.data.minuti} min · {T.conMappa}</small>
        </span>
      </a>
    </section>
  )}

  <!-- 3. GUIDE, con filtri -->
  {guide.length > 0 && (
    <section class="contenitore blocco filtri" data-sezione aria-labelledby="t-guide">
      <div class="filtri-testa">
        <h2 id="t-guide" class="titolo-grande">{T.guide}</h2>
        {FILTRI.length > 2 && (
          <fieldset class="chips">
            <legend class="sr">{T.filtra}</legend>
            {FILTRI.map(([id, nome], i) => (<><input class="sr" type="radio" name="filtro-blog" id={`b-${id}`} checked={i === 0} /><label class="chip" for={`b-${id}`}>{nome}</label></>))}
          </fieldset>
        )}
      </div>
      <ul class="griglia">
        {guide.map((g) => {
          const s = strumenti.find((x) => x.id === g.data.strumentoId && x.pronto);
          return (
            <li class="articolo articolo-cerca" data-cat={g.data.categoria} data-testo={cercabile(g)}>
              <a href={`${blog}${g.id}/`} class="scheda-art">
                <span class="scheda-copertina"><Copertina tema={g.data.tema} lang={lang} /></span>
                <span class="scheda-testi">
                  <span class="occhiello">{g.data.etichetta}</span>
                  <strong>{g.data.title}</strong>
                  <span>{g.data.description}</span>
                  <small><span>{T.lettura} {g.data.minuti} min</span>{s && <span>{T.conStrumento}: {s.nome}</span>}</small>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <!-- 4. ARTICOLI BREVI + LEGGI, POI PROVA -->
  {pillole.length > 0 && (
    <section class="contenitore blocco" data-sezione>
      <div class="pillole">
        <div class="pillole-testa">
          <div>
            <h2 class="titolo-grande">{T.cinque}</h2>
            <p>{T.cinqueSotto}</p>
          </div>
          <span class="pesca-orologio" aria-hidden="true"><Pesca dimensione={110} colore="#ffc06b" animata={false} /></span>
        </div>
        <ul class="griglia-pillole">
          {pillole.map((p) => (
            <li class="articolo-cerca" data-testo={cercabile(p)}>
              <a href={`${blog}${p.id}/`} class="pillola">
                <span class="pillola-testa">
                  <span class="etichetta">{p.data.etichetta}</span>
                  <span class="tacche" aria-label={T.letturaDi(p.data.minuti)}>
                    <span aria-hidden="true">{[0, 1, 2, 3, 4, 5].map((n) => <i class:list={{ piena: n < p.data.minuti }} />)}</span>{p.data.minuti} min
                  </span>
                </span>
                <strong>{p.data.title}</strong>
                <span class="leggi">{T.leggi} <span aria-hidden="true">→</span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      {coppie.length > 0 && (
        <div class="coppie">
          <div class="coppie-testi">
            <strong>{T.leggiProva}</strong>
            <span>{T.leggiProvaSotto}</span>
          </div>
          <ul>
            {coppie.map(({ a, s }) => (
              <li><a href={`${blog}${a.id}/`} class="c-art">{a.data.title}</a><span aria-hidden="true" class="c-freccia">→</span><a href={linkStrumento(lang, s!.id)} class="c-str">{s!.nome}</a></li>
            ))}
          </ul>
          <a href={link(lang, "strumenti")} class="bottone">{T.vediStrumenti}</a>
        </div>
      )}
    </section>
  )}

  <p class="contenitore nessuno" data-nessuno hidden>{T.nessuno} <a href={blog}>{T.guardaTutti}</a>.</p>
  <style is:inline set:html={css}></style>
</Base>

<script>
  // Ricerca nel blog: nasconde gli articoli che non contengono le parole cercate.
  // Senza JavaScript la pagina mostra semplicemente tutti gli articoli.
  const form = document.querySelector<HTMLFormElement>("[data-cerca]")!;
  const campo = form.querySelector<HTMLInputElement>("input")!;
  const esito = document.querySelector<HTMLElement>("[data-cerca-esito]")!;
  const normalizza = (t: string) => t.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
  function filtra() {
    const parole = normalizza(campo.value.trim()).split(/\s+/).filter(Boolean);
    let trovati = 0;
    document.querySelectorAll<HTMLElement>(".articolo-cerca").forEach((el) => {
      const ok = parole.every((p) => normalizza(el.dataset.testo ?? "").includes(p));
      el.hidden = !ok; if (ok) trovati++;
    });
    document.querySelectorAll<HTMLElement>("[data-sezione]").forEach((s) => (s.hidden = !s.querySelector(".articolo-cerca:not([hidden])")));
    document.querySelector<HTMLElement>("[data-nessuno]")!.hidden = trovati > 0;
    esito.textContent = parole.length ? `${trovati} ${trovati === 1 ? form.dataset.trovato : form.dataset.trovati}` : "";
  }
  campo.addEventListener("input", filtra);
  form.addEventListener("submit", (e) => { e.preventDefault(); filtra(); document.querySelector(".articolo-cerca:not([hidden])")?.scrollIntoView({ behavior: "smooth", block: "center" }); });
</script>

<style>
  .apertura { padding-block: 72px 48px; display: flex; flex-wrap: wrap; gap: 40px; align-items: center; }
  .apertura-testi { flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  h1 { font-size: clamp(2.6rem, 7vw, 4.1rem); line-height: .98; max-width: 14ch; }
  .grande { margin: 0; font-size: 1.2rem; line-height: 1.55; color: var(--testo-2); max-width: 46ch; }
  .cerca { display: flex; gap: 8px; max-width: 520px; }
  .cerca-campo { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10px; border: 2px solid var(--inchiostro); border-radius: 999px; padding: 0 18px; background: #fff; box-shadow: 0 5px 0 var(--pesca-chiaro); }
  .cerca-campo input { flex: 1; min-width: 0; border: 0; outline: none; font: inherit; font-size: 1rem; padding: 14px 0; background: transparent; }
  .cerca-campo:focus-within { border-color: var(--arancio); }
  .cerca button { font: inherit; font-weight: 700; padding: 0 22px; border-radius: 999px; border: 0; background: var(--inchiostro); color: #fff; cursor: pointer; }
  .cerca-esito { margin: 0; font-size: .9rem; font-weight: 600; color: var(--testo-3); min-height: 1.2em; }
  .apertura-figura { flex: 1 1 340px; min-width: 0; position: relative; display: grid; place-items: center; min-height: 340px; }
  .cerchio { position: absolute; width: min(340px, 86%); aspect-ratio: 1; border-radius: 50%; background: #ffe8d6; }
  .pesca { position: relative; animation: galleggia 5s ease-in-out infinite; }
  @keyframes galleggia { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

  .blocco { padding-bottom: 64px; display: flex; flex-direction: column; gap: 24px; }
  .titolo-grande { font-size: clamp(2rem, 5vw, 2.75rem); line-height: 1.05; }
  .evidenza { text-decoration: none; background: #fff; border: 2px solid var(--inchiostro); border-radius: 28px; box-shadow: 8px 8px 0 var(--pesca-chiaro); overflow: hidden; display: flex; flex-wrap: wrap; transition: transform .2s; }
  .evidenza:hover { transform: translateY(-3px); color: var(--inchiostro); }
  .evidenza-copertina { flex: 1 1 480px; min-width: 0; border-right: 2px solid var(--inchiostro); }
  .evidenza-testi { flex: 1 1 380px; min-width: 0; padding: 32px; display: flex; flex-direction: column; gap: 12px; justify-content: center; }
  .badge-arancio { align-self: flex-start; font-size: .75rem; font-weight: 800; background: var(--arancio); padding: 5px 10px; border-radius: 999px; text-transform: uppercase; letter-spacing: .06em; }
  .evidenza-testi strong { font-family: var(--font-titoli); font-size: clamp(1.7rem, 4vw, 2.25rem); line-height: 1.05; }
  .evidenza-testi > span:not(.badge-arancio) { font-size: 1.05rem; color: var(--testo-2); line-height: 1.5; }
  .evidenza-testi small { font-size: .875rem; color: var(--testo-3); font-weight: 600; }

  .filtri-testa { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end; justify-content: space-between; }
  .chips { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { padding: 9px 14px; border-radius: 999px; border: 2px solid var(--inchiostro); font-weight: 700; font-size: .9rem; cursor: pointer; background: #fff; }
  .sr:checked + .chip { background: var(--inchiostro); color: #fff; }
  .sr:focus-visible + .chip { outline: 3px solid var(--arancio); outline-offset: 2px; }
  .griglia { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 22px; }
  .scheda-art { height: 100%; text-decoration: none; background: #fff; border: 2px solid var(--inchiostro); border-radius: var(--raggio); box-shadow: var(--ombra); overflow: hidden; display: flex; flex-direction: column; transition: transform .2s; }
  .scheda-art:hover { transform: translateY(-3px); color: var(--inchiostro); }
  .scheda-copertina { border-bottom: 2px solid var(--linea); }
  .scheda-testi { padding: 20px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .occhiello { font-size: .75rem; font-weight: 800; color: var(--etichetta); text-transform: uppercase; letter-spacing: .06em; }
  .scheda-testi strong { font-family: var(--font-titoli); font-size: 1.4rem; line-height: 1.15; }
  .scheda-testi > span:not(.occhiello) { font-size: .95rem; color: var(--testo-2); line-height: 1.45; }
  .scheda-testi small { margin-top: auto; padding-top: 8px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; font-size: .82rem; color: var(--testo-3); font-weight: 600; }

  .pillole { background: var(--crema); border-radius: 32px; padding: clamp(22px, 4vw, 40px); display: flex; flex-direction: column; gap: 24px; }
  .pillole-testa { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; justify-content: space-between; }
  .pillole-testa > div { display: flex; flex-direction: column; gap: 8px; max-width: 52ch; }
  .pillole-testa p { margin: 0; font-size: 1.05rem; line-height: 1.5; color: var(--testo-2); }
  .griglia-pillole { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 14px; }
  .pillola { height: 100%; text-decoration: none; background: #fff; border: 2px solid var(--inchiostro); border-radius: 18px; box-shadow: 4px 4px 0 var(--pesca-chiaro); padding: 18px; display: flex; flex-direction: column; gap: 12px; transition: transform .2s; }
  .pillola:hover { transform: translateY(-3px); color: var(--inchiostro); }
  .pillola-testa { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .tacche { display: flex; align-items: center; gap: 6px; font-size: .75rem; font-weight: 700; color: var(--testo-3); white-space: nowrap; }
  .tacche > span { display: flex; gap: 2px; }
  .tacche i { width: 10px; height: 6px; border-radius: 99px; background: var(--linea); }
  .tacche i.piena { background: var(--arancio); }
  .pillola strong { font-family: var(--font-titoli); font-size: 1.2rem; line-height: 1.2; }
  .leggi { margin-top: auto; font-size: .9rem; font-weight: 700; color: var(--etichetta); }

  .coppie { background: var(--inchiostro); color: #fff; border-radius: 28px; padding: 28px 32px; display: flex; flex-wrap: wrap; gap: 20px 40px; align-items: center; justify-content: space-between; }
  .coppie-testi { display: flex; flex-direction: column; gap: 6px; max-width: 34ch; }
  .coppie-testi strong { font-family: var(--font-titoli); font-size: 1.75rem; line-height: 1.1; }
  .coppie-testi span { color: #d9c6ba; line-height: 1.5; }
  .coppie ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .coppie li { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; font-size: .95rem; }
  .c-art { background: #3d2c24; color: #fff; border-radius: 10px; padding: 8px 12px; text-decoration: none; }
  .c-str { background: var(--arancio); color: var(--inchiostro); font-weight: 700; border-radius: 10px; padding: 8px 12px; text-decoration: none; }
  .c-art:hover, .c-str:hover { text-decoration: underline; }
  .c-freccia { color: var(--pesca); font-weight: 800; }
  .nessuno { padding-bottom: 64px; font-size: 1.05rem; }
  @media (prefers-reduced-motion: reduce) { .pesca { animation: none; } .evidenza, .scheda-art, .pillola { transition: none; } }
  @media (max-width: 560px) {
    .apertura { padding-block: 40px 32px; }
    .apertura-figura { min-height: 280px; }
    .cerca button { padding: 0 16px; }
    .evidenza-copertina { border-right: 0; border-bottom: 2px solid var(--inchiostro); }
    .evidenza-testi { padding: 22px; }
    .coppie { padding: 24px 20px; }
  }
</style>
