---
// SCHEDA DI UN PRODOTTO NELLE GRIGLIE DEL NEGOZIO (home, categoria, prodotti correlati)
// Foto disegnata, nome, formato, voto, prezzo e bottone "Aggiungi" (finto, disattivato).
import Confezione from "./Confezione.astro";
import { voto, prezzo, etichettaProdotto } from "../../scripts/negozio";
import { linguaDa } from "../../i18n";
interface Props { p: { id: string; categoria: string; nome: string; prezzo: number; formato: string; disponibile: boolean; url: string; recensioni: number }; categoriaNome?: string }
const { p, categoriaNome } = Astro.props;
const en = linguaDa(Astro.url) === "en";
const L = (it: string, eng: string) => (en ? eng : it);
const etichetta = etichettaProdotto(p, en);
const link = `${en ? "/en" : ""}/app/negozio${p.url}`;
---
<article class="nscheda">
  <a class="foto" href={link} tabindex="-1" aria-hidden="true">
    {etichetta && <span class="etichetta">{etichetta}</span>}
    <Confezione categoria={p.categoria} nome={p.nome} />
  </a>
  <div class="testi">
    {categoriaNome && <span class="cat">{categoriaNome}</span>}
    <a class="nome" href={link}>{p.nome}</a>
    <span class="formato">{p.formato}</span>
    <span class="voto">{p.recensioni ? <><span class="stelle" aria-hidden="true">★★★★★</span> {voto(p.id, en)} <span class="sr">{L("su 5,", "out of 5,")}</span>({p.recensioni}<span class="sr"> {L("recensioni", "reviews")}</span>)</> : L("Nessuna recensione", "No reviews")}</span>
    <div class="piede">
      <strong>{prezzo(p.prezzo, en)}</strong>
      <button type="button" disabled={!p.disponibile} title={L("Negozio finto: non si può comprare", "Fake shop: you can't buy anything")}>{p.disponibile ? L("Aggiungi", "Add") : L("Esaurito", "Out of stock")}</button>
    </div>
  </div>
</article>

<style>
  .nscheda { background: #fff; border: 1px solid #e6dfd0; border-radius: 18px; overflow: hidden; display: flex; flex-direction: column; height: 100%; }
  .foto { position: relative; display: block; }
  .etichetta { position: absolute; top: 12px; left: 12px; background: #fff; color: #1f4d36; font-size: .75rem; font-weight: 700; padding: 4px 10px; border-radius: 999px; }
  .testi { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .cat { font-size: .78rem; font-weight: 600; color: #4a5a50; }
  .nome { font-size: 1.02rem; font-weight: 700; color: #1d2a22 !important; text-decoration: none; }
  .nome:hover { text-decoration: underline; }
  .formato, .voto { font-size: .82rem; color: #4a5a50; }
  .stelle { color: #b06a10; letter-spacing: 1px; }
  .voto { white-space: nowrap; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .piede { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 12px; margin-top: auto; padding-top: 12px; }
  .piede strong { font-size: 1.1rem; }
  .piede button { font: inherit; font-size: .85rem; font-weight: 700; background: #1f4d36; color: #fff; border: 0; border-radius: 999px; padding: 10px 16px; min-height: 42px; cursor: not-allowed; }
  .piede button:disabled { background: #b9c4bc; }
  /* schede strette (due per riga sul telefono): meno spazio intorno, bottone a tutta larghezza */
  @container sito (max-width: 760px) {
    .testi { padding: 12px 12px 14px; }
    .nome { font-size: .95rem; }
    .piede button { flex: 1 1 100%; min-height: 40px; padding: 8px 12px; }
  }
</style>
