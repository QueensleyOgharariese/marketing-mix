---
// "FOTO" DI UN PRODOTTO: un disegno semplice di un barattolo (o di un oggetto), del colore della categoria.
// Niente foto vere: tutto originale (regola del progetto sulle licenze).
interface Props { categoria: string; nome: string; grande?: boolean; }
const { categoria, nome, grande = false } = Astro.props;
const COLORI: Record<string, [string, string]> = {
  "te-verdi": ["#5f8a4a", "#e3ecda"], "te-neri": ["#4a2f22", "#efe3d8"], tisane: ["#8a5a2b", "#f3e6d3"],
  matcha: ["#6f9a3a", "#e6efd4"], "te-freddi": ["#c9653d", "#f6e2d6"], accessori: ["#556270", "#e4e8ec"],
};
const [colore, sfondo] = COLORI[categoria] ?? ["#556270", "#ebeae6"];
// Sull'etichetta va la parola che distingue il prodotto (es. "Tè verde alla menta" → "Menta")
const corto = nome.replace(/^(tè (verde|nero|freddo)( al| alla| e)?|tè|kit|cold brew|tazza in|teiera in|infusore in|barattolo in)\s+/i, "");
const parola = corto.length > 10 ? corto.split(" ")[0] : corto;
const etichetta = parola.charAt(0).toUpperCase() + parola.slice(1);
---
<svg class:list={["confezione", { grande }]} viewBox="0 0 200 170" role="img" aria-label={`Confezione di ${nome}`}>
  <rect width="200" height="170" fill={sfondo} />
  <rect x="58" y="22" width="84" height="20" rx="5" fill="#2f3b33" />
  <rect x="62" y="42" width="76" height="128" rx="8" fill={colore} />
  <rect x="62" y="74" width="76" height="46" fill="#f6efe0" />
  <text x="100" y="102" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-size={etichetta.length > 9 ? 11 : 14} fill={colore}>{etichetta}</text>
</svg>

<style>
  .confezione { display: block; width: 100%; height: auto; }
</style>
