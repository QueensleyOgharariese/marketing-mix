---
// IL NEGOZIO FINTO DI CINQUE FOGLIE (percorso SEO "Approfondisci")
// Mostra una pagina del negozio dentro una finestra del browser, con l'indirizzo cinquefoglie.example/...
// Il pulsante "Ispeziona" mostra quello che Google legge nel codice della pagina:
// title, meta description, meta robots, canonical, H1, stato. I dati arrivano da crawl.json.
// Gli indirizzi veri del negozio (es. /te-verdi/sencha-bio/) qui stanno sotto /app/negozio/.
// Aspetto (dai design approvati): verde bosco e crema, titoli in Fraunces (font libero, licenza OFL),
// testo in Figtree. Barra delle spedizioni, ricerca, account, carrello, menu, piè di pagina con note legali.
// Ricerca, carrello e newsletter sono finti: non fanno nulla.
import "@fontsource/fraunces/latin-500.css";
import "@fontsource/fraunces/latin-600.css";
import AppLayout from "../../layouts/AppLayout.astro";
import GuidaMissione from "../seopro/GuidaMissione.astro";
import SchermoIntero from "../SchermoIntero.astro";
import catalogoIt from "../../data/app/seo-pro/catalogo.json";
import catalogoEn from "../../data/app/seo-pro/catalogo.en.json";
import crawlIt from "../../data/app/seo-pro/crawl.json";
import crawlEn from "../../data/app/seo-pro/crawl.en.json";
import { linguaDa } from "../../i18n";

interface Props { url: string; titoloScheda: string; }
const { url, titoloScheda } = Astro.props;
// Versione inglese (/en/app/negozio/...): testi dai dati gemelli .en.json, indirizzi uguali
const en = linguaDa(Astro.url) === "en";
const L = (it: string, eng: string) => (en ? eng : it);
const catalogo = en ? (catalogoEn as typeof catalogoIt) : catalogoIt;
const crawl = en ? (crawlEn as typeof crawlIt) : crawlIt;
const APP = en ? "/en/app" : "/app";
const pagina = crawl.pagine.find((p) => p.url === url);
const testa = pagina ?? { title: "", description: "", robots: "", canonical: "", h1: "", stato: 404 };
const NEG = `${APP}/negozio`;
const attiva = (id: string) => url.startsWith(`/${id}/`);
---
<AppLayout title={`${L("Negozio", "Shop")} · ${titoloScheda}`} percorso={[{ etichetta: L("Simulazione SEO", "SEO Simulation"), link: `${APP}/percorsi/seo/` }, { etichetta: L("Il negozio", "The shop") }, { etichetta: titoloScheda }]} indietro={{ etichetta: L("Simulazione SEO", "SEO Simulation"), link: `${APP}/percorsi/seo/` }}>
  <SchermoIntero slot="barra" />
  <div class="area">
    <div class="finestra" data-url-negozio={url}>
      <div class="barra-browser">
        <span class="pallini" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="indirizzo" data-indirizzo><svg class="lucchetto" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5 V7.5 A4 4 0 0 1 16 7.5 V10.5"/></svg>https://{catalogo.dominio}{url}</span>
        <details class="ispeziona">
          <summary>{L("Ispeziona", "Inspect")}</summary>
          <div class="codice" role="region" aria-label={L("Cosa legge Google in questa pagina", "What Google reads on this page")}>
            <span class="codice-titolo">{L("Cosa legge Google", "What Google reads")}</span>
            <dl>
              <div><dt>{L("Stato", "Status")}</dt><dd data-isp="stato">{testa.stato === 200 ? "200 OK" : testa.stato === 404 ? L("404 Non trovata", "404 Not found") : `${testa.stato} ${L("Reindirizzamento", "Redirect")}`}</dd></div>
              <div><dt>&lt;title&gt;</dt><dd data-isp="title">{testa.title || <em>{L("vuoto", "empty")}</em>}</dd></div>
              <div><dt>meta description</dt><dd data-isp="description">{testa.description || <em>{L("manca", "missing")}</em>}</dd></div>
              <div><dt>meta robots</dt><dd data-isp="robots" class:list={{ allarme: (testa.robots || "").includes("noindex") }}>{testa.robots || <em>—</em>}</dd></div>
              <div><dt>canonical</dt><dd data-isp="canonical">{testa.canonical ? `https://${catalogo.dominio}${testa.canonical}` : <em>{L("manca", "missing")}</em>}</dd></div>
              <div><dt>&lt;h1&gt;</dt><dd data-isp="h1">{testa.h1 || <em>{L("manca", "missing")}</em>}</dd></div>
            </dl>
          </div>
        </details>
      </div>

      <p class="avviso-301" data-avviso-301 hidden></p>
      <div class="sito">
        <p class="striscia">{L("Spedizione gratuita da 39 €. Consegna in 24-48 ore in tutta Italia.", "Free shipping from €39. Delivery in 24-48 hours across Italy.")}</p>
        <header class="sito-testa">
          <div class="testa-riga">
            <a class="sito-logo" href={NEG + "/"}>
              <svg width="28" height="28" viewBox="0 0 30 30" aria-hidden="true"><path d="M15 3c7 4 9 13 0 24C6 16 8 7 15 3z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15 8v17" stroke="currentColor" stroke-width="1.6"/></svg>
              Cinque Foglie
            </a>
            <form class="cerca" role="search" onsubmit="return false">
              <label for="cerca-negozio" class="sr">{L("Cerca nel negozio", "Search the shop")}</label>
              <input id="cerca-negozio" type="search" placeholder={L("Cerca tè, tisane, accessori…", "Search teas, herbal teas, accessories…")} />
              <button type="submit" aria-label={L("Cerca", "Search")}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg></button>
            </form>
            <nav class="conto" aria-label={L("Il tuo account", "Your account")}>
              <a href={`${NEG}/account/`}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4-6 8-6s7 2 8 6"/></svg>{L("Accedi", "Sign in")}</a>
              <a class="carrello" href={`${NEG}/carrello/`}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 7h14l-1.5 11h-11z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>{L("Carrello", "Cart")}</a>
            </nav>
          </div>
          <nav class="menu" aria-label={L("Categorie del negozio", "Shop categories")}>
            {catalogo.categorie.map((c) => <a href={`${NEG}/${c.id}/`} aria-current={attiva(c.id) ? "page" : undefined}>{c.nome}</a>)}
            <a class="menu-blog" href={`${NEG}/blog/`} aria-current={attiva("blog") ? "page" : undefined}>{L("Il Diario del tè", "The Tea Journal")}</a>
          </nav>
        </header>

        <div class="sito-corpo"><slot /></div>

        <footer class="sito-piede">
          <div class="piede-colonne">
            <div><strong class="piede-logo">Cinque Foglie</strong><p>{L("Tè e tisane biologiche, selezionati e confezionati in Veneto.", "Organic teas and herbal teas, selected and packed in Veneto.")}</p></div>
            <div><strong>{L("Negozio", "Shop")}</strong>{catalogo.categorie.slice(0, 4).map((c) => <a href={`${NEG}/${c.id}/`}>{c.nome}</a>)}</div>
            <div><strong>{L("Aiuto", "Help")}</strong><a href={`${NEG}/spedizioni-e-resi/`}>{L("Spedizioni e resi", "Shipping and returns")}</a><a href={`${NEG}/contatti/`}>{L("Contatti", "Contact")}</a><a href={`${NEG}/chi-siamo/`}>{L("Chi siamo", "About us")}</a></div>
            <div><strong>{L("Il Diario del tè", "The Tea Journal")}</strong><a href={`${NEG}/blog/`}>{L("Tutti gli articoli", "All articles")}</a><a href={`${NEG}/blog/sencha-guida-completa/`}>{L("Guida al Sencha", "Sencha guide")}</a></div>
          </div>
          <p class="finto">{L("Cinque Foglie è un negozio finto, creato per gli esercizi di Marketing Mix: non si può comprare nulla.", "Cinque Foglie is a fake shop, created for the Marketing Mix exercises: you can't buy anything.")}</p>
        </footer>
      </div>
    </div>
    <aside class="guida-negozio" aria-label={L("Guida della missione", "Exercise guide")} data-barra="guida-negozio" data-lato="destra" data-etichetta="guida"><GuidaMissione pagina="negozio" /></aside>
  </div>
</AppLayout>


<script>
  // Applica al negozio le modifiche fatte nel Pannello del negozio (src/scripts/cms.ts)
  import { leggiModifiche, paginaEffettiva, introCategoria } from "../../scripts/cms";
  import { t, conLingua } from "../../scripts/lingua";
  const finestra = document.querySelector<HTMLElement>("[data-url-negozio]");
  if (finestra) {
    const url = finestra.dataset.urlNegozio!;
    const m = leggiModifiche();
    const qui = new URL(location.href);
    // 1. Reindirizzamento 301: si va subito alla pagina nuova (come farebbe il server)
    const verso = m.redirect[url];
    if (verso && !qui.searchParams.get("da")) {
      location.replace(conLingua(`/app/negozio${verso}`) + `?da=${encodeURIComponent(url)}`);
    } else {
      const da = qui.searchParams.get("da");
      if (da) {
        const avviso = document.querySelector<HTMLElement>("[data-avviso-301]")!;
        avviso.hidden = false;
        avviso.textContent = t(`Reindirizzamento 301: hai aperto ${da} e il sito ti ha portato qui.`, `301 redirect: you opened ${da} and the website brought you here.`);
      }
      // 2. Ispeziona: quello che legge Google oggi
      const p = paginaEffettiva(url, m);
      if (p) {
        const vuoto = (x: string, s = t("manca", "missing")) => x ? x : `<em>${s}</em>`;
        const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;");
        const set = (k: string, html: string) => { const el = document.querySelector(`[data-isp="${k}"]`); if (el) el.innerHTML = html; };
        set("stato", p.stato === 200 ? "200 OK" : p.stato === 404 ? t("404 Non trovata", "404 Not found") : `${p.stato} ${t("Reindirizzamento", "Redirect")}`);
        set("title", vuoto(esc(p.title ?? ""), t("vuoto", "empty")));
        set("description", vuoto(esc(p.description ?? "")));
        set("robots", vuoto(esc(p.robots ?? ""), "—"));
        document.querySelector("[data-isp=robots]")?.classList.toggle("allarme", (p.robots ?? "").includes("noindex"));
        set("canonical", p.canonical ? `https://cinquefoglie.example${esc(p.canonical)}` : `<em>${t("manca", "missing")}</em>`);
        set("h1", vuoto(esc(p.h1 ?? "")));
        // 3. Testi visibili: H1 e testo introduttivo delle categorie
        const h = document.querySelector<HTMLElement>("[data-cms-h1]");
        if (h && m.pagine[url]?.h1 !== undefined) {
          // copia anche gli attributi (servono per gli stili della pagina)
          const nuovo = document.createElement(m.pagine[url].h1 ? "h1" : "p");
          for (const at of [...h.attributes]) nuovo.setAttribute(at.name, at.value);
          nuovo.textContent = m.pagine[url].h1 || h.textContent;
          nuovo.classList.toggle("titolo-finto", !m.pagine[url].h1);
          h.replaceWith(nuovo);
        }
        const intro = document.querySelector<HTMLElement>("[data-cms-intro]");
        if (intro && m.pagine[url]?.intro !== undefined) {
          intro.replaceChildren(...introCategoria(intro.dataset.cmsIntro!, m).split(/\n+/).filter((x) => x.trim()).map((r) => { const e = document.createElement("p"); e.textContent = r.trim(); return e; }));
        }
      }
    }
  }
</script>

<style>
  /* La guida è larga 400 px sugli schermi grandi, 320 px sui portatili: così resta più spazio al negozio */
  .area { --guida: 400px; padding: 24px; max-width: 1760px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) var(--guida); gap: 24px; align-items: start; }
  @media (max-width: 1500px) { .area { --guida: 320px; } }
  .area:has(> .guida-negozio[data-chiuso]) { grid-template-columns: minmax(0, 1fr) 52px; }
  .guida-negozio { display: flex; flex-direction: column; gap: 4px; background: #fff; border: 1px solid #e3e1dc; border-radius: 16px; padding: 20px 24px 0; position: sticky; top: 80px; max-height: calc(100vh - 100px); overflow-y: auto; }
  @media (max-width: 1180px) { .area, .area:has(> .guida-negozio[data-chiuso]) { grid-template-columns: 1fr; } .guida-negozio { position: static; max-height: none; } .guida-negozio[data-chiuso] > :global(.apri-pannello) { margin: 0; } }
  .finestra { background: #fff; border: 1px solid #d1cec8; border-radius: 14px; overflow: hidden; box-shadow: 0 20px 50px -30px rgba(42, 29, 24, .35); }
  .barra-browser { position: relative; display: flex; align-items: center; gap: 12px; padding: 10px 14px; background: #ebeae6; border-bottom: 1px solid #dcdad5; }
  .pallini { display: flex; gap: 6px; } .pallini i { width: 11px; height: 11px; border-radius: 50%; background: #d1cec8; } .pallini i:first-child { background: #f07a5a; } .pallini i:nth-child(2) { background: #f2c14e; } .pallini i:nth-child(3) { background: #7cc27c; }
  .indirizzo { flex: 1; min-width: 0; background: #fff; border-radius: 999px; padding: 6px 14px; font-size: .85rem; color: #2a1d18; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .avviso-301 { margin: 0; padding: 8px 16px; background: #fff3d6; color: #5c4400; font-size: .85rem; border-bottom: 1px solid #f0dca8; }
  .lucchetto { margin-right: 6px; vertical-align: -1px; color: #2f7a4f; }
  .ispeziona summary { cursor: pointer; font-weight: 700; font-size: .85rem; padding: 7px 14px; border-radius: 8px; background: #2a1d18; color: #fff; list-style: none; }
  .ispeziona summary::-webkit-details-marker { display: none; }
  .codice { position: absolute; right: 12px; top: calc(100% + 6px); z-index: 20; width: min(560px, calc(100vw - 64px)); background: #2a1d18; color: #f1efeb; border-radius: 12px; padding: 16px 18px; box-shadow: 0 16px 40px -12px rgba(0, 0, 0, .5); font-family: ui-monospace, Menlo, Consolas, monospace; font-size: .8rem; }
  .codice-titolo { display: block; font-family: var(--font-testo); font-weight: 800; font-size: .85rem; color: #ff7a1a; margin-bottom: 8px; }
  .codice dl { margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .codice dl div { display: grid; grid-template-columns: 130px 1fr; gap: 10px; }
  .codice dt { color: #ffa866; } .codice dd { margin: 0; overflow-wrap: anywhere; } .codice em { color: #a8a39c; }
  .codice .allarme { color: #ff9b8a; font-weight: 700; }

  /* ---- Il sito di Cinque Foglie ---- */
  /* Il sito è un "contenitore": il suo aspetto dipende dalla larghezza della finestra del browser finto, non dello schermo
     (sul portatile, con la guida aperta, la finestra è stretta come un tablet) */
  .sito { container: sito / inline-size; --verde: #1f4d36; --verde-scuro: #143323; --crema: #fbf8f2; --linea: #e6dfd0; --testo-n: #1d2a22; --testo-2n: #4a5a50;
    font-family: var(--font-testo); color: var(--testo-n); background: var(--crema); }
  .sito :global(a) { color: var(--verde); }
  .striscia { margin: 0; background: var(--verde); color: #f3efe4; font-size: .82rem; text-align: center; padding: 9px 16px; }
  .sito-testa { border-bottom: 1px solid var(--linea); }
  .testa-riga { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px; padding: 20px 48px 14px; }
  .sito-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--verde) !important; font-family: "Fraunces", Georgia, serif; font-weight: 600; font-size: 1.55rem; letter-spacing: -.01em; }
  .cerca { flex: 1 1 280px; display: flex; min-width: 0; }
  .cerca input { flex: 1; min-width: 0; font: inherit; font-size: .92rem; padding: 10px 16px; border: 1px solid #d8cfbd; border-right: 0; border-radius: 999px 0 0 999px; background: #fff; }
  .cerca button { border: 1px solid var(--verde); background: var(--verde); color: #fff; border-radius: 0 999px 999px 0; padding: 0 16px; min-height: 44px; cursor: pointer; }
  .conto { display: flex; gap: 4px; align-items: center; }
  .conto a { display: flex; align-items: center; gap: 7px; padding: 9px 12px; font-size: .88rem; font-weight: 600; text-decoration: none; color: var(--testo-n) !important; border-radius: 999px; }
  .conto .carrello { background: var(--verde); color: #fff !important; }
  .menu { display: flex; flex-wrap: wrap; gap: 4px 28px; padding: 0 48px 12px; font-size: .95rem; font-weight: 600; }
  .menu a { text-decoration: none; color: var(--testo-n) !important; padding: 6px 0; border-bottom: 2px solid transparent; }
  .menu a:hover, .menu a[aria-current="page"] { border-bottom-color: var(--verde); color: var(--verde) !important; }
  .menu-blog { margin-left: auto; }
  .sito-corpo { padding: 40px 48px 72px; min-height: 420px; max-width: 1360px; margin: 0 auto; }
  .sito-piede { background: var(--verde-scuro); color: #cfdccf; font-size: .88rem; }
  .piede-colonne { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 32px; padding: 48px 48px 32px; max-width: 1360px; margin: 0 auto; }
  .piede-colonne > div { display: flex; flex-direction: column; gap: 7px; }
  .piede-colonne strong { color: #fff; }
  .piede-colonne p { margin: 0; line-height: 1.6; }
  .piede-colonne a { color: #cfdccf !important; }
  .piede-logo { font-family: "Fraunces", Georgia, serif; font-size: 1.3rem; font-weight: 500; }
  .finto { margin: 0; padding: 18px 48px 24px; border-top: 1px solid #2b4c3a; font-size: .8rem; color: #e9c9a5; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 760px) {
    .area { padding: 12px; gap: 16px; }
    .codice dl div { grid-template-columns: 1fr; gap: 2px; }
  }
  @container sito (max-width: 640px) {
    .testa-riga, .menu, .sito-corpo, .piede-colonne, .finto { padding-inline: 16px; }
    .sito-corpo { padding-top: 24px; padding-bottom: 48px; }
    .conto a:first-child { display: none; }
    .menu { gap: 2px 16px; }
    .menu-blog { margin-left: 0; }
  }
</style>
