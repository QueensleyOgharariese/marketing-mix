---
// STRUMENTO 2 · ANTEPRIMA RISULTATO GOOGLE (italiano e inglese)
// Mostra come appaiono titolo e descrizione nei risultati. Il titolo si misura in pixel
// (come fa Google), la descrizione in caratteri. Riusa le funzioni dell'esercizio SEO
// (src/scripts/controlli-seo.ts): misura in pixel e controllo delle frasi sulla salute.
// In inglese il controllo della salute usa un elenco di parole inglesi (vedi lo script).
import Strumento from "../Strumento.astro";
import type { Lingua } from "../../i18n";

interface Props { lang: Lingua; }
const { lang } = Astro.props;
const TESTI = {
  it: {
    descrizione: "Anteprima gratuita del risultato su Google: scrivi title e meta description e guarda se sono troppo lunghi, se c'è la parola chiave e come appariranno.",
    url: "Indirizzo della pagina", urlEs: "www.tuosito.it/pagina",
    titolo: "Titolo (title)", titoloEs: "La parola chiave all'inizio, il marchio alla fine",
    descr: "Descrizione (meta description)", descrEs: "Cosa trova la persona sulla pagina, in una o due frasi",
    keyword: "Parola chiave (facoltativa)", keywordEs: "es. tè verde sencha",
    esempio: "Usa l'esempio di Cinque Foglie", svuota: "Svuota", come: "Come apparirà",
    nota: "Stima per i risultati da computer: Google può mostrare o riscrivere titoli e descrizioni in modo diverso.",
    js: {
      lingua: "it", caratteri: "caratteri", urlVuoto: "www.tuosito.it › pagina", titoloVuoto: "Il titolo comparirà qui",
      descrVuota: "E qui la descrizione: se manca, Google ne sceglie una dal testo della pagina.",
      esiti: ["Titolo non troppo lungo", "Titolo non troppo corto", "Descrizione 70-160 caratteri", "Parola chiave nel titolo", "Nessuna promessa sulla salute"],
      esempio: { url: "cinquefoglie.example/te-verdi/sencha-bio", titolo: "Tè verde Sencha biologico in foglie | Cinque Foglie", descrizione: "Sencha bio giapponese a foglie intere, dal gusto fresco ed erbaceo. Ottimo anche freddo. Spedizione in 24 ore.", keyword: "tè verde sencha" },
    },
  },
  en: {
    descrizione: "Free Google snippet preview: write your title tag and meta description and check whether they are too long, include the keyword and how they will look.",
    url: "Page address", urlEs: "www.yoursite.com/page",
    titolo: "Title (title tag)", titoloEs: "Keyword at the start, brand at the end",
    descr: "Description (meta description)", descrEs: "What people will find on the page, in one or two sentences",
    keyword: "Keyword (optional)", keywordEs: "e.g. sencha green tea",
    esempio: "Use the Cinque Foglie example", svuota: "Clear", come: "How it will look",
    nota: "Estimate for desktop results: Google may show or rewrite titles and descriptions differently.",
    js: {
      lingua: "en", caratteri: "characters", urlVuoto: "www.yoursite.com › page", titoloVuoto: "Your title will appear here",
      descrVuota: "And your description here: if it's missing, Google picks some text from the page.",
      esiti: ["Title not too long", "Title not too short", "Description 70-160 characters", "Keyword in the title", "No health claims"],
      esempio: { url: "cinquefoglie.example/green-tea/organic-sencha", titolo: "Organic Loose Leaf Sencha Green Tea | Cinque Foglie", descrizione: "Organic Japanese Sencha with whole leaves and a fresh, grassy taste. Great iced too. 24-hour delivery.", keyword: "sencha green tea" },
    },
  },
};
const T = TESTI[lang];
---
<Strumento id="anteprima-google" descrizione={T.descrizione} lang={lang}>
  <form class="attrezzo" data-serp data-testi={JSON.stringify(T.js)} novalidate>
    <div class="attrezzo-pannello">
      <label class="attrezzo-campo">{T.url}
        <input type="text" name="url" placeholder={T.urlEs} autocomplete="off" />
      </label>
      <label class="attrezzo-campo">
        <span class="attrezzo-riga"><span>{T.titolo}</span><span class="attrezzo-conta" data-conta-t>0 px</span></span>
        <input type="text" name="titolo" placeholder={T.titoloEs} autocomplete="off" />
        <span class="attrezzo-barra" aria-hidden="true"><span data-barra-t></span></span>
      </label>
      <label class="attrezzo-campo">
        <span class="attrezzo-riga"><span>{T.descr}</span><span class="attrezzo-conta" data-conta-d>0 {T.js.caratteri}</span></span>
        <textarea name="descrizione" placeholder={T.descrEs}></textarea>
        <span class="attrezzo-barra" aria-hidden="true"><span data-barra-d></span></span>
      </label>
      <label class="attrezzo-campo">{T.keyword}
        <input type="text" name="keyword" placeholder={T.keywordEs} autocomplete="off" />
      </label>
      <div class="attrezzo-azioni">
        <button type="button" class="bottone-piccolo" data-esempio>{T.esempio}</button>
        <button type="reset" class="bottone-piccolo">{T.svuota}</button>
      </div>
    </div>

    <div class="attrezzo-pannello attrezzo-pannello--crema" aria-live="polite">
      <span class="attrezzo-titolo">{T.come}</span>
      <div class="serp">
        <span class="s-url" data-a-url>{T.js.urlVuoto}</span>
        <span class="s-titolo" data-a-titolo>{T.js.titoloVuoto}</span>
        <span class="s-desc" data-a-desc>{T.js.descrVuota}</span>
      </div>
      <ul class="attrezzo-esiti" data-esiti></ul>
      <p class="nota">{T.nota}</p>
    </div>
  </form>

  {lang === "it" ? (
    <Fragment slot="spiega">
      <h2>Perché il titolo si misura in pixel</h2>
      <p>Google non conta le lettere: guarda quanto spazio occupano. Una "m" è più larga di una "i", quindi due titoli con gli stessi caratteri possono avere larghezze diverse. Oltre circa 580 pixel, il titolo viene tagliato con "...".</p>
      <h2>Cosa rende buono un risultato</h2>
      <p>Il titolo dice subito di cosa parla la pagina, con la parola chiave all'inizio e il marchio alla fine. La descrizione non cambia la posizione su Google, ma convince a cliccare: tra 70 e 160 caratteri, concreta, senza promesse che non puoi mantenere.</p>
      <p><strong>Attenzione alle regole:</strong> per gli alimenti, nell'Unione europea le promesse sulla salute sono permesse solo se autorizzate (Regolamento CE 1924/2006). Lo strumento ti avvisa se trova parole come "dimagrire" o "detox".</p>
    </Fragment>
  ) : (
    <Fragment slot="spiega">
      <h2>Why the title is measured in pixels</h2>
      <p>Google doesn't count letters: it looks at how much space they take up. An "m" is wider than an "i", so two titles with the same number of characters can have different widths. Beyond about 580 pixels, the title gets cut off with "...".</p>
      <h2>What makes a good result</h2>
      <p>The title says straight away what the page is about, with the keyword at the start and the brand at the end. The description doesn't change your position on Google, but it convinces people to click: between 70 and 160 characters, concrete, with no promises you can't keep.</p>
      <p><strong>Mind the rules:</strong> for food, in the European Union health claims are only allowed if they are authorised (Regulation (EC) No 1924/2006). The tool warns you if it finds words like "detox" or "weight loss".</p>
    </Fragment>
  )}
</Strumento>

<script>
  import { pixel, senzaSalute, normalizza, LIMITI } from "../../scripts/controlli-seo";
  const form = document.querySelector<HTMLFormElement>("[data-serp]")!;
  const M = JSON.parse(form.dataset.testi!);
  const campo = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
  const $ = (s: string) => form.querySelector<HTMLElement>(s)!;

  // Parole inglesi che fanno pensare a promesse sulla salute (Regolamento CE 1924/2006)
  const SALUTE_EN = [/\bburn/, /\bfat\b/, /slim/, /weight ?loss/, /lose weight/, /detox/, /cleans/, /\bcures?\b/, /\bheal/, /prevent/, /immun/, /metabolism/, /antioxidant/, /\bhealth/];
  const senzaSaluteEn = (...t: string[]) => { const x = normalizza(t.join(" ")); return x.length > 0 && !SALUTE_EN.some((r) => r.test(x)); };
  // Ogni lingua usa il suo elenco: quello italiano contiene "grass" (grassi), che in inglese
  // troverebbe per errore "grassy" (erbaceo). Errore trovato nel ricontrollo del 26/10/2026.
  const pulito = (...t: string[]) => (M.lingua === "en" ? senzaSaluteEn(...t) : senzaSalute(...t));

  // Taglia un testo con "..." quando supera la larghezza massima, come fa Google
  function taglia(t: string, max: number) {
    if (pixel(t) <= max) return t;
    while (t.length > 1 && pixel(t + " ...") > max) t = t.slice(0, -1);
    return t.trimEnd() + " ...";
  }

  function aggiorna() {
    const t = campo("titolo").value.trim();
    const d = campo("descrizione").value.trim();
    const k = campo("keyword").value.trim();
    const u = campo("url").value.trim().replace(/^https?:\/\//, "").replace(/\/$/, "");
    const px = pixel(t);

    $("[data-conta-t]").textContent = `${px} / ${LIMITI.titoloPx} px · ${t.length} ${M.caratteri}`;
    $("[data-conta-d]").textContent = `${d.length} ${M.caratteri}`;
    const bt = $("[data-barra-t]"), bd = $("[data-barra-d]");
    bt.style.width = `${Math.min(100, (px / LIMITI.titoloPx) * 100)}%`;
    bt.style.background = px > LIMITI.titoloPx ? "#c0392b" : t.length >= LIMITI.titoloMin ? "#2f7a4f" : "#ff7a1a";
    bd.style.width = `${Math.min(100, (d.length / LIMITI.descrizione[1]) * 100)}%`;
    bd.style.background = d.length > LIMITI.descrizione[1] ? "#c0392b" : d.length >= LIMITI.descrizione[0] ? "#2f7a4f" : "#ff7a1a";

    $("[data-a-url]").textContent = u ? u.split("/").join(" › ") : M.urlVuoto;
    $("[data-a-titolo]").textContent = t ? taglia(t, LIMITI.titoloPx) : M.titoloVuoto;
    $("[data-a-desc]").textContent = d ? (d.length > 160 ? d.slice(0, 155).trimEnd() + " ..." : d) : M.descrVuota;

    // Controlli: null = non ancora valutabile (grigio), true = verde, false = rosso
    const esiti: (boolean | null)[] = [
      t ? px <= LIMITI.titoloPx : null,
      t ? t.length >= LIMITI.titoloMin : null,
      d ? d.length >= LIMITI.descrizione[0] && d.length <= LIMITI.descrizione[1] : null,
      k && t ? normalizza(t).includes(normalizza(k)) : null,
      t || d ? pulito(t, d) : null,
    ];
    $("[data-esiti]").innerHTML = esiti.map((ok, i) => `<li class="${ok === true ? "ok" : ok === false ? "no" : ""}">${ok === true ? "✓ " : ok === false ? "✗ " : ""}${M.esiti[i]}</li>`).join("");
  }

  form.addEventListener("input", aggiorna);
  form.addEventListener("reset", () => setTimeout(aggiorna));
  $("[data-esempio]").addEventListener("click", () => {
    for (const [k, v] of Object.entries(M.esempio as Record<string, string>)) campo(k).value = v;
    aggiorna();
  });
  aggiorna();
</script>

<style>
  .serp { background: #fff; border: 1px solid var(--linea); border-radius: 14px; padding: 16px 18px; display: flex; flex-direction: column; gap: 4px; }
  .s-url { font-size: .82rem; color: #3d6b4a; overflow-wrap: anywhere; }
  .s-titolo { font-family: Arial, sans-serif; font-size: 20px; line-height: 1.3; color: #1f45b8; overflow-wrap: anywhere; }
  .s-desc { font-size: .9rem; line-height: 1.5; color: #4a4a4a; overflow-wrap: anywhere; }
  .nota { margin: 0; font-size: .82rem; color: var(--testo-3); line-height: 1.5; }
</style>
