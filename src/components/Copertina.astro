const ALT_EN: Record<string, string> = {
  basi: "The peach walks along the 4 stages of the customer journey",
  seo: "The peach searches on Google with a magnifying glass",
  sea: "The peach next to a rising chart",
  social: "The peach publishes a post and hearts arrive",
  influencer: "The peach with glasses checks a sponsored post",
  crm: "The peach receives an email with a heart: the customer comes back",
  brand: "The peach chooses the brand colours",
  carriera: "The peach with glasses and her portfolio",
  regole: "The peach next to a shield and a cookie: privacy and consent",
};
interface Props { tema: string; altezza?: number; lang?: "it" | "en"; }
const { tema, altezza = 150, lang = "it" } = Astro.props;
const scena = SCENE[tema] ?? SCENE.basi;
const alt = lang === "en" ? (ALT_EN[tema] ?? ALT_EN.basi) : scena.alt;
---
<svg class="copertina" viewBox="0 0 320 150" width="100%" height={altezza} preserveAspectRatio="xMidYMid slice" role="img" aria-label={alt} set:html={scena.svg} />

<style>
  .copertina { display: block; }
</style>
