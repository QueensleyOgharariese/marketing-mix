---
// CORNICE DELLA WORKSPACE SEO (percorso SEO "Approfondisci", livello junior)
// In alto: livello e missioni completate. A sinistra il menu (Il lavoro, Strumenti), al centro lo strumento,
// a destra la guida della missione (componente GuidaMissione).
// Gli strumenti sono ispirati a quelli professionali (Google Search Console, Keyword Planner,
// Screaming Frog, Google Analytics) ma hanno nomi generici: non imitano marchi reali.
// Qui ci sono anche gli stili comuni (tabelle, schede, numeri), validi per tutti gli strumenti.
import AppLayout from "../../layouts/AppLayout.astro";
import GuidaMissione from "./GuidaMissione.astro";

interface Props { attivo: string; titolo: string; ispirato?: string; sottotitolo?: string; }
const { attivo, titolo, ispirato, sottotitolo } = Astro.props;
const B = "/app/percorsi/seo";
const GRUPPI = [
  { nome: "Il lavoro", voci: [
    { id: "percorso", nome: "Panoramica", link: `${B}/` },
    { id: "negozio", nome: "Il negozio", link: "/app/negozio/" },
  ] },
  { nome: "Strumenti", voci: [
    { id: "console", nome: "Console di ricerca", link: `${B}/strumenti/console/` },
    { id: "indicizzazione", nome: "Pagine e indicizzazione", link: `${B}/strumenti/indicizzazione/` },
    { id: "keyword", nome: "Ricerca keyword", link: `${B}/strumenti/keyword/` },
    { id: "crawler", nome: "Crawler", link: `${B}/strumenti/crawler/` },
    { id: "statistiche", nome: "Statistiche", link: `${B}/strumenti/statistiche/` },
  ] },
];
// La guida della missione c'è in tutti gli strumenti (non nella panoramica)
const conGuida = attivo !== "percorso";
---
<AppLayout title={`${titolo} · Percorso SEO`} percorso={attivo === "percorso" ? [{ etichetta: "Percorso SEO" }] : [{ etichetta: "Percorso SEO", link: `${B}/` }, { etichetta: titolo }]} indietro={{ etichetta: "Scrivania", link: "/app/scrivania/" }}>
  <div slot="barra" class="stato">
    <span class="livello">Livello junior</span>
    <span class="missioni-testo" data-missioni-testo>Missioni 0 di 5</span>
    <span class="missioni-barra" aria-hidden="true"><span data-missioni-barra></span></span>
  </div>
  <div class:list={["console", { "con-guida": conGuida }]}>
    <nav class="menu" aria-label="Workspace SEO">
      {GRUPPI.map((g) => (
        <div class="gruppo">
          <span class="menu-titolo">{g.nome}</span>
          {g.voci.map((v) => (
            <a class:list={["voce", { attiva: v.id === attivo }]} href={v.link} aria-current={v.id === attivo ? "page" : undefined}>
              <span class="pallino" aria-hidden="true"></span>{v.nome}
            </a>
          ))}
        </div>
      ))}
      <p class="menu-nota">Dati inventati ma coerenti: un problema che trovi in uno strumento lo ritrovi anche negli altri.</p>
    </nav>
    <main class="contenuto">
      <header class="testa">
        <h1 class="app-titolo">{titolo}</h1>
        {sottotitolo && <p class="sottotitolo">{sottotitolo}</p>}
        {ispirato && <p class="ispirato">Simulazione ispirata a {ispirato}</p>}
      </header>
      <slot />
    </main>
    {conGuida && <aside class="guida" aria-label="Guida della missione"><GuidaMissione pagina={attivo} /></aside>}
  </div>
</AppLayout>

<script>
  // Missioni completate: lette dai progressi salvati nel browser (chiave del percorso SEO)
  function aggiornaBarra() {
    try {
      const dati = JSON.parse(localStorage.getItem("marketing-mix-percorso-seo") ?? "{}");
      const fatte = Object.values(dati.missioni ?? {}).filter((m: any) => m?.stato === "completata").length;
      const t = document.querySelector("[data-missioni-testo]"); const b = document.querySelector<HTMLElement>("[data-missioni-barra]");
      if (t) t.textContent = `Missioni ${fatte} di 5`;
      if (b) b.style.width = `${(fatte / 5) * 100}%`;
    } catch {}
  }
  aggiornaBarra();
  // la guida avvisa quando una missione finisce
  document.addEventListener("missioni-aggiornate", aggiornaBarra);
</script>

<style>
  .stato { display: flex; align-items: center; gap: 10px; font-size: .82rem; color: #55514c; }
  .livello { font-weight: 700; background: var(--arancio); color: var(--inchiostro); padding: 4px 10px; border-radius: 999px; }
  .missioni-barra { width: 90px; height: 6px; border-radius: 99px; background: #e9e8e4; overflow: hidden; }
  .missioni-barra span { display: block; height: 100%; width: 0; background: var(--arancio); }
  .console { display: grid; grid-template-columns: 240px minmax(0, 1fr); min-height: calc(100vh - 61px); }
  .console.con-guida { grid-template-columns: 240px minmax(0, 1fr) 340px; }
  .menu { background: #fff; border-right: 1px solid #e3e1dc; padding: 20px 12px; display: flex; flex-direction: column; gap: 14px; }
  .gruppo { display: flex; flex-direction: column; gap: 2px; }
  .menu-titolo { font-size: .78rem; font-weight: 700; color: #55514c; padding: 0 12px 6px; }
  .voce { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 10px; color: #423e39; text-decoration: none; font-size: .9rem; }
  .voce:hover { background: #f4f4f2; color: var(--inchiostro); }
  .voce.attiva { background: #e9e8e4; color: var(--inchiostro); font-weight: 700; }
  .pallino { flex: none; width: 8px; height: 8px; border-radius: 50%; background: #d1cec8; }
  .attiva .pallino { background: var(--arancio); }
  .menu-nota { margin-top: auto; font-size: .78rem; color: #55514c; line-height: 1.5; padding: 10px; }
  .contenuto { min-width: 0; padding: 26px 30px 56px; display: flex; flex-direction: column; gap: 18px; }
  .testa h1 { font-size: 1.85rem; }
  .sottotitolo { margin: 4px 0 0; font-size: .92rem; color: #423e39; }
  .ispirato { margin: 2px 0 0; font-size: .8rem; color: #625e58; }
  .guida { background: #fff; border-left: 1px solid #e3e1dc; padding: 24px 22px; display: flex; flex-direction: column; gap: 16px; align-self: start; position: sticky; top: 61px; max-height: calc(100vh - 61px); overflow-y: auto; min-height: calc(100vh - 61px); box-sizing: border-box; }
  @media (max-width: 1180px) {
    .console.con-guida { grid-template-columns: 220px minmax(0, 1fr); }
    .guida { grid-column: 1 / -1; border-left: 0; border-top: 1px solid #e3e1dc; position: static; max-height: none; min-height: 0; }
  }
  @media (max-width: 860px) {
    .console, .console.con-guida { grid-template-columns: 1fr; }
    .menu { flex-direction: row; flex-wrap: nowrap; overflow-x: auto; border-right: 0; border-bottom: 1px solid #e3e1dc; padding: 10px; gap: 4px; }
    .gruppo { flex-direction: row; gap: 4px; }
    .menu-titolo, .menu-nota { display: none; }
    .voce { white-space: nowrap; flex: none; }
    .contenuto { padding: 18px 14px 40px; }
    .missioni-testo { display: none; }
  }
</style>

<style is:global>
  /* ---- Stili comuni degli strumenti SEO ---- */
  .sp-pannello { background: #fff; border: 1px solid #e3e1dc; border-radius: 14px; padding: 18px 20px; min-width: 0; }
  .sp-riga { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; }
  .sp-cifre { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
  .sp-cifra { background: #fff; border: 1px solid #e3e1dc; border-radius: 12px; padding: 14px 16px; display: flex; flex-direction: column; gap: 2px; }
  .sp-cifra span { font-size: .78rem; color: #5f5a55; font-weight: 600; }
  .sp-cifra strong { font-family: var(--font-titoli); font-size: 1.7rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .sp-cifra small { font-size: .78rem; font-weight: 700; }
  .su { color: #2f7a4f; } .giu { color: #c0392b; }
  .sp-schede { display: flex; flex-wrap: wrap; gap: 4px; border-bottom: 1px solid #e3e1dc; }
  .sp-schede button { font: inherit; font-weight: 700; font-size: .9rem; background: none; border: 0; border-bottom: 3px solid transparent; padding: 10px 14px; color: #5f5a55; cursor: pointer; }
  .sp-schede button[aria-selected="true"] { color: var(--inchiostro); border-bottom-color: var(--arancio); }
  .sp-cerca { font: inherit; font-size: .9rem; padding: 9px 12px; border: 1px solid #d1cec8; border-radius: 10px; min-width: 220px; background: #fff; }
  .sp-cerca:focus, .sp-scegli:focus { outline: 2px solid var(--arancio); outline-offset: 1px; }
  .sp-scegli { font: inherit; font-size: .9rem; padding: 8px 10px; border: 1px solid #d1cec8; border-radius: 10px; background: #fff; }
  .sp-scorri { overflow-x: auto; border: 1px solid #e3e1dc; border-radius: 12px; background: #fff; }
  table[data-tabella] { width: 100%; border-collapse: collapse; font-size: .85rem; font-variant-numeric: tabular-nums; }
  table[data-tabella] th { text-align: left; font-size: .75rem; color: #5f5a55; font-weight: 700; padding: 0; border-bottom: 1px solid #e3e1dc; white-space: nowrap; background: #f8f8f6; position: sticky; top: 0; }
  table[data-tabella] th:not(:has(button)) { padding: 9px 10px; }
  table[data-tabella] th .ordina { font: inherit; font-weight: 700; color: inherit; background: none; border: 0; padding: 9px 10px; cursor: pointer; display: flex; align-items: center; gap: 4px; width: 100%; text-align: left; }
  table[data-tabella] th[aria-sort="descending"] .freccia::after { content: "↓"; color: var(--arancio-scuro); }
  table[data-tabella] th[aria-sort="ascending"] .freccia::after { content: "↑"; color: var(--arancio-scuro); }
  table[data-tabella] td { padding: 8px 10px; border-bottom: 1px solid #efeeeb; vertical-align: top; }
  table[data-tabella] td.n, table[data-tabella] th.n { text-align: right; white-space: nowrap; }
  table[data-tabella] th.n .ordina { justify-content: flex-end; }
  table[data-tabella] tbody tr:hover { background: #f8f8f6; }
  table[data-tabella] tr.selezionata { background: #efeeea; }
  .url { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: .8rem; overflow-wrap: anywhere; }
  .sp-badge { display: inline-block; font-size: .72rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; background: #efeeeb; color: #55514c; white-space: nowrap; }
  .sp-badge.ok { background: #e3f3e8; color: #1f5c38; } .sp-badge.no { background: #fde8e4; color: #a12d1d; } .sp-badge.medio { background: #fff3d6; color: #7a5200; }
  .sp-nota { font-size: .8rem; color: #5f5a55; line-height: 1.5; margin: 0; }
  .sp-grafico { width: 100%; height: auto; display: block; }
</style>
