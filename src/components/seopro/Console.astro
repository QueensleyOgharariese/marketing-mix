---
// CORNICE DELLA SIMULAZIONE SEO (prima "percorso SEO junior"; dal 30/10/2026 si chiama "Simulazione SEO")
// In alto: livello e missioni completate. A sinistra il menu (Il lavoro, Strumenti), al centro lo strumento,
// a destra la guida della missione (componente GuidaMissione).
// Gli strumenti sono ispirati a quelli professionali (Google Search Console, Keyword Planner,
// Screaming Frog, Google Analytics) ma hanno nomi generici: non imitano marchi reali.
// Qui ci sono anche gli stili comuni (tabelle, schede, numeri), validi per tutti gli strumenti.
import AppLayout from "../../layouts/AppLayout.astro";
import GuidaMissione from "./GuidaMissione.astro";
import SchermoIntero from "../SchermoIntero.astro";

// sim: quale simulazione (seo o social). Cambiano menu, nome e conteggio degli esercizi; tutto il resto è comune.
interface Props { attivo: string; titolo: string; ispirato?: string; sottotitolo?: string; sim?: "seo" | "social" | "sea" | "brand" }
import { testiDa } from "../../i18n";
const { attivo, titolo, ispirato, sottotitolo, sim = "seo" } = Astro.props;
const L = testiDa(Astro.url);
const B = "/app/percorsi/seo";
const S = "/app/simulazioni/social";
const A = "/app/simulazioni/sea";
const R = "/app/simulazioni/brand";
const NOME = L(`Simulazione ${sim === "seo" || sim === "sea" ? sim.toUpperCase() : sim[0].toUpperCase() + sim.slice(1)}`, `${sim === "seo" || sim === "sea" ? sim.toUpperCase() : sim[0].toUpperCase() + sim.slice(1)} Simulation`);
const BASE = { seo: B, social: S, sea: A, brand: R }[sim];
const GRUPPI = sim === "brand" ? [
  { nome: L("Il lavoro", "The work"), voci: [
    { id: "percorso", nome: L("Panoramica", "Overview"), link: `${R}/` },
    { id: "manuale", nome: L("Manuale del brand", "Brand manual"), link: `${R}/manuale/` },
    { id: "testi", nome: L("Testi del brand", "Brand copy"), link: `${R}/testi/` },
    { id: "piano", nome: L("Piano di brand", "Brand plan"), link: `${R}/piano/` },
    { id: "stampa", nome: L("Ufficio stampa", "Press office"), link: `${R}/stampa/` },
  ] },
  { nome: L("Strumenti", "Tools"), voci: [
    { id: "ricerche", nome: L("Ricerche sul brand", "Brand research"), link: `${R}/ricerche/` },
  ] },
] : sim === "sea" ? [
  { nome: L("Il lavoro", "The work"), voci: [
    { id: "percorso", nome: L("Panoramica", "Overview"), link: `${A}/` },
    { id: "campagne", nome: L("Campagne", "Campaigns"), link: `${A}/campagne/` },
  ] },
  { nome: L("Strumenti", "Tools"), voci: [
    { id: "termini", nome: L("Termini di ricerca", "Search terms"), link: `${A}/termini/` },
    { id: "pianificatore", nome: L("Pianificatore keyword", "Keyword planner"), link: `${A}/pianificatore/` },
    { id: "rendimento", nome: L("Rendimento sul sito", "Website performance"), link: `${A}/rendimento/` },
  ] },
] : sim === "social" ? [
  { nome: L("Il lavoro", "The work"), voci: [
    { id: "percorso", nome: L("Panoramica", "Overview"), link: `${S}/` },
    { id: "profilo", nome: L("Il profilo", "The profile"), link: `${S}/profilo/` },
    { id: "calendario", nome: L("Calendario e post", "Calendar and posts"), link: `${S}/calendario/` },
    { id: "community", nome: L("Commenti e messaggi", "Comments and messages"), link: `${S}/community/` },
  ] },
  { nome: L("Strumenti", "Tools"), voci: [
    { id: "insight", nome: L("Statistiche dei post", "Post insights"), link: `${S}/statistiche/` },
    { id: "libreria", nome: L("Libreria foto e musica", "Photo and music library"), link: `${S}/libreria/` },
  ] },
] : [
  { nome: L("Il lavoro", "The work"), voci: [
    { id: "percorso", nome: L("Panoramica", "Overview"), link: `${B}/` },
    { id: "negozio", nome: L("Il negozio", "The shop"), link: "/app/negozio/" },
    { id: "pannello", nome: L("Pannello del negozio", "Shop admin"), link: `${B}/pannello/` },
  ] },
  { nome: L("Strumenti", "Tools"), voci: [
    { id: "console", nome: L("Console di ricerca", "Search console"), link: `${B}/strumenti/console/` },
    { id: "indicizzazione", nome: L("Pagine e indicizzazione", "Pages and indexing"), link: `${B}/strumenti/indicizzazione/` },
    { id: "keyword", nome: L("Ricerca keyword", "Keyword research"), link: `${B}/strumenti/keyword/` },
    { id: "crawler", nome: "Crawler", link: `${B}/strumenti/crawler/` },
    { id: "statistiche", nome: L("Statistiche", "Analytics"), link: `${B}/strumenti/statistiche/` },
  ] },
];
// La guida della missione c'è in tutti gli strumenti (non nella panoramica)
const conGuida = attivo !== "percorso";
---
<AppLayout title={`${titolo} · ${NOME}`} percorso={attivo === "percorso" ? [{ etichetta: NOME }] : [{ etichetta: NOME, link: `${BASE}/` }, { etichetta: titolo }]} indietro={{ etichetta: L("Simulazioni", "Simulations"), link: "/app/simulazioni/" }}>
  <div slot="barra" class="stato">
    <SchermoIntero />
    <span class="missioni-testo" data-missioni-testo data-sim={sim}>{L("Esercizi 0", "Exercises 0")}</span>
    <span class="missioni-barra" aria-hidden="true"><span data-missioni-barra></span></span>
  </div>
  <div class:list={["console", { "con-guida": conGuida }]}>
    <nav class="menu" aria-label={L(`Strumenti della ${NOME}`, `${NOME} tools`)} data-barra="menu-seo" data-etichetta="menu">
      {GRUPPI.map((g) => (
        <div class="gruppo">
          <span class="menu-titolo">{g.nome}</span>
          {g.voci.map((v) => (
            <a class:list={["voce", { attiva: v.id === attivo }]} href={v.link} aria-current={v.id === attivo ? "page" : undefined}>
              <span class="pallino" aria-hidden="true"></span>{v.nome}
            </a>
          ))}
        </div>
      ))}
      <p class="menu-nota">{L("Dati inventati ma coerenti: un problema che trovi in uno strumento lo ritrovi anche negli altri.", "Invented but consistent data: a problem you find in one tool also shows up in the others.")}</p>
    </nav>
    <main class="contenuto">
      <header class="testa">
        <h1 class="app-titolo">{titolo}</h1>
        {sottotitolo && <p class="sottotitolo">{sottotitolo}</p>}
        {ispirato && <p class="ispirato">{L("Simulazione ispirata a", "Simulation inspired by")} {ispirato}</p>}
      </header>
      <slot />
    </main>
    {conGuida && <aside class="guida" aria-label={L("Guida della missione", "Exercise guide")} data-barra="guida-seo" data-lato="destra" data-etichetta={L("guida", "guide")}><GuidaMissione pagina={attivo} sim={sim} /></aside>}
  </div>
</AppLayout>

<script>
  // Esercizi completati: letti dai progressi salvati nel browser (il tutorial non conta)
  import { motoreSeo } from "../../scripts/missioni";
  import { motoreSocial } from "../../scripts/social/missioni-social";
  import { motoreSea } from "../../scripts/sea/missioni-sea";
  import { motoreBrand } from "../../scripts/brand/missioni-brand";
  import { t as tr } from "../../scripts/lingua";
  function aggiornaBarra() {
    const t = document.querySelector<HTMLElement>("[data-missioni-testo]"); const b = document.querySelector<HTMLElement>("[data-missioni-barra]");
    const mo = { social: motoreSocial, sea: motoreSea, brand: motoreBrand }[t?.dataset.sim ?? ""] ?? motoreSeo;
    const s = mo.leggiStato();
    const n = mo.MISSIONI.filter((m) => mo.fatta(s, m)).length;
    if (t) t.textContent = `${tr("Esercizi", "Exercises")} ${n} ${tr("di", "of")} ${mo.MISSIONI.length}`;
    if (b) b.style.width = `${(n / mo.MISSIONI.length) * 100}%`;
  }
  aggiornaBarra();
  // la guida avvisa quando un esercizio finisce
  document.addEventListener("missioni-aggiornate", aggiornaBarra);
</script>

<style>
  .stato { display: flex; align-items: center; gap: 12px; font-size: .82rem; color: #55514c; }
  .livello { font-weight: 700; background: var(--arancio); color: var(--inchiostro); padding: 4px 10px; border-radius: 999px; }
  .missioni-barra { width: 90px; height: 6px; border-radius: 99px; background: #e9e8e4; overflow: hidden; }
  .missioni-barra span { display: block; height: 100%; width: 0; background: var(--arancio); }
  .console { display: grid; grid-template-columns: 248px minmax(0, 1fr); min-height: calc(100vh - 61px); }
  .console.con-guida { grid-template-columns: 248px minmax(0, 1fr) 400px; }
  .menu { background: #fff; border-right: 1px solid #e3e1dc; padding: 24px 16px; display: flex; flex-direction: column; gap: 24px; }
  .gruppo { display: flex; flex-direction: column; gap: 2px; }
  .menu-titolo { font-size: .78rem; font-weight: 700; color: #55514c; padding: 0 12px 8px; }
  .voce { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 10px; color: #423e39; text-decoration: none; font-size: .9rem; }
  .voce:hover { background: #f4f4f2; color: var(--inchiostro); }
  .voce.attiva { background: #e9e8e4; color: var(--inchiostro); font-weight: 700; }
  .pallino { flex: none; width: 8px; height: 8px; border-radius: 50%; background: #d1cec8; }
  .attiva .pallino { background: var(--arancio); }
  .menu-nota { margin-top: auto; font-size: .78rem; color: #55514c; line-height: 1.5; padding: 10px; }
  .contenuto { min-width: 0; width: 100%; max-width: 1280px; margin: 0 auto; box-sizing: border-box; padding: 32px 40px 72px; display: flex; flex-direction: column; gap: 24px; }
  .testa { display: flex; flex-direction: column; gap: 6px; margin-bottom: 4px; }
  .testa h1 { font-size: 2rem; line-height: 1.15; }
  .sottotitolo { margin: 0; font-size: .95rem; color: #423e39; }
  .ispirato { margin: 0; font-size: .8rem; color: #625e58; }
  .guida { background: #fff; border-left: 1px solid #e3e1dc; padding: 28px 24px 0; display: flex; flex-direction: column; gap: 18px; align-self: start; position: sticky; top: 61px; max-height: calc(100vh - 61px); overflow-y: auto; min-height: calc(100vh - 61px); box-sizing: border-box; }
  /* Barre chiuse: diventano strisce sottili da 52 px */
  .console:has(> .menu[data-chiuso]) { grid-template-columns: 52px minmax(0, 1fr); }
  .console.con-guida:has(> .menu[data-chiuso]) { grid-template-columns: 52px minmax(0, 1fr) 400px; }
  .console.con-guida:has(> .guida[data-chiuso]) { grid-template-columns: 248px minmax(0, 1fr) 52px; }
  .console.con-guida:has(> .menu[data-chiuso]):has(> .guida[data-chiuso]) { grid-template-columns: 52px minmax(0, 1fr) 52px; }
  .guida[data-chiuso] { min-height: 0; }
  @media (max-width: 1180px) {
    .console.con-guida:has(> .guida[data-chiuso]) { grid-template-columns: 220px minmax(0, 1fr); }
    .console.con-guida:has(> .menu[data-chiuso]):has(> .guida[data-chiuso]) { grid-template-columns: 52px minmax(0, 1fr); }
    .guida[data-chiuso] > :global(.apri-pannello) { margin: 0; }
    .console.con-guida { grid-template-columns: 220px minmax(0, 1fr); }
    .guida { grid-column: 1 / -1; border-left: 0; border-top: 1px solid #e3e1dc; position: static; max-height: none; min-height: 0; }
  }
  @media (max-width: 860px) {
    .console, .console.con-guida { grid-template-columns: 1fr; }
    .menu { flex-direction: row; flex-wrap: nowrap; overflow-x: auto; border-right: 0; border-bottom: 1px solid #e3e1dc; padding: 10px; gap: 4px; }
    .gruppo { flex-direction: row; gap: 4px; }
    .menu-titolo, .menu-nota { display: none; }
    .voce { white-space: nowrap; flex: none; }
    .contenuto { padding: 20px 16px 48px; gap: 20px; }
    .missioni-testo { display: none; }
  }
</style>

<style is:global>
  /* ---- Stili comuni degli strumenti SEO ---- */
  .sp-pannello { background: #fff; border: 1px solid #e3e1dc; border-radius: 16px; padding: 20px 24px; min-width: 0; }
  .sp-riga { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; }
  .sp-cifre { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 16px; }
  .sp-cifra { background: #fff; border: 1px solid #e3e1dc; border-radius: 16px; padding: 18px 20px; display: flex; flex-direction: column; gap: 4px; }
  .sp-cifra span { font-size: .78rem; color: #5f5a55; font-weight: 600; }
  .sp-cifra strong { font-family: var(--font-titoli); font-size: 1.7rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .sp-cifra small { font-size: .78rem; font-weight: 700; }
  .su { color: #2f7a4f; } .giu { color: #c0392b; }
  .sp-schede { display: flex; flex-wrap: wrap; gap: 4px; border-bottom: 1px solid #e3e1dc; }
  .sp-schede button { font: inherit; font-weight: 700; font-size: .9rem; background: none; border: 0; border-bottom: 3px solid transparent; padding: 10px 14px; color: #5f5a55; cursor: pointer; }
  .sp-schede button[aria-selected="true"] { color: var(--inchiostro); border-bottom-color: var(--arancio); }
  .sp-cerca { font: inherit; font-size: .9rem; padding: 9px 12px; border: 1px solid #d1cec8; border-radius: 10px; min-width: 220px; background: #fff; }
  .sp-cerca:focus, .sp-scegli:focus { outline: 2px solid var(--arancio); outline-offset: 1px; }
  .sp-scegli { font: inherit; font-size: .9rem; padding: 8px 10px; border: 1px solid #d1cec8; border-radius: 10px; background: #fff; }
  .sp-scorri { overflow-x: auto; border: 1px solid #e3e1dc; border-radius: 12px; background: #fff; }
  table[data-tabella] { width: 100%; border-collapse: collapse; font-size: .85rem; font-variant-numeric: tabular-nums; }
  table[data-tabella] th { text-align: left; font-size: .75rem; color: #5f5a55; font-weight: 700; padding: 0; border-bottom: 1px solid #e3e1dc; white-space: nowrap; background: #f8f8f6; position: sticky; top: 0; }
  table[data-tabella] th:not(:has(button)) { padding: 10px 12px; }
  table[data-tabella] th .ordina { font: inherit; font-weight: 700; color: inherit; background: none; border: 0; padding: 9px 10px; cursor: pointer; display: flex; align-items: center; gap: 4px; width: 100%; text-align: left; padding: 10px 12px !important; }
  table[data-tabella] th[aria-sort="descending"] .freccia::after { content: "↓"; color: var(--arancio-scuro); }
  table[data-tabella] th[aria-sort="ascending"] .freccia::after { content: "↑"; color: var(--arancio-scuro); }
  table[data-tabella] td { padding: 10px 12px; border-bottom: 1px solid #efeeeb; vertical-align: top; }
  table[data-tabella] td.n, table[data-tabella] th.n { text-align: right; white-space: nowrap; }
  table[data-tabella] th.n .ordina { justify-content: flex-end; }
  table[data-tabella] tbody tr:hover { background: #f8f8f6; }
  table[data-tabella] tr.selezionata { background: #efeeea; }
  .url { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: .8rem; overflow-wrap: anywhere; }
  .sp-badge { display: inline-block; font-size: .72rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; background: #efeeeb; color: #55514c; white-space: nowrap; }
  .sp-badge.ok { background: #e3f3e8; color: #1f5c38; } .sp-badge.no { background: #fde8e4; color: #a12d1d; } .sp-badge.medio { background: #fff3d6; color: #7a5200; }
  .sp-nota { font-size: .8rem; color: #5f5a55; line-height: 1.5; margin: 0; }
  .sp-grafico { width: 100%; height: auto; display: block; }
</style>
