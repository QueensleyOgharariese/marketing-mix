---
// GUIDA DELL'ESERCIZIO (pannello a destra negli strumenti, nel Pannello del negozio e nel negozio)
// Ordine (30/10/2026): prima il compito, poi la risposta; gli aiuti stanno in tre schede chiuse finché non servono.
//   testa:  nome dell'esercizio, barre di avanzamento, "Mini esercizio X di N", Ricomincia
//   corpo:  messaggio di Elena (solo al primo mini esercizio), domanda, consegna, risposta
//           (scelta, modifica sul sito o testo da scrivere), esito, schede di aiuto
//   piede:  Controlla (sempre visibile in basso) e "Mostrami lo strumento"
// Schede di aiuto:
//   Come funziona = come si usa lo strumento (aiuto-strumenti.json), mai la risposta
//   Teoria        = spiegazione, esempio, errore comune (gratis)
//   Indizio       = una spinta verso la risposta (costa 5 punti)
// La guida cala con il livello: Basi "Come funziona" già aperto; Diagnosi tutto chiuso; Casi solo Teoria.
// Il contenuto arriva da missioni.json e viene disegnato nel browser, perché dipende dallo stato salvato (localStorage).
// pagina: id dello strumento in cui si trova la guida (console, crawler, negozio...); sim: quale simulazione
interface Props { pagina: string; sim?: "seo" | "social" | "sea" }
const { pagina, sim = "seo" } = Astro.props;
---
<div class="gm" data-guida-missione={pagina} data-sim={sim} aria-live="polite">
  <p class="gm-attesa">Caricamento dell'esercizio…</p>
</div>

<script>
  import { motoreSeo, type Missione, type Passo } from "../../scripts/missioni";
  import { motoreSocial } from "../../scripts/social/missioni-social";
  import { motoreSea } from "../../scripts/sea/missioni-sea";
  // La stessa guida serve tutte le simulazioni: si sceglie il motore in base a data-sim
  const SIM = document.querySelector<HTMLElement>("[data-guida-missione]")?.dataset.sim ?? "seo";
  const MO = { social: motoreSocial, sea: motoreSea }[SIM] ?? motoreSeo;
  const { TUTTE, LIVELLI, STRUMENTI, leggiStato, salvaStato, linkPasso, controlla, punti, avvia, ricomincia, etichetta, consigliata, livelloAperto } = MO;
  const PANORAMICA = `${MO.base}/`;
  // Chi assegna i compiti in ogni simulazione (persone inventate)
  const CHI = { social: { nome: "Sara L.", ruolo: "social media manager" }, sea: { nome: "Davide R.", ruolo: "performance marketing manager" } }[SIM] ?? { nome: "Elena M.", ruolo: "responsabile e-commerce" };
  import { verifica } from "../../scripts/verifiche";
  import AIUTO from "../../data/app/seo-pro/aiuto-strumenti.json";

  const radice = document.querySelector<HTMLElement>("[data-guida-missione]");
  const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  const AIUTI = AIUTO as unknown as Record<string, { nome: string; punti: string[] }>;

  // Testi scritti nella guida (passi "testo"): restano salvati in questo browser
  const CHIAVE_TESTI = "marketing-mix-seo-testi";
  const leggiTesti = (): Record<string, string> => { try { return JSON.parse(localStorage.getItem(CHIAVE_TESTI) ?? "{}"); } catch { return {}; } };
  const salvaTesto = (k: string, v: string) => { try { const t = leggiTesti(); t[k] = v; localStorage.setItem(CHIAVE_TESTI, JSON.stringify(t)); } catch {} };
  const contaParole = (t: string) => t.trim().split(/\s+/).filter(Boolean).length;

  function barre(m: Missione, passo: number) {
    return `<div class="gm-barre" aria-hidden="true">${m.passi.map((_, i) => `<span class="${i < passo ? "fatto" : i === passo ? "ora" : ""}"></span>`).join("")}</div>`;
  }
  function teoria(p: Passo) {
    return `<p>${esc(p.spiega)}</p>${p.esempio ? `<p class="gm-esempio"><strong>Per esempio</strong>${esc(p.esempio)}</p>` : ""}${p.errore ? `<p class="gm-errore"><strong>Errore comune</strong>${esc(p.errore)}</p>` : ""}`;
  }
  function comeFunziona(p: Passo) {
    const a = AIUTI[p.strumento];
    return a ? `<h3>${esc(a.nome)}</h3><ul>${a.punti.map((x) => `<li>${x}</li>`).join("")}</ul>` : "<p>Questo mini esercizio non usa uno strumento.</p>";
  }
  // Il bottone "Mostrami lo strumento" c'è solo se l'elemento è in questa pagina (e non nei Casi)
  const puoMostrare = (p: Passo, livello: number) => livello < 3 && !!p.dove && !!document.querySelector(p.dove);

  function mostraElemento(sel: string) {
    const el = document.querySelector<HTMLElement>(sel);
    if (!el) return;
    el.closest<HTMLElement>("[data-barra][data-chiuso]")?.querySelector<HTMLButtonElement>(".apri-pannello")?.click();
    const alto = el.getBoundingClientRect().height > innerHeight * 0.8;
    el.scrollIntoView({ behavior: "smooth", block: alto ? "start" : "center" });
    el.classList.add("gm-evidenzia");
    if (alto) el.style.outlineOffset = "-3px";
    setTimeout(() => { el.classList.remove("gm-evidenzia"); el.style.outlineOffset = ""; }, 2600);
  }

  function disegna() {
    if (!radice) return;
    const pagina = radice.dataset.guidaMissione!;
    const s = leggiStato();
    const m = TUTTE.find((x) => x.id === s.attiva);
    const sm = m ? s.missioni[m.id] : undefined;

    // Nessun esercizio in corso
    if (!m || !sm) {
      radice.innerHTML = `<div class="gm-corpo"><h2 class="gm-titolo">Nessun esercizio in corso</h2><p class="gm-testo">Puoi esplorare gli strumenti liberamente. Quando vuoi, scegli un esercizio dalla panoramica.</p><a class="bottone-app" href="${PANORAMICA}#livelli">Scegli un esercizio</a></div>`;
      return;
    }
    const tutorial = m.id === "tutorial";

    // Esercizio (o tutorial) completato: riepilogo e scelta del prossimo
    if (sm.stato === "completata") {
      const prossima = consigliata(s);
      const primo = sm.primoColpo.filter(Boolean).length;
      const domande = m.passi.filter((p) => p.tipo !== "info").length;
      const nuovo = m.livello < 3 && livelloAperto(s, m.livello + 1) && prossima?.livello === m.livello + 1 ? LIVELLI[m.livello + 1] : undefined;
      radice.innerHTML = `<div class="gm-testa"><p class="gm-missione">${esc(etichetta(m))}</p>${barre(m, m.passi.length)}</div>
        <div class="gm-corpo">
          <h2 class="gm-titolo">${tutorial ? "Tutorial completato" : "Esercizio completato"}</h2>
          ${tutorial ? "" : `<p class="gm-punti"><strong>${punti(sm)}</strong> punti su 100</p><p class="gm-testo">Giusti al primo tentativo: ${primo} su ${domande}. Aiuti usati: ${sm.aiuti.length}.</p>`}
          ${nuovo && !tutorial ? `<p class="gm-sblocco"><strong>Livello ${nuovo.n} aperto: ${esc(nuovo.nome)}</strong>${esc(nuovo.cosa)}</p>` : ""}
          <div class="gm-blocco"><h3>Cosa hai imparato</h3><ul>${m.imparato.map((x) => `<li>${esc(x)}</li>`).join("")}</ul></div>
          <div class="gm-messaggio"><strong>${CHI.nome}</strong><p>${esc(m.elena)}</p></div>
        </div>
        <div class="gm-piede">${prossima ? `<button type="button" class="bottone-app" data-prossima="${prossima.id}">Prossimo: ${esc(prossima.nome)}</button>` : ""}<a class="gm-secondario" href="${PANORAMICA}#livelli">${prossima ? "Scegli tu" : "Torna agli esercizi"}</a></div>`;
      radice.querySelector<HTMLButtonElement>("[data-prossima]")?.addEventListener("click", (e) => {
        location.href = avvia((e.currentTarget as HTMLElement).dataset.prossima!);
      });
      return;
    }

    const p = m.passi[sm.passo];
    const ultimo = sm.passo === m.passi.length - 1;
    const livello = m.livello;
    const testa = `<div class="gm-testa"><p class="gm-missione">${esc(etichetta(m))}</p>${barre(m, sm.passo)}<p class="gm-passo">${tutorial ? "Passo" : "Mini esercizio"} ${sm.passo + 1} di ${m.passi.length}<button type="button" class="gm-ricomincia" data-ricomincia>Ricomincia</button></p></div>`;
    const elena = sm.passo === 0 && m.situazione ? `<div class="gm-situazione"><span class="gm-da">${CHI.nome}, ${CHI.ruolo}</span><p>${esc(m.situazione)}</p></div>` : "";
    const avanti = ultimo ? (tutorial ? "Concludi il tutorial" : "Concludi l'esercizio") : "Passo successivo";

    // Passo "info" (tutorial): si legge e si va avanti
    if (p.tipo === "info") {
      radice.innerHTML = `${testa}<div class="gm-corpo">${elena}
        <h2 class="gm-titolo">${esc(p.domanda)}</h2>
        <p class="gm-testo">${esc(p.spiega)}</p>
        ${p.come?.length ? `<ul class="gm-elenco">${p.come.map((c) => `<li>${c}</li>`).join("")}</ul>` : ""}</div>
        <div class="gm-piede"><button type="button" class="bottone-app" data-avanti>${ultimo ? "Concludi il tutorial" : "Ho capito, avanti"}</button>${p.dove && document.querySelector(p.dove) ? `<button type="button" class="gm-secondario" data-dove>Mostrami dove</button>` : ""}</div>`;
      radice.querySelector("[data-avanti]")!.addEventListener("click", () => vaiAvanti(m, ultimo, pagina));
      radice.querySelector("[data-dove]")?.addEventListener("click", () => mostraElemento(p.dove));
      return;
    }

    // Passo a scelta che si fa in un altro strumento: la guida dice dove e porta lì
    if ((p.tipo === "radio" || p.tipo === "checkbox") && p.strumento !== pagina) {
      radice.innerHTML = `${testa}<div class="gm-corpo">${elena}<h2 class="gm-titolo">${esc(p.domanda)}</h2><p class="gm-testo">Questo mini esercizio si fa in <strong>${esc(STRUMENTI[p.strumento].nome)}</strong>.</p></div>
        <div class="gm-piede"><a class="bottone-app" href="${linkPasso(p)}">Vai a ${esc(STRUMENTI[p.strumento].nome)}</a></div>`;
      return;
    }

    // --- Risposta: scelta, modifica sul sito o testo ---
    const chiaveTesto = `${SIM === "seo" ? "" : SIM + "-"}${m.id}-${sm.passo}`; // le simulazioni hanno id uguali (base1, d1…): il prefisso li tiene separati
    let risposta = "";
    if (p.tipo === "radio" || p.tipo === "checkbox") {
      risposta = `<fieldset class="gm-opzioni"><legend>${p.tipo === "checkbox" ? "Scegli tutte le risposte giuste" : "Scegli una risposta"}</legend>
        ${p.opzioni.map((o) => `<label class="gm-opzione"><input type="${p.tipo}" name="gm-r" value="${o.id}" /><span>${esc(o.testo)}</span></label>`).join("")}</fieldset>`;
    } else if (p.tipo === "azione") {
      risposta = `<div class="gm-lavoro">
          ${p.vai ? `<a class="gm-secondario" href="${p.vai.link}">${esc(p.vai.testo)}</a>` : ""}
          <p class="gm-nota">Fai la modifica, salvala e poi premi <strong>Controlla il lavoro</strong>. Puoi riprovare senza perdere punti.${p.negozio ? ` <a href="${p.negozio}">Guarda il risultato nel negozio</a>` : ""}</p>
        </div>`;
    } else if (p.tipo === "testo") {
      const [min, max] = p.parole ?? [30, 160];
      risposta = `<label class="gm-scrivi"><span class="sr">Il tuo testo</span>
          <textarea rows="8" data-gm-testo placeholder="Scrivi qui…">${esc(leggiTesti()[chiaveTesto] ?? "")}</textarea>
          <span class="gm-conta" data-conta>0 parole · tra ${min} e ${max}</span></label>`;
    }

    // --- Schede di aiuto (dipendono dal livello) ---
    const schede: [string, string, string][] = livello >= 3
      ? [["teoria", "Teoria", "gratis"]]
      : [["funziona", "Come funziona", "lo strumento"], ["teoria", "Teoria", "gratis"], ["indizio", "Indizio", "−5 punti"]];
    const aperta = livello <= 1 ? "funziona" : "";
    const usatoIndizio = sm.aiuti.includes(sm.passo);

    radice.innerHTML = `${testa}<div class="gm-corpo">${elena}
        <h2 class="gm-titolo">${esc(p.domanda)}</h2>
        ${p.consegna ? `<p class="gm-consegna">${esc(p.consegna)}</p>` : ""}
        ${risposta}
        <div class="gm-esito" data-esito hidden></div>
        <div class="gm-schede" role="tablist" aria-label="Aiuti">${schede.map(([id, nome, nota]) => `<button type="button" role="tab" aria-selected="${id === aperta}" data-scheda-aiuto="${id}">${nome}<small>${nota}</small></button>`).join("")}</div>
        <div class="gm-scheda-corpo" data-scheda-corpo ${aperta ? "" : "hidden"}></div>
      </div>
      <div class="gm-piede"><button type="button" class="bottone-app" data-controlla>${p.tipo === "radio" || p.tipo === "checkbox" ? "Controlla" : "Controlla il lavoro"}</button>${puoMostrare(p, livello) ? `<button type="button" class="gm-secondario" data-dove>Mostrami lo strumento</button>` : ""}</div>`;

    const corpoScheda = radice.querySelector<HTMLElement>("[data-scheda-corpo]")!;
    const contenuto: Record<string, () => string> = {
      funziona: () => comeFunziona(p),
      teoria: () => `<h3>Teoria</h3>${teoria(p)}`,
      indizio: () => leggiStato().missioni[m.id].aiuti.includes(leggiStato().missioni[m.id].passo)
        ? `<h3>Indizio</h3><p>${esc(p.aiuto)}</p>`
        : `<h3>Indizio</h3><p>L'indizio ti avvicina alla risposta e costa 5 punti.</p><button type="button" class="gm-secondario" data-usa-indizio>Mostra l'indizio (−5 punti)</button>`,
    };
    const apriScheda = (id: string) => {
      radice.querySelectorAll<HTMLButtonElement>("[data-scheda-aiuto]").forEach((b) => b.setAttribute("aria-selected", String(b.dataset.schedaAiuto === id)));
      corpoScheda.hidden = !id;
      corpoScheda.innerHTML = id ? contenuto[id]() : "";
      corpoScheda.querySelector("[data-usa-indizio]")?.addEventListener("click", () => {
        const st = leggiStato(); const cur = st.missioni[m.id];
        if (!cur.aiuti.includes(cur.passo)) { cur.aiuti.push(cur.passo); salvaStato(st); }
        apriScheda("indizio");
      });
    };
    radice.querySelectorAll<HTMLButtonElement>("[data-scheda-aiuto]").forEach((b) => b.addEventListener("click", () => {
      const id = b.dataset.schedaAiuto!;
      apriScheda(b.getAttribute("aria-selected") === "true" ? "" : id); // un secondo clic chiude la scheda
    }));
    if (aperta) apriScheda(aperta);
    if (usatoIndizio && !aperta) { /* l'indizio già usato si riapre gratis cliccando la scheda */ }

    radice.querySelector("[data-dove]")?.addEventListener("click", () => mostraElemento(p.dove));

    // Testo: contatore di parole e salvataggio automatico
    const area = radice.querySelector<HTMLTextAreaElement>("[data-gm-testo]");
    if (area) {
      const conta = radice.querySelector<HTMLElement>("[data-conta]")!;
      const [min, max] = p.parole ?? [30, 160];
      const aggiorna = () => { const n = contaParole(area.value); conta.textContent = `${n} parole · tra ${min} e ${max}`; conta.classList.toggle("fuori", n > 0 && (n < min || n > max)); };
      area.addEventListener("input", () => { salvaTesto(chiaveTesto, area.value); aggiorna(); });
      aggiorna();
    }

    const esito = radice.querySelector<HTMLElement>("[data-esito]")!;
    const btn = radice.querySelector<HTMLButtonElement>("[data-controlla]")!;
    const mostraEsito = () => { esito.hidden = false; requestAnimationFrame(() => esito.scrollIntoView({ behavior: "smooth", block: "nearest" })); };
    // Quando è giusto, il bottone in basso diventa "Passo successivo"
    const fatto = () => {
      btn.textContent = avanti;
      btn.dataset.fatto = "si";
    };
    btn.addEventListener("click", () => {
      if (btn.dataset.fatto) { vaiAvanti(m, ultimo, pagina); return; }
      const st = leggiStato(); const cur = st.missioni[m.id];

      if (p.tipo === "radio" || p.tipo === "checkbox") {
        const scelte = [...radice.querySelectorAll<HTMLInputElement>("input[name=gm-r]:checked")].map((x) => x.value);
        if (!scelte.length) { esito.className = "gm-esito"; esito.innerHTML = "<p>Scegli almeno una risposta.</p>"; mostraEsito(); return; }
        const r = controlla(p, scelte);
        if (cur.primoColpo[cur.passo] === undefined) cur.primoColpo[cur.passo] = r.ok;
        if (!r.ok && !tutorial) cur.errori += 1; // nel tutorial gli errori non contano
        salvaStato(st);
        if (r.ok) {
          esito.className = "gm-esito ok";
          esito.innerHTML = `<strong>Giusto.</strong><p>${esc(p.perche)}</p>`;
          radice.querySelectorAll<HTMLInputElement>("input[name=gm-r]").forEach((x) => (x.disabled = true));
          fatto();
        } else {
          esito.className = "gm-esito no";
          const note = r.sbagliate.map((o) => `<li><strong>${esc(o.testo)}</strong>: ${esc(o.nota)}</li>`).join("");
          const manca = r.mancanti.length && p.tipo === "checkbox" ? "<p>Manca ancora almeno una risposta giusta.</p>" : "";
          const sbagli = Number(btn.dataset.sbagli ?? 0) + 1; btn.dataset.sbagli = String(sbagli);
          // Dopo due tentativi si può vedere la risposta e andare avanti (gli errori hanno già tolto punti)
          esito.innerHTML = `<strong>Non ancora.</strong>${note ? `<ul>${note}</ul>` : ""}${manca}<p>Riprova. Se ti serve, apri la Teoria.</p>${sbagli >= 2 ? '<button type="button" class="gm-secondario gm-mostra" data-mostra-risposta>Mostra la risposta</button>' : ""}`;
          esito.querySelector("[data-mostra-risposta]")?.addEventListener("click", () => {
            const giuste = p.opzioni.filter((o) => o.giusta);
            radice.querySelectorAll<HTMLInputElement>("input[name=gm-r]").forEach((x) => { x.checked = giuste.some((o) => o.id === x.value); x.disabled = true; });
            esito.className = "gm-esito";
            esito.innerHTML = `<strong>La risposta giusta</strong><p>${giuste.map((o) => `«${esc(o.testo)}»`).join(" e ")}</p><p>${esc(p.perche)}</p>`;
            fatto();
          });
        }
        mostraEsito();
        return;
      }

      // Modifica sul sito o testo scritto: la verifica controlla com'è adesso, si può riprovare senza perdere punti
      const r = verifica(p.verifica!, area?.value ?? "");
      if (cur.primoColpo[cur.passo] === undefined) cur.primoColpo[cur.passo] = r.ok;
      salvaStato(st);
      const lista = `<ul class="gm-controlli">${r.controlli.map((c) => `<li class="${c.ok ? "ok" : "no"}"><span class="gm-segno" aria-hidden="true"></span><span><strong>${esc(c.nome)}</strong>${c.ok ? "" : `<br>${esc(c.suggerimento)}`}</span><span class="sr">${c.ok ? "superato" : "da sistemare"}</span></li>`).join("")}</ul>`;
      if (r.ok) {
        esito.className = "gm-esito ok";
        esito.innerHTML = `<strong>Fatto.</strong>${lista}<p>${esc(p.perche)}</p>`;
        if (area) area.readOnly = true;
        fatto();
      } else {
        esito.className = "gm-esito no";
        esito.innerHTML = `<strong>Non ancora.</strong>${lista}<p>${p.tipo === "testo" ? "Completa il testo" : "Sistema i punti rossi, salva"} e premi di nuovo "Controlla il lavoro".</p>`;
      }
      mostraEsito();
    });
  }

  // Passa al mini esercizio dopo (o conclude). Se si fa in un'altra pagina, porta lì.
  function vaiAvanti(m: Missione, ultimo: boolean, pagina: string) {
    const s2 = leggiStato(); const c2 = s2.missioni[m.id];
    if (ultimo) { c2.stato = "completata"; salvaStato(s2); disegna(); document.dispatchEvent(new CustomEvent("missioni-aggiornate")); radice!.scrollIntoView({ behavior: "smooth", block: "start" }); return; }
    c2.passo += 1; salvaStato(s2);
    const prossimo = m.passi[c2.passo];
    const altraPagina = (prossimo.tipo === "radio" || prossimo.tipo === "checkbox") && !!prossimo.pagina && location.pathname !== prossimo.pagina;
    const altroStrumento = (prossimo.tipo === "radio" || prossimo.tipo === "checkbox" || prossimo.tipo === "azione") && prossimo.strumento !== pagina;
    if (altroStrumento || altraPagina) location.href = linkPasso(prossimo);
    else { disegna(); radice!.scrollIntoView({ behavior: "smooth", block: "start" }); }
  }

  // "Ricomincia": torna al primo mini esercizio e riporta le pagine dell'esercizio com'erano (con conferma)
  radice?.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest("[data-ricomincia]");
    if (!b) return;
    if (b.getAttribute("data-conferma") !== "si") { b.setAttribute("data-conferma", "si"); b.textContent = "Sicura? Clicca di nuovo"; return; }
    const id = leggiStato().attiva; if (id) location.href = ricomincia(id);
  });

  disegna();
</script>

<style>
  .gm { display: flex; flex-direction: column; font-size: .9rem; min-height: 100%; }
  .gm :global(.gm-testa) { display: flex; flex-direction: column; gap: 8px; padding-bottom: 14px; border-bottom: 1px solid #e3e1dc; }
  .gm :global(.gm-corpo) { display: flex; flex-direction: column; gap: 14px; padding: 16px 0 20px; flex: 1; }
  .gm :global(.gm-piede) { position: sticky; bottom: 0; z-index: 2; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 12px 0 16px; background: #fff; border-top: 1px solid #e3e1dc; box-shadow: 0 -10px 16px -12px rgba(42, 29, 24, .18); }
  .gm :global(.gm-missione) { margin: 0; font-weight: 700; color: #423e39; font-size: .85rem; }
  .gm :global(.gm-barre) { display: flex; gap: 4px; }
  .gm :global(.gm-barre span) { flex: 1; height: 5px; border-radius: 3px; background: #e9e8e4; }
  .gm :global(.gm-barre span.fatto) { background: #2f7a4f; } .gm :global(.gm-barre span.ora) { background: var(--arancio); }
