---
// PAGINA DEI RUOLI
// I 12 ruoli stanno in src/data/ruoli.json.
// Le schede si aprono con <details>: funziona senza JavaScript ed è accessibile da tastiera.
import Base from "../layouts/Base.astro";
import ruoli from "../data/ruoli.json";

// Versione provvisoria: tutti i 12 ruoli insieme, senza divisione in hub (scelta di Queen).
// La pagina definitiva con i "pass" arriva nel prossimo passo.
const gruppi = [{ titolo: "Tutti i ruoli", testo: "12 ruoli da provare nell'azienda finta." }];
---
<Base title="Ruoli del marketing" description="I ruoli del marketing spiegati semplici: cosa fanno, una giornata tipo e gli strumenti gratuiti per provarli.">
  <div class="contenitore pagina">
  <h1>Ruoli del marketing</h1>
  <p class="intro testo">Il marketing non è un solo mestiere. Apri una scheda per scoprire cosa fa ogni ruolo.</p>

  {gruppi.map((g) => (
    <section class="gruppo">
      <h2>{g.titolo}</h2>
      <p class="nota">{g.testo}</p>
      <div class="griglia">
        {ruoli.map((r) => (
          <details class="scheda">
            <summary>
              <span class="fase">{r.fase}</span>
              <strong>{r.nome}</strong>
              <span>{r.cosa}</span>
            </summary>
            <h3>Una giornata tipo</h3>
            <ul>{r.giornata.map((g) => <li>{g}</li>)}</ul>
            <h3>Strumenti gratuiti per provare</h3>
            <p>{r.strumenti.join(" · ")}</p>
            <h3>Ruoli più specifici</h3>
            <p>{r.ruoliFigli.join(" · ")}</p>
            <p class="adatto">{r.tiPiaceSe}</p>
          </details>
        ))}
      </div>
    </section>
  ))}
  </div>
</Base>

<style>
  h1 { font-size: clamp(2rem, 5vw, 2.75rem); margin-block: 0 var(--space-1); }
  .intro, .nota { color: var(--testo-2); margin: 0; }
  .gruppo { display: grid; gap: var(--space-2); margin-top: var(--space-4); }
  h2 { margin: 0; }
  .griglia { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: var(--space-2); align-items: start; }
  .scheda { background: #fff; border: 1px solid var(--linea); border-radius: 8px; padding: var(--space-2); }
  summary { cursor: pointer; display: grid; gap: 0.25rem; }
  .fase { font-family: var(--font-testo); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--testo-2); }
  strong { font-size: 1.15rem; }
  h3 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--etichetta); margin: var(--space-2) 0 0.25rem; }
  ul { margin: 0; padding-left: 1.1rem; }
  details p { margin: 0; }
  .adatto { margin-top: var(--space-2) !important; color: var(--testo-2); }
</style>
