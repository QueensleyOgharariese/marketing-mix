---
import { LINGUE_APP } from "../../../../i18n";
// APP · TEORIA (ingresso degli Hub) — si arriva qui dalla scelta iniziale /app/
// Presenta l'azienda finta, spiega i tre passi (teoria nell'Hub, prova veloce, pratica nei percorsi)
// e mostra i 12 ruoli divisi in Hub 1 e Hub 2. Ogni ruolo porta alla sua pagina di teoria (/app/impara/<ruolo>/).
// Dati in src/data/app/cinque-foglie.json; le teorie pronte sono i file in src/data/app/teoria/.
import AppLayout from "../../../../layouts/AppLayout.astro";
import Progresso from "../../../../components/Progresso.astro";
import Pesca from "../../../../components/Pesca.astro";
import Icona from "../../../../components/Icona.astro";
import aziendaIt from "../../../../data/app/cinque-foglie.json";
import aziendaEn from "../../../../data/app/cinque-foglie.en.json";
import { linguaDa, appLink } from "../../../../i18n";
const lang = linguaDa(Astro.url);
const L = (it: string, en: string) => (lang === "en" ? en : it);
const azienda = lang === "en" ? aziendaEn : aziendaIt;
const TEORIE = import.meta.glob(["../../../../data/app/teoria/*.json", "!../../../../data/app/teoria/*.en.json"], { eager: true }) as Record<string, { default: any }>;
const SIMULAZIONI = new Set(["seo", "sea", "brand", "social"]);
const pronti = new Set(Object.values(TEORIE).map((t) => t.default.id));
const HUB = [
  { n: 1, nome: L("Farsi trovare e parlare con i clienti", "Getting found and talking to customers"), ruoli: ["seo", "sea", "brand", "social", "influencer", "crm"] },
  { n: 2, nome: L("Prodotto, vendite e dati", "Product, sales and data"), ruoli: ["product", "trade", "pr", "partner", "ricerca", "analytics"] },
];
const ruolo = (id: string) => azienda.ruoli.find((r) => r.id === id)!;
export function getStaticPaths() { return LINGUE_APP(); }
---
<AppLayout title={L("Benvenuto in Cinque Foglie", "Welcome to Cinque Foglie")} percorso={[{ etichetta: azienda.nome, link: appLink(lang, "/app/") }, { etichetta: L("Teoria", "Theory") }]}>
  <Progresso slot="barra" />
  <main class="contenuto">
    <section class="benvenuto">
      <Pesca dimensione={84} etichetta={L("Pesca, la tua tutor", "Pesca, your tutor")} />
      <div class="benvenuto-testi">
        <span class="tag">{L("Primo giorno", "First day")}</span>
        <h1 class="app-titolo">{L("Ti diamo il benvenuto in", "Welcome to")} {azienda.nome}</h1>
        <p>{L("Sono Pesca, la tua tutor. Qui lavori per un'azienda finta. Per ogni ruolo del marketing prima impari la teoria con lezioni brevi, poi la metti alla prova. Scegli il ruolo da cui partire.", "I'm Pesca, your tutor. Here you work for a fictional company. For each marketing role you first learn the theory with short lessons, then put it to the test. Choose the role to start with.")}</p>
      </div>
    </section>

    <div class="colonne">
      <section class="pannello azienda" aria-labelledby="t-azienda">
        <div class="azienda-testa">
          <span class="foglia" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#2f7a4f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20 C4 10 10 4 20 4 C20 14 14 20 4 20 Z" /><path d="M4 20 L13 11" /></svg></span>
          <div>
            <div class="azienda-nome"><strong id="t-azienda">{azienda.nome}</strong><span class="simulata">{L("Azienda simulata", "Simulated company")}</span></div>
            <p>{azienda.descrizione}</p>
          </div>
        </div>
        <dl class="numeri">
          {azienda.numeri.map((n) => (
            <div><dt>{n.etichetta}</dt><dd>{n.valore}</dd></div>
          ))}
        </dl>
        <p class="avviso">{L(`Tutti i dati di ${azienda.nome} sono inventati per gli esercizi.`, `All of ${azienda.nome}'s data is made up for the exercises.`)}</p>
        <div class="dettagli">
          <div>
            <h2 class="piccolo">{L("Catalogo", "Catalogue")}</h2>
            <ul class="chip">{azienda.catalogo.map((c) => <li>{c}</li>)}</ul>
          </div>
          <div>
            <h2 class="piccolo">{L("Chi ti scriverà", "Who will write to you")}</h2>
            <ul class="colleghi">
              {azienda.colleghi.map((c) => (
                <li><span class="avatar">{c.sigla}</span><span><strong>{c.nome}</strong> · {c.ruolo}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <aside class="pannello come" aria-labelledby="t-come">
        <h2 id="t-come" class="app-titolo come-titolo">{L("Come funziona", "How it works")}</h2>
        <ol class="tappe">
          <li><span class="tappa-n">1</span><span><strong>{L("Teoria", "Theory")}</strong>{L("Scheda del ruolo, tre lezioni da dieci minuti con domande dopo ogni concetto, una verifica.", "Role profile, three ten-minute lessons with questions after every concept, a quiz.")}</span></li>
          <li><span class="tappa-n">2</span><span><strong>{L("Prova veloce", "Quick exercise")}</strong>{L("Una richiesta di un collega di Cinque Foglie, per vedere che lavoro è.", "A request from a Cinque Foglie colleague, to see what the job is like.")}</span></li>
          <li><span class="tappa-n">3</span><span><strong>{L("Simulazione", "Simulation")}</strong>{L("Lavori su Cinque Foglie con gli strumenti del mestiere.", "You work on Cinque Foglie with the tools of the trade.")} <a href={appLink(lang, "/app/simulazioni/")}>{L("Vedi le simulazioni", "See the simulations")}</a></span></li>
        </ol>
        <p class="nota">{L("Per approfondire la teoria ci sono gli articoli del", "To go deeper into the theory there are the articles on the")} <a href={lang === "en" ? "/en/blog/" : "/blog/"}>blog</a>.</p>
      </aside>
    </div>

    <section id="ruoli" class="hub-tutti" aria-label={L("I ruoli", "The roles")}>
      {HUB.map((h) => (
        <section class="hub" aria-labelledby={`t-hub-${h.n}`}>
          <div class="hub-testa"><span class="hub-n">Hub {h.n}</span><h2 id={`t-hub-${h.n}`} class="app-titolo hub-titolo">{h.nome}</h2></div>
          <ul class="griglia">
            {h.ruoli.map((id) => { const r = ruolo(id); return (
              <li>
                <a class="ruolo" href={appLink(lang, `/app/impara/${r.id}/`)} data-ruolo-card={r.id}>
                  <span class="ruolo-icona"><Icona nome={r.icona} dimensione={18} /></span>
                  <span class="ruolo-testi"><strong>{r.nome}</strong><span>{r.breve}</span></span>
                  <span class="ruolo-piede">
                    {pronti.has(r.id) ? <span class="etichetta pronta" data-avanz>{L("Teoria pronta", "Theory ready")}</span> : <span class="etichetta">{L("Teoria in arrivo", "Theory coming soon")}</span>}
                    {SIMULAZIONI.has(r.id) && <span class="etichetta pratica">{L("Simulazione", "Simulation")}</span>}
                  </span>
                </a>
              </li>
            ); })}
          </ul>
        </section>
      ))}
    </section>
  </main>
</AppLayout>

<script>
  // Sui ruoli con la teoria pronta, quante parti hai già fatto
  import { leggiTeoria } from "../../../../scripts/quiz";
  import { t as tr } from "../../../../scripts/lingua";
  const t = leggiTeoria();
  document.querySelectorAll<HTMLElement>("[data-ruolo-card]").forEach((a) => {
    const s = t[a.dataset.ruoloCard!]; const e = a.querySelector("[data-avanz]");
    if (!s || !e) return;
    const fatte = Object.values(s.lezioni ?? {}).filter(Boolean).length + (s.verifica?.superata ? 1 : 0);
    e.textContent = s.verifica?.superata ? tr("Teoria completata", "Theory completed") : tr(`Teoria: ${fatte} di 4`, `Theory: ${fatte} of 4`);
  });
</script>

<style>
  .contenuto { max-width: 1160px; margin: 0 auto; padding: 32px 24px 56px; display: flex; flex-direction: column; gap: 22px; }
  .benvenuto { background: #efeeea; border-radius: 18px; padding: 24px 28px; display: flex; flex-wrap: wrap; gap: 22px; align-items: center; }
  .benvenuto .tag { align-self: flex-start; }
  .benvenuto-testi { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  h1 { font-size: clamp(1.8rem, 4vw, 2.3rem); line-height: 1.1; }
  .benvenuto p { line-height: 1.55; color: #55514c; max-width: 62ch; }
  .colonne { display: flex; flex-wrap: wrap; gap: 18px; align-items: flex-start; }
  .azienda { flex: 999 1 520px; min-width: 0; padding: 22px; display: flex; flex-direction: column; gap: 18px; }
  .azienda-testa { display: flex; gap: 14px; align-items: flex-start; }
  .foglia { flex: none; width: 52px; height: 52px; border-radius: 14px; background: #e8f4ec; display: grid; place-items: center; }
  .azienda-nome { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 4px; }
  .azienda-nome strong { font-family: var(--font-titoli); font-size: 1.4rem; }
  .simulata { font-size: .7rem; font-weight: 700; background: #efeeeb; color: #5f5a55; padding: 3px 8px; border-radius: 999px; }
  .azienda-testa p { line-height: 1.55; color: #55514c; }
  .numeri { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; }
  .numeri div { background: #f8f8f6; border-radius: 12px; padding: 12px 14px; }
  .numeri dt { font-size: .75rem; color: #5f5a55; }
  .numeri dd { margin: 2px 0 0; font-family: var(--font-titoli); font-weight: 800; font-size: 1.5rem; }
  .avviso { font-size: .8rem; color: #5f5a55; }
  .dettagli { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; }
  .piccolo { font-family: var(--font-testo); font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6f6a64; margin-bottom: 8px; }
  .chip { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .chip li { font-size: .85rem; background: #efeeea; padding: 5px 10px; border-radius: 999px; }
  .colleghi { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .colleghi li { display: flex; align-items: center; gap: 10px; color: #55514c; }
  .colleghi strong { color: var(--inchiostro); }
  .come { flex: 1 1 320px; min-width: 0; padding: 22px; display: flex; flex-direction: column; gap: 14px; }
  .come-titolo { font-size: 1.3rem; }
  .tappe { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .tappe li { display: flex; gap: 12px; align-items: flex-start; line-height: 1.5; font-size: .9rem; color: #55514c; }
  .tappe strong { display: block; color: var(--inchiostro); font-size: .95rem; }
  .tappa-n { flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--arancio); display: grid; place-items: center; font-weight: 800; color: var(--inchiostro); }
  .nota { font-size: .85rem; color: #5f5a55; margin: 0; }
  .nota a { color: var(--inchiostro); font-weight: 700; }
  .hub-tutti { display: flex; flex-direction: column; gap: 28px; margin-top: 8px; }
  .hub { display: flex; flex-direction: column; gap: 14px; }
  .hub-testa { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .hub-n { font-size: .78rem; font-weight: 800; background: var(--inchiostro); color: #fff; padding: 4px 10px; border-radius: 999px; }
  .hub-titolo { font-size: 1.3rem; margin: 0; }
  .griglia { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 900px) { .griglia { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .griglia { grid-template-columns: 1fr; } }
  .ruolo { height: 100%; box-sizing: border-box; display: grid; grid-template-columns: 40px 1fr; gap: 12px; align-items: start; padding: 16px; background: #fff; border: 1px solid #e3e1dc; border-radius: 16px; text-decoration: none; color: var(--inchiostro); transition: border-color .15s, transform .15s; }
  .ruolo:hover { border-color: var(--arancio); transform: translateY(-2px); color: var(--inchiostro); }
  .ruolo-icona { width: 40px; height: 40px; border-radius: 12px; background: var(--arancio); display: grid; place-items: center; }
  .ruolo-testi { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .ruolo-testi span { font-size: .82rem; color: #5f5a55; }
  .ruolo-piede { grid-column: 2; display: flex; flex-wrap: wrap; gap: 6px; }
  .etichetta { font-size: .72rem; font-weight: 700; padding: 3px 8px; border-radius: 999px; background: #efeeea; color: #5f5a55; }
  .etichetta.pronta { background: #e3f3e8; color: #1f5c38; }
  .etichetta.pratica { background: var(--inchiostro); color: #fff; }
</style>
