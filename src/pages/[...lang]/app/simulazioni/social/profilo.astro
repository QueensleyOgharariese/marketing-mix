---
import { LINGUE_APP, linguaDa } from "../../../../../i18n";
// SIMULAZIONE SOCIAL · IL PROFILO
// Il profilo di Cinque Foglie come lo vedono i follower (ispirato ai social fotografici, nome generico).
// Clic su un post: si apre il dettaglio con data, ora, testo alternativo ed etichetta di collaborazione.
// Dal dettaglio si modificano didascalia, testo alternativo ed etichetta, o si archivia il post.
// Le modifiche restano in questo browser (scripts/social/stato.ts) e le leggono anche gli altri strumenti.
import Console from "../../../../../components/seopro/Console.astro";
import PROFILO_IT from "../../../../../data/app/social-sim/profilo.json";
import PROFILO_EN from "../../../../../data/app/social-sim/profilo.en.json";
export function getStaticPaths() { return LINGUE_APP(); }
const lang = linguaDa(Astro.url);
const L = (it: string, en: string) => (lang === "en" ? en : it);
const PROFILO = lang === "en" ? PROFILO_EN : PROFILO_IT;
---
<Console sim="social" attivo="profilo" titolo={L("Il profilo", "The profile")} ispirato={L("un social network fotografico (nome generico, nessun marchio reale)", "a photo social network (generic name, no real brand)")}>
  <section class="sp-pannello prof-testa">
    <span class="prof-avatar" aria-hidden="true">CF</span>
    <div class="prof-dati">
      <strong class="prof-nome">{PROFILO.nome}</strong>
      <span class="prof-cifre"><span><b data-n-post>24</b> post</span><span><b>{L("12.670", "12,670")}</b> follower</span><span><b>182</b> {L("seguiti", "following")}</span></span>
      <span class="prof-visibile">{PROFILO.nomeVisibile}</span>
      <p class="prof-bio">{PROFILO.bio}</p>
    </div>
  </section>

  <div class="prof-corpo">
    <section class="sp-pannello">
      <div class="sp-riga"><h2 class="prof-tit">Post</h2><span class="sp-nota">{L("Dal più recente. Clicca un post per aprirlo.", "Most recent first. Click a post to open it.")}</span></div>
      <div class="prof-griglia" data-griglia></div>
      <details class="prof-archivio" data-archivio hidden>
        <summary>{L("Post archiviati", "Archived posts")} (<span data-n-arch>0</span>)</summary>
        <div class="prof-griglia" data-griglia-arch></div>
      </details>
    </section>
    <section class="sp-pannello prof-dett" data-dettaglio>
      <p class="sp-nota">{L("Nessun post aperto. Clicca un post della griglia per vedere i dettagli.", "No post open. Click a post in the grid to see the details.")}</p>
    </section>
  </div>
</Console>

<script>
  import { leggi, salva, pubblicati, dataBreve, giorno, er, POST } from "../../../../../scripts/social/stato";
  import { t, EN } from "../../../../../scripts/lingua";
  const griglia = document.querySelector<HTMLElement>("[data-griglia]")!;
  const grigliaArch = document.querySelector<HTMLElement>("[data-griglia-arch]")!;
  const archivio = document.querySelector<HTMLDetailsElement>("[data-archivio]")!;
  const dett = document.querySelector<HTMLElement>("[data-dettaglio]")!;
  const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  const ICONA: Record<string, string> = { reel: "Reel", carosello: t("Carosello", "Carousel"), foto: t("Foto", "Photo") };
  const classe = (pil: string) => "pil-" + pil.toLowerCase().replace(/[^a-z]/g, "").slice(0, 8);
  let aperto: string | null = null;
  let modifica = false;

  function tessera(p: ReturnType<typeof pubblicati>[number]) {
    return `<button type="button" class="tessera ${classe(p.pilastro)}${p.id === aperto ? " aperta" : ""}" data-post="${p.id}" aria-label="${esc(p.titolo)}, ${dataBreve(p.data)}">
      <span class="t-formato">${ICONA[p.formato] ?? p.formato}</span>
      <span class="t-titolo">${esc(p.titolo)}</span>
      <span class="t-data">${dataBreve(p.data)}</span></button>`;
  }
  function disegna() {
    const m = leggi();
    const tutti = pubblicati(m).sort((a, b) => `${b.data}${b.ora}`.localeCompare(`${a.data}${a.ora}`));
    const visibili = tutti.filter((p) => !p.archiviato), arch = tutti.filter((p) => p.archiviato);
    griglia.innerHTML = visibili.map(tessera).join("");
    grigliaArch.innerHTML = arch.map(tessera).join("");
    archivio.hidden = arch.length === 0;
    document.querySelector("[data-n-arch]")!.textContent = String(arch.length);
    document.querySelector("[data-n-post]")!.textContent = String(visibili.length);
    disegnaDettaglio();
  }

  function disegnaDettaglio() {
    if (!aperto) return;
    const m = leggi();
    const p = pubblicati(m).find((x) => x.id === aperto)!;
    const orig = POST.post.find((x) => x.id === aperto)!;
    const cambiato = !!m.post[p.id] && Object.keys(m.post[p.id]).length > 0;
    const testa = `<div class="d-testa"><h2 class="prof-tit">${esc(p.titolo)}</h2><button type="button" class="d-chiudi" data-chiudi aria-label="${t("Chiudi il post", "Close the post")}">${t("Chiudi", "Close")}</button></div>
      <div class="d-anteprima ${classe(p.pilastro)}"><span class="t-formato">${ICONA[p.formato]}</span><span>${esc(p.titolo)}</span></div>
      ${p.archiviato ? `<p class="d-avviso">${t("Questo post è archiviato: i follower non lo vedono.", "This post is archived: followers can't see it.")}</p>` : ""}`;
    if (modifica) {
      dett.innerHTML = `${testa}
        <form class="d-form" data-form>
          <label>${t("Didascalia", "Caption")}<textarea name="didascalia" rows="6">${esc(p.didascalia)}</textarea></label>
          <label>${t("Testo alternativo", "Alt text")} <span class="sp-nota">${t("(descrizione per chi non vede l'immagine)", "(description for people who can't see the image)")}</span><textarea name="alt" rows="3">${esc(p.alt ?? "")}</textarea></label>
          <label class="d-check"><input type="checkbox" name="collab" ${p.collab ? "checked" : ""} /> ${t("Etichetta «Partnership a pagamento» (collaborazione commerciale)", "«Paid partnership» label (commercial partnership)")}</label>
          <div class="d-bottoni"><button type="submit" class="bottone-app">${t("Salva", "Save")}</button><button type="button" class="d-sec" data-annulla>${t("Annulla", "Cancel")}</button></div>
        </form>`;
      dett.querySelector("[data-annulla]")!.addEventListener("click", () => { modifica = false; disegnaDettaglio(); });
      dett.querySelector<HTMLFormElement>("[data-form]")!.addEventListener("submit", (e) => {
        e.preventDefault();
        const f = new FormData(e.target as HTMLFormElement);
        const m2 = leggi();
        const c = { ...(m2.post[p.id] ?? {}) };
        const did = String(f.get("didascalia") ?? ""), alt = String(f.get("alt") ?? ""), collab = f.get("collab") === "on";
        if (did !== orig.didascalia) c.didascalia = did; else delete c.didascalia;
        if (alt !== orig.alt) c.alt = alt; else delete c.alt;
        if (collab !== orig.collab) c.collab = collab; else delete c.collab;
        m2.post[p.id] = c; salva(m2); modifica = false; disegna();
      });
    } else {
      dett.innerHTML = `${testa}
        <p class="d-did">${esc(p.didascalia)}</p>
        <dl class="d-info">
          <div><dt>${t("Pubblicato", "Published")}</dt><dd>${giorno(p.data)} ${dataBreve(p.data)}/2026 ${t("alle", "at")} ${p.ora}</dd></div>
          <div><dt>${t("Formato", "Format")}</dt><dd>${ICONA[p.formato]}</dd></div>
          <div><dt>${t("Pilastro", "Pillar")}</dt><dd>${esc(p.pilastro)}</dd></div>
          <div><dt>${t("Testo alternativo", "Alt text")}</dt><dd>${p.alt ? esc(p.alt) : `<em>${t("non scritto", "not written")}</em>`}</dd></div>
          <div><dt>${t("Etichetta", "Label")}</dt><dd>${p.collab ? `<span class="sp-badge ok">${t("Partnership a pagamento", "Paid partnership")}</span>` : t("nessuna", "none")}</dd></div>
          <div><dt>${t("Reazioni", "Reactions")}</dt><dd>${p.like} like · ${p.commenti} ${t("commenti", "comments")} · ${p.salvataggi} ${t("salvataggi", "saves")} · ER ${EN ? er(p) : String(er(p)).replace(".", ",")}%</dd></div>
        </dl>
        <div class="d-bottoni">
          <button type="button" class="bottone-app" data-modifica>${t("Modifica", "Edit")}</button>
          <button type="button" class="d-sec" data-archivia>${p.archiviato ? t("Rimetti sul profilo", "Put back on the profile") : t("Archivia", "Archive")}</button>
          ${cambiato ? `<button type="button" class="d-link" data-originale>${t("Torna all'originale", "Back to the original")}</button>` : ""}
        </div>`;
      dett.querySelector("[data-modifica]")!.addEventListener("click", () => { modifica = true; disegnaDettaglio(); });
      dett.querySelector("[data-archivia]")!.addEventListener("click", () => {
        const m2 = leggi(); const c = { ...(m2.post[p.id] ?? {}) };
        if (p.archiviato) delete c.archiviato; else c.archiviato = true;
        m2.post[p.id] = c; salva(m2); disegna();
      });
      dett.querySelector("[data-originale]")?.addEventListener("click", () => { const m2 = leggi(); delete m2.post[p.id]; salva(m2); disegna(); });
    }
    dett.querySelector("[data-chiudi]")!.addEventListener("click", () => { aperto = null; modifica = false; dett.innerHTML = `<p class="sp-nota">${t("Nessun post aperto. Clicca un post della griglia per vedere i dettagli.", "No post open. Click a post in the grid to see the details.")}</p>`; disegna(); });
  }

  for (const g of [griglia, grigliaArch]) g.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>("[data-post]");
    if (!b) return;
    aperto = b.dataset.post!; modifica = false; disegna();
    if (innerWidth < 1000) dett.scrollIntoView({ behavior: "smooth", block: "start" });
  });
  disegna();
</script>

<style>
  .prof-testa { display: flex; gap: 22px; align-items: center; }
  .prof-avatar { flex: none; width: 84px; height: 84px; border-radius: 50%; background: #1f5c38; color: #fff; display: grid; place-items: center; font-family: var(--font-titoli); font-weight: 800; font-size: 1.6rem; }
  .prof-dati { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .prof-nome { font-size: 1.1rem; }
  .prof-cifre { display: flex; flex-wrap: wrap; gap: 16px; font-size: .9rem; }
  .prof-visibile { font-weight: 700; font-size: .9rem; }
  .prof-bio { margin: 0; font-size: .9rem; color: #423e39; }
  .prof-corpo { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  @media (max-width: 1000px) { .prof-corpo { grid-template-columns: 1fr; } }
  .prof-tit { font-family: var(--font-titoli); font-size: 1.15rem; font-weight: 800; margin: 0; }
  .prof-griglia { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; margin-top: 14px; }
  .prof-archivio { margin-top: 18px; font-size: .88rem; }
  .prof-archivio summary { cursor: pointer; font-weight: 700; }
  .prof-dett { position: sticky; top: 80px; display: flex; flex-direction: column; gap: 12px; }
  @media (max-width: 1000px) { .prof-dett { position: static; } }
  :global(.tessera) { aspect-ratio: 1; border: 0; border-radius: 6px; padding: 10px; display: flex; flex-direction: column; justify-content: space-between; text-align: left; font: inherit; cursor: pointer; color: var(--inchiostro); min-width: 0; }
  :global(.tessera:hover), :global(.tessera.aperta) { outline: 3px solid var(--arancio); outline-offset: -3px; }
  :global(.t-formato) { align-self: flex-end; font-size: .66rem; font-weight: 700; background: rgba(255,255,255,.85); padding: 2px 6px; border-radius: 999px; }
  :global(.t-titolo) { font-size: .78rem; font-weight: 700; line-height: 1.25; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
  :global(.t-data) { font-size: .68rem; color: #423e39; }
  @media (max-width: 560px) { :global(.t-titolo) { font-size: .66rem; -webkit-line-clamp: 2; } :global(.tessera) { padding: 6px; } }
  :global(.pil-imparail) { background: #dcecdf; } :global(.pil-ricette) { background: #dfe8f7; } :global(.pil-dietrole) { background: #e7e2f3; }
  :global(.pil-lacommun) { background: #d9eeec; } :global(.pil-prodotto) { background: #e8e6e1; } :global(.pil-collabor) { background: #f3e1ea; }
  /* gli stessi colori per i pilastri in inglese */
  :global(.pil-learnabo) { background: #dcecdf; } :global(.pil-recipes) { background: #dfe8f7; } :global(.pil-behindth) { background: #e7e2f3; }
  :global(.pil-thecommu) { background: #d9eeec; } :global(.pil-product) { background: #e8e6e1; } :global(.pil-partners) { background: #f3e1ea; }
  :global(.d-testa) { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
  :global(.d-chiudi), :global(.d-sec) { font: inherit; font-weight: 700; font-size: .85rem; padding: 9px 14px; border-radius: 10px; border: 1px solid #d1cec8; background: #fff; cursor: pointer; color: var(--inchiostro); }
  :global(.d-link) { font: inherit; font-size: .85rem; background: none; border: 0; text-decoration: underline; cursor: pointer; color: #55514c; }
  :global(.d-anteprima) { border-radius: 10px; padding: 18px; min-height: 120px; display: flex; flex-direction: column; gap: 8px; font-weight: 700; }
  :global(.d-avviso) { margin: 0; font-size: .85rem; font-weight: 700; color: #7a5200; background: #fff3d6; padding: 8px 12px; border-radius: 8px; }
  :global(.d-did) { margin: 0; line-height: 1.55; font-size: .92rem; white-space: pre-wrap; overflow-wrap: anywhere; }
  :global(.d-info) { margin: 0; display: flex; flex-direction: column; gap: 8px; font-size: .86rem; }
  :global(.d-info div) { display: flex; flex-direction: column; gap: 1px; }
  :global(.d-info dt) { font-weight: 700; color: #55514c; font-size: .76rem; } :global(.d-info dd) { margin: 0; overflow-wrap: anywhere; }
  :global(.d-bottoni) { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  :global(.d-form) { display: flex; flex-direction: column; gap: 12px; }
  :global(.d-form label) { display: flex; flex-direction: column; gap: 6px; font-weight: 700; font-size: .86rem; }
  :global(.d-form textarea), :global(.d-form input:not([type=checkbox])) { font: inherit; font-weight: 400; font-size: .9rem; padding: 9px 11px; border: 1px solid #d1cec8; border-radius: 10px; width: 100%; box-sizing: border-box; }
  :global(.d-form .d-check) { flex-direction: row; align-items: center; font-weight: 600; }
</style>
