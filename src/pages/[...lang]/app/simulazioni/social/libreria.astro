---
import { LINGUE_APP } from "../../../../../i18n";
// SIMULAZIONE SOCIAL · LIBRERIA FOTO E MUSICA
// Foto, video e musica che il team può usare, con la provenienza e il permesso o la licenza.
// Per le foto di altre persone senza permesso si scrive qui il messaggio per chiederlo (esercizio Diagnosi 3).
import Console from "../../../../../components/seopro/Console.astro";
export function getStaticPaths() { return LINGUE_APP(); }
---
<Console sim="social" attivo="libreria" titolo="Libreria foto e musica" ispirato="le librerie di contenuti dei team social (nome generico, nessun marchio reale)">
  <p class="sp-nota lib-intro">Prima di pubblicare un contenuto controlla da dove arriva e che permesso ha. Verde: si può usare. Rosso: non si può usare. Giallo: da verificare.</p>
  <ul class="lib-griglia" data-libreria></ul>
</Console>

<script>
  import { leggi, salva } from "../../../../../scripts/social/stato";
  import LIB from "../../../../../data/app/social-sim/libreria.json";
  const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  const el = document.querySelector<HTMLElement>("[data-libreria]")!;
  const OK = ["proprio", "concesso", "licenza commerciale", "uso commerciale"];
  const NO = ["non chiesto", "non per profili aziendali"];
  const TIPO: Record<string, string> = { foto: "Foto", video: "Video", musica: "Musica" };
  let scrivi: string | null = null;

  function disegna() {
    const m = leggi();
    el.innerHTML = LIB.voci.map((v) => {
      const cl = OK.includes(v.permesso) ? "ok" : NO.includes(v.permesso) ? "no" : "medio";
      const chiedibile = v.tipo === "foto" && (v.permesso === "non chiesto" || v.permesso === "sconosciuto") && v.fonte.startsWith("@");
      const msg = m.permessi[v.id];
      return `<li class="lib-voce" data-voce-lib="${v.id}">
        <div class="lib-anteprima lib-${v.tipo}"><span>${TIPO[v.tipo] ?? v.tipo}</span></div>
        <strong>${esc(v.titolo)}</strong>
        <span class="sp-nota">Fonte: ${esc(v.fonte)}</span>
        <span><span class="sp-badge ${cl}">${esc(v.permesso)}</span></span>
        <span class="sp-nota">${esc(v.nota)}</span>
        ${msg && scrivi !== v.id ? `<div class="lib-msg"><strong>Messaggio inviato a ${esc(v.fonte)}</strong><p>${esc(msg)}</p><button type="button" class="com-bt" data-scrivi>Modifica il messaggio</button></div>` : ""}
        ${chiedibile && !msg && scrivi !== v.id ? '<button type="button" class="com-bt" data-scrivi>Chiedi il permesso</button>' : ""}
        ${scrivi === v.id ? `<form class="lib-form" data-form-permesso>
            <label class="sp-nota" for="p-${v.id}">Messaggio privato a ${esc(v.fonte)}</label>
            <textarea id="p-${v.id}" name="testo" rows="5">${esc(msg ?? "")}</textarea>
            <div class="lib-bottoni"><button type="submit" class="bottone-app">Invia</button><button type="button" class="com-bt" data-annulla>Annulla</button></div>
          </form>` : ""}
      </li>`;
    }).join("");
    const f = el.querySelector<HTMLFormElement>("[data-form-permesso]");
    if (f) {
      f.querySelector("textarea")!.focus();
      f.addEventListener("submit", (e) => {
        e.preventDefault();
        const t = String(new FormData(f).get("testo") ?? "").trim();
        const m2 = leggi(); if (t) m2.permessi[scrivi!] = t; else delete m2.permessi[scrivi!];
        scrivi = null; salva(m2); disegna();
      });
      f.querySelector("[data-annulla]")!.addEventListener("click", () => { scrivi = null; disegna(); });
    }
  }
  el.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>("[data-scrivi]");
    if (!b) return;
    scrivi = b.closest<HTMLElement>("[data-voce-lib]")!.dataset.voceLib!; disegna();
  });
  disegna();
</script>

<style>
  .lib-intro { max-width: 70ch; }
  .lib-griglia { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px; }
  :global(.lib-voce) { background: #fff; border: 1px solid #e3e1dc; border-radius: 16px; padding: 14px; display: flex; flex-direction: column; gap: 6px; font-size: .88rem; min-width: 0; }
  :global(.lib-anteprima) { height: 110px; border-radius: 10px; display: flex; align-items: flex-end; padding: 8px; }
  :global(.lib-anteprima span) { font-size: .7rem; font-weight: 700; background: rgba(255,255,255,.85); padding: 2px 8px; border-radius: 999px; }
  :global(.lib-foto) { background: linear-gradient(135deg, #dcecdf, #d9eeec); }
  :global(.lib-video) { background: linear-gradient(135deg, #e7e2f3, #dfe8f7); }
  :global(.lib-musica) { background: repeating-linear-gradient(90deg, #e8e6e1 0 6px, #f4f3f0 6px 12px); }
  :global(.lib-msg) { border-left: 3px solid var(--arancio); padding-left: 10px; display: flex; flex-direction: column; gap: 4px; }
  :global(.lib-msg p) { margin: 0; overflow-wrap: anywhere; }
  :global(.lib-form) { display: flex; flex-direction: column; gap: 8px; }
  :global(.lib-form textarea) { font: inherit; font-size: .88rem; padding: 9px 11px; border: 1px solid #d1cec8; border-radius: 10px; width: 100%; box-sizing: border-box; }
  :global(.lib-bottoni) { display: flex; gap: 8px; flex-wrap: wrap; }
  :global(.com-bt) { align-self: flex-start; font: inherit; font-weight: 700; font-size: .82rem; padding: 8px 12px; border-radius: 10px; border: 1px solid #d1cec8; background: #fff; cursor: pointer; color: var(--inchiostro); }
</style>
