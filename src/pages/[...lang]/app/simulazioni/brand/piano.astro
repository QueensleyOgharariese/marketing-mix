---
import { LINGUE_APP, testiDa } from "../../../../../i18n";
// SIMULAZIONE BRAND · PIANO DI BRAND 2027
// Una pagina: obiettivo, pubblico, messaggio chiave, canali e KPI (scelti da elenchi). Si salva in questo browser.
import Console from "../../../../../components/seopro/Console.astro";
export function getStaticPaths() { return LINGUE_APP(); }
const L = testiDa(Astro.url);
// Il valore salvato è il codice (il nome italiano), uguale nelle due lingue; l'etichetta cambia con la lingua
const CANALI = [["Ufficio stampa", "Press office"], ["Social", "Social media"], ["Newsletter", "Newsletter"], ["Collaborazioni con creator", "Partnerships with creators"], ["Annunci sui motori di ricerca", "Search engine ads"], ["Packaging", "Packaging"], ["Eventi e fiere", "Events and fairs"], ["Podcast di settore", "Trade podcasts"], ["Pubblicità in TV nazionale", "National TV advertising"]].map(([v, en]) => ({ v, nome: L(v, en) }));
const KPI = [["Notorietà spontanea", "Unaided awareness"], ["Notorietà guidata", "Aided awareness"], ["Ricerche del nome del negozio", "Searches for the shop's name"], ["NPS", "NPS"], ["Numero di follower", "Number of followers"], ["Like ai post", "Likes on posts"], ["Fatturato del mese", "Monthly revenue"], ["Visite alla home", "Home page visits"]].map(([v, en]) => ({ v, nome: L(v, en) }));
---
<Console sim="brand" attivo="piano" titolo={L("Piano di brand 2027", "2027 brand plan")} sottotitolo={L("Una pagina, da presentare alla direzione", "One page, to present to management")}>
  <form class="sp-pannello pn-form" data-piano>
    <label>{L("Obiettivo", "Goal")} <span class="sp-nota">{L("Da quanto a quanto, per chi, entro quando.", "From how much to how much, for whom, by when.")}</span><textarea name="obiettivo" rows="2"></textarea></label>
    <label>{L("Pubblico", "Audience")} <span class="sp-nota">{L("A chi parliamo prima di tutto.", "Who we speak to first of all.")}</span><textarea name="pubblico" rows="2"></textarea></label>
    <label>{L("Messaggio chiave", "Key message")} <span class="sp-nota">{L("Una frase: cosa vogliamo che ricordino.", "One sentence: what we want them to remember.")}</span><textarea name="messaggio" rows="2"></textarea></label>
    <fieldset><legend>{L("Canali", "Channels")}</legend><div class="pn-scelte">{CANALI.map((c) => <label class="pn-check"><input type="checkbox" name="canali" value={c.v} /> {c.nome}</label>)}</div></fieldset>
    <fieldset><legend>{L("KPI (come misuriamo)", "KPIs (how we measure)")}</legend><div class="pn-scelte">{KPI.map((k) => <label class="pn-check"><input type="checkbox" name="kpi" value={k.v} /> {k.nome}</label>)}</div></fieldset>
    <div class="pn-bottoni"><button type="submit" class="bottone-app">{L("Salva il piano", "Save the plan")}</button><span class="sp-nota" data-esito-piano></span></div>
  </form>
</Console>

<script>
  import { leggi, salva } from "../../../../../scripts/brand/stato";
  import { t } from "../../../../../scripts/lingua";
  const f = document.querySelector<HTMLFormElement>("[data-piano]")!;
  const m = leggi();
  for (const k of ["obiettivo", "pubblico", "messaggio"] as const) f.querySelector<HTMLTextAreaElement>(`[name=${k}]`)!.value = m.piano[k] ?? "";
  f.querySelectorAll<HTMLInputElement>("input[type=checkbox]").forEach((c) => { c.checked = ((m.piano as any)[c.name] ?? []).includes(c.value); });
  f.addEventListener("submit", (e) => {
    e.preventDefault(); const d = new FormData(f), m2 = leggi();
    m2.piano = { obiettivo: String(d.get("obiettivo") ?? "").trim(), pubblico: String(d.get("pubblico") ?? "").trim(), messaggio: String(d.get("messaggio") ?? "").trim(), canali: d.getAll("canali").map(String), kpi: d.getAll("kpi").map(String) };
    salva(m2); document.querySelector("[data-esito-piano]")!.textContent = t("Piano salvato.", "Plan saved.");
  });
</script>

<style>
  .pn-form { display: flex; flex-direction: column; gap: 14px; }
  .pn-form > label { display: flex; flex-direction: column; gap: 5px; font-weight: 700; font-size: .9rem; }
  .pn-form textarea { font: inherit; font-weight: 400; font-size: .92rem; padding: 9px 11px; border: 1px solid #d1cec8; border-radius: 10px; width: 100%; box-sizing: border-box; }
  .pn-form fieldset { border: 1px solid #e3e1dc; border-radius: 12px; padding: 10px 14px; margin: 0; min-width: 0; }
  .pn-form legend { font-weight: 700; font-size: .9rem; padding: 0 4px; }
  .pn-scelte { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 6px 12px; }
  .pn-check { display: flex; gap: 8px; align-items: center; font-size: .9rem; }
  .pn-bottoni { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
</style>
