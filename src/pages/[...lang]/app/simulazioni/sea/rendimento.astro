---
import { LINGUE_APP } from "../../../../../i18n";
// SIMULAZIONE SEA · RENDIMENTO SUL SITO
// Cosa succede dopo il clic, gruppo per gruppo (dalle statistiche del negozio), accanto al costo degli annunci.
// In alto il margine lordo medio: serve per il ROAS di pareggio (1 ÷ margine), che chi gioca calcola da sé.
import Console from "../../../../../components/seopro/Console.astro";
import R from "../../../../../data/app/sea-sim/rendimento.json";
import CONTO from "../../../../../data/app/sea-sim/account.json";
import { num } from "../../../../../scripts/tabella";
const euro = (x: number) => num(x, 2) + " €";
const gruppi = CONTO.campagne.flatMap((c) => c.gruppi.map((g) => ({ ...g, campagna: c.nome })));
const righe = R.righe.map((r) => {
  const g = gruppi.find((x) => x.id === r.gruppo)!;
  const costo = g.keyword.reduce((s, k) => s + k.costo, 0);
  return { ...r, nomeC: g.campagna, nomeG: g.nome, costo, roas: costo ? r.ricavi / costo : 0 };
});
export function getStaticPaths() { return LINGUE_APP(); }
---
<Console sim="sea" attivo="rendimento" titolo="Rendimento sul sito" sottotitolo="Visite arrivate dagli annunci, dal 1 al 28 ottobre 2026" ispirato="le statistiche di un sito e-commerce (nome generico)">
  <div class="sp-cifre" data-margine>
    <div class="sp-cifra"><span>Margine lordo medio sui prodotti</span><strong>{Math.round(CONTO.margine * 100)}%</strong><small>su 100 € di vendite, 40 € restano dopo il costo dei prodotti</small></div>
    <div class="sp-cifra"><span>Ordini arrivati dagli annunci</span><strong>{righe.reduce((s, r) => s + r.ordini, 0)}</strong></div>
    <div class="sp-cifra"><span>Ricavi dagli annunci</span><strong>{num(righe.reduce((s, r) => s + r.ricavi, 0))} €</strong></div>
  </div>
  <section class="sp-pannello">
    <div class="sp-scorri">
      <table data-tabella id="t-rendimento">
        <thead><tr><th data-ordina="testo">Campagna</th><th data-ordina="testo">Gruppo</th><th data-ordina="testo">Pagina di arrivo</th>
          <th class="n" data-ordina="numero">Sessioni</th><th class="n" data-ordina="numero">Frequenza di rimbalzo</th><th class="n" data-ordina="numero">Ordini</th>
          <th class="n" data-ordina="numero">Ricavi</th><th class="n" data-ordina="numero">Costo annunci</th><th class="n" data-ordina="numero">ROAS</th></tr></thead>
        <tbody>{righe.map((r) => (
          <tr><td>{r.nomeC}</td><td><strong>{r.nomeG}</strong></td><td class="url">{r.pagina}</td>
            <td class="n" data-valore={r.sessioni}>{num(r.sessioni)}</td><td class="n" data-valore={r.rimbalzo}>{Math.round(r.rimbalzo * 100)}%</td>
            <td class="n">{r.ordini}</td><td class="n" data-valore={r.ricavi}>{euro(r.ricavi)}</td><td class="n" data-valore={r.costo}>{euro(r.costo)}</td><td class="n" data-valore={r.roas}>{num(r.roas, 2)}</td></tr>
        ))}</tbody>
      </table>
    </div>
    <p class="sp-nota">Frequenza di rimbalzo: su 100 visite, quante lasciano il sito dalla prima pagina senza fare altro. ROAS = ricavi ÷ costo degli annunci del gruppo.</p>
  </section>
</Console>
<script>
  import { attivaTabelle } from "../../../../../scripts/tabella";
  attivaTabelle();
</script>
