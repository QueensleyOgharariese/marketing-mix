---
import { LINGUE_APP } from "../../../../../i18n";
// SIMULAZIONE SEA · CAMPAGNE (ispirato agli strumenti per gli annunci sui motori di ricerca, nome generico)
// In alto la tabella delle campagne con i numeri di ottobre. Clic sul nome (o indirizzo #id-campagna):
// si apre la campagna con budget e stato, parole chiave negative, gruppi con parole chiave e annunci.
// Tutte le modifiche restano in questo browser (scripts/sea/stato.ts).
import Console from "../../../../../components/seopro/Console.astro";
export function getStaticPaths() { return LINGUE_APP(); }
---
<Console sim="sea" attivo="campagne" titolo="Campagne" sottotitolo="Numeri dal 1 al 28 ottobre 2026" ispirato="gli strumenti per gli annunci sui motori di ricerca (nome generico, nessun marchio reale)">
  <section class="sp-pannello">
    <div class="sp-scorri">
      <table data-tabella data-tabella-campagne>
        <thead><tr>
          <th data-ordina="testo">Campagna</th><th data-ordina="testo">Stato</th><th class="n" data-ordina="numero">Budget/giorno</th>
          <th class="n" data-ordina="numero">Impressioni</th><th class="n" data-ordina="numero">Clic</th><th class="n" data-ordina="numero">CTR</th>
          <th class="n" data-ordina="numero">Costo</th><th class="n" data-ordina="numero">Conversioni</th><th class="n" data-ordina="numero">CPA</th>
          <th class="n" data-ordina="numero">Valore</th><th class="n" data-ordina="numero">ROAS</th><th class="n" data-ordina="numero">Impressioni perse per budget</th>
        </tr></thead>
        <tbody data-righe-campagne></tbody>
      </table>
    </div>
    <p class="sp-nota">Clicca il nome di una campagna per aprirla. Conversioni = vendite arrivate dagli annunci; Valore = quanto valgono quelle vendite.</p>
  </section>
  <section class="sp-pannello ca-dett" data-campagna-aperta hidden></section>
</Console>

<script>
  import { leggi, salva, campagne, totali, euro, type Campagna, type Gruppo, type Annuncio, type Corrispondenza } from "../../../../../scripts/sea/stato";
  import { attivaTabelle, num } from "../../../../../scripts/tabella";
  const esc = (t: string) => String(t).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  const dec = (x: number, d = 2) => num(x, d);
  const corpo = document.querySelector<HTMLElement>("[data-righe-campagne]")!;
  const dett = document.querySelector<HTMLElement>("[data-campagna-aperta]")!;
  const STATO: Record<string, string> = { attiva: "Attiva", "in pausa": "In pausa", bozza: "Bozza" };
  let modificaAnnuncio: string | null = null;
  let qsAperto: string | null = null;

  function disegnaTabella() {
    corpo.innerHTML = campagne().map((c) => {
      const t = totali(c);
      return `<tr><td data-valore="${esc(c.nome)}"><a href="#${c.id}" class="ca-nome">${esc(c.nome)}</a></td>
        <td><span class="sp-badge ${c.stato === "attiva" ? "ok" : c.stato === "bozza" ? "medio" : ""}">${STATO[c.stato] ?? c.stato}</span></td>
        <td class="n" data-valore="${c.budget}">${euro(c.budget, 0)}</td>
        <td class="n" data-valore="${t.impressioni}">${num(t.impressioni)}</td><td class="n" data-valore="${t.clic}">${num(t.clic)}</td>
        <td class="n" data-valore="${t.ctr}">${t.impressioni ? dec(t.ctr, 1) + "%" : "–"}</td>
        <td class="n" data-valore="${t.costo}">${euro(t.costo)}</td><td class="n" data-valore="${t.conversioni}">${t.conversioni}</td>
        <td class="n" data-valore="${t.cpa}">${t.conversioni ? euro(t.cpa) : "–"}</td>
        <td class="n" data-valore="${t.valore}">${euro(t.valore, 0)}</td>
        <td class="n" data-valore="${t.roas}">${t.costo ? dec(t.roas) : "–"}</td>
        <td class="n" data-valore="${c.quotaPersaBudget}">${c.stato === "bozza" ? "–" : num(c.quotaPersaBudget * 100) + "%"}</td></tr>`;
    }).join("");
  }

  function tabellaKeyword(c: Campagna, g: Gruppo) {
    if (!g.keyword.length) return `<p class="sp-nota">Nessuna parola chiave in questo gruppo.</p>`;
    return `<div class="sp-scorri"><table data-tabella class="ca-kw"><thead><tr><th>Parola chiave</th><th>Corrispondenza</th><th class="n">Qualità</th><th class="n">Impr.</th><th class="n">Clic</th><th class="n">CTR</th><th class="n">CPC</th><th class="n">Costo</th><th class="n">Conv.</th><th class="n">Valore</th><th></th></tr></thead><tbody>
      ${g.keyword.map((k) => `<tr data-kw="${k.id}">
        <td><strong>${esc(k.testo)}</strong>${k.nuova ? ' <span class="sp-badge">nuova</span>' : ""}</td>
        <td><select class="sp-scegli ca-corr" data-corr="${k.id}" aria-label="Corrispondenza di ${esc(k.testo)}">${["generica", "frase", "esatta"].map((x) => `<option value="${x}" ${k.corrispondenza === x ? "selected" : ""}>${x[0].toUpperCase() + x.slice(1)}</option>`).join("")}</select></td>
        <td class="n">${k.qs ? `<button type="button" class="ca-qs q${k.qs <= 4 ? "b" : k.qs <= 6 ? "m" : "a"}" data-qs="${k.id}" aria-expanded="${qsAperto === k.id}">${k.qs}/10</button>` : "–"}</td>
        <td class="n">${num(k.impressioni)}</td><td class="n">${num(k.clic)}</td><td class="n">${k.impressioni ? dec((k.clic / k.impressioni) * 100, 1) + "%" : "–"}</td>
        <td class="n">${k.clic ? euro(k.costo / k.clic) : "–"}</td><td class="n">${euro(k.costo)}</td><td class="n">${k.conversioni}</td><td class="n">${euro(k.valore, 0)}</td>
        <td>${k.nuova ? `<button type="button" class="ca-link" data-togli-kw="${g.id}|${k.id}">Togli</button>` : ""}</td></tr>
        ${qsAperto === k.id ? `<tr class="ca-qs-riga"><td colspan="11"><strong>Punteggio di qualità ${k.qs}/10</strong> · CTR previsto: <em>${k.componenti.ctr}</em> · Pertinenza dell'annuncio: <em>${k.componenti.pertinenza}</em> · Esperienza sulla pagina di destinazione: <em>${k.componenti.pagina}</em></td></tr>` : ""}`).join("")}
      </tbody></table></div>`;
  }

  function vistaAnnuncio(a: Annuncio) {
    if (modificaAnnuncio === a.id) {
      const t = [...a.titoli, ...Array(15).fill("")].slice(0, 15), d = [...a.descrizioni, ...Array(4).fill("")].slice(0, 4);
      return `<form class="ca-form-ann" data-form-annuncio="${a.id}">
        <fieldset><legend>Titoli (fino a 15, massimo 30 caratteri)</legend>
          ${t.map((x, i) => `<label class="ca-campo"><span class="sr">Titolo ${i + 1}</span><input name="titolo" value="${esc(x)}" placeholder="Titolo ${i + 1}" data-max="30" /><span class="ca-conta" aria-live="off"></span></label>`).join("")}</fieldset>
        <fieldset><legend>Descrizioni (fino a 4, massimo 90 caratteri)</legend>
          ${d.map((x, i) => `<label class="ca-campo"><span class="sr">Descrizione ${i + 1}</span><input name="descrizione" value="${esc(x)}" placeholder="Descrizione ${i + 1}" data-max="90" /><span class="ca-conta"></span></label>`).join("")}</fieldset>
        <label class="ca-riga">URL finale <input name="url" value="${esc(a.url)}" placeholder="/categoria/prodotto/" /></label>
        ${a.fine !== undefined ? `<label class="ca-riga">Data di fine <input name="fine" type="date" value="${esc(a.fine ?? "")}" min="2026-10-29" max="2026-12-31" /></label>` : ""}
        <p class="sp-nota">Gli indirizzi sono quelli del negozio di Cinque Foglie (per esempio /te-verdi/ o /matcha/kit-matcha/).</p>
        <div class="ca-bottoni"><button type="submit" class="bottone-app">Salva l'annuncio</button><button type="button" class="ca-sec" data-annulla-ann>Annulla</button></div>
      </form>`;
    }
    const vuoto = !a.titoli.length;
    return vuoto ? `<p class="sp-nota">Annuncio vuoto: ancora nessun titolo né descrizione.</p><button type="button" class="ca-sec" data-modifica-ann="${a.id}">Scrivi l'annuncio</button>`
      : `<div class="ca-anteprima"><span class="ca-sponsor">Sponsorizzato · cinquefoglie.example${esc(a.url)}</span>
          <strong class="ca-ant-tit">${a.titoli.slice(0, 3).map(esc).join(" | ")}</strong><span>${a.descrizioni.slice(0, 2).map(esc).join(" ")}</span></div>
        <details class="ca-tutti"><summary>Tutti i testi (${a.titoli.length} titoli, ${a.descrizioni.length} descrizioni)</summary>
          <ol>${a.titoli.map((x) => `<li>${esc(x)} <span class="sp-nota">${x.length}</span></li>`).join("")}</ol><ol>${a.descrizioni.map((x) => `<li>${esc(x)} <span class="sp-nota">${x.length}</span></li>`).join("")}</ol></details>
        <p class="sp-nota">URL finale: <strong>${esc(a.url || "nessuno")}</strong>${a.fine ? ` · Data di fine: <strong>${a.fine.split("-").reverse().join("/")}</strong>` : ""}</p>
        <button type="button" class="ca-sec" data-modifica-ann="${a.id}">Modifica l'annuncio</button>`;
  }

  function disegnaDettaglio() {
    const id = location.hash.slice(1);
    const c = campagne().find((x) => x.id === id);
    if (!c) { dett.hidden = true; return; }
    dett.hidden = false;
    dett.innerHTML = `<div class="ca-testa" data-campagna="${c.id}"><div><span class="sp-nota">Campagna · ${esc(c.tipo)}</span><h2 class="ca-tit">${esc(c.nome)}</h2></div><a class="ca-sec" href="#">Chiudi</a></div>
      <form class="ca-imp" data-budget>
        <label>Budget giornaliero (€) <input name="budget" type="number" min="0" max="500" step="0.5" value="${c.budget}" class="sp-scegli" /></label>
        <label>Stato <select name="stato" class="sp-scegli">${(c.stato === "bozza" ? ["bozza", "attiva"] : ["attiva", "in pausa"]).map((s) => `<option value="${s}" ${c.stato === s ? "selected" : ""}>${s === "attiva" && c.stato === "bozza" ? "Pubblica (attiva)" : STATO[s]}</option>`).join("")}</select></label>
        <button type="submit" class="bottone-app">Salva</button><span class="sp-nota" data-esito-imp></span>
      </form>
      <section class="ca-blocco" data-negative><h3>Parole chiave negative</h3>
        <p class="sp-nota">L'annuncio non compare se la ricerca contiene tutte le parole di una negativa.</p>
        <ul class="ca-neg">${c.negative.map((n) => `<li>${esc(n)} <button type="button" class="ca-x" data-togli-neg="${esc(n)}" aria-label="Togli ${esc(n)}">×</button></li>`).join("") || '<li class="sp-nota">Nessuna.</li>'}</ul>
        <form class="ca-riga-form" data-form-neg><input name="neg" placeholder="es. gratis" class="sp-cerca" aria-label="Nuova parola chiave negativa" /><button type="submit" class="ca-sec">Aggiungi negativa</button></form>
      </section>
      ${c.gruppi.map((g) => `<section class="ca-blocco ca-gruppo" data-gruppo="${g.id}">
        <h3>Gruppo · ${esc(g.nome)}</h3>
        <h4>Parole chiave</h4>${tabellaKeyword(c, g)}
        <form class="ca-riga-form" data-nuova-keyword="${g.id}"><input name="testo" class="sp-cerca" placeholder="Nuova parola chiave" aria-label="Nuova parola chiave per ${esc(g.nome)}" />
          <select name="corr" class="sp-scegli" aria-label="Corrispondenza"><option value="frase">Frase</option><option value="esatta">Esatta</option><option value="generica">Generica</option></select>
          <button type="submit" class="ca-sec">Aggiungi parola chiave</button></form>
        <h4>Annuncio</h4>${g.annunci.map((a) => `<div class="ca-ann" data-annuncio="${a.id}">${vistaAnnuncio(a)}</div>`).join("")}
      </section>`).join("")}`;
    collega(c);
  }

  function collega(c: Campagna) {
    dett.querySelector<HTMLFormElement>("[data-budget]")!.addEventListener("submit", (e) => {
      e.preventDefault();
      const f = new FormData(e.target as HTMLFormElement), m = leggi();
      m.campagne[c.id] = { ...(m.campagne[c.id] ?? {}), budget: Number(f.get("budget")), stato: String(f.get("stato")) };
      salva(m); disegna(); dett.querySelector("[data-esito-imp]")!.textContent = "Salvato.";
    });
    dett.querySelector<HTMLFormElement>("[data-form-neg]")!.addEventListener("submit", (e) => {
      e.preventDefault();
      const v = String(new FormData(e.target as HTMLFormElement).get("neg") ?? "").trim().toLowerCase();
      if (!v) return;
      const m = leggi(); const n = m.negative[c.id] ?? []; if (!n.includes(v)) m.negative[c.id] = [...n, v];
      salva(m); disegna();
    });
    dett.querySelectorAll<HTMLFormElement>("[data-nuova-keyword]").forEach((f) => f.addEventListener("submit", (e) => {
      e.preventDefault();
      const d = new FormData(f), testo = String(d.get("testo") ?? "").trim().toLowerCase();
      if (!testo) return;
      const m = leggi(), gid = f.dataset.nuovaKeyword!;
      const lista = m.nuove[gid] ?? [];
      if (!lista.some((k) => k.testo === testo)) m.nuove[gid] = [...lista, { id: `n-${Date.now()}`, testo, corrispondenza: String(d.get("corr")) as Corrispondenza }];
      salva(m); disegna();
      dett.querySelector<HTMLInputElement>(`[data-nuova-keyword="${gid}"] input`)?.focus();
    }));
    dett.querySelectorAll<HTMLFormElement>("[data-form-annuncio]").forEach((f) => {
      const conta = () => f.querySelectorAll<HTMLInputElement>("input[data-max]").forEach((i) => {
        const s = i.nextElementSibling as HTMLElement; const max = Number(i.dataset.max);
        s.textContent = i.value ? `${i.value.length}/${max}` : ""; s.classList.toggle("troppo", i.value.length > max);
      });
      f.addEventListener("input", conta); conta();
      f.addEventListener("submit", (e) => {
        e.preventDefault();
        const d = new FormData(f), m = leggi();
        const pulisci = (k: string) => d.getAll(k).map((x) => String(x).trim()).filter(Boolean);
        m.annunci[f.dataset.formAnnuncio!] = { titoli: pulisci("titolo"), descrizioni: pulisci("descrizione"), url: String(d.get("url") ?? "").trim(), ...(d.has("fine") ? { fine: String(d.get("fine")) } : {}) };
        modificaAnnuncio = null; salva(m); disegna();
      });
      f.querySelector("[data-annulla-ann]")!.addEventListener("click", () => { modificaAnnuncio = null; disegnaDettaglio(); });
    });
  }

  dett.addEventListener("click", (e) => {
    const el = e.target as HTMLElement;
    const mod = el.closest<HTMLElement>("[data-modifica-ann]"); if (mod) { modificaAnnuncio = mod.dataset.modificaAnn!; disegnaDettaglio(); return; }
    const qs = el.closest<HTMLElement>("[data-qs]"); if (qs) { qsAperto = qsAperto === qs.dataset.qs ? null : qs.dataset.qs!; disegnaDettaglio(); return; }
    const neg = el.closest<HTMLElement>("[data-togli-neg]");
    if (neg) { const id = location.hash.slice(1), m = leggi(); m.negative[id] = (m.negative[id] ?? []).filter((x) => x !== neg.dataset.togliNeg); salva(m); disegna(); return; }
    const tk = el.closest<HTMLElement>("[data-togli-kw]");
    if (tk) { const [g, k] = tk.dataset.togliKw!.split("|"); const m = leggi(); m.nuove[g] = (m.nuove[g] ?? []).filter((x) => x.id !== k); salva(m); disegna(); }
  });
  dett.addEventListener("change", (e) => {
    const s = (e.target as HTMLElement).closest<HTMLSelectElement>("[data-corr]");
    if (!s) return;
    const m = leggi(), id = s.dataset.corr!;
    const nuova = Object.entries(m.nuove).find(([, l]) => l.some((k) => k.id === id));
    if (nuova) nuova[1].forEach((k) => { if (k.id === id) k.corrispondenza = s.value as Corrispondenza; });
    else m.keyword[id] = { ...(m.keyword[id] ?? {}), corrispondenza: s.value as Corrispondenza };
    salva(m); disegna();
  });

  function disegna() { disegnaTabella(); disegnaDettaglio(); }
  addEventListener("hashchange", () => { modificaAnnuncio = null; qsAperto = null; disegnaDettaglio(); if (location.hash.length > 1) dett.scrollIntoView({ behavior: "smooth", block: "start" }); });
  disegna(); attivaTabelle();
  if (location.hash.length > 1) setTimeout(() => dett.scrollIntoView({ block: "start" }), 50);
</script>

<style>
  .ca-dett { display: flex; flex-direction: column; gap: 18px; }
  :global(.ca-nome) { font-weight: 700; color: var(--inchiostro); display: inline-block; min-width: 150px; }
  :global(.ca-testa) { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  :global(.ca-tit) { font-family: var(--font-titoli); font-size: 1.3rem; font-weight: 800; margin: 2px 0 0; }
  :global(.ca-imp) { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; padding: 14px; background: #f8f8f6; border-radius: 12px; }
  :global(.ca-imp label) { display: flex; flex-direction: column; gap: 4px; font-weight: 700; font-size: .84rem; }
  :global(.ca-imp input) { width: 120px; }
  :global(.ca-blocco) { display: flex; flex-direction: column; gap: 10px; border-top: 1px solid #e3e1dc; padding-top: 16px; min-width: 0; }
  :global(.ca-blocco h3) { font-family: var(--font-titoli); font-size: 1.05rem; font-weight: 800; margin: 0; }
  :global(.ca-blocco h4) { font-size: .82rem; margin: 6px 0 0; color: #55514c; }
  :global(.ca-neg) { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  :global(.ca-neg li) { background: #efeeea; border-radius: 999px; padding: 4px 4px 4px 12px; font-size: .84rem; display: flex; align-items: center; gap: 4px; }
  :global(.ca-x) { border: 0; background: none; font-size: 1.1rem; cursor: pointer; width: 26px; height: 26px; border-radius: 50%; }
  :global(.ca-x:hover) { background: #dedcd6; }
  :global(.ca-riga-form) { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  :global(.ca-riga-form .sp-cerca) { min-width: 0; flex: 1 1 200px; }
  :global(.ca-sec) { font: inherit; font-weight: 700; font-size: .84rem; padding: 9px 13px; border-radius: 10px; border: 1px solid #d1cec8; background: #fff; cursor: pointer; color: var(--inchiostro); text-decoration: none; align-self: flex-start; }
  :global(.ca-link) { font: inherit; font-size: .8rem; background: none; border: 0; text-decoration: underline; cursor: pointer; color: #55514c; }
  :global(.ca-corr) { padding: 5px 8px; font-size: .82rem; }
  :global(.ca-qs) { font: inherit; font-weight: 800; font-size: .8rem; border: 0; border-radius: 999px; padding: 3px 9px; cursor: pointer; }
  :global(.ca-qs.qb) { background: #fde8e4; color: #a12d1d; } :global(.ca-qs.qm) { background: #fff3d6; color: #7a5200; } :global(.ca-qs.qa) { background: #e3f3e8; color: #1f5c38; }
  :global(.ca-qs-riga td) { background: #f8f8f6; font-size: .82rem; white-space: normal; }
  :global(.ca-anteprima) { border: 1px solid #e3e1dc; border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 4px; font-size: .88rem; max-width: 640px; overflow-wrap: anywhere; }
  :global(.ca-sponsor) { font-size: .76rem; color: #55514c; }
  :global(.ca-ant-tit) { color: #1a4fa0; font-size: 1rem; }
  :global(.ca-tutti) { font-size: .86rem; }
  :global(.ca-tutti summary) { cursor: pointer; font-weight: 700; }
  :global(.ca-tutti ol) { margin: 6px 0; padding-left: 22px; }
  :global(.ca-form-ann) { display: flex; flex-direction: column; gap: 12px; }
  :global(.ca-form-ann fieldset) { border: 1px solid #e3e1dc; border-radius: 12px; padding: 10px 12px; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 6px 12px; margin: 0; min-width: 0; }
  :global(.ca-form-ann legend) { font-weight: 700; font-size: .84rem; padding: 0 4px; }
  :global(.ca-campo) { display: flex; align-items: center; gap: 6px; min-width: 0; }
  :global(.ca-campo input), :global(.ca-riga input) { font: inherit; font-size: .88rem; padding: 7px 9px; border: 1px solid #d1cec8; border-radius: 8px; flex: 1; min-width: 0; }
  :global(.ca-conta) { font-size: .72rem; color: #55514c; width: 42px; text-align: right; flex: none; }
  :global(.ca-conta.troppo) { color: #a12d1d; font-weight: 800; }
  :global(.ca-riga) { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-weight: 700; font-size: .86rem; }
  :global(.ca-bottoni) { display: flex; gap: 8px; flex-wrap: wrap; }
  :global(.sr) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
