---
import { LINGUE_APP, linguaDa } from "../../../../i18n";
// APP · 4. CORREZIONE (mista)
// Parte automatica: i 4 controlli misurabili (40 punti). Parte creativa: autovalutazione
// confrontando il proprio lavoro con la soluzione di un professionista (60 punti).
// Tutto viene letto e salvato nel browser (vedi src/scripts/progressi.ts).
import AppLayout from "../../../../layouts/AppLayout.astro";
import Pesca from "../../../../components/Pesca.astro";
import Passi from "../../../../components/PassiEsercizio.astro";
import esIt from "../../../../data/app/seo-sencha.json";
import esEn from "../../../../data/app/seo-sencha.en.json";
import { partiDi } from "../../../../scripts/controlli-seo";
export function getStaticPaths() { return LINGUE_APP(); }
const en = linguaDa(Astro.url) === "en";
const L = (it: string, eng: string) => (en ? eng : it);
const es = en ? (esEn as typeof esIt) : esIt;
const PARTI = partiDi(en);
const APP = en ? "/en/app" : "/app";
---
<AppLayout title={L("Correzione · SEO", "Feedback · SEO")} indietro={{ etichetta: L("Teoria del ruolo", "Role theory"), link: `${APP}/impara/seo/` }} percorso={[{ etichetta: "SEO", link: `${APP}/impara/seo/` }, { etichetta: L("Esercizio 1 · Correzione", "Exercise 1 · Feedback") }]}>
  <Passi slot="barra" attivo={3} />

  <!-- Se non c'è ancora una consegna -->
  <main class="contenuto" data-vuoto hidden>
    <section class="pannello vuoto">
      <Pesca dimensione={80} occhiali />
      <div>
        <h1 class="app-titolo">{L("Non hai ancora consegnato", "You haven't submitted yet")}</h1>
        <p>{L("Scrivi titolo e descrizione nell'esercizio, poi torna qui per il confronto.", "Do the exercise, then come back here for the comparison.")}</p>
        <a class="bottone-app" href={`${APP}/seo/esercizio/`}>{L("Vai all'esercizio →", "Go to the exercise →")}</a>
      </div>
    </section>
  </main>

  <main class="contenuto" data-pieno hidden>
    <section class="pannello risultato">
      <div class="risultato-testa">
        <Pesca dimensione={72} class="festa" etichetta={L("Pesca che festeggia", "Pesca celebrating")} />
        <div>
          <h1 class="app-titolo">{L("Consegnato! Ora confronta il tuo lavoro", "Submitted! Now compare your work")}</h1>
          <p>{L("Due parti: i controlli automatici su ciò che si misura, e la tua autovalutazione rispetto alla soluzione di un professionista.", "Two parts: the automatic checks on what can be measured, and your self-assessment against a professional's solution.")}</p>
        </div>
      </div>
      <dl class="punti" aria-live="polite">
        <div><dt>{L("Controlli automatici", "Automatic checks")}</dt><dd><span data-p-auto>0</span> / 40</dd><span class="barra"><span data-b-auto></span></span></div>
        <div><dt>{L("Autovalutazione", "Self-assessment")}</dt><dd><span data-p-voto>0</span> / 60</dd><span class="barra"><span data-b-voto></span></span></div>
        <div data-riga-aiuti><dt>{L("Aiuti di Pesca", "Pesca's hints")}</dt><dd>− <span data-p-aiuti>0</span></dd></div>
        <div class="totale"><dt>{L("Totale", "Total")}</dt><dd data-p-totale>0</dd></div>
      </dl>
    </section>

    <section class="pannello controlli" aria-labelledby="t-controlli">
      <h2 id="t-controlli" class="sottotitolo">{L("Controlli automatici, parte per parte", "Automatic checks, part by part")}</h2>
      <div class="gruppi">
        {PARTI.map((p, n) => (
          <div class="gruppo">
            <strong>{n + 1}. {p.nome} <span class="conteggio" data-conteggio={n}></span></strong>
            <ul>
              {p.controlli.map((c, k) => (
                <li data-controllo={n * 4 + k}><span class="segno" aria-hidden="true"></span><span>{c}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Confronto parte per parte: il tuo lavoro a sinistra, la soluzione a destra -->
    <section class="confronto" aria-label={L("Confronto con la soluzione", "Comparison with the solution")}>
      <div class="riga-confronto">
        <div class="pannello lavoro"><span class="piccolo">{L("1 · Il tuo intento e la keyword", "1 · Your intent and keyword")}</span><span>{L("Keyword scelta", "Chosen keyword")}: <strong data-tuo="keyword"></strong></span><ul class="intenti-tuoi" data-tuo="intenti"></ul></div>
        <div class="pannello lavoro lavoro--pro"><span class="piccolo">{L("Soluzione", "Solution")}</span><span>{es.soluzione.intento}</span></div>
      </div>
      <div class="riga-confronto">
        <div class="pannello lavoro"><span class="piccolo">{L("2 · Il tuo risultato su Google", "2 · Your result on Google")}</span><span class="a-titolo" data-tuo="titolo"></span><span class="a-desc" data-tuo="descrizione"></span></div>
        <div class="pannello lavoro lavoro--pro"><span class="piccolo">{L("Soluzione", "Solution")}</span><span class="a-titolo">{es.soluzione.titolo}</span><span class="a-desc">{es.soluzione.descrizione}</span></div>
      </div>
      <div class="riga-confronto">
        <div class="pannello lavoro"><span class="piccolo">{L("3 · I tuoi dati strutturati", "3 · Your structured data")}</span><span data-tuo="dati"></span></div>
        <div class="pannello lavoro lavoro--pro"><span class="piccolo">{L("Soluzione", "Solution")}</span><span>{es.soluzione.dati}</span></div>
      </div>
      <div class="riga-confronto">
        <div class="pannello lavoro"><span class="piccolo">{L("4 · La tua risposta breve", "4 · Your short answer")}</span><span data-tuo="risposta"></span></div>
        <div class="pannello lavoro lavoro--pro"><span class="piccolo">{L("Soluzione", "Solution")}</span><span>{es.soluzione.risposta}</span></div>
      </div>
      <div class="pannello note-pro">
        <strong>{L("Perché la soluzione funziona", "Why the solution works")}</strong>
        <ul class="perche">{es.soluzione.note.map((p) => <li>{p}</li>)}</ul>
      </div>
    </section>

    <section class="parte-finale">
      <form class="pannello autovalutazione" data-autovalutazione>
        <div>
          <h2 class="sottotitolo">{L("Autovalutazione", "Self-assessment")}</h2>
          <p class="nota">{L("Guarda la soluzione e segna onestamente cosa hai fatto anche tu. Ogni punto vale 15.", "Look at the solution and honestly tick what you did too. Each point is worth 15.")}</p>
        </div>
        {es.autovalutazione.map((frase, i) => (
          <label class="scelta"><input type="checkbox" data-voto={i} /><span>{frase}</span></label>
        ))}
        <fieldset class="gradimento">
          <legend>{L("Quanto ti è piaciuto questo ruolo?", "How much did you enjoy this role?")}</legend>
          <div class="stelle">
            {[1, 2, 3, 4, 5].map((n) => (
              <label><input type="radio" name="gradimento" value={n} /><span>{n}</span></label>
            ))}
          </div>
          <p class="nota">{L("1 = per niente, 5 = moltissimo. Serve a consigliarti il percorso giusto.", "1 = not at all, 5 = very much. It helps us recommend the right path for you.")}</p>
        </fieldset>
      </form>

      <aside class="lato">
        <div class="pannello risposta">
          <span class="mittente"><span class="avatar">{es.richiesta.da}</span><strong>{L("Risposta di", "Reply from")} {es.richiesta.nome}</strong></span>
          <p>{es.risposta}</p>
        </div>
        <div class="pannello imparato">
          <strong>{L("Cosa hai imparato", "What you've learned")}</strong>
          <ul>{es.imparato.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="azioni">
          <button type="button" class="bottone-app" data-completa>{L("Segna come completato →", "Mark as completed →")}</button>
          <a class="bottone-app bottone-app--chiaro" href={`${APP}/seo/esercizio/`}>{L("Riprova", "Try again")}</a>
        </div>
      </aside>
    </section>
  </main>
</AppLayout>

<script>
  import { conLingua, scegli, t } from "../../../../scripts/lingua";
  import { leggi, aggiornaRuolo, punteggio } from "../../../../scripts/progressi";
  import esIt from "../../../../data/app/seo-sencha.json";
  import esEn from "../../../../data/app/seo-sencha.en.json";
  const es = scegli(esIt, esEn as typeof esIt);
  const INTENTI_JS = Object.fromEntries(es.intenti.map((i) => [i.id, i.nome]));

  const seo = leggi().ruoli.seo;
  if (!seo?.consegna) {
    document.querySelector<HTMLElement>("[data-vuoto]")!.hidden = false;
  } else {
    document.querySelector<HTMLElement>("[data-pieno]")!.hidden = false;
    const c = seo.consegna;
    const l = c.lavoro as any;
    const metti = (chiave: string, testo: string) => { document.querySelector(`[data-tuo="${chiave}"]`)!.textContent = testo; };
    metti("keyword", l.keyword || t("nessuna", "none"));
    metti("titolo", l.titolo);
    metti("descrizione", l.descrizione);
    metti("risposta", l.risposta);
    const nomi = INTENTI_JS as Record<string, string>;
    document.querySelector('[data-tuo="intenti"]')!.innerHTML = "";
    Object.entries(l.intenti ?? {}).forEach(([ricerca, id]) => {
      const li = document.createElement("li");
      li.textContent = `${ricerca}: ${nomi[id as string] ?? "?"}`;
      document.querySelector('[data-tuo="intenti"]')!.appendChild(li);
    });
    const d = l.schema ?? {};
    const disp: Record<string, string> = { InStock: t("disponibile", "in stock"), OutOfStock: t("esaurito", "out of stock"), PreOrder: t("preordine", "pre-order") };
    metti("dati", t(`Nome: ${d.nome || "–"}. Marca: ${d.marca || "–"}. Prezzo: ${d.prezzo || "–"} ${d.valuta}. ${disp[d.disponibilita] ?? "disponibilità non indicata"}. ${d.stelle ? "Con stelle 4,8 (inventate!)" : "Nessuna stella"}.`,
      `Name: ${d.nome || "–"}. Brand: ${d.marca || "–"}. Price: ${d.prezzo || "–"} ${d.valuta}. ${disp[d.disponibilita] ?? "availability not given"}. ${d.stelle ? "With 4.8 stars (made up!)" : "No stars"}.`));
    c.controlli.forEach((ok, i) => {
      const li = document.querySelector(`[data-controllo="${i}"]`);
      li?.classList.toggle("ok", ok);
    });
    document.querySelectorAll<HTMLElement>("[data-conteggio]").forEach((el) => {
      const n = Number(el.dataset.conteggio);
      el.textContent = `${c.controlli.slice(n * 4, n * 4 + 4).filter(Boolean).length}/4`;
    });

    // Ripristina autovalutazione e gradimento salvati
    const voti = document.querySelectorAll<HTMLInputElement>("[data-voto]");
    (seo.autovalutazione ?? []).forEach((v, i) => { if (voti[i]) voti[i].checked = v; });
    if (seo.gradimento) {
      const r = document.querySelector<HTMLInputElement>(`input[name="gradimento"][value="${seo.gradimento}"]`);
      if (r) r.checked = true;
    }

    function mostraPunti() {
      const r = leggi().ruoli.seo ?? {};
      const p = punteggio(r);
      document.querySelector("[data-p-auto]")!.textContent = String(p.auto);
      document.querySelector("[data-p-voto]")!.textContent = String(p.voto);
      document.querySelector("[data-p-aiuti]")!.textContent = String(p.aiuti);
      document.querySelector<HTMLElement>("[data-riga-aiuti]")!.hidden = p.aiuti === 0;
      document.querySelector("[data-p-totale]")!.textContent = String(p.totale);
      document.querySelector<HTMLElement>("[data-b-auto]")!.style.width = `${(p.auto / 40) * 100}%`;
      document.querySelector<HTMLElement>("[data-b-voto]")!.style.width = `${(p.voto / 60) * 100}%`;
    }

    const form = document.querySelector("[data-autovalutazione]")!;
    form.addEventListener("change", () => {
      const gradimento = document.querySelector<HTMLInputElement>('input[name="gradimento"]:checked');
      aggiornaRuolo("seo", {
        autovalutazione: [...voti].map((v) => v.checked),
        gradimento: gradimento ? Number(gradimento.value) : undefined,
      });
      mostraPunti();
    });
    mostraPunti();

    document.querySelector("[data-completa]")!.addEventListener("click", () => {
      aggiornaRuolo("seo", { stato: "completato", autovalutazione: [...voti].map((v) => v.checked) });
      window.location.href = conLingua("/app/impara/seo/"); // dopo la prova veloce si torna alla pagina del ruolo
    });
  }
</script>

<style>
  .contenuto { max-width: 1160px; margin: 0 auto; padding: 28px 24px 56px; display: flex; flex-direction: column; gap: 16px; }
  .vuoto { padding: 28px; display: flex; flex-wrap: wrap; gap: 20px; align-items: center; }
  .vuoto div { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .risultato { padding: 22px; display: flex; flex-wrap: wrap; gap: 22px; align-items: center; justify-content: space-between; }
  .risultato-testa { flex: 1 1 420px; min-width: 0; display: flex; gap: 16px; align-items: center; }
  .risultato-testa :global(.festa) { animation: festa 1.8s ease-in-out 3; }
  @keyframes festa { 0%, 100% { transform: translateY(0) rotate(-3deg); } 50% { transform: translateY(-6px) rotate(3deg); } }
  h1 { font-size: 1.6rem; line-height: 1.15; margin-bottom: 4px; }
  .risultato p { color: #55514c; line-height: 1.5; }
  .punti { flex: 1 1 300px; min-width: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .punti div { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; align-items: baseline; }
  .punti dt { font-size: .85rem; color: #55514c; }
  .punti dd { margin: 0; font-weight: 700; font-variant-numeric: tabular-nums; }
  .punti .barra { grid-column: 1 / -1; height: 6px; background: #e9e8e4; border-radius: 99px; overflow: hidden; }
  .punti .barra span { display: block; height: 100%; width: 0; background: var(--arancio); transition: width .3s; }
  .totale { border-top: 1px solid #e3e1dc; padding-top: 8px; }
  .totale dd { font-family: var(--font-titoli); font-size: 2rem; font-weight: 800; color: #c4520b; }
  .controlli { padding: 18px 22px; display: flex; flex-direction: column; gap: 10px; }
  .sottotitolo { font-family: var(--font-testo); font-size: 1rem; font-weight: 700; }
  .controlli ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 8px 16px; font-size: .9rem; }
  .controlli li { display: flex; align-items: center; gap: 8px; color: #5f5a55; }
  .esito { margin-left: auto; font-variant-numeric: tabular-nums; }
  .segno { flex: none; width: 20px; height: 20px; border-radius: 50%; border: 2px solid #c0392b; background: #fde8e4; }
  .controlli li.ok { color: var(--inchiostro); }
  .controlli li.ok .segno { background: #2f7a4f; border-color: #2f7a4f; display: grid; place-items: center; }
  .controlli li.ok .segno::after { content: ""; width: 8px; height: 4px; border-left: 2px solid #fff; border-bottom: 2px solid #fff; transform: rotate(-45deg) translate(1px, -1px); }
  .gruppi { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .gruppo { display: flex; flex-direction: column; gap: 8px; }
  .gruppo strong { font-size: .9rem; display: flex; justify-content: space-between; }
  .conteggio { color: #8a3a06; font-variant-numeric: tabular-nums; }
  .gruppo ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: .85rem; }
  .gruppo li { display: flex; align-items: center; gap: 8px; color: #5f5a55; }
  .gruppo li.ok { color: var(--inchiostro); }
  .gruppo li.ok .segno { background: #2f7a4f; border-color: #2f7a4f; display: grid; place-items: center; }
  .gruppo li.ok .segno::after { content: ""; width: 8px; height: 4px; border-left: 2px solid #fff; border-bottom: 2px solid #fff; transform: rotate(-45deg) translate(1px, -1px); }
  .confronto { display: flex; flex-direction: column; gap: 12px; }
  .riga-confronto { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 12px; }
  .intenti-tuoi { margin: 6px 0 0; padding-left: 18px; font-size: .85rem; line-height: 1.6; color: #4a3a32; }
  .note-pro { padding: 18px 20px; display: flex; flex-direction: column; gap: 6px; }
  .lavoro { min-width: 0; padding: 18px 20px; display: flex; flex-direction: column; gap: 6px; line-height: 1.55; }
  .lavoro--pro { border-color: #2f7a4f; box-shadow: inset 4px 0 0 #2f7a4f; }
  .piccolo { font-size: .7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #6f6a64; margin-bottom: 4px; }
  .a-titolo { font-family: Arial, sans-serif; font-size: 1.15rem; color: #1f45b8; line-height: 1.3; overflow-wrap: anywhere; }
  .a-desc { font-size: .9rem; color: #4a4a4a; line-height: 1.45; overflow-wrap: anywhere; }
  .perche { margin: 10px 0 0; padding-left: 18px; font-size: .9rem; line-height: 1.55; color: #3a2b24; display: flex; flex-direction: column; gap: 4px; }
  .parte-finale { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-start; }
  .autovalutazione { flex: 2 1 460px; min-width: 0; padding: 22px; display: flex; flex-direction: column; gap: 12px; }
  .nota { font-size: .85rem; color: #5f5a55; line-height: 1.5; margin-top: 4px; }
  .scelta { display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; border: 1px solid #e3e1dc; border-radius: 12px; line-height: 1.45; cursor: pointer; }
  .scelta:has(input:checked) { border-color: #2f7a4f; background: #f3faf5; }
  .scelta input { width: 18px; height: 18px; margin-top: 2px; accent-color: #2f7a4f; }
  .gradimento { border: 0; margin: 6px 0 0; padding: 0; }
  legend { font-weight: 700; margin-bottom: 8px; }
  .stelle { display: flex; gap: 8px; }
  .stelle label { position: relative; }
  .stelle input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .stelle span { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; border: 2px solid #d1cec8; font-weight: 800; cursor: pointer; }
  .stelle input:checked + span { background: var(--arancio); border-color: var(--inchiostro); }
  .stelle input:focus-visible + span { outline: 3px solid var(--arancio); outline-offset: 2px; }
  .lato { flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  .risposta, .imparato { padding: 18px; display: flex; flex-direction: column; gap: 10px; line-height: 1.55; }
  .mittente { display: flex; align-items: center; gap: 10px; }
  .imparato ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .imparato li { font-size: .85rem; background: #e3f3e8; color: #1f5c38; padding: 5px 10px; border-radius: 999px; }
  .azioni { display: flex; flex-wrap: wrap; gap: 10px; }
</style>
