---
import { LINGUE_APP } from "../../../i18n";
// APP · INGRESSO: SCEGLI COME INIZIARE
// Si arriva qui dai bottoni del sito ("Entra in azienda", "Prova un ruolo").
// Due strade: Teoria (gli Hub: lezioni brevi con quiz, /app/teoria/) o Simulazioni (pratica nel negozio finto, /app/simulazioni/).
import AppLayout from "../../../layouts/AppLayout.astro";
import Progresso from "../../../components/Progresso.astro";
import Pesca from "../../../components/Pesca.astro";
import Icona from "../../../components/Icona.astro";
import aziendaIt from "../../../data/app/cinque-foglie.json";
import aziendaEn from "../../../data/app/cinque-foglie.en.json";
import { linguaDa, appLink } from "../../../i18n";
export function getStaticPaths() { return LINGUE_APP(); }
const lang = linguaDa(Astro.url);
const L = (it: string, en: string) => (lang === "en" ? en : it);
const azienda = lang === "en" ? aziendaEn : aziendaIt;
---
<AppLayout title={L("Come vuoi iniziare?", "How do you want to start?")} percorso={[{ etichetta: azienda.nome }]}>
  <Progresso slot="barra" />
  <main class="ingresso">
    <header class="testa">
      <Pesca dimensione={72} etichetta={L("Pesca, la tua tutor", "Pesca, your tutor")} />
      <div>
        <h1 class="app-titolo">{L("Come vuoi iniziare?", "How do you want to start?")}</h1>
        <p>{L(`Lavori per ${azienda.nome}, un negozio online di tè inventato. Puoi partire dalla teoria dei ruoli o entrare subito in una simulazione. Puoi cambiare quando vuoi.`, `You work for ${azienda.nome}, a fictional online tea shop. You can start from the theory of the roles or jump straight into a simulation. You can switch whenever you like.`)}</p>
      </div>
    </header>

    <div class="scelte">
      <a class="scelta teoria" href={appLink(lang, "/app/teoria/")}>
        <span class="scelta-icona" aria-hidden="true"><Icona nome="lampadina" dimensione={26} /></span>
        <span class="scelta-tipo">{L("Teoria", "Theory")}</span>
        <strong>{L("Impara i ruoli del marketing", "Learn the marketing roles")}</strong>
        <span class="scelta-testo">{L("12 ruoli in due Hub. Per ogni ruolo una scheda, tre lezioni da dieci minuti con domande dopo ogni concetto e una verifica.", "12 roles in two Hubs. For each role a profile, three ten-minute lessons with questions after every concept, and a quiz.")}</span>
        <ul class="punti"><li>{L("Per chi parte da zero", "For complete beginners")}</li><li>{L("Approfondimenti sul blog", "Further reading on the blog")}</li><li>{L("Prova veloce alla fine di ogni ruolo", "A quick exercise at the end of each role")}</li></ul>
        <span class="bottone-finto">{L("Inizia dalla teoria", "Start with the theory")} →</span>
      </a>
      <a class="scelta simula" href={appLink(lang, "/app/simulazioni/")}>
        <span class="scelta-icona" aria-hidden="true"><Icona nome="anteprima" dimensione={26} /></span>
        <span class="scelta-tipo">{L("Simulazioni", "Simulations")}</span>
        <strong>{L("Fai pratica come in azienda", "Practise like on the job")}</strong>
        <span class="scelta-testo">{L(`Lavori sul sito, sui social, sugli annunci e sul brand di ${azienda.nome}, con strumenti come quelli che si usano nel lavoro. Dalle basi ai casi difficili.`, `You work on ${azienda.nome}'s website, social media, ads and brand, with tools like the ones used on the job. From the basics to the hard cases.`)}</span>
        <ul class="punti"><li>{L("Disponibili: SEO, SEA, Brand e Social", "Available: SEO, SEA, Brand and Social")}</li><li>{L("Le modifiche si vedono negli strumenti", "Your changes show up in the tools")}</li><li>{L("Esercizi controllati, con la soluzione di un collega senior", "Checked exercises, with a senior colleague's solution")}</li></ul>
        <span class="bottone-finto">{L("Entra nelle simulazioni", "Go to the simulations")} →</span>
      </a>
    </div>
    <p class="nota">{L(`${azienda.nome} è un'azienda finta: persone, prodotti e numeri sono inventati per gli esercizi.`, `${azienda.nome} is a fictional company: people, products and numbers are made up for the exercises.`)}</p>
  </main>
</AppLayout>

<style>
  .ingresso { max-width: 1080px; margin: 0 auto; padding: 40px 24px 64px; display: flex; flex-direction: column; gap: 28px; }
  .testa { display: flex; gap: 20px; align-items: center; }
  .testa h1 { margin: 0 0 6px; font-size: clamp(1.9rem, 4vw, 2.6rem); }
  .testa p { margin: 0; line-height: 1.6; color: #55514c; max-width: 60ch; }
  .scelte { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .scelta { display: flex; flex-direction: column; gap: 10px; padding: 28px; border-radius: 22px; text-decoration: none; border: 1px solid #e3e1dc; background: #fff; color: var(--inchiostro); transition: transform .15s, border-color .15s; }
  .scelta:hover { transform: translateY(-3px); border-color: var(--arancio); color: var(--inchiostro); }
  .scelta.simula { background: var(--inchiostro); border-color: var(--inchiostro); color: #f1efeb; }
  .scelta.simula:hover { color: #f1efeb; border-color: var(--arancio); }
  .scelta-icona { width: 52px; height: 52px; border-radius: 16px; background: var(--arancio); color: var(--inchiostro); display: grid; place-items: center; }
  .scelta-tipo { font-size: .8rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: #8a3a06; }
  .simula .scelta-tipo { color: var(--arancio); }
  .scelta strong { font-family: var(--font-titoli); font-size: 1.6rem; line-height: 1.15; }
  .simula strong { color: #fff; }
  .scelta-testo { line-height: 1.6; color: #55514c; }
  .simula .scelta-testo { color: #dedad3; }
  .punti { margin: 4px 0 8px; padding-left: 18px; display: flex; flex-direction: column; gap: 4px; font-size: .9rem; line-height: 1.5; }
  .bottone-finto { margin-top: auto; align-self: flex-start; background: var(--arancio); color: var(--inchiostro); font-weight: 800; padding: 12px 18px; border-radius: 10px; }
  .nota { margin: 0; text-align: center; font-size: .85rem; color: #625e58; }
  @media (max-width: 760px) {
    .ingresso { padding: 24px 16px 48px; }
    .testa { flex-direction: column; align-items: flex-start; }
    .scelte { grid-template-columns: 1fr; }
    .scelta { padding: 22px; }
  }
</style>
