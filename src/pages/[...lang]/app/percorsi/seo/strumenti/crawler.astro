---
import { LINGUE_APP, linguaDa } from "../../../../../../i18n";
// STRUMENTO · CRAWLER: ispirato a Screaming Frog SEO Spider
// Elenca tutti gli indirizzi trovati seguendo i link del sito, con stato, indicizzabilità, title (anche in pixel),
// description, H1, canonical, parole, link in entrata, LCP. I filtri raggruppano i problemi per tipo.
// Cliccando un indirizzo si vedono i dettagli: chi lo linka (per i 404) e la catena di redirect.
// Dati: src/data/app/seo-pro/crawl.json (generati da strumenti-dati/genera_negozio.py).
import Console from "../../../../../../components/seopro/Console.astro";
import crawlIt from "../../../../../../data/app/seo-pro/crawl.json";
import crawlEn from "../../../../../../data/app/seo-pro/crawl.en.json";
import { num as numIt } from "../../../../../../scripts/tabella";
import { nomeTipo as tipoIt } from "../../../../../../scripts/cms";

const en = linguaDa(Astro.url) === "en";
const L = (it: string, eng: string) => (en ? eng : it);
const crawl = en ? (crawlEn as typeof crawlIt) : crawlIt;
const num = (x: number, d = 0) => numIt(x, d, en);
// tipi e motivi sono codici italiani: in inglese si mostrano tradotti (le funzioni di cms.ts lo fanno nel browser)
const TIPI: Record<string, string> = { Categoria: "Category", Prodotto: "Product", Articolo: "Article", Filtro: "Filter", Paginazione: "Pagination", Servizio: "Service page", "Vecchio indirizzo": "Old address" };
const MOTIVI: Record<string, string> = { Reindirizzamento: "redirect", "Errore client (404)": "client error (404)" };
const nomeTipo = (x: string) => (en ? TIPI[x] ?? x : tipoIt(x));
const nomeMotivo = (x: string) => (en ? MOTIVI[x] ?? x : x).toLowerCase();

// Problemi raggruppati come nel design junior: errori, cose da sistemare, cose da controllare
const GRUPPI: [string, string, [string, string][]][] = en ? [
  ["tutti", "", [["tutti", "All addresses"]]],
  ["errori", "Errors", [["4xx", "404 pages"]]],
  ["sistemare", "To fix", [["title-dup", "Duplicate titles"], ["desc-manca", "Missing description"], ["h1-manca", "Missing H1"], ["lcp", "LCP over 2.5 s"]]],
  ["controllare", "To check", [["noindex", "Non-indexable"], ["3xx", "3xx redirects"], ["title-lungo", "Title over 580 px"], ["poche-parole", "Under 200 words"]]],
] : [
  ["tutti", "", [["tutti", "Tutti gli indirizzi"]]],
  ["errori", "Errori", [["4xx", "Pagine 404"]]],
  ["sistemare", "Da sistemare", [["title-dup", "Title duplicati"], ["desc-manca", "Description mancante"], ["h1-manca", "H1 mancante"], ["lcp", "LCP oltre 2,5 s"]]],
  ["controllare", "Da controllare", [["noindex", "Non indicizzabili"], ["3xx", "Redirect 3xx"], ["title-lungo", "Title oltre 580 px"], ["poche-parole", "Meno di 200 parole"]]],
];
export function getStaticPaths() { return LINGUE_APP(); }
---
<Console attivo="crawler" titolo="Crawler" sottotitolo={L("Il sito letto pagina per pagina, seguendo i link, come fa Google", "The website read page by page, following the links, as Google does")} ispirato="Screaming Frog SEO Spider">
  <div class="sp-pannello comandi">
    <span data-intestazione-scansione><strong>{L("Scansione completata", "Crawl completed")}</strong> {L("il", "on")} {crawl.data.split("-").reverse().join("/")}: {crawl.pagine.length} {L("indirizzi di", "addresses of")} <span class="url">https://cinquefoglie.example/</span></span>
    <input class="sp-cerca" type="search" placeholder={L("Filtra gli indirizzi…", "Filter the addresses…")} data-testo />
  </div>
  <div class="corpo">
    <nav class="filtri sp-pannello" aria-label={L("Problemi trovati", "Problems found")}>
      {GRUPPI.map(([gid, nome, voci]) => (
        <div class:list={["gruppo", gid]}>
          {nome && <span class="gruppo-nome">{nome}</span>}
          {voci.map(([id, testo]) => <button type="button" class="filtro" data-filtro={id} aria-pressed={id === "tutti" ? "true" : "false"}><span>{testo}</span><span class="conta" data-conta={id}></span></button>)}
        </div>
      ))}
    </nav>
    <div class="tabella-e-dettaglio">
  <div class="sp-scorri">
    <table data-tabella id="t-crawl">
      <thead><tr>
        <th data-ordina="testo">{L("Indirizzo e title", "Address and title")}</th><th data-ordina="testo">{L("Tipo", "Type")}</th><th data-ordina="numero" class="n">{L("Stato", "Status")}</th><th data-ordina="testo">{L("Indicizzabile", "Indexable")}</th>
        <th data-ordina="numero" class="n">Title px</th><th data-ordina="numero" class="n">{L("Descr. car.", "Descr. chars")}</th><th data-ordina="testo">H1</th>
        <th data-ordina="numero" class="n">{L("Parole", "Words")}</th><th data-ordina="numero" class="n">{L("Link entrata", "Inlinks")}</th><th data-ordina="numero" class="n">LCP</th>
      </tr></thead>
      <tbody>
        {crawl.pagine.map((p, i) => (
          <tr data-i={i} tabindex="0">
            <td class="url"><span class="u">{p.url}</span><span class="title" data-title={p.title}>{p.title || "—"}</span></td>
            <td>{nomeTipo(p.tipo)}</td>
            <td class="n" data-valore={p.stato}><span class:list={["sp-badge", p.stato === 200 ? "ok" : p.stato === 404 ? "no" : "medio"]}>{p.stato}</span></td>
            <td>{p.indicizzabile ? <span class="sp-badge ok">{L("Sì", "Yes")}</span> : <span class="sp-badge no">No, {nomeMotivo(p.motivo)}</span>}</td>
            <td class="n" data-px></td>
            <td class="n" data-valore={p.description.length}>{p.stato === 200 ? (p.description ? p.description.length : <span class="sp-badge no">{L("manca", "missing")}</span>) : ""}</td>
            <td>{p.stato === 200 ? (p.h1 || <span class="sp-badge no">{L("manca", "missing")}</span>) : ""}</td>
            <td class="n" data-valore={p.parole}>{p.parole ? num(p.parole) : ""}</td>
            <td class="n" data-valore={p.inlinks}>{p.inlinks}</td>
            <td class="n" data-valore={p.lcp ?? 0}>{p.lcp ? `${num(p.lcp, 1)} s` : ""}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
        <div class="dettaglio sp-pannello" data-dettaglio hidden></div>
    </div>
  </div>

  <details class="sp-pannello aiuto">
    <summary>{L("Come funziona un crawler", "How a crawler works")}</summary>
    {en
      ? <p>A crawler does what Google does: it starts from the home page and follows all the links, page after page, noting what it finds. <strong>Status</strong>: 200 the page exists, 301 it redirects to another, 404 it doesn't exist. <strong>Indexable</strong>: whether Google can put it in the results (it can't if it has "noindex", if it redirects or if the canonical points to another page). <strong>Inlinks</strong>: how many pages on the website link to it. Titles are measured in pixels: beyond about 580 px Google cuts them.</p>
      : <p>Un crawler fa quello che fa Google: parte dalla home e segue tutti i link, pagina dopo pagina, annotando cosa trova. <strong>Stato</strong>: 200 la pagina esiste, 301 reindirizza a un'altra, 404 non esiste. <strong>Indicizzabile</strong>: se Google può metterla nei risultati (non lo è se ha "noindex", se reindirizza o se il canonical indica un'altra pagina). <strong>Link in entrata</strong>: quante pagine del sito la linkano. I title si misurano in pixel: oltre circa 580 px Google li taglia.</p>}
  </details>
</Console>

<script>
  import crawlIt from "../../../../../../data/app/seo-pro/crawl.json";
  import crawlEn from "../../../../../../data/app/seo-pro/crawl.en.json";
  import { attivaTabelle, num } from "../../../../../../scripts/tabella";
  import { pixel } from "../../../../../../scripts/controlli-seo";
  import { t as tr, scegli, conLingua } from "../../../../../../scripts/lingua";
  import { leggiModifiche, paginaEffettiva, OGGI, catena as catenaCms, nomeTipo, nomeMotivo } from "../../../../../../scripts/cms";
  const crawl = scegli(crawlIt, crawlEn as typeof crawlIt);

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const righe = [...document.querySelectorAll<HTMLTableRowElement>("#t-crawl tbody tr")];
  // Il crawler legge il sito com'è adesso: con le modifiche fatte nel Pannello del negozio
  const MOD = leggiModifiche();
  const PAG = crawl.pagine.map((p) => paginaEffettiva(p.url, MOD) ?? p);
  const esc0 = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;");
  if (PAG.some((p) => p.modificata)) {
    $("[data-intestazione-scansione]").innerHTML = tr(`<strong>Nuova scansione</strong> il ${OGGI}: ${PAG.length} indirizzi, con le modifiche del pannello`, `<strong>New crawl</strong> on ${OGGI}: ${PAG.length} addresses, with the admin changes`);
    righe.forEach((r) => {
      const p = PAG[Number(r.dataset.i)];
      if (!p.modificata) return;
      const c = r.cells;
      c[2].dataset.valore = String(p.stato);
      c[2].innerHTML = `<span class="sp-badge ${p.stato === 200 ? "ok" : p.stato === 404 ? "no" : "medio"}">${p.stato}</span>`;
      c[3].innerHTML = p.indicizzabile ? `<span class="sp-badge ok">${tr("Sì", "Yes")}</span>` : `<span class="sp-badge no">No, ${esc0(nomeMotivo(p.motivo || "").toLowerCase())}</span>`;
      const t = c[0].querySelector<HTMLElement>(".title")!; t.dataset.title = p.title ?? ""; t.textContent = p.title || "—";
      c[5].dataset.valore = String((p.description ?? "").length); c[5].innerHTML = p.stato === 200 ? (p.description ? String(p.description.length) : `<span class="sp-badge no">${tr("manca", "missing")}</span>`) : "";
      c[6].innerHTML = p.stato === 200 ? (p.h1 ? esc0(p.h1) : `<span class="sp-badge no">${tr("manca", "missing")}</span>`) : "";
      r.classList.add("cambiata");
    });
  }
  // Larghezza dei title in pixel (come nell'esercizio SEO) e title ripetuti su più pagine
  const contaTitle: Record<string, number> = {};
  PAG.forEach((p) => { if (p.stato === 200 && p.title) contaTitle[p.title] = (contaTitle[p.title] ?? 0) + 1; });
  righe.forEach((r) => {
    const p = PAG[Number(r.dataset.i)];
    const cella = r.querySelector<HTMLElement>("[data-px]")!;
    if (p.stato === 200 && p.title) {
      const px = pixel(p.title);
      cella.dataset.valore = String(px);
      cella.innerHTML = px > 580 ? `<span class="sp-badge no">${px}</span>` : String(px);
      r.dataset.px = String(px);
    } else cella.dataset.valore = "0";
    if (p.stato === 200 && contaTitle[p.title] > 1) r.querySelector<HTMLElement>(".title")!.insertAdjacentHTML("beforeend", ` <span class="sp-badge medio">${contaTitle[p.title]} ${tr("uguali", "identical")}</span>`);
  });
  attivaTabelle();

  const prova: Record<string, (p: (typeof PAG)[number], r: HTMLTableRowElement) => boolean> = {
    tutti: () => true,
    "4xx": (p) => p.stato >= 400,
    "3xx": (p) => p.stato >= 300 && p.stato < 400,
    noindex: (p) => !p.indicizzabile,
    "title-dup": (p) => p.stato === 200 && contaTitle[p.title] > 1,
    "title-lungo": (_p, r) => Number(r.dataset.px ?? 0) > 580,
    "desc-manca": (p) => p.stato === 200 && !p.description,
    "h1-manca": (p) => p.stato === 200 && !p.h1,
    "poche-parole": (p) => p.stato === 200 && p.parole < 200,
    lcp: (p) => (p.lcp ?? 0) > 2.5,
  };
  let filtro = "tutti";
  function applica() {
    const t = $<HTMLInputElement>("[data-testo]").value.trim().toLowerCase();
    righe.forEach((r) => { const p = PAG[Number(r.dataset.i)]; r.hidden = !prova[filtro](p, r) || (!!t && !p.url.toLowerCase().includes(t)); });
  }
  document.querySelectorAll<HTMLButtonElement>("[data-filtro]").forEach((b) => {
    const id = b.dataset.filtro!;
    b.querySelector("[data-conta]")!.textContent = String(righe.filter((r) => prova[id](PAG[Number(r.dataset.i)], r)).length);
    b.addEventListener("click", () => {
      filtro = id;
      document.querySelectorAll("[data-filtro]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      applica();
    });
  });
  $("[data-testo]").addEventListener("input", applica);

  // Dettaglio di un indirizzo
  const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;");
  const catena = (url: string) => catenaCms(url, MOD);
  const dett = $("[data-dettaglio]");
  function apri(r: HTMLTableRowElement) {
    righe.forEach((x) => x.classList.remove("selezionata"));
    r.classList.add("selezionata");
    const p = PAG[Number(r.dataset.i)];
    const manca = tr("manca", "missing");
    const voci: [string, string][] = [
      [tr("Indirizzo", "Address"), `<span class="url">${esc(p.url)}</span>`], [tr("Tipo", "Type"), nomeTipo(p.tipo)], [tr("Stato", "Status"), String(p.stato)],
      [tr("Indicizzabile", "Indexable"), p.indicizzabile ? tr("Sì", "Yes") : `No, ${nomeMotivo(p.motivo).toLowerCase()}`],
    ];
    if (p.stato === 200) voci.push(["Title", esc(p.title) + (r.dataset.px ? ` (${r.dataset.px} px)` : "")], ["Meta description", p.description ? `${esc(p.description)} (${p.description.length} ${tr("caratteri", "characters")})` : manca],
      ["H1", p.h1 ? esc(p.h1) : manca], ["Meta robots", p.robots], ["Canonical", p.canonical ? `<span class="url">${esc(p.canonical)}</span>` : manca], [tr("Parole", "Words"), num(p.parole)],
      [tr("Profondità", "Depth"), tr(`${p.profondita} clic dalla home`, `${p.profondita} ${p.profondita === 1 ? "click" : "clicks"} from the home page`)], ...(p.lcp ? [[tr("LCP (laboratorio)", "LCP (lab)"), `${num(p.lcp, 1)} s · ${tr("peso della pagina", "page weight")} ${num(p.peso ?? 0)} KB`] as [string, string]] : []));
    if (p.redirect) voci.push([tr("Catena di redirect", "Redirect chain"), catena(p.url).map((u) => `<span class="url">${esc(u)}</span>`).join(" → ") + ` (${catena(p.url).length - 1} ${tr("salti", catena(p.url).length === 2 ? "hop" : "hops")})`]);
    const linkanti = (crawl.link404 as Record<string, string[]>)[p.url];
    if (linkanti) voci.push([tr("Linkata da", "Linked from"), linkanti.map((u) => `<span class="url">${esc(u)}</span>`).join("<br>")]);
    if (p.note) voci.push([tr("Nota", "Note"), esc(p.note)]);
    dett.hidden = false;
    dett.innerHTML = `<strong>${tr("Dettagli dell'indirizzo", "Address details")}</strong><dl>${voci.map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`).join("")}</dl>` +
      (p.stato === 200 ? `<a href="${conLingua(`/app/negozio${p.url.split("?")[0]}`)}">${tr("Apri la pagina nel negozio →", "Open the page in the shop →")}</a>` : "");
    dett.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }
  righe.forEach((r) => { r.addEventListener("click", () => apri(r)); r.addEventListener("keydown", (e) => { if (e.key === "Enter") apri(r); }); });
</script>

<style>
  .comandi { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; justify-content: space-between; font-size: .85rem; color: #55514c; }
  .corpo { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 16px; align-items: start; }
  .tabella-e-dettaglio { min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .filtri { display: flex; flex-direction: column; gap: 10px; padding: 12px; }
  .gruppo { display: flex; flex-direction: column; gap: 2px; }
  .gruppo-nome { font-size: .78rem; font-weight: 700; padding: 6px 8px 2px; }
  .errori .gruppo-nome { color: #a12d1d; } .sistemare .gruppo-nome { color: #7a5200; } .controllare .gruppo-nome { color: #55514c; }
  .filtro { font: inherit; font-size: .86rem; text-align: left; display: flex; justify-content: space-between; gap: 8px; padding: 9px 10px; min-height: 40px; border-radius: 10px; border: 0; background: none; cursor: pointer; color: var(--inchiostro); }
  .filtro:hover { background: #f4f4f2; }
  .filtro[aria-pressed="true"] { background: #e9e8e4; font-weight: 700; }
  .conta { font-variant-numeric: tabular-nums; opacity: .75; }
  .sp-scorri { max-height: 560px; overflow: auto; }
  tr[data-i] { cursor: pointer; }
  :global(tr.cambiata) td:first-child { box-shadow: inset 3px 0 0 var(--arancio); }
  /* Il title sta sotto l'indirizzo, così si legge anche quando la tabella è stretta (guida aperta) */
  #t-crawl td.url { min-width: 240px; max-width: 320px; }
  #t-crawl td.url .u { display: block; white-space: nowrap; }
  #t-crawl td.url .title { display: block; margin-top: 3px; font-family: var(--font-testo); font-size: .78rem; line-height: 1.4; color: #55514c; white-space: normal; }
  .dettaglio { border: 2px solid var(--arancio); background: #f8f8f6; display: flex; flex-direction: column; gap: 10px; }
  .dettaglio :global(dl) { margin: 0; display: flex; flex-direction: column; gap: 6px; font-size: .85rem; }
  .dettaglio :global(dl div) { display: grid; grid-template-columns: 160px 1fr; gap: 10px; }
  .dettaglio :global(dt) { color: #5f5a55; font-weight: 700; }
  .dettaglio :global(dd) { margin: 0; overflow-wrap: anywhere; }
  .aiuto summary { cursor: pointer; font-weight: 700; }
  .aiuto p { margin: 10px 0 0; line-height: 1.6; font-size: .9rem; }
  /* area stretta: i filtri vanno sopra la tabella, divisi in colonne invece di una lista lunga */
  @container area (max-width: 760px) { .corpo { grid-template-columns: 1fr; } .filtri { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); align-items: start; } }
  @container area (max-width: 520px) { .dettaglio :global(dl div) { grid-template-columns: 1fr; gap: 2px; } }
</style>
