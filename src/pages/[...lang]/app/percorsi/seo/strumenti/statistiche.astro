---
import { LINGUE_APP, linguaDa } from "../../../../../../i18n";
// STRUMENTO · STATISTICHE: ispirato a Google Analytics 4 (rapporto "Pagine di destinazione", solo traffico organico)
// Mostra cosa succede DOPO il clic: sessioni, tasso di conversione, ordini e ricavi per pagina di arrivo,
// più l'andamento mensile. Serve a capire quanto vale in euro un calo di traffico.
// Dati: src/data/app/seo-pro/analytics.json (generati da strumenti-dati/genera_negozio.py).
import Console from "../../../../../../components/seopro/Console.astro";
import gaIt from "../../../../../../data/app/seo-pro/analytics.json";
import gaEn from "../../../../../../data/app/seo-pro/analytics.en.json";
import { num as numIt } from "../../../../../../scripts/tabella";

const en = linguaDa(Astro.url) === "en";
const L = (it: string, eng: string) => (en ? eng : it);
const ga = en ? (gaEn as typeof gaIt) : gaIt;
const num = (x: number, d = 0) => numIt(x, d, en);
const euro = (x: number, d = 0) => (en ? `€${num(x, d)}` : `${num(x, d)} €`);
const MESI = en ? ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"] : ["gen", "feb", "mar", "apr", "mag", "giu", "lug", "ago", "set", "ott", "nov", "dic"];
const nomeMese = (m: string) => `${MESI[Number(m.slice(5)) - 1]} ${m.slice(2, 4)}`;
// Totali del periodo (agosto-ottobre 2026) presi dai mesi: comprendono tutte le pagine, non solo le 25 della tabella
const tot = ga.mesi.filter((m) => m.mese >= "2026-08").reduce((s, m) => ({ sessioni: s.sessioni + m.sessioni, ordini: s.ordini + m.ordini, ricavi: s.ricavi + m.ricavi }), { sessioni: 0, ordini: 0, ricavi: 0 });
const tipo = (u: string) => (u === "/" ? "Home" : u.startsWith("/blog/") ? L("Articolo", "Article") : u.split("/").filter(Boolean).length === 1 ? L("Categoria", "Category") : L("Prodotto", "Product"));
// Grafico a barre dei ricavi mensili
const W = 900, H = 220, sx = 50;
const maxR = Math.max(...ga.mesi.map((m) => m.ricavi));
const bw = (W - sx - 10) / ga.mesi.length;
export function getStaticPaths() { return LINGUE_APP(); }
---
<Console attivo="statistiche" titolo={L("Statistiche", "Analytics")} sottotitolo={L("Cosa fanno le persone dopo il clic su Google: visite, ordini e ricavi", "What people do after clicking on Google: visits, orders and revenue")} ispirato={L("Google Analytics 4 (pagine di destinazione, solo traffico organico)", "Google Analytics 4 (landing pages, organic traffic only)")}>
  <p class="sp-nota avviso">{en ? "Simulated analytics: only visits from organic search, with cookie consent (about 70% of real visits). Made-up data. That's why the numbers are a little lower than the clicks you see in the Search console." : `${ga._nota} Per questo i numeri sono un po' più bassi dei clic che vedi nella Console di ricerca.`}</p>

  <div class="sp-cifre">
    <div class="sp-cifra"><span>{L("Sessioni organiche", "Organic sessions")}</span><strong>{num(tot.sessioni)}</strong><small>{ga.periodo}</small></div>
    <div class="sp-cifra"><span>{L("Ordini", "Orders")}</span><strong>{num(tot.ordini)}</strong><small>{L("conversione", "conversion")} {num((tot.ordini / tot.sessioni) * 100, 1)}%</small></div>
    <div class="sp-cifra"><span>{L("Ricavi", "Revenue")}</span><strong>{euro(tot.ricavi)}</strong><small>{L("valore medio", "average value")} {euro(tot.ricavi / tot.ordini, 2)}</small></div>
  </div>

  <div class="sp-pannello">
    <strong class="sottotitolo">{L("Ricavi da ricerca organica, mese per mese", "Revenue from organic search, month by month")}</strong>
    <svg class="sp-grafico" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${L("Ricavi mensili", "Monthly revenue")}: ${ga.mesi.map((m) => `${nomeMese(m.mese)} ${m.ricavi} euro`).join(", ")}`}>
      {[0, 0.5, 1].map((f) => <g><line x1={sx} x2={W} y1={H - 24 - f * (H - 44)} y2={H - 24 - f * (H - 44)} stroke="#e9e8e4" /><text x={sx - 6} y={H - 20 - f * (H - 44)} font-size="11" text-anchor="end" fill="#6f6a64">{num(maxR * f)}</text></g>)}
      {ga.mesi.map((m, i) => {
        const h = (m.ricavi / maxR) * (H - 44), x = sx + i * bw + 4;
        return (<g>
          <rect x={x} y={H - 24 - h} width={bw - 8} height={h} rx="3" fill={m.mese >= "2026-09" ? "#c4520b" : "#d1cec8"}><title>{`${nomeMese(m.mese)}: ${num(m.sessioni)} ${L("sessioni", "sessions")}, ${m.ordini} ${L("ordini", "orders")}, ${euro(m.ricavi)}`}</title></rect>
          <text x={x + (bw - 8) / 2} y={H - 8} font-size="10" text-anchor="middle" fill="#6f6a64">{nomeMese(m.mese)}</text>
        </g>);
      })}
    </svg>
    <p class="sp-nota">{L("Passa sulle barre per vedere sessioni e ordini. In arancione scuro gli ultimi due mesi.", "Hover over the bars to see sessions and orders. The last two months are in dark orange.")}</p>
  </div>

  <div class="sp-pannello">
    <div class="riga-titolo">
      <strong class="sottotitolo">{L(`Le ${ga.pagine.length} pagine di destinazione principali`, `The top ${ga.pagine.length} landing pages`)} · {ga.periodo}</strong>
      <input class="sp-cerca" type="search" placeholder={L("Filtra le pagine…", "Filter the pages…")} data-filtra="t-ga" />
    </div>
    <div class="sp-scorri">
      <table data-tabella id="t-ga">
        <thead><tr>
          <th data-ordina="testo">{L("Pagina di destinazione", "Landing page")}</th><th data-ordina="testo">{L("Tipo", "Type")}</th><th data-ordina="numero" class="n">{L("Sessioni", "Sessions")}</th>
          <th data-ordina="numero" class="n">{L("Conversione", "Conversion")}</th><th data-ordina="numero" class="n">{L("Ordini", "Orders")}</th><th data-ordina="numero" class="n">{L("Ricavi", "Revenue")}</th>
        </tr></thead>
        <tbody>
          {ga.pagine.map((p) => (
            <tr>
              <td class="url"><a href={`${en ? "/en" : ""}/app/negozio${p.pagina}`}>{p.pagina}</a></td><td>{tipo(p.pagina)}</td>
              <td class="n" data-valore={p.sessioni}>{num(p.sessioni)}</td><td class="n" data-valore={p.conversione}>{num(p.conversione, 1)}%</td>
              <td class="n" data-valore={p.ordini}>{p.ordini}</td><td class="n" data-valore={p.ricavi}>{euro(p.ricavi)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <details class="sp-pannello aiuto">
    <summary>{L("Come si leggono queste cifre", "How to read these figures")}</summary>
    {en && <p><strong>Session</strong>: a visit, which can include several pages. <strong>Landing page</strong>: the first page seen, i.e. the one people land on from Google. <strong>Conversion</strong>: out of 100 visits, how many end with an order. Blog articles bring lots of visits but convert little: people reading "how to make matcha" often aren't ready to buy yet. To estimate how much a drop is worth, multiply the sessions lost by the conversion and by the average order value.</p>}
    {!en && <p><strong>Sessione</strong>: una visita, che può comprendere più pagine. <strong>Pagina di destinazione</strong>: la prima pagina vista, cioè quella su cui si arriva da Google. <strong>Conversione</strong>: su 100 visite, quante finiscono con un ordine. Gli articoli del blog portano tante visite ma convertono poco: chi legge "come si prepara il matcha" spesso non è ancora pronto a comprare. Per stimare quanto vale un calo, moltiplica le sessioni perse per la conversione e per il valore medio dell'ordine.</p>}
  </details>
</Console>

<script>
  import { attivaTabelle } from "../../../../../../scripts/tabella";
  attivaTabelle();
</script>

<style>
  .avviso { background: #fff3d6; border-radius: 10px; padding: 10px 14px; color: #5c4400; }
  .sottotitolo { display: block; font-size: .95rem; margin-bottom: 8px; }
  .riga-titolo { display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .riga-titolo .sottotitolo { margin: 0; }
  .aiuto summary { cursor: pointer; font-weight: 700; }
  .aiuto p { margin: 10px 0 0; line-height: 1.6; font-size: .9rem; }
</style>
