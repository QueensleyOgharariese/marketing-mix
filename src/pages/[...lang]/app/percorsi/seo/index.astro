---
import { LINGUE_APP, linguaDa } from "../../../../../i18n";
// PERCORSO DI APPROFONDIMENTO · SEO (pagina di partenza, livello junior)
// Benvenuto, messaggio della responsabile, il tutorial, poi i tre livelli di esercizi (Basi, Diagnosi, Casi):
// un livello si apre quando è finito quello prima, dentro il livello si sceglie l'ordine.
// Poi gli strumenti e le parole che si incontrano.
// Lo stato delle missioni (da iniziare, in corso, completata, bloccata) arriva dal browser: lo scrive la guida della missione.
import Console from "../../../../../components/seopro/Console.astro";
import sc from "../../../../../data/app/seo-pro/search-console.json";
import { num } from "../../../../../scripts/tabella";
import datiIt from "../../../../../data/app/seo-pro/missioni.json";
import datiEn from "../../../../../data/app/seo-pro/missioni.en.json";

const lang = linguaDa(Astro.url);
const en = lang === "en";
const L = (it: string, eng: string) => (en ? eng : it);
const dati = en ? (datiEn as typeof datiIt) : datiIt;
const n0 = (x: number) => num(x, 0, en);
const B = `${en ? "/en" : ""}/app/percorsi/seo/strumenti`;
const STRUMENTI = en ? [
  { nome: "Search console", link: `${B}/console/`, vero: "Google Search Console", cosa: "How often the website appears on Google and how many clicks it gets." },
  { nome: "Pages and indexing", link: `${B}/indicizzazione/`, vero: "Search Console's Pages report", cosa: "Which pages are on Google, which aren't and why." },
  { nome: "Keyword research", link: `${B}/keyword/`, vero: "Keyword Planner or Semrush", cosa: "What people search for and at what time of year." },
  { nome: "Crawler", link: `${B}/crawler/`, vero: "Screaming Frog", cosa: "The website as Google sees it: errors, redirects, titles." },
  { nome: "Analytics", link: `${B}/statistiche/`, vero: "Google Analytics", cosa: "What happens after the click: visits, orders, revenue." },
] : [
  { nome: "Console di ricerca", link: `${B}/console/`, vero: "Google Search Console", cosa: "Quante volte il sito compare su Google e quanti clic riceve." },
  { nome: "Pagine e indicizzazione", link: `${B}/indicizzazione/`, vero: "il rapporto Pagine di Search Console", cosa: "Quali pagine sono su Google, quali no e perché." },
  { nome: "Ricerca keyword", link: `${B}/keyword/`, vero: "Keyword Planner o Semrush", cosa: "Cosa cercano le persone e in che periodo dell'anno." },
  { nome: "Crawler", link: `${B}/crawler/`, vero: "Screaming Frog", cosa: "Il sito visto da Google: errori, redirect, titoli." },
  { nome: "Statistiche", link: `${B}/statistiche/`, vero: "Google Analytics", cosa: "Cosa succede dopo il clic: visite, ordini, ricavi." },
];
// Tutorial ed esercizi arrivano da missioni.json, divisi per livello
const TUTORIAL = dati.missioni.find((m) => m.id === "tutorial")!;
const LIVELLI = dati.livelli.filter((l) => l.n > 0).map((l) => ({ ...l, esercizi: dati.missioni.filter((m) => m.livello === l.n) }));
const prima = (n: number) => dati.livelli[n - 1].nome;
const ott = sc.mesi.find((m) => m.mese === "2026-10")!;
const set = sc.mesi.find((m) => m.mese === "2026-09")!;
const calo = Math.round((1 - ott.clic / set.clic) * 100);
export function getStaticPaths() { return LINGUE_APP(); }
---
<Console attivo="percorso" titolo={L("Simulazione SEO", "SEO Simulation")}>
  <section class="apertura">
    <div class="benvenuto">
      <p class="occhiello">{L("Simulazione · primo giorno da SEO specialist", "Simulation · first day as an SEO specialist")}</p>
      <h2>{L("Benvenuta nel team di cinquefoglie.example", "Welcome to the cinquefoglie.example team")}</h2>
      {en
        ? <p>You have the shop's website, its admin and five tools. You start with the tutorial, then three levels: <strong>Basics</strong>, <strong>Diagnosis</strong> and <strong>Cases</strong>. Each level opens when you finish the one before; within a level you choose the order.</p>
        : <p>Hai a disposizione il sito del negozio, il suo pannello di gestione e cinque strumenti. Si parte dal tutorial, poi tre livelli: <strong>Basi</strong>, <strong>Diagnosi</strong> e <strong>Casi</strong>. Ogni livello si apre quando finisci quello prima; dentro il livello scegli tu l'ordine.</p>}
      <div class="bottoni">
        <button type="button" class="bottone-app" data-avvia-prossima>{L("Inizia il tutorial", "Start the tutorial")}</button>
        <a class="bottone-scuro" href={`${en ? "/en" : ""}/app/negozio/`}>{L("Prima guardo il negozio", "I'll look at the shop first")}</a>
      </div>
      <button type="button" class="salta" data-salta hidden>{L("Conosco già gli strumenti: salta il tutorial", "I already know the tools: skip the tutorial")}</button>
    </div>
    <article class="messaggio">
      <div class="mittente"><span class="avatar avatar--verde">EM</span><span><strong>Elena M.</strong><span class="nota">{L("Responsabile e-commerce, oggi alle 9:12", "E-commerce manager, today at 9:12")}</span></span></div>
      <strong>{L("Benvenuta nel team!", "Welcome to the team!")}</strong>
      <p>{en
        ? `This week you're working with me on the website. We'll start with the simple things, titles, descriptions and broken links, then move on to the real problems. At the end of the week I have a big question for you: why did clicks from Google drop by ${calo}% in October compared with September (${n0(ott.clic)} against ${n0(set.clic)})?`
        : `Questa settimana lavori con me sul sito. Partiamo dalle cose semplici, title, description e link rotti, poi passiamo ai problemi veri. A fine settimana ho una domanda grossa per te: perché a ottobre i clic da Google sono scesi del ${calo}% rispetto a settembre (${n0(ott.clic)} contro ${n0(set.clic)}).`}</p>
      <span class="nota">{L("Persona e azienda inventate", "Fictional person and company")}</span>
    </article>
  </section>

  <section class="tutorial" data-tutorial>
    <div class="tut-testo">
      <span class="tut-etichetta">{L("Livello 0 · Da fare per primo", "Level 0 · Do this first")} · {TUTORIAL.tempo}</span>
      <h2 class="titoletto">{TUTORIAL.nome}</h2>
      <p>{TUTORIAL.cosa}</p>
    </div>
    <ol class="tut-passi">
      {TUTORIAL.passi.map((p) => <li>{p.domanda}</li>)}
    </ol>
    <div class="tut-azione"><span class="stato" data-tut-stato>{L("Da iniziare", "Not started")}</span><button type="button" class="bottone-app" data-tut-azione>{L("Inizia il tutorial", "Start the tutorial")}</button></div>
  </section>

  <div id="livelli" class="livelli">
    {LIVELLI.map((l) => (
      <section class="livello" data-livello={l.n}>
        <div class="livello-testa">
          <span class="livello-n" aria-hidden="true">{l.n}</span>
          <div>
            <h2 class="titoletto">{L("Livello", "Level")} {l.n} · {l.nome}</h2>
            <p class="nota">{l.cosa}</p>
          </div>
          <span class="livello-stato" data-livello-stato>{L("Si apre quando finisci", "Opens when you finish")}: {prima(l.n)}</span>
        </div>
        <ol class="esercizi">
          {l.esercizi.map((m) => (
            <li class="esercizio" data-missione={m.id}>
              <strong>{m.nome}</strong>
              <span class="cosa">{m.cosa}</span>
              <span class="meta">{m.passi.length} {L("mini esercizi", "mini exercises")} · {m.tempo}<br />{m.strumenti}</span>
              <div class="riga-stato"><span class="stato" data-stato>{L("Chiuso", "Locked")}</span><button type="button" class="azione" data-azione hidden></button></div>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  <section class="sotto">
    <div class="strumenti">
      <h2 class="titoletto">{L("Gli strumenti", "The tools")}</h2>
      <div class="griglia">
        {STRUMENTI.map((s) => (
          <a class="strumento" href={s.link}>
            <strong>{s.nome}</strong>
            <span>{s.cosa}</span>
            <span class="vero">{L("Come", "Like")} {s.vero}</span>
          </a>
        ))}
      </div>
    </div>
    <aside class="parole">
      <h2 class="titoletto">{L("Parole che incontrerai", "Words you'll come across")}</h2>
      <dl>
        <div><dt>{L("Impressione", "Impression")}</dt><dd>{L("Il sito compare nei risultati di Google, anche se nessuno clicca.", "The website appears in Google's results, even if nobody clicks.")}</dd></div>
        <div><dt>CTR</dt><dd>{L("Su 100 persone che vedono il risultato, quante cliccano.", "Out of 100 people who see the result, how many click.")}</dd></div>
        <div><dt>{L("Indicizzata", "Indexed")}</dt><dd>{L("La pagina è nell'archivio di Google e può comparire nei risultati.", "The page is in Google's index and can appear in the results.")}</dd></div>
        <div><dt>Noindex</dt><dd>{L("Un'istruzione che chiede a Google di non mostrare la pagina.", "An instruction that asks Google not to show the page.")}</dd></div>
      </dl>
    </aside>
  </section>
</Console>

<script>
  import { TUTTE, MISSIONI, TUTORIAL, LIVELLI, leggiStato, sbloccata, livelloAperto, fatta, punti, avvia, tutorialFatto, saltaTutorial, consigliata } from "../../../../../scripts/missioni";
  import { t } from "../../../../../scripts/lingua";
  const s = leggiStato();
  const prossima = consigliata(s);

  // Tutorial
  const st = s.missioni.tutorial;
  const tut = document.querySelector<HTMLElement>("[data-tutorial]")!;
  const tutStato = tut.querySelector<HTMLElement>("[data-tut-stato]")!;
  const tutAzione = tut.querySelector<HTMLButtonElement>("[data-tut-azione]")!;
  if (tutorialFatto(s)) { tut.classList.add("fatta"); tutStato.textContent = t("Fatto", "Done"); tutAzione.textContent = t("Rifai il tutorial", "Redo the tutorial"); tutAzione.className = "azione"; }
  else if (st?.stato === "in-corso") { tutStato.textContent = t(`In corso, passo ${st.passo + 1} di ${TUTORIAL.passi.length}`, `In progress, step ${st.passo + 1} of ${TUTORIAL.passi.length}`); tutAzione.textContent = t("Continua il tutorial", "Continue the tutorial"); }
  tutAzione.addEventListener("click", () => { location.href = avvia("tutorial"); });

  // Livelli: aperto o chiuso, quanti esercizi fatti
  for (const l of LIVELLI.filter((x) => x.n > 0)) {
    const sez = document.querySelector<HTMLElement>(`[data-livello="${l.n}"]`)!;
    const es = MISSIONI.filter((m) => m.livello === l.n);
    const n = es.filter((m) => fatta(s, m)).length;
    if (livelloAperto(s, l.n)) sez.querySelector("[data-livello-stato]")!.textContent = n === es.length ? t("Livello completato", "Level completed") : t(`${n} di ${es.length} fatti`, `${n} of ${es.length} done`);
    else sez.classList.add("chiuso");
    if (n === es.length) sez.classList.add("completato");
  }

  // Esercizi
  for (const m of MISSIONI) {
    const li = document.querySelector<HTMLElement>(`[data-missione="${m.id}"]`)!;
    const stato = li.querySelector<HTMLElement>("[data-stato]")!;
    const azione = li.querySelector<HTMLButtonElement>("[data-azione]")!;
    const sm = s.missioni[m.id];
    if (!sbloccata(s, m)) continue;
    azione.hidden = false;
    if (sm?.stato === "completata") { stato.textContent = t(`Fatto, ${punti(sm)} punti`, `Done, ${punti(sm)} points`); azione.textContent = t("Rifai", "Redo"); li.classList.add("fatta"); }
    else if (sm?.stato === "in-corso") { stato.textContent = t(`In corso, passo ${sm.passo + 1} di ${m.passi.length}`, `In progress, step ${sm.passo + 1} of ${m.passi.length}`); azione.textContent = t("Continua", "Continue"); }
    else { stato.textContent = t("Da fare", "To do"); azione.textContent = t("Inizia", "Start"); }
    if (m.id === prossima?.id && sm?.stato !== "in-corso") { li.classList.add("prima"); stato.textContent = t("Consigliato ora", "Recommended now"); }
    azione.addEventListener("click", () => { location.href = avvia(m.id); });
  }

  // Bottone grande in alto: l'esercizio in corso, altrimenti il consigliato
  const hero = document.querySelector<HTMLButtonElement>("[data-avvia-prossima]")!;
  const salta = document.querySelector<HTMLButtonElement>("[data-salta]")!;
  const inCorso = TUTTE.find((m) => s.attiva === m.id && s.missioni[m.id]?.stato === "in-corso") ?? TUTTE.find((m) => s.missioni[m.id]?.stato === "in-corso");
  const m = inCorso ?? prossima;
  if (m) {
    hero.textContent = m.id === "tutorial" ? (inCorso ? t("Continua il tutorial", "Continue the tutorial") : t("Inizia il tutorial", "Start the tutorial")) : `${inCorso ? t("Continua", "Continue") : t("Inizia", "Start")}: ${m.nome}`;
    hero.addEventListener("click", () => { location.href = avvia(m.id); });
  } else { hero.textContent = t("Hai finito tutti gli esercizi", "You've finished all the exercises"); hero.disabled = true; }
  if (!tutorialFatto(s)) { salta.hidden = false; salta.addEventListener("click", () => { saltaTutorial(); location.reload(); }); }
</script>

<style>
  .apertura { display: flex; flex-wrap: wrap; gap: 20px; }
  .benvenuto { flex: 2 1 480px; background: var(--inchiostro); color: #f1efeb; border-radius: 22px; padding: 34px 38px; display: flex; flex-direction: column; gap: 12px; }
  .benvenuto h2 { font-family: var(--font-titoli); font-weight: 800; font-size: clamp(1.7rem, 3vw, 2.3rem); line-height: 1.1; color: #fff; }
  .benvenuto p { margin: 0; line-height: 1.6; color: #dedad3; max-width: 60ch; }
  .occhiello { font-size: .85rem; font-weight: 700; color: var(--arancio) !important; }
  .bottoni { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  .benvenuto .bottone-app:disabled { opacity: .6; cursor: default; }
  .bottone-scuro { display: inline-flex; align-items: center; font-weight: 700; color: #fff; text-decoration: none; padding: 12px 18px; border-radius: 10px; border: 1.5px solid #5e5953; }
  .bottone-scuro:hover { color: #fff; border-color: #fff; }
  .messaggio { flex: 1 1 280px; background: #fff; border: 1px solid #e3e1dc; border-radius: 22px; padding: 22px; display: flex; flex-direction: column; gap: 10px; }
  .messaggio p { margin: 0; line-height: 1.6; font-size: .92rem; color: #423e39; }
  .messaggio .nota:last-child { margin-top: auto; }
  .mittente { display: flex; align-items: center; gap: 12px; }
  .mittente > span:last-child { display: flex; flex-direction: column; }
  .avatar--verde { background: #e3efe6; color: #1f5c38; width: 40px; height: 40px; }
  .nota { font-size: .8rem; color: #625e58; }
  .titolo-riga { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 12px; }
  .titoletto { font-family: var(--font-titoli); font-size: 1.35rem; font-weight: 800; margin: 0 0 12px; }
  .titolo-riga .titoletto { margin: 0; }
  .salta { align-self: flex-start; font: inherit; font-size: .85rem; color: #cfcac2; background: none; border: 0; padding: 4px 0; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .salta:hover { color: #fff; }
  .tutorial { background: #fff; border: 2px solid var(--arancio); border-radius: 22px; padding: 24px 26px; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.3fr) auto; gap: 24px; align-items: center; }
  .tutorial.fatta { border: 1px solid #e3e1dc; }
  .tut-testo { display: flex; flex-direction: column; gap: 6px; }
  .tut-testo .titoletto { margin: 0; }
  .tut-testo p { margin: 0; line-height: 1.55; color: #423e39; font-size: .92rem; }
  .tut-etichetta { font-size: .78rem; font-weight: 700; color: #55514c; }
  .tut-passi { margin: 0; padding: 0; list-style: none; counter-reset: t; display: flex; flex-direction: column; gap: 8px; font-size: .88rem; }
  .tut-passi li { counter-increment: t; display: flex; gap: 10px; align-items: center; }
  .tut-passi li::before { content: counter(t); flex: none; width: 24px; height: 24px; border-radius: 50%; background: #e9e8e4; display: grid; place-items: center; font-weight: 800; font-size: .78rem; }
  .tut-azione { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .tutorial.fatta .stato { color: #1f5c38; }
  @container area (max-width: 720px) { .tutorial { grid-template-columns: 1fr; gap: 16px; padding: 20px; } }
  .livelli { display: flex; flex-direction: column; gap: 28px; }
  .livello { display: flex; flex-direction: column; gap: 14px; }
  .livello-testa { display: grid; grid-template-columns: 44px 1fr auto; gap: 14px; align-items: center; }
  .livello-testa .titoletto { margin: 0 0 2px; }
  .livello-testa .nota { margin: 0; }
  .livello-n { width: 44px; height: 44px; border-radius: 50%; background: var(--arancio); color: var(--inchiostro); display: grid; place-items: center; font-family: var(--font-titoli); font-weight: 800; font-size: 1.2rem; }
  .livello-stato { font-size: .82rem; font-weight: 700; color: #423e39; }
  .livello.completato .livello-n { background: #2f7a4f; color: #fff; }
  .livello.chiuso .livello-n { background: #e9e8e4; color: #625e58; }
  .livello.chiuso .livello-stato { font-weight: 600; color: #625e58; }
  .esercizi { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  .esercizio { background: #fff; border: 1px solid #e3e1dc; border-radius: 18px; padding: 18px; display: flex; flex-direction: column; gap: 8px; color: #55514c; }
  .esercizio strong { color: var(--inchiostro); font-size: .98rem; line-height: 1.3; }
  .esercizio.prima { border: 2px solid var(--arancio); }
  .esercizio.fatta { border-color: #b9d8c4; }
  .chiuso .esercizio { background: #f8f8f6; }
  .chiuso .esercizio strong { color: #55514c; }
  .stato { font-size: .78rem; font-weight: 700; }
  .cosa { font-size: .86rem; line-height: 1.5; }
  .meta { font-size: .78rem; line-height: 1.5; }
  .azione { font: inherit; font-weight: 700; font-size: .85rem; padding: 9px 14px; border-radius: 10px; border: 1px solid #d1cec8; background: #fff; color: var(--inchiostro); cursor: pointer; }
  .chiuso .stato { font-weight: 600; color: #625e58; }
  .riga-stato { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .fatta .stato { color: #1f5c38; }
  .prima .azione { background: var(--arancio); border-color: var(--arancio); }
  @container area (max-width: 520px) { .livello-testa { grid-template-columns: 40px 1fr; } .livello-stato { grid-column: 2; } .livello-n { width: 40px; height: 40px; } }
  .sotto { display: flex; flex-wrap: wrap; gap: 20px; }
  .strumenti { flex: 2 1 480px; }
  .griglia { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
  .strumento { background: #fff; border: 1px solid #e3e1dc; border-radius: 18px; padding: 18px; display: flex; flex-direction: column; gap: 6px; text-decoration: none; color: var(--inchiostro); font-size: .88rem; line-height: 1.5; }
  .strumento:hover { border-color: #c9c6c0; color: var(--inchiostro); }
  .strumento strong { font-size: .98rem; }
  .vero { font-size: .78rem; color: #625e58; }
  .parole { flex: 1 1 260px; background: #fff; border: 1px solid #e3e1dc; border-radius: 18px; padding: 20px; align-self: flex-start; }
  .parole dl { margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: .86rem; line-height: 1.5; }
  .parole dt { font-weight: 700; } .parole dd { margin: 0; color: #423e39; }
</style>
