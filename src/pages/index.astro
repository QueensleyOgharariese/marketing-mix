---
// HOME PAGE (versione provvisoria: solo l'apertura)
// Le altre sezioni del design (ruoli, esercizi, percorso, strumenti, blog, newsletter)
// arrivano nei prossimi passi.
// I testi arrivano da src/data/impostazioni.json, così si cambiano senza toccare il codice.
import Base from "../layouts/Base.astro";
import Pesca from "../components/Pesca.astro";
import impostazioni from "../data/impostazioni.json";
---
<Base title={impostazioni.nomeSito}>
  <section class="contenitore apertura">
    <div class="testi">
      <span class="etichetta">Gratis · 12 ruoli · 1 azienda finta</span>
      <h1>{impostazioni.home.titolo}</h1>
      <p class="sotto">{impostazioni.home.sottotitolo}</p>
      <div class="azioni">
        <a class="bottone" href="/ruoli/">Scopri i ruoli <span aria-hidden="true">→</span></a>
        <a class="bottone bottone--contorno" href="/progetto/">Come funziona</a>
      </div>
    </div>
    <div class="disegno">
      <span class="cerchio" aria-hidden="true"></span>
      <Pesca dimensione={260} saluta etichetta="Pesca, la mascotte di Marketing Mix, che saluta" class="galleggia" />
    </div>
  </section>
</Base>

<style>
  .apertura { display: flex; flex-wrap: wrap; gap: 40px; align-items: center; padding-block: 72px 48px; }
  .testi { flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  h1 { font-size: clamp(2.6rem, 7vw, 4.6rem); line-height: .98; max-width: 13ch; }
  .sotto { font-size: 1.2rem; line-height: 1.55; color: var(--testo-2); max-width: 46ch; }
  .azioni { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .disegno { flex: 1 1 320px; min-width: 0; position: relative; display: grid; place-items: center; min-height: 340px; }
  .cerchio { position: absolute; width: min(340px, 90%); aspect-ratio: 1; border-radius: 50%; background: #ffe8d6; }
  .disegno :global(.galleggia) { position: relative; animation: galleggia 4s ease-in-out infinite; }
  @keyframes galleggia { 0%, 100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-10px) rotate(2deg); } }
</style>
