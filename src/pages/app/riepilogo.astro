---
// APP · 5. I TUOI RISULTATI
// Punti e gradimento per ogni ruolo, letti dal browser. Si possono scaricare (file di testo per il CV)
// o cancellare. Il consiglio di Pesca indica il ruolo che è piaciuto di più (o il prossimo da provare).
import AppLayout from "../../layouts/AppLayout.astro";
import Progresso from "../../components/Progresso.astro";
import Pesca from "../../components/Pesca.astro";
import azienda from "../../data/app/cinque-foglie.json";
---
<AppLayout title="I tuoi risultati" percorso={[{ etichetta: azienda.nome, link: "/app/" }, { etichetta: "Risultati" }]}>
  <Progresso slot="barra" />
  <main class="contenuto">
    <section class="testa">
      <Pesca dimensione={80} />
      <div>
        <span class="tag">Il tuo profilo</span>
        <h1 class="app-titolo" data-titolo>I tuoi risultati</h1>
        <p data-intro>Qui trovi punti e gradimento per ogni ruolo che provi. Ti aiutano a scegliere da dove approfondire.</p>
      </div>
    </section>

    <div class="colonne">
      <section class="pannello tabella" aria-labelledby="t-tabella">
        <h2 id="t-tabella" class="sottotitolo">Ruolo per ruolo</h2>
        <div class="scorri">
          <table>
            <thead><tr><th scope="col">Ruolo</th><th scope="col">Punti</th><th scope="col">Gradimento</th></tr></thead>
            <tbody>
              {azienda.ruoli.map((r) => (
                <tr data-riga={r.id}>
                  <th scope="row">{r.nome}</th>
                  <td><span class="punti-cella"><span class="barra"><span data-barra></span></span><strong data-punti>da fare</strong></span></td>
                  <td data-gradimento>–</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="nota">I risultati sono salvati solo in questo browser: niente account, nessun dato inviato.</p>
      </section>

      <aside class="lato">
        <div class="pannello consiglio">
          <span class="tag">Consiglio di Pesca</span>
          <strong class="app-titolo" data-consiglio-titolo>Inizia dalla SEO</strong>
          <p data-consiglio-testo>È un buon punto di partenza. Ci vogliono circa 25 minuti.</p>
          <a class="bottone-app" href="/app/seo/esercizio/" data-consiglio-link>Vai all'esercizio →</a>
        </div>
        <div class="pannello altre">
          <strong>Altre azioni</strong>
          <button type="button" class="azione" data-scarica>Scarica il riepilogo per il CV</button>
          <button type="button" class="azione azione--rischio" data-cancella>Cancella i miei progressi</button>
          <p class="nota" data-messaggio aria-live="polite"></p>
        </div>
      </aside>
    </div>
  </main>
</AppLayout>

<script>
  import { leggi, punteggio, cancellaTutto, type Ruolo } from "../../scripts/progressi";
  import { esercizio, riassunto } from "../../scripts/esercizi";
  import azienda from "../../data/app/cinque-foglie.json";

  const p = leggi();
  const fatti: { id: string; nome: string; r: Ruolo; totale: number }[] = [];

  // 1. Una riga per ruolo
  for (const ruolo of azienda.ruoli) {
    const r = p.ruoli[ruolo.id];
    const riga = document.querySelector(`[data-riga="${ruolo.id}"]`)!;
    if (r?.stato === "completato") {
      const punti = punteggio(r);
      riga.querySelector("[data-punti]")!.textContent = String(punti.totale);
      riga.querySelector<HTMLElement>("[data-barra]")!.style.width = `${punti.totale}%`;
      riga.querySelector("[data-gradimento]")!.textContent = r.gradimento ? `${r.gradimento}/5` : "–";
      fatti.push({ id: ruolo.id, nome: ruolo.nome, r, totale: punti.totale });
    } else if (r?.stato === "in-corso") {
      riga.querySelector("[data-punti]")!.textContent = "in corso";
    }
  }

  // 2. Titolo e consiglio di Pesca
  const titolo = document.querySelector("[data-titolo]")!;
  const intro = document.querySelector("[data-intro]")!;
  const cTitolo = document.querySelector("[data-consiglio-titolo]")!;
  const cTesto = document.querySelector("[data-consiglio-testo]")!;
  const cLink = document.querySelector<HTMLAnchorElement>("[data-consiglio-link]")!;
  const prossimo = azienda.ruoli.find((r) => p.ruoli[r.id]?.stato === "in-corso") ?? azienda.ruoli.find((r) => p.ruoli[r.id]?.stato !== "completato");

  if (fatti.length > 0) {
    titolo.textContent = fatti.length === azienda.ruoli.length ? "Hai provato tutti i ruoli!" : `Hai completato ${fatti.length} ${fatti.length === 1 ? "ruolo" : "ruoli"} su ${azienda.ruoli.length}`;
    intro.textContent = "Confronta punti e gradimento: il ruolo che ti è piaciuto di più è un buon punto da cui approfondire.";
    // Il preferito: prima il gradimento, poi i punti
    const preferito = [...fatti].sort((a, b) => (b.r.gradimento ?? 0) - (a.r.gradimento ?? 0) || b.totale - a.totale)[0];
    if (prossimo && fatti.length < 3) {
      cTitolo.textContent = prossimo.nome;
      cTesto.textContent = "Prova ancora qualche ruolo prima di scegliere: è il confronto che ti fa capire cosa ti piace davvero.";
      cLink.textContent = "Vai all'esercizio →";
      cLink.href = `/app/${prossimo.id}/esercizio/`;
    } else {
      cTitolo.textContent = preferito.nome;
      cTesto.textContent = (preferito.r.gradimento ?? 0) >= 4 ? "È il ruolo che ti è piaciuto di più: parti da qui per approfondire." : "È il ruolo dove sei andata o andato meglio. Rileggi la correzione per capire perché.";
      cLink.textContent = "Rivedi la correzione →";
      cLink.href = `/app/${preferito.id}/correzione/`;
    }
  } else if (prossimo) {
    cTitolo.textContent = p.ruoli[prossimo.id]?.stato === "in-corso" ? `Finisci: ${prossimo.nome}` : "Inizia dalla SEO";
    if (p.ruoli[prossimo.id]?.stato === "in-corso") cTesto.textContent = "Hai una bozza salvata: riprendila da dove eri rimasta o rimasto.";
    cLink.textContent = "Vai all'esercizio →";
    cLink.href = `/app/${prossimo.id}/esercizio/`;
  }

  const messaggio = document.querySelector("[data-messaggio]")!;

  // 3. Scarica un file di testo con i risultati (per il CV o il portfolio)
  document.querySelector("[data-scarica]")!.addEventListener("click", () => {
    const righe = ["Marketing Mix · I miei risultati", `Data: ${new Date().toLocaleDateString("it-IT")}`, "Azienda simulata: Cinque Foglie (dati inventati)", ""];
    for (const f of fatti) {
      const punti = punteggio(f.r);
      righe.push(`${f.nome}: ${punti.totale}/100 (controlli ${punti.auto}/40, autovalutazione ${punti.voto}/60${punti.aiuti ? `, aiuti -${punti.aiuti}` : ""})`);
      const l = f.r.consegna?.lavoro as any;
      if (!l) continue;
      if (f.id === "seo") {
        righe.push(`  Keyword scelta: ${l.keyword}`, `  Titolo composto: ${l.titolo}`, `  Descrizione scelta: ${l.descrizione}`, `  Risposta breve scelta: ${l.risposta}`);
      } else {
        const es = esercizio(f.id);
        es?.parti.forEach((parte) => { righe.push(`  ${parte.titolo}${parte.titolo.endsWith("?") ? "" : ":"}`); riassunto(parte, l[parte.id]).forEach((x) => righe.push(`    - ${x}`)); });
      }
      righe.push("");
    }
    if (fatti.length === 0) righe.push("Nessun ruolo completato per ora.");
    const file = new Blob([righe.join("\n")], { type: "text/plain;charset=utf-8" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(file);
    a.download = "marketing-mix-risultati.txt";
    a.click();
    URL.revokeObjectURL(a.href);
  });

  // 4. Cancella: serve un secondo clic di conferma (niente finestre di dialogo)
  const cancella = document.querySelector<HTMLButtonElement>("[data-cancella]")!;
  let conferma = false;
  cancella.addEventListener("click", () => {
    if (!conferma) {
      conferma = true;
      cancella.textContent = "Sicura o sicuro? Clicca di nuovo per cancellare";
      return;
    }
    cancellaTutto();
    messaggio.textContent = "Progressi cancellati da questo browser.";
    setTimeout(() => window.location.reload(), 800);
  });
</script>

<style>
  .contenuto { max-width: 1160px; margin: 0 auto; padding: 28px 24px 56px; display: flex; flex-direction: column; gap: 20px; }
  .testa { background: #efeeea; border-radius: 18px; padding: 24px 28px; display: flex; flex-wrap: wrap; gap: 22px; align-items: center; }
  .testa div { flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  h1 { font-size: clamp(1.8rem, 4vw, 2.2rem); }
  .testa p { color: #55514c; line-height: 1.55; max-width: 60ch; }
  .colonne { display: flex; flex-wrap: wrap; gap: 18px; align-items: flex-start; }
  .tabella { flex: 999 1 520px; min-width: 0; padding: 18px 20px; display: flex; flex-direction: column; gap: 10px; }
  .sottotitolo { font-family: var(--font-testo); font-size: 1rem; font-weight: 700; }
  .scorri { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: .9rem; font-variant-numeric: tabular-nums; }
  thead th { text-align: left; font-size: .75rem; color: #6f6a64; font-weight: 600; padding: 8px 8px 8px 0; border-bottom: 1px solid #e3e1dc; }
  tbody th { text-align: left; font-weight: 600; padding: 12px 8px 12px 0; border-bottom: 1px solid #efeeeb; }
  td { padding: 12px 8px 12px 0; border-bottom: 1px solid #efeeeb; color: #55514c; }
  td:last-child, thead th:last-child { text-align: right; }
  .punti-cella { display: flex; align-items: center; gap: 10px; }
  .barra { flex: 1; min-width: 60px; height: 8px; border-radius: 99px; background: #e9e8e4; overflow: hidden; }
  .barra span { display: block; height: 100%; width: 0; background: var(--arancio); }
  .nota { font-size: .8rem; color: #5f5a55; line-height: 1.5; }
  .lato { flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .consiglio { border-color: var(--arancio); padding: 20px; display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .consiglio strong { font-size: 1.5rem; }
  .consiglio p { line-height: 1.55; color: #55514c; }
  .altre { padding: 16px 18px; display: flex; flex-direction: column; gap: 8px; }
  .azione { font: inherit; font-weight: 600; text-align: left; padding: 11px 12px; border-radius: 10px; border: 1px dashed #d1cec8; background: #fff; cursor: pointer; }
  .azione:hover { background: #f8f8f6; }
  .azione--rischio { color: #a12d1d; border-color: #e7b8ae; }
</style>
