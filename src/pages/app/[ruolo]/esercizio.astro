---
// APP · ESERCIZIO GENERICO (SEA, Brand, Social, Influencer, CRM)
// Una sola pagina per tutti i ruoli: Astro crea /app/sea/esercizio/, /app/brand/esercizio/ ecc.
// partendo dai file JSON in src/data/app/esercizi/. La SEO ha una pagina sua (src/pages/app/seo/).
// Tipi di parte: classifica (tabella a scelte), scelta (una tra più proposte), menu (tendine), spunte (più risposte).
// Nessun testo da scrivere: si clicca e si sceglie.
import AppLayout from "../../../layouts/AppLayout.astro";
import Pesca from "../../../components/Pesca.astro";
import Passi from "../../../components/PassiEsercizio.astro";
import Guida from "../../../components/Guida.astro";
import Lezione from "../../../components/esercizio/Lezione.astro";
import Spiega from "../../../components/esercizio/Spiega.astro";
import { ESERCIZI, type Esercizio } from "../../../scripts/esercizi";

export function getStaticPaths() {
  return ESERCIZI.map((es) => ({ params: { ruolo: es.id }, props: { es } }));
}
const { es } = Astro.props as { es: Esercizio };
const n = es.parti.length;

// Guida iniziale: si apre da sola la prima volta che si entra in questo esercizio
const guida = [
  { zona: "tutto", titolo: `Il tuo esercizio da ${es.ruolo}`, testo: `${es.richiesta.nome} ti ha scritto: <strong>${es.richiesta.oggetto}</strong>. Lo risolvi in <strong>${n} parti</strong>, in circa ${es.minuti} minuti.` },
  { zona: "sinistra", titolo: "A sinistra: la richiesta e i dati", testo: "Qui trovi la richiesta e una <strong>scheda con i numeri</strong>. Usali per rispondere: le risposte giuste si trovano lì." },
  { zona: "centro", titolo: "Al centro: il tuo lavoro", testo: "Le parti una sotto l'altra. <strong>Non devi scrivere nulla</strong>: scegli nelle tabelle, tra le proposte e nei menu. Attenzione alle trappole!" },
  { zona: "destra", titolo: "A destra: Pesca e i controlli", testo: "I controlli diventano <strong>verdi</strong> quando una cosa è giusta, e io ti dico cosa sistemare. Ogni aiuto aperto toglie 5 punti." },
  { zona: "tutto", titolo: "Si salva da solo", testo: "Il lavoro resta salvato in questo browser. Alla fine clicca <strong>Consegna e confronta</strong> per vedere punti e soluzione." },
] as const;

// Numero del primo controllo di ogni parte (serve per collegare i controlli a destra)
const inizio = es.parti.map((_, i) => es.parti.slice(0, i).reduce((s, p) => s + p.controlli.length, 0));
---
<AppLayout title={`${es.titolo} · ${es.ruolo}`} indietro={{ etichetta: "Scrivania", link: "/app/scrivania/" }} percorso={[{ etichetta: es.ruolo }, { etichetta: es.titolo }]}>
  <Passi slot="barra" attivo={2} />
  <div class="layout" data-esercizio={es.id}>
    <!-- ====== SINISTRA: richiesta e scheda ====== -->
    <aside class="sinistra">
      <section class="pannello blocco">
        <span class="mittente"><span class="avatar">{es.richiesta.da}</span><strong>La richiesta di {es.richiesta.nome}</strong></span>
        <p>{es.richiesta.testo}</p>
      </section>
      <section class="pannello blocco" aria-labelledby="t-scheda">
        <div class="riga"><h2 id="t-scheda" class="sottotitolo">{es.scheda.titolo}</h2><span class="simulati">dati simulati</span></div>
        <dl class="scheda-prodotto">
          {es.scheda.voci.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
        </dl>
      </section>
    </aside>

    <!-- ====== CENTRO: le parti ====== -->
    <form id="lavoro" class="centro" novalidate>
      <header class="intro">
        <h1 class="app-titolo">{es.richiesta.oggetto}</h1>
        <p class="nota">{n} parti, circa {es.minuti} minuti. Il lavoro si salva da solo in questo browser. <button type="button" class="link-guida" data-apri-guida>Rivedi la guida</button></p>
      </header>

      {es.lezione && <Lezione lezione={es.lezione} parti={es.parti.map((p) => p.id)} />}

      {es.parti.map((p, i) => (
        <section class="pannello parte" id={`parte-${p.id}`} aria-labelledby={`t-${p.id}`}>
          <div class="parte-testa"><span class="numero">{i + 1}</span><h2 id={`t-${p.id}`} class="parte-titolo">{p.titolo}</h2></div>
          {p.spiega && <Spiega spiega={p.spiega} />}
          <p class="domanda">{p.testo}</p>

          {p.tipo === "classifica" && (
            <div class="scorri">
              <table class="classifica">
                <thead><tr><th scope="col">Voce</th>{p.colonne.map((c) => <th scope="col">{c.nome}</th>)}</tr></thead>
                <tbody>
                  {p.righe.map((r) => (
                    <tr>
                      <th scope="row">{r.testo}</th>
                      {p.colonne.map((c) => (
                        <td class="scelta-cella"><label><input type="radio" name={`${p.id}-${r.id}`} value={c.id} data-parte={p.id} data-riga={r.id} /><span class="sr">{r.testo}: {c.nome}</span></label></td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {p.tipo === "scelta" && (
            <fieldset class="opzioni">
              <legend class="sr">{p.titolo}</legend>
              {p.opzioni.map((o) => (
                <label class="opzione"><input type="radio" name={p.id} value={o.id} data-parte={p.id} /><span>{o.testo}</span></label>
              ))}
            </fieldset>
          )}

          {p.tipo === "spunte" && (
            <fieldset class="opzioni">
              <legend class="sr">{p.titolo}</legend>
              {p.opzioni.map((o) => (
                <label class="opzione opzione--spunta"><input type="checkbox" value={o.id} data-parte={p.id} /><span>{o.testo}</span></label>
              ))}
            </fieldset>
          )}

          {p.tipo === "menu" && (
            <div class="griglia-campi">
              {p.campi.map((c) => (
                <label class="campo">{c.etichetta}
                  <select data-parte={p.id} data-campo={c.id}>
                    <option value="">Scegli…</option>
                    {c.opzioni.map((o) => <option>{o}</option>)}
                  </select>
                </label>
              ))}
            </div>
          )}

          <p class="perche"><strong>Perché conta.</strong> {p.perche}</p>
        </section>
      ))}

      <div class="consegna">
        <span class="salvato" data-salvato aria-live="polite"></span>
        <button type="submit" class="bottone-app">Consegna e confronta →</button>
      </div>
    </form>

    <!-- ====== DESTRA: Pesca, controlli, aiuti ====== -->
    <aside class="destra">
      <div class="pannello blocco">
        <div class="mittente"><Pesca dimensione={46} occhiali animata={false} /><span><strong>Pesca</strong><span class="nota">Ti do un suggerimento alla volta</span></span></div>
        <p class="pesca-dice" data-pesca aria-live="polite">{es.consiglio}</p>
      </div>
      <div class="pannello blocco">
        <strong>Controlli automatici</strong>
        <p class="nota">Ogni controllo mostra cosa hai fatto bene solo quando lo superi.</p>
        <ul class="parti">
          {es.parti.map((p, i) => (
            <li>
              <a href={`#parte-${p.id}`} class="parte-link"><span>{i + 1}. {p.titolo}</span><span class="conteggio" data-conteggio={i}>0/{p.controlli.length}</span></a>
              <ul class="controlli">
                {p.controlli.map((c, k) => (<li data-controllo={inizio[i] + k}><span class="segno" aria-hidden="true"></span><span class="nome-controllo">{c.nome}</span><span class="attesa">Da superare</span><span class="sr" data-esito>non ancora</span></li>))}
              </ul>
            </li>
          ))}
        </ul>
      </div>
      {es.aiuti.map((a, i) => (
        <details class="pannello aiuto" data-aiuto={i}>
          <summary>Aiuto {i + 1}: {a.titolo} <span class="costo">−5 punti</span></summary>
          <p>{a.testo}</p>
        </details>
      ))}
      <details class="pannello aiuto">
        <summary>Glossario</summary>
        <p>{es.glossario}</p>
      </details>
    </aside>
  </div>
  <Guida chiave={`${es.id}-1`} passi={[...guida]} />
</AppLayout>

<script>
  import { esercizio, controlla, completa, type Risposte } from "../../../scripts/esercizi";
  import { leggi, aggiornaRuolo } from "../../../scripts/progressi";

  const radice = document.querySelector<HTMLElement>("[data-esercizio]")!;
  const es = esercizio(radice.dataset.esercizio!)!;
  const id = es.id;
  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const tutti = (sel: string) => [...document.querySelectorAll<HTMLInputElement & HTMLSelectElement>(sel)];
  const pesca = $("[data-pesca]");

  // Legge tutte le risposte dalla pagina
  function risposte(): Risposte {
    const r: Risposte = {};
    for (const p of es.parti) {
      if (p.tipo === "classifica") {
        r[p.id] = Object.fromEntries(tutti(`input[data-parte="${p.id}"]:checked`).map((x) => [x.dataset.riga, x.value]));
      } else if (p.tipo === "scelta") {
        r[p.id] = tutti(`input[data-parte="${p.id}"]:checked`)[0]?.value ?? "";
      } else if (p.tipo === "spunte") {
        r[p.id] = tutti(`input[data-parte="${p.id}"]:checked`).map((x) => x.value);
      } else {
        r[p.id] = Object.fromEntries(tutti(`select[data-parte="${p.id}"]`).map((x) => [x.dataset.campo, x.value]));
      }
    }
    return r;
  }

  // Rimette nella pagina le risposte salvate
  function ripristina(r: Risposte) {
    for (const p of es.parti) {
      const v = r[p.id];
      if (v == null) continue;
      if (p.tipo === "classifica") tutti(`input[data-parte="${p.id}"]`).forEach((x) => (x.checked = v[x.dataset.riga!] === x.value));
      else if (p.tipo === "scelta") tutti(`input[data-parte="${p.id}"]`).forEach((x) => (x.checked = x.value === v));
      else if (p.tipo === "spunte") tutti(`input[data-parte="${p.id}"]`).forEach((x) => (x.checked = v.includes(x.value)));
      else tutti(`select[data-parte="${p.id}"]`).forEach((x) => (x.value = v[x.dataset.campo!] ?? ""));
    }
  }

  const salvato = leggi().ruoli[id];
  const ripresa = salvato?.bozza ?? salvato?.consegna?.lavoro;
  if (ripresa) ripristina(ripresa);

  // Aiuti aperti: si ricordano e ognuno toglie 5 punti
  const aiutiAperti = new Set<number>(salvato?.aiuti ?? []);
  document.querySelectorAll<HTMLDetailsElement>("details[data-aiuto]").forEach((d) => {
    const n = Number(d.dataset.aiuto);
    if (aiutiAperti.has(n)) d.open = true;
    d.addEventListener("toggle", () => { if (d.open && !aiutiAperti.has(n)) { aiutiAperti.add(n); aggiornaRuolo(id, { aiuti: [...aiutiAperti] }); } });
  });

  // Suggerimenti di Pesca: uno per controllo, nell'ordine dei controlli
  const suggerimenti = es.parti.flatMap((p, i) => p.controlli.map((c) => `Parte ${i + 1}: ${c.suggerimento}`));

  function aggiorna() {
    const r = risposte();
    const esiti = controlla(es, r);
    esiti.forEach((ok, i) => {
      const li = $(`[data-controllo="${i}"]`);
      li.classList.toggle("ok", ok);
      li.querySelector("[data-esito]")!.textContent = ok ? "superato" : "non ancora";
    });
    let k = 0;
    es.parti.forEach((p, i) => {
      const fatti = esiti.slice(k, k + p.controlli.length).filter(Boolean).length;
      $(`[data-conteggio="${i}"]`).textContent = `${fatti}/${p.controlli.length}`;
      k += p.controlli.length;
    });
    const primo = esiti.findIndex((ok) => !ok);
    pesca.textContent = primo === -1 ? "Tutti i controlli sono verdi! Rileggi le tue scelte, poi consegna." : suggerimenti[primo];
    return { r, esiti };
  }

  function salva() {
    const { r } = aggiorna();
    aggiornaRuolo(id, { stato: leggi().ruoli[id]?.stato === "completato" ? "completato" : "in-corso", bozza: r });
    $("[data-salvato]").textContent = "Salvato in questo browser";
  }

  const form = $<HTMLFormElement>("#lavoro");
  form.addEventListener("change", salva);
  aggiorna();

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const { r, esiti } = aggiorna();
    const mancante = es.parti.find((p) => !completa(p, r[p.id]));
    if (mancante) {
      pesca.textContent = `Prima di consegnare completa la parte "${mancante.titolo}".`;
      document.getElementById(`parte-${mancante.id}`)!.scrollIntoView({ behavior: "smooth" });
      return;
    }
    aggiornaRuolo(id, { stato: leggi().ruoli[id]?.stato === "completato" ? "completato" : "in-corso", bozza: r, consegna: { lavoro: r, controlli: esiti, data: new Date().toISOString() } });
    window.location.href = `/app/${id}/correzione/`;
  });
</script>

<style>
  /* Colori: sfondo neutro, bianco per le superfici, un solo arancione (--arancio) per azioni e stato attivo */
  .layout { --linea-l: #e3e1dc; --grigio: #f4f4f2; --testo-2: #55514c; display: grid; grid-template-columns: minmax(250px, 300px) minmax(0, 760px) minmax(250px, 300px); justify-content: center; gap: 24px; padding: 28px 24px 48px; align-items: start; }
  .sinistra, .destra { position: sticky; top: 84px; display: flex; flex-direction: column; gap: 12px; max-height: calc(100vh - 100px); overflow-y: auto; }
  .centro { min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .blocco { padding: 18px; display: flex; flex-direction: column; gap: 10px; line-height: 1.55; }
  .mittente { display: flex; align-items: center; gap: 10px; }
  .mittente > span:last-child { display: flex; flex-direction: column; }
  .riga { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .sottotitolo { font-family: var(--font-testo); font-size: 1rem; font-weight: 700; }
  .simulati { font-size: .75rem; font-weight: 600; background: var(--grigio); color: var(--testo-2); padding: 3px 8px; border-radius: 999px; }
  .scheda-prodotto { margin: 0; display: flex; flex-direction: column; font-size: .88rem; }
  .scheda-prodotto div { display: grid; grid-template-columns: 105px 1fr; gap: 10px; padding: 8px 0; border-bottom: 1px solid #efeeeb; }
  .scheda-prodotto div:last-child { border-bottom: 0; }
  .scheda-prodotto dt { color: var(--testo-2); }
  .scheda-prodotto dd { margin: 0; font-weight: 600; }
  .nota { font-size: .82rem; color: var(--testo-2); line-height: 1.5; margin: 0; }
  .intro { display: flex; flex-direction: column; gap: 8px; }
  h1 { font-size: 2rem; line-height: 1.15; }
  .link-guida { font: inherit; font-weight: 700; color: var(--inchiostro); background: none; border: 0; padding: 0; text-decoration: underline; cursor: pointer; }

  /* Parti dell'esercizio */
  .parte { padding: 24px 28px; display: flex; flex-direction: column; gap: 16px; scroll-margin-top: 84px; }
  .parte > p { line-height: 1.6; margin: 0; }
  .parte-testa { display: flex; align-items: center; gap: 12px; }
  .numero { flex: none; width: 34px; height: 34px; border-radius: 50%; background: var(--arancio); color: var(--inchiostro); display: grid; place-items: center; font-weight: 800; }
  .parte-titolo { font-family: var(--font-titoli); font-size: 1.35rem; font-weight: 800; }
  .domanda { font-weight: 700; font-size: 1.05rem; }
  .perche { font-size: .88rem; line-height: 1.6; border-top: 1px solid var(--linea-l); padding-top: 12px; color: var(--testo-2); }
  .perche strong { color: var(--inchiostro); }

  .scorri { overflow-x: auto; position: relative; }
  .classifica { width: 100%; border-collapse: collapse; font-size: .92rem; }
  .classifica thead th { font-size: .8rem; color: var(--testo-2); font-weight: 700; padding: 8px 6px; border-bottom: 1px solid var(--linea-l); text-align: center; white-space: nowrap; }
  .classifica thead th:first-child { text-align: left; }
  .classifica tbody th { text-align: left; font-weight: 600; padding: 10px 8px 10px 0; border-bottom: 1px solid #efeeeb; line-height: 1.4; }
  .classifica td { border-bottom: 1px solid #efeeeb; padding: 6px; }
  .classifica tbody tr:has(input:checked) th { color: var(--inchiostro); }
  .scelta-cella { text-align: center; width: 92px; }
  .scelta-cella label { position: relative; display: inline-grid; place-items: center; width: 44px; height: 44px; cursor: pointer; }
  .scelta-cella input { width: 20px; height: 20px; accent-color: var(--arancio); cursor: pointer; }

  .opzioni { border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .opzione { display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: start; padding: 13px 15px; border: 1.5px solid var(--linea-l); border-radius: 12px; background: #fff; cursor: pointer; line-height: 1.5; }
  .opzione:hover { border-color: #c9c6c0; }
  .opzione:has(input:checked) { border-color: var(--arancio); }
  .opzione:has(input:focus-visible) { outline: 3px solid var(--inchiostro); outline-offset: 2px; }
  .opzione input { width: 18px; height: 18px; margin-top: 3px; accent-color: var(--arancio); }
  .opzione span { min-width: 0; overflow-wrap: anywhere; } /* i link lunghi (es. UTM) vanno a capo */

  .griglia-campi { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; align-items: end; }
  .campo { display: flex; flex-direction: column; gap: 6px; font-weight: 700; font-size: .9rem; line-height: 1.35; }
  select { font: inherit; font-weight: 400; font-size: 1rem; padding: 11px 13px; min-height: 46px; border: 1.5px solid #d1cec8; border-radius: 10px; background: #fff; color: var(--inchiostro); }
  select:focus-visible { outline: 3px solid var(--inchiostro); outline-offset: 1px; border-color: var(--arancio); }

  .consegna { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 12px; padding-bottom: 24px; }
  .salvato { margin-right: auto; font-size: .85rem; color: #2f7a4f; font-weight: 600; }

  /* Colonna di destra: Pesca e controlli */
  .pesca-dice { background: var(--grigio); border-radius: 12px; padding: 12px 14px; font-size: .92rem; margin: 0; }
  .parti { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .parte-link { display: flex; justify-content: space-between; gap: 8px; font-weight: 700; font-size: .9rem; text-decoration: none; color: var(--inchiostro); }
  .conteggio { flex: none; font-variant-numeric: tabular-nums; color: var(--testo-2); }
  .controlli { list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: .82rem; }
  .controlli li { display: flex; align-items: center; gap: 8px; color: var(--testo-2); }
  .controlli li .nome-controllo { display: none; }
  .controlli li.ok .nome-controllo { display: inline; }
  .controlli li.ok .attesa { display: none; }
  .segno { flex: none; width: 16px; height: 16px; border-radius: 50%; border: 2px solid #c9c6c0; display: grid; place-items: center; }
  .controlli li.ok { color: var(--inchiostro); }
  .controlli li.ok .segno { background: #2f7a4f; border-color: #2f7a4f; }
  .controlli li.ok .segno::after { content: ""; width: 6px; height: 3px; border-left: 2px solid #fff; border-bottom: 2px solid #fff; transform: rotate(-45deg) translate(1px, -1px); }
  .aiuto { padding: 14px 16px; }
  .aiuto summary { font-weight: 700; font-size: .9rem; cursor: pointer; }
  .costo { font-weight: 600; color: var(--testo-2); white-space: nowrap; }
  .aiuto p { margin: 10px 0 0; font-size: .9rem; line-height: 1.55; color: #3d3935; }

  @media (max-width: 1200px) {
    .layout { grid-template-columns: minmax(0, 1fr) minmax(250px, 300px); }
    .sinistra { grid-column: 1 / -1; position: static; max-height: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  }
  @media (max-width: 860px) {
    .layout { grid-template-columns: minmax(0, 1fr); padding: 16px; gap: 16px; }
    .destra { position: static; max-height: none; }
    .parte { padding: 20px 18px; }
    .scelta-cella { width: 64px; }
  }
</style>
