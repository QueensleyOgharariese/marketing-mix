---
// APP · DATI: RICERCHE SU GOOGLE
// Tabella delle ricerche (numeri inventati) che serve per l'esercizio SEO.
import AppLayout from "../../../layouts/AppLayout.astro";
import Progresso from "../../../components/Progresso.astro";
import azienda from "../../../data/app/cinque-foglie.json";
import es from "../../../data/app/seo-sencha.json";
---
<AppLayout title="Ricerche su Google" percorso={[{ etichetta: azienda.nome, link: "/app/" }, { etichetta: "Scrivania", link: "/app/scrivania/" }, { etichetta: "Ricerche su Google" }]}>
  <Progresso slot="barra" />
  <main class="contenuto">
    <div>
      <span class="tag">Dati dell'azienda</span>
      <h1 class="app-titolo">Ricerche su Google · tè verde</h1>
      <p class="nota">Quante volte al mese le persone cercano queste parole. <strong>Numeri inventati</strong> per l'esercizio, non presi da strumenti reali.</p>
    </div>
    <section class="pannello tabella">
      <table>
        <caption class="sr">Ricerche al mese, dati simulati</caption>
        <thead><tr><th scope="col">Ricerca</th><th scope="col">Al mese</th></tr></thead>
        <tbody>
          {es.ricerche.map((r) => (
            <tr><td>{r.ricerca} {r.attenzione && <span class="attenzione">attenzione</span>}</td><td>{r.mese}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="nota">{es.notaRicerche}</p>
    </section>
    <a class="bottone-app" href="/app/seo/esercizio/">Usa questi dati nell'esercizio →</a>
  </main>
</AppLayout>

<style>
  .contenuto { max-width: 760px; margin: 0 auto; padding: 28px 24px 56px; display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  h1 { font-size: 1.8rem; margin: 8px 0 6px; }
  .nota { font-size: .9rem; color: #5f5a55; line-height: 1.55; }
  .tabella { width: 100%; padding: 18px 20px; display: flex; flex-direction: column; gap: 12px; }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  th { text-align: left; font-size: .8rem; color: #6f6a64; font-weight: 600; padding: 8px 0; border-bottom: 1px solid #e3e1dc; }
  th:last-child, td:last-child { text-align: right; }
  td { padding: 10px 0; border-bottom: 1px solid #efeeeb; }
  .attenzione { font-size: .7rem; font-weight: 700; background: #fde8e4; color: #a12d1d; padding: 2px 6px; border-radius: 999px; margin-left: 4px; }
</style>
