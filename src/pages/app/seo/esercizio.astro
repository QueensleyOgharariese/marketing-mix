---
// APP · 3. ESERCIZIO SEO (versione 2, SEO moderna): la pagina prodotto del Sencha in 4 parti
//   1. Intento di ricerca  2. Titolo e descrizione (misurati in pixel)  3. Dati strutturati Product  4. Risposta breve
// A sinistra richiesta e scheda prodotto, al centro il lavoro, a destra Pesca, gli aiuti e i controlli per parte.
// Lo script in fondo aggiorna controlli e anteprime mentre lavori e salva tutto nel browser.
import AppLayout from "../../../layouts/AppLayout.astro";
import Pesca from "../../../components/Pesca.astro";
import Passi from "../../../components/PassiEsercizio.astro";
import es from "../../../data/app/seo-sencha.json";
import { PARTI, LIMITI } from "../../../scripts/controlli-seo";

const s = es.scheda;
const voci = [
  ["Prodotto", s.nome], ["Marca", s.marca], ["Origine", s.origine], ["Formato", s.formato],
  ["Prezzo", `${s.prezzo} €`], ["Disponibilità", s.disponibilita], ["Preparazione", s.preparazione],
  ["Gusto", s.gusto], ["Spedizione", s.spedizione], ["Recensioni", s.recensioni],
];
---
<AppLayout title={es.titolo} indietro={{ etichetta: "Scrivania", link: "/app/scrivania/" }} percorso={[{ etichetta: "SEO" }, { etichetta: es.titolo }]}>
  <Passi slot="barra" attivo={2} />
  <div class="layout">
    <!-- ====== SINISTRA: richiesta e scheda prodotto ====== -->
    <aside class="sinistra">
      <section class="pannello blocco">
        <span class="mittente"><span class="avatar">{es.richiesta.da}</span><strong>La richiesta di {es.richiesta.nome}</strong></span>
        <p>{es.richiesta.testo}</p>
      </section>
      <section class="pannello blocco" aria-labelledby="t-scheda">
        <div class="riga"><h2 id="t-scheda" class="sottotitolo">Scheda prodotto</h2><span class="simulati">dati simulati</span></div>
        <dl class="scheda-prodotto">
          {voci.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
        </dl>
        <p class="nota">Usa solo queste informazioni: niente dati inventati.</p>
      </section>
    </aside>

    <!-- ====== CENTRO: il lavoro in 4 parti ====== -->
    <form id="lavoro" class="centro" novalidate>
      <header class="intro">
        <h1 class="app-titolo">Sistema la pagina del Sencha per Google</h1>
        <p class="nota">4 parti, circa {es.minuti} minuti. Il lavoro si salva da solo in questo browser.</p>
        <div class="serp-attuale"><span class="piccolo">Oggi su Google</span><span class="a-url">{es.attuale.url}</span><span class="a-titolo">{es.attuale.titolo}</span><span class="a-desc">{es.attuale.descrizione}</span></div>
      </header>

      <!-- 1. INTENTO -->
      <section class="pannello parte" id="parte-intento" aria-labelledby="t-1">
        <div class="parte-testa"><span class="numero">1</span><h2 id="t-1" class="parte-titolo">Capisci chi cerca cosa</h2></div>
        <p>Per ogni ricerca scegli cosa vuole fare la persona. Poi scegli la keyword principale della pagina prodotto.</p>
        <div class="scorri">
          <table class="intenti">
            <caption class="sr">Ricerche su Google al mese (numeri inventati) e intento</caption>
            <thead><tr><th scope="col">Ricerca</th><th scope="col">Al mese</th>{es.intenti.map((i) => <th scope="col" title={i.spiega}>{i.nome}</th>)}<th scope="col">Keyword principale</th></tr></thead>
            <tbody>
              {es.ricerche.map((r, n) => (
                <tr>
                  <th scope="row">{r.ricerca} {r.attenzione && <span class="attenzione">attenzione</span>}</th>
                  <td class="num">{r.mese}</td>
                  {es.intenti.map((i) => (
                    <td class="scelta-cella"><label><input type="radio" name={`intento-${n}`} value={i.id} data-ricerca={r.ricerca} /><span class="sr">{r.ricerca}: {i.nome}</span></label></td>
                  ))}
                  <td class="scelta-cella"><label><input type="radio" name="keyword" value={r.ricerca} /><span class="sr">Keyword principale: {r.ricerca}</span></label></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="legenda">{es.intenti.map((i) => <span><strong>{i.nome}</strong>: {i.spiega.toLowerCase()}</span>)}</p>
        <p class="attenzione-nota">{es.notaRicerche}</p>
        <p class="perche"><strong>Perché conta oggi.</strong> {es.perche.intento}</p>
      </section>

      <!-- 2. TITOLO E DESCRIZIONE -->
      <section class="pannello parte" id="parte-titolo" aria-labelledby="t-2">
        <div class="parte-testa"><span class="numero">2</span><h2 id="t-2" class="parte-titolo">Scrivi titolo e descrizione</h2></div>
        <div class="campo">
          <div class="riga"><label for="titolo">Titolo della pagina (title)</label><span class="conta"><span data-conta="titolo">0 caratteri</span> · <span data-pixel>0 / {LIMITI.titoloPx} px</span></span></div>
          <input id="titolo" type="text" autocomplete="off" maxlength="120" placeholder={es.attuale.titolo} />
          <span class="barra" aria-hidden="true"><span data-barra="titolo"></span></span>
        </div>
        <div class="campo">
          <div class="riga"><label for="descrizione">Descrizione (meta description)</label><span class="conta" data-conta="descrizione">0 / {LIMITI.descrizione[1]}</span></div>
          <textarea id="descrizione" rows="3" maxlength="300" placeholder={es.attuale.descrizione}></textarea>
          <span class="barra" aria-hidden="true"><span data-barra="descrizione"></span></span>
        </div>
        <div class="serp">
          <span class="piccolo">Anteprima nei risultati</span>
          <span class="a-url">{es.attuale.url}</span>
          <span class="a-titolo" data-anteprima="titolo">{es.attuale.titolo}</span>
          <span class="a-ricco" data-ricco hidden></span>
          <span class="a-desc" data-anteprima="descrizione">{es.attuale.descrizione}</span>
        </div>
        <p class="perche"><strong>Perché conta oggi.</strong> {es.perche.titolo}</p>
      </section>

      <!-- 3. DATI STRUTTURATI -->
      <section class="pannello parte" id="parte-dati" aria-labelledby="t-3">
        <div class="parte-testa"><span class="numero">3</span><h2 id="t-3" class="parte-titolo">Prepara i dati per Google</h2></div>
        <p>Compila i dati strutturati del prodotto: sono codice che le persone non vedono, ma Google sì.</p>
        <div class="griglia-campi">
          <label class="campo">Nome del prodotto<input id="s-nome" type="text" autocomplete="off" /></label>
          <label class="campo">Marca<input id="s-marca" type="text" autocomplete="off" /></label>
          <label class="campo">Prezzo<input id="s-prezzo" type="text" inputmode="decimal" autocomplete="off" placeholder="es. 9,90" /></label>
          <label class="campo">Valuta
            <select id="s-valuta"><option value="EUR">EUR (euro)</option><option value="USD">USD (dollaro)</option></select>
          </label>
          <label class="campo">Disponibilità
            <select id="s-disp"><option value="">Scegli…</option><option value="InStock">Disponibile</option><option value="OutOfStock">Esaurito</option><option value="PreOrder">Preordine</option></select>
          </label>
          <label class="spunta"><input id="s-stelle" type="checkbox" /><span>Aggiungi le stelle: 4,8 su 5 (120 recensioni)</span></label>
        </div>
        <details class="codice">
          <summary>Guarda il codice che stai creando (JSON-LD)</summary>
          <pre data-jsonld></pre>
        </details>
        <p class="perche"><strong>Perché conta oggi.</strong> {es.perche.dati}</p>
      </section>

      <!-- 4. RISPOSTA BREVE -->
      <section class="pannello parte" id="parte-risposta" aria-labelledby="t-4">
        <div class="parte-testa"><span class="numero">4</span><h2 id="t-4" class="parte-titolo">Rispondi a una domanda</h2></div>
        <p>Molte persone chiedono a Google: <strong>"{es.domanda}"</strong>. Scrivi la risposta breve che andrà sulla pagina.</p>
        <div class="campo">
          <div class="riga"><label for="risposta">La tua risposta</label><span class="conta" data-conta="risposta">0 parole</span></div>
          <textarea id="risposta" rows="4" maxlength="800"></textarea>
        </div>
        <div class="paa">
          <span class="piccolo">Anteprima · Le persone chiedono anche</span>
          <div class="paa-riquadro"><strong>{es.domanda}</strong><span data-anteprima="risposta">La tua risposta comparirà qui.</span><span class="a-url">{es.attuale.url}</span></div>
        </div>
        <p class="perche"><strong>Perché conta oggi.</strong> {es.perche.risposta}</p>
      </section>

      <div class="consegna">
        <span class="salvato" data-salvato aria-live="polite"></span>
        <button type="submit" class="bottone-app">Consegna e confronta →</button>
      </div>
    </form>

    <!-- ====== DESTRA: Pesca, controlli per parte, aiuti ====== -->
    <aside class="destra">
      <div class="pannello blocco">
        <div class="mittente"><Pesca dimensione={46} occhiali animata={false} /><span><strong>Pesca</strong><span class="nota">Ogni aiuto aperto toglie 5 punti</span></span></div>
        <p class="pesca-dice" data-pesca aria-live="polite">Inizia dalla parte 1: per ogni ricerca scegli cosa vuole fare la persona.</p>
      </div>
      <div class="pannello blocco">
        <strong>Controlli automatici</strong>
        <ul class="parti">
          {PARTI.map((p, n) => (
            <li>
              <a href={`#parte-${p.id}`} class="parte-link"><span>{n + 1}. {p.nome}</span><span class="conteggio" data-conteggio={n}>0/4</span></a>
              <ul class="controlli">
                {p.controlli.map((c, k) => (<li data-controllo={n * 4 + k}><span class="segno" aria-hidden="true"></span><span>{c}</span><span class="sr" data-esito>non ancora</span></li>))}
              </ul>
            </li>
          ))}
        </ul>
      </div>
      {es.aiuti.map((a, i) => (
        <details class="pannello aiuto" data-aiuto={i}>
          <summary>Aiuto {i + 1} · {a.titolo}</summary>
          <p>{a.testo}</p>
        </details>
      ))}
      <details class="pannello aiuto">
        <summary>Glossario</summary>
        <p>{es.glossario}</p>
      </details>
    </aside>
  </div>
</AppLayout>

<script>
  import es from "../../../data/app/seo-sencha.json";
  import { controlla, jsonLd, pixel, contaParole, LIMITI, PARTI, type Lavoro } from "../../../scripts/controlli-seo";
  import { leggi, aggiornaRuolo } from "../../../scripts/progressi";

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const titolo = $<HTMLInputElement>("#titolo");
  const descrizione = $<HTMLTextAreaElement>("#descrizione");
  const risposta = $<HTMLTextAreaElement>("#risposta");
  const campi = { nome: $<HTMLInputElement>("#s-nome"), marca: $<HTMLInputElement>("#s-marca"), prezzo: $<HTMLInputElement>("#s-prezzo"), valuta: $<HTMLSelectElement>("#s-valuta"), disponibilita: $<HTMLSelectElement>("#s-disp") };
  const stelle = $<HTMLInputElement>("#s-stelle");
  const pesca = $("[data-pesca]");
  const salvato = $("[data-salvato]");

  // Legge tutto il lavoro dal modulo
  function lavoro(): Lavoro {
    const intenti: Record<string, string> = {};
    document.querySelectorAll<HTMLInputElement>("input[data-ricerca]:checked").forEach((r) => (intenti[r.dataset.ricerca!] = r.value));
    return {
      intenti,
      keyword: document.querySelector<HTMLInputElement>('input[name="keyword"]:checked')?.value ?? "",
      titolo: titolo.value, descrizione: descrizione.value, risposta: risposta.value,
      schema: { nome: campi.nome.value, marca: campi.marca.value, prezzo: campi.prezzo.value, valuta: campi.valuta.value, disponibilita: campi.disponibilita.value, stelle: stelle.checked },
    };
  }

  // Rimette nel modulo un lavoro salvato
  function ripristina(l: Partial<Lavoro>) {
    Object.entries(l.intenti ?? {}).forEach(([ricerca, valore]) => {
      document.querySelectorAll<HTMLInputElement>("input[data-ricerca]").forEach((r) => { if (r.dataset.ricerca === ricerca && r.value === valore) r.checked = true; });
    });
    if (l.keyword) document.querySelectorAll<HTMLInputElement>('input[name="keyword"]').forEach((r) => (r.checked = r.value === l.keyword));
    titolo.value = l.titolo ?? ""; descrizione.value = l.descrizione ?? ""; risposta.value = l.risposta ?? "";
    if (l.schema) {
      campi.nome.value = l.schema.nome; campi.marca.value = l.schema.marca; campi.prezzo.value = l.schema.prezzo;
      campi.valuta.value = l.schema.valuta; campi.disponibilita.value = l.schema.disponibilita; stelle.checked = l.schema.stelle;
    }
  }

  const seo = leggi().ruoli.seo;
  const ripresa = seo?.bozza ?? seo?.consegna?.lavoro;
  if (ripresa) ripristina(ripresa as Lavoro);

  // Aiuti aperti: si ricordano e ognuno toglie 5 punti
  const aiutiAperti = new Set<number>(seo?.aiuti ?? []);
  document.querySelectorAll<HTMLDetailsElement>("details[data-aiuto]").forEach((d) => {
    const n = Number(d.dataset.aiuto);
    if (aiutiAperti.has(n)) d.open = true;
    d.addEventListener("toggle", () => { if (d.open && !aiutiAperti.has(n)) { aiutiAperti.add(n); aggiornaRuolo("seo", { aiuti: [...aiutiAperti] }); } });
  });

  function colore(n: number, min: number, max: number) { return n > max ? "#c0392b" : n >= min ? "#2f7a4f" : "#ff7a1a"; }

  // Suggerimento di Pesca: il primo controllo non ancora superato
  const SUGGERIMENTI = [
    "Parte 1: le ricerche generiche o con \"come\" e \"benefici\" sono per informarsi.",
    "Parte 1: chi scrive il nome preciso del prodotto vuole scegliere (o comprare).",
    "Parte 1: \"comprare sencha online\" è chiarissima: la persona vuole comprare.",
    "Parte 1: per una pagina prodotto scegli una keyword vicina al prodotto, non la più cercata.",
    "Parte 2: metti nel titolo la keyword che hai scelto, meglio all'inizio.",
    "Parte 2: il titolo deve avere almeno 30 caratteri e stare sotto i 580 pixel.",
    "Parte 2: chiudi il titolo con \"| Cinque Foglie\".",
    "Parte 2: descrizione tra 70 e 160 caratteri, e niente promesse sulla salute.",
    "Parte 3: scrivi nome del prodotto e marca come nella scheda.",
    "Parte 3: il prezzo deve essere uguale a quello della scheda prodotto.",
    "Parte 3: controlla valuta e disponibilità nella scheda prodotto.",
    "Parte 3: niente stelle! La scheda dice che non ci sono recensioni verificate.",
    "Parte 4: la risposta deve avere tra 30 e 70 parole.",
    "Parte 4: scrivi la temperatura dell'acqua, la trovi nella scheda prodotto.",
    "Parte 4: scrivi anche il tempo di infusione.",
    "Parte 4: niente promesse sulla salute, parla di come si prepara.",
  ];

  function aggiorna() {
    const l = lavoro();
    // Contatori e barre
    const px = pixel(l.titolo.trim());
    $("[data-conta=titolo]").textContent = `${l.titolo.trim().length} caratteri`;
    $("[data-pixel]").textContent = `${px} / ${LIMITI.titoloPx} px`;
    const bt = $("[data-barra=titolo]");
    bt.style.width = `${Math.min(100, (px / LIMITI.titoloPx) * 100)}%`;
    bt.style.background = px > LIMITI.titoloPx ? "#c0392b" : l.titolo.trim().length >= LIMITI.titoloMin ? "#2f7a4f" : "#ff7a1a";
    const nd = l.descrizione.trim().length;
    $("[data-conta=descrizione]").textContent = `${nd} / ${LIMITI.descrizione[1]}`;
    const bd = $("[data-barra=descrizione]");
    bd.style.width = `${Math.min(100, (nd / LIMITI.descrizione[1]) * 100)}%`;
    bd.style.background = colore(nd, LIMITI.descrizione[0], LIMITI.descrizione[1]);
    $("[data-conta=risposta]").textContent = `${contaParole(l.risposta)} parole (30-70)`;

    // Anteprime
    $("[data-anteprima=titolo]").textContent = l.titolo.trim() || titolo.placeholder;
    $("[data-anteprima=descrizione]").textContent = l.descrizione.trim() || descrizione.placeholder;
    $("[data-anteprima=risposta]").textContent = l.risposta.trim() || "La tua risposta comparirà qui.";
    const ricco = $("[data-ricco]");
    const parti: string[] = [];
    if (l.schema.stelle) parti.push("★★★★★ 4,8 (120)");
    if (l.schema.prezzo.trim()) parti.push(`${l.schema.prezzo.trim()} ${l.schema.valuta === "EUR" ? "€" : "$"}`);
    if (l.schema.disponibilita) parti.push(({ InStock: "Disponibile", OutOfStock: "Esaurito", PreOrder: "Preordine" } as Record<string, string>)[l.schema.disponibilita] ?? "");
    ricco.hidden = parti.length === 0;
    ricco.textContent = parti.join(" · ");
    $("[data-jsonld]").textContent = jsonLd(l, `https://${es.attuale.url.replace(/ › /g, "/")}`);

    // Controlli
    const esiti = controlla(l, es.ricerche, es.keywordGiuste);
    esiti.forEach((ok, i) => {
      const li = $(`[data-controllo="${i}"]`);
      li.classList.toggle("ok", ok);
      li.querySelector("[data-esito]")!.textContent = ok ? "superato" : "non ancora";
    });
    PARTI.forEach((_, n) => { $(`[data-conteggio="${n}"]`).textContent = `${esiti.slice(n * 4, n * 4 + 4).filter(Boolean).length}/4`; });
    const primo = esiti.findIndex((ok) => !ok);
    pesca.textContent = primo === -1 ? "Tutti i controlli sono verdi! Rileggi tutto come farebbe una cliente, poi consegna." : SUGGERIMENTI[primo];
    return { l, esiti };
  }

  // Salvataggio automatico a ogni modifica
  function salva() {
    const { l } = aggiorna();
    aggiornaRuolo("seo", { stato: seo?.stato === "completato" ? "completato" : "in-corso", bozza: l });
    salvato.textContent = "Salvato in questo browser";
  }

  const form = $<HTMLFormElement>("#lavoro");
  form.addEventListener("input", salva);
  form.addEventListener("change", salva);
  aggiorna();

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const { l, esiti } = aggiorna();
    if (!l.titolo.trim() || !l.descrizione.trim() || !l.risposta.trim()) {
      pesca.textContent = "Prima di consegnare compila almeno titolo, descrizione e risposta breve.";
      (!l.titolo.trim() ? titolo : !l.descrizione.trim() ? descrizione : risposta).focus();
      return;
    }
    aggiornaRuolo("seo", { stato: seo?.stato === "completato" ? "completato" : "in-corso", bozza: l, consegna: { lavoro: l, controlli: esiti, data: new Date().toISOString() } });
    window.location.href = "/app/seo/correzione/";
  });
</script>

<style>
  .layout { display: grid; grid-template-columns: minmax(260px, 320px) minmax(0, 1fr) minmax(260px, 320px); gap: 18px; padding: 24px; align-items: start; }
  .sinistra, .destra { position: sticky; top: 84px; display: flex; flex-direction: column; gap: 12px; max-height: calc(100vh - 100px); overflow-y: auto; }
  .centro { min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .blocco { padding: 18px; display: flex; flex-direction: column; gap: 10px; line-height: 1.55; }
  .mittente { display: flex; align-items: center; gap: 10px; }
  .mittente > span:last-child { display: flex; flex-direction: column; }
  .riga { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .sottotitolo { font-family: var(--font-testo); font-size: 1rem; font-weight: 700; }
  .simulati { font-size: .7rem; font-weight: 700; background: #f3eeea; color: #6b5d55; padding: 3px 8px; border-radius: 999px; }
  .scheda-prodotto { margin: 0; display: flex; flex-direction: column; font-size: .85rem; }
  .scheda-prodotto div { display: grid; grid-template-columns: 96px 1fr; gap: 8px; padding: 7px 0; border-bottom: 1px solid #f3eeea; }
  .scheda-prodotto dt { color: #8a7b72; font-weight: 600; }
  .scheda-prodotto dd { margin: 0; }
  .nota { font-size: .8rem; color: #6b5d55; line-height: 1.5; }

  .intro { display: flex; flex-direction: column; gap: 8px; }
  h1 { font-size: 1.7rem; }
  .serp-attuale, .serp { border: 1px solid #eadfd6; border-radius: 12px; padding: 14px 16px; display: flex; flex-direction: column; gap: 3px; background: #fff; }
  .piccolo { font-size: .7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #8a7b72; margin-bottom: 4px; }
  .a-url { font-size: .8rem; color: #3d6b4a; overflow-wrap: anywhere; }
  .a-titolo { font-family: Arial, sans-serif; font-size: 20px; color: #1f45b8; line-height: 1.3; overflow-wrap: anywhere; }
  .a-ricco { font-size: .85rem; color: #4a4a4a; }
  .a-desc { font-size: .9rem; color: #4a4a4a; line-height: 1.45; overflow-wrap: anywhere; }

  .parte { padding: 22px 24px; display: flex; flex-direction: column; gap: 14px; scroll-margin-top: 84px; }
  .parte > p { line-height: 1.55; }
  .parte-testa { display: flex; align-items: center; gap: 12px; }
  .numero { width: 34px; height: 34px; border-radius: 10px; background: #fff1e6; color: #8a3a06; display: grid; place-items: center; font-weight: 800; }
  .parte-titolo { font-family: var(--font-titoli); font-size: 1.35rem; font-weight: 800; }
  .perche { font-size: .85rem; line-height: 1.55; background: #f7f4f1; border-radius: 12px; padding: 12px 14px; color: #3a2b24; }
  .scorri { overflow-x: auto; position: relative; }
  .scelta-cella label { position: relative; display: inline-block; }
  .intenti { width: 100%; border-collapse: collapse; font-size: .9rem; font-variant-numeric: tabular-nums; }
  .intenti thead th { font-size: .75rem; color: #8a7b72; font-weight: 700; padding: 8px 6px; border-bottom: 1px solid #eadfd6; text-align: center; white-space: nowrap; }
  .intenti thead th:first-child { text-align: left; }
  .intenti tbody th { text-align: left; font-weight: 600; padding: 10px 6px 10px 0; border-bottom: 1px solid #f3eeea; }
  .intenti td { border-bottom: 1px solid #f3eeea; padding: 6px; }
  .num { text-align: right; color: #5c4a42; }
