---
// PANNELLO DEL NEGOZIO (CMS finto, ispirato ai pannelli di WordPress o Shopify, con nomi generici)
// Qui chi gioca modifica davvero il sito: title, description, H1, testo delle categorie, visibilità sui motori
// di ricerca, reindirizzamenti. Le modifiche si vedono nel negozio, in Ispeziona e negli strumenti.
// Tutto resta salvato solo in questo browser (src/scripts/cms.ts).
import Console from "../../../../components/seopro/Console.astro";
import catalogo from "../../../../data/app/seo-pro/catalogo.json";
---
<Console attivo="pannello" titolo="Pannello del negozio" sottotitolo="Dove si modifica davvero cinquefoglie.example: pagine, reindirizzamenti e impostazioni del tema" ispirato="i pannelli di gestione dei negozi online (come WordPress o Shopify)">
  <div class="sp-schede" role="tablist" aria-label="Sezioni del pannello">
    <button type="button" role="tab" aria-selected="true" data-sezione="pagine">Pagine</button>
    <button type="button" role="tab" aria-selected="false" data-sezione="redirect">Reindirizzamenti</button>
    <button type="button" role="tab" aria-selected="false" data-sezione="tema">Tema e impostazioni</button>
  </div>

  <!-- PAGINE -->
  <section data-pannello-sezione="pagine" class="sezione">
    <div class="sp-pannello elenco-testa">
      <label for="cerca-pagine" class="sr">Cerca una pagina</label>
      <input id="cerca-pagine" class="sp-cerca" type="search" placeholder="Cerca una pagina, es. /te-verdi/" data-cerca-pagine />
      <span class="sp-nota">Clicca una pagina per modificarne i dati che legge Google.</span>
    </div>
    <div class="due">
      <div class="sp-scorri elenco"><table class="tabella-pagine"><thead><tr><th>Pagina</th><th>Stato</th></tr></thead><tbody data-righe-pagine></tbody></table></div>
      <form class="sp-pannello editor" data-editor hidden>
        <div class="editor-testa"><h2 data-editor-url></h2><a data-editor-apri target="_self">Apri nel negozio</a></div>
        <label class="campo">Title <span class="conta" data-conta-title></span>
          <input name="title" maxlength="140" autocomplete="off" />
          <span class="barra" aria-hidden="true"><span data-barra-title></span></span>
        </label>
        <label class="campo">Meta description <span class="conta" data-conta-desc></span>
          <textarea name="description" rows="3" maxlength="300"></textarea>
        </label>
        <label class="campo">H1 (il titolo grande nella pagina)
          <input name="h1" maxlength="120" autocomplete="off" />
        </label>
        <label class="campo" data-campo-intro>Testo introduttivo della categoria <span class="conta" data-conta-intro></span>
          <textarea name="intro" rows="8" maxlength="2000"></textarea>
          <span class="aiuto-campo">Puoi andare a capo per fare più paragrafi.</span>
        </label>
        <label class="campo">Visibilità sui motori di ricerca (meta robots)
          <select name="robots"><option value="">Come da tema</option><option value="index, follow">Visibile (index, follow)</option><option value="noindex, follow">Nascosta (noindex, follow)</option></select>
          <span class="aiuto-campo" data-nota-robots></span>
        </label>
        <div class="anteprima" aria-live="polite">
          <span class="anteprima-etichetta">Anteprima nei risultati di Google</span>
          <span class="a-url" data-ant-url></span>
          <span class="a-titolo" data-ant-titolo></span>
          <span class="a-desc" data-ant-desc></span>
        </div>
        <div class="azioni">
          <button type="submit" class="bottone-app">Salva le modifiche</button>
          <button type="button" class="bottone-app bottone-app--chiaro" data-annulla-pagina>Torna all'originale</button>
          <span class="salvato" data-salvato-pagina aria-live="polite"></span>
        </div>
      </form>
    </div>
  </section>

  <!-- REINDIRIZZAMENTI -->
  <section data-pannello-sezione="redirect" class="sezione" hidden>
    <form class="sp-pannello nuovo-redirect" data-nuovo-redirect>
      <h2 class="titoletto">Aggiungi o modifica un reindirizzamento 301</h2>
      <p class="sp-nota">Chi apre il primo indirizzo viene mandato al secondo. Se esiste già un reindirizzamento dallo stesso indirizzo, viene sostituito.</p>
      <div class="campi-riga">
        <label class="campo">Da (indirizzo vecchio)<input name="da" placeholder="/vecchia-pagina/" autocomplete="off" required /></label>
        <span class="freccia" aria-hidden="true">→</span>
        <label class="campo">A (pagina nuova)<input name="a" placeholder="/pagina-nuova/" autocomplete="off" required list="indirizzi-validi" /></label>
        <button type="submit" class="bottone-app">Salva il 301</button>
      </div>
      <datalist id="indirizzi-validi"></datalist>
      <p class="messaggio" data-msg-redirect aria-live="polite"></p>
    </form>
    <div class="sp-scorri"><table class="tabella-pagine"><thead><tr><th>Da</th><th>A</th><th>Tipo</th><th><span class="sr">Azioni</span></th></tr></thead><tbody data-righe-redirect></tbody></table></div>
  </section>

  <!-- TEMA -->
  <section data-pannello-sezione="tema" class="sezione" hidden>
    <div class="sp-pannello">
      <h2 class="titoletto">Categorie visibili sui motori di ricerca</h2>
      <p class="sp-nota">Se una categoria è nascosta, il tema mette il noindex sulla categoria e su tutti i suoi prodotti. Ultimo aggiornamento del tema: 18/09/2026.</p>
      <div class="interruttori" data-categorie>
        {catalogo.categorie.map((c) => (
          <label class="interruttore"><input type="checkbox" value={c.id} /><span class="int-nome">{c.nome}</span><span class="int-stato" data-stato-cat={c.id}></span></label>
        ))}
      </div>
    </div>
    <div class="sp-pannello">
      <h2 class="titoletto">Pagine filtrate (ordina, colore, materiale)</h2>
      <label class="interruttore"><input type="checkbox" data-canonical-filtri /><span class="int-nome">Canonical automatico verso la categoria</span></label>
      <p class="sp-nota">Le pagine come /te-verdi/?ordina=prezzo dicono a Google che la versione principale è /te-verdi/.</p>
    </div>
    <div class="sp-pannello pericolo">
      <h2 class="titoletto">Ricomincia da capo</h2>
      <p class="sp-nota">Annulla tutte le modifiche e riporta il negozio com'era all'inizio del percorso.</p>
      <button type="button" class="bottone-app bottone-app--chiaro" data-ripristina>Ripristina il negozio</button>
      <div class="sp-conferma" data-conferma hidden>
        <p><strong>Sicura?</strong> Perderai tutte le modifiche (title, testi, reindirizzamenti, tema).</p>
        <button type="button" class="bottone-app" data-conferma-si>Sì, ripristina</button>
        <button type="button" class="bottone-app bottone-app--chiaro" data-conferma-no>Annulla</button>
      </div>
      <p class="sp-nota" data-ripristinato role="status"></p>
    </div>
  </section>
</Console>

<script>
  import { leggiModifiche, salvaModifiche, ripristina, paginaEffettiva, pagineEffettive, pulisciUrl, introCategoria, type Modifiche } from "../../../../scripts/cms";
  import { pixel } from "../../../../scripts/controlli-seo";
  import catalogo from "../../../../data/app/seo-pro/catalogo.json";
  import crawl from "../../../../data/app/seo-pro/crawl.json";

  const $ = <T extends HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s)!;
  const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  const CATEGORIE = catalogo.categorie.map((c) => c.id);
  const modificabili = crawl.pagine.filter((p) => p.stato === 200 && !p.url.includes("?"));

  // ---- Schede
  document.querySelectorAll<HTMLButtonElement>("[data-sezione]").forEach((b) => b.addEventListener("click", () => mostraSezione(b.dataset.sezione!)));
  function mostraSezione(id: string) {
    document.querySelectorAll("[data-sezione]").forEach((x) => x.setAttribute("aria-selected", String((x as HTMLElement).dataset.sezione === id)));
    document.querySelectorAll<HTMLElement>("[data-pannello-sezione]").forEach((s) => (s.hidden = s.dataset.pannelloSezione !== id));
    history.replaceState(null, "", `#${id}`);
  }
  // Apre la sezione scritta dopo il # (es. dal link della guida); funziona anche se si è già nel pannello
  const daHash = () => { const h = location.hash.slice(1); if (h && document.querySelector(`[data-sezione="${h}"]`)) mostraSezione(h); };
  daHash();
  window.addEventListener("hashchange", daHash);

  // ---- Pagine
  let aperta = "";
  function righePagine() {
    const t = $<HTMLInputElement>("[data-cerca-pagine]").value.trim().toLowerCase();
    const m = leggiModifiche();
    $("[data-righe-pagine]").innerHTML = modificabili.filter((p) => !t || p.url.includes(t) || p.title.toLowerCase().includes(t)).map((b) => {
      const p = paginaEffettiva(b.url, m)!;
      const noindex = (p.robots ?? "").includes("noindex");
      return `<tr data-url="${esc(p.url)}" tabindex="0" class="${p.url === aperta ? "selezionata" : ""}"><td class="url"><span class="u">${esc(p.url)}</span><span class="tipo">${esc(p.tipo)}${p.modificata ? ' · <strong>modificata</strong>' : ""}</span></td><td>${noindex ? '<span class="sp-badge no">nascosta</span>' : '<span class="sp-badge ok">visibile</span>'}</td></tr>`;
    }).join("");
    document.querySelectorAll<HTMLTableRowElement>("[data-righe-pagine] tr").forEach((r) => {
      r.addEventListener("click", () => apri(r.dataset.url!));
      r.addEventListener("keydown", (e) => { if (e.key === "Enter") apri(r.dataset.url!); });
    });
  }
  $("[data-cerca-pagine]").addEventListener("input", righePagine);

  const form = $<HTMLFormElement>("[data-editor]");
  const campo = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
  function apri(url: string) {
    aperta = url;
    const m = leggiModifiche();
    const p = paginaEffettiva(url, m)!;
    const cat = CATEGORIE.find((c) => url === `/${c}/`);
    form.hidden = false;
    $("[data-editor-url]").textContent = url;
    ($("[data-editor-apri]") as HTMLAnchorElement).href = `/app/negozio${url}`;
    campo("title").value = p.title ?? "";
    campo("description").value = p.description ?? "";
    campo("h1").value = p.h1 ?? "";
    ($("[data-campo-intro]") as HTMLElement).hidden = !cat;
    campo("intro").value = cat ? introCategoria(cat, m) : "";
    (form.elements.namedItem("robots") as HTMLSelectElement).value = m.pagine[url]?.robots ?? "";
    const catDi = url.split("/")[1];
    $("[data-nota-robots]").textContent = CATEGORIE.includes(catDi)
      ? `"Come da tema": la categoria ${m.tema.nascoste.includes(catDi) ? "è nascosta" : "è visibile"} nelle impostazioni del tema (oggi: ${p.robots || "index, follow"}).`
      : `Oggi: ${p.robots || "index, follow"}.`;
    $("[data-salvato-pagina]").textContent = "";
    aggiornaAnteprima();
    righePagine();
    form.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }
  function aggiornaAnteprima() {
    const t = campo("title").value, d = campo("description").value, intro = campo("intro").value;
    const px = pixel(t);
    $("[data-conta-title]").textContent = `${t.length} caratteri, ${px} di 580 px`;
    const barra = $("[data-barra-title]"); barra.style.width = `${Math.min(100, (px / 580) * 100)}%`; barra.className = px > 580 ? "troppo" : "";
    $("[data-conta-desc]").textContent = `${d.length} caratteri (consigliati 120-160)`;
    $("[data-conta-intro]").textContent = `${intro.trim() ? intro.trim().split(/\s+/).length : 0} parole`;
    $("[data-ant-url]").textContent = `cinquefoglie.example${aperta.replace(/\/$/, "").replace(/\//g, " › ")}`;
    // Google taglia i title troppo lunghi con "..."
    let vis = t; while (pixel(vis + "…") > 580 && vis.length) vis = vis.slice(0, -1);
    $("[data-ant-titolo]").textContent = pixel(t) > 580 ? vis.trimEnd() + "…" : t || "(title vuoto)";
    $("[data-ant-desc]").textContent = d.length > 160 ? d.slice(0, 157).trimEnd() + "…" : d || "(Google sceglierà un pezzo di testo della pagina)";
  }
  form.addEventListener("input", aggiornaAnteprima);
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const m = leggiModifiche();
    const base = crawl.pagine.find((p) => p.url === aperta)!;
    const cat = CATEGORIE.find((c) => aperta === `/${c}/`);
    const nuovi: Record<string, string> = {};
    for (const k of ["title", "description", "h1"]) { const v = campo(k).value.trim(); if (v !== ((base as any)[k] ?? "")) nuovi[k] = v; }
    if (cat) { const v = campo("intro").value.trim(); const orig = catalogo.categorie.find((c) => c.id === cat)!.intro; if (v !== orig) nuovi.intro = v; }
    const r = (form.elements.namedItem("robots") as HTMLSelectElement).value; if (r) nuovi.robots = r;
    if (Object.keys(nuovi).length) m.pagine[aperta] = nuovi; else delete m.pagine[aperta];
    salvaModifiche(m);
    $("[data-salvato-pagina]").textContent = "Salvato: la modifica è già online nel negozio.";
    righePagine();
  });
  $("[data-annulla-pagina]").addEventListener("click", () => {
    const m = leggiModifiche(); delete m.pagine[aperta]; salvaModifiche(m); apri(aperta);
    $("[data-salvato-pagina]").textContent = "Pagina riportata all'originale.";
  });

  // ---- Reindirizzamenti
  const validi = pagineEffettive().filter((p) => p.stato === 200 && !p.url.includes("?")).map((p) => p.url);
  $("#indirizzi-validi").innerHTML = validi.map((u) => `<option value="${esc(u)}"></option>`).join("");
  function righeRedirect() {
    const m = leggiModifiche();
    const voci = Object.entries(m.redirect);
    $("[data-righe-redirect]").innerHTML = voci.length ? voci.map(([da, a]) => {
      const catenaLunga = m.redirect[a] ? ' <span class="sp-badge medio">catena: anche questo rimanda</span>' : "";
      return `<tr><td class="url">${esc(da)}</td><td class="url">${esc(a)}${catenaLunga}</td><td>301</td><td class="n"><button type="button" class="piccolo" data-modifica="${esc(da)}">Modifica</button> <button type="button" class="piccolo" data-elimina="${esc(da)}">Elimina</button></td></tr>`;
    }).join("") : `<tr><td colspan="4">Nessun reindirizzamento.</td></tr>`;
    document.querySelectorAll<HTMLButtonElement>("[data-elimina]").forEach((b) => b.addEventListener("click", () => {
      const m2 = leggiModifiche(); delete m2.redirect[b.dataset.elimina!]; salvaModifiche(m2); righeRedirect();
      $("[data-msg-redirect]").textContent = `Reindirizzamento da ${b.dataset.elimina} eliminato.`;
    }));
    document.querySelectorAll<HTMLButtonElement>("[data-modifica]").forEach((b) => b.addEventListener("click", () => {
      const f = $<HTMLFormElement>("[data-nuovo-redirect]");
      (f.elements.namedItem("da") as HTMLInputElement).value = b.dataset.modifica!;
      (f.elements.namedItem("a") as HTMLInputElement).value = leggiModifiche().redirect[b.dataset.modifica!];
      (f.elements.namedItem("a") as HTMLInputElement).focus();
    }));
  }
  $<HTMLFormElement>("[data-nuovo-redirect]").addEventListener("submit", (e) => {
    e.preventDefault();
    const f = e.currentTarget as HTMLFormElement;
    const da = pulisciUrl((f.elements.namedItem("da") as HTMLInputElement).value);
    const a = pulisciUrl((f.elements.namedItem("a") as HTMLInputElement).value);
    const msg = $("[data-msg-redirect]");
    if (!da || !a) { msg.textContent = "Scrivi tutti e due gli indirizzi."; return; }
    if (da === a) { msg.textContent = "Un indirizzo non può rimandare a sé stesso."; return; }
    const m = leggiModifiche();
    m.redirect[da] = a;
    salvaModifiche(m);
    const dest = paginaEffettiva(a, m);
    msg.textContent = !dest ? `Salvato, ma attenzione: ${a} non esiste nel negozio.` : dest.stato !== 200 ? `Salvato, ma attenzione: ${a} non è una pagina che funziona (stato ${dest.stato}).` : `Salvato: chi apre ${da} ora arriva su ${a}.`;
    f.reset();
    righeRedirect();
  });

  // ---- Tema
  function mostraTema() {
    const m = leggiModifiche();
    document.querySelectorAll<HTMLInputElement>("[data-categorie] input").forEach((i) => {
      i.checked = !m.tema.nascoste.includes(i.value);
      $(`[data-stato-cat="${i.value}"]`).textContent = i.checked ? "visibile" : "nascosta ai motori di ricerca";
    });
    $<HTMLInputElement>("[data-canonical-filtri]").checked = m.tema.canonicalFiltri;
  }
  document.querySelectorAll<HTMLInputElement>("[data-categorie] input").forEach((i) => i.addEventListener("change", () => {
    const m = leggiModifiche();
    m.tema.nascoste = m.tema.nascoste.filter((x) => x !== i.value);
    if (!i.checked) m.tema.nascoste.push(i.value);
    salvaModifiche(m); mostraTema(); righePagine();
  }));
  $<HTMLInputElement>("[data-canonical-filtri]").addEventListener("change", (e) => {
    const m: Modifiche = leggiModifiche(); m.tema.canonicalFiltri = (e.currentTarget as HTMLInputElement).checked; salvaModifiche(m);
  });
  // Ripristino in due passi: prima si chiede conferma nella pagina (niente finestre del browser)
  const conferma = $("[data-conferma]"), btnRip = $("[data-ripristina]");
  btnRip.addEventListener("click", () => { conferma.hidden = false; btnRip.hidden = true; $("[data-conferma-no]").focus(); });
  $("[data-conferma-no]").addEventListener("click", () => { conferma.hidden = true; btnRip.hidden = false; btnRip.focus(); });
  $("[data-conferma-si]").addEventListener("click", () => {
    ripristina(); mostraTema(); righePagine(); righeRedirect(); form.hidden = true;
    conferma.hidden = true; btnRip.hidden = false;
    $("[data-ripristinato]").textContent = "Fatto: il negozio è tornato com'era all'inizio.";
  });

  righePagine(); righeRedirect(); mostraTema();
  // Si può aprire direttamente una pagina: /app/percorsi/seo/pannello/?pagina=/te-verdi/
  const daAprire = new URLSearchParams(location.search).get("pagina");
  if (daAprire && modificabili.some((p) => p.url === daAprire)) apri(daAprire);
</script>

<style>
  .sezione { display: flex; flex-direction: column; gap: 20px; }
  .elenco-testa { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; }
  .due { display: grid; grid-template-columns: minmax(260px, 1fr) minmax(0, 1.4fr); gap: 20px; align-items: start; }
  .elenco { max-height: 640px; overflow-y: auto; }
  .tabella-pagine :global(td.url .u) { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 30ch; }
  .tabella-pagine :global(td.url .tipo) { display: block; font-family: var(--font-testo); font-size: .75rem; color: #6b6660; margin-top: 2px; }
  .tabella-pagine :global(td.url .tipo strong) { color: #b4530a; font-weight: 600; }
  .tabella-pagine { width: 100%; border-collapse: collapse; font-size: .86rem; }
  .tabella-pagine th { text-align: left; font-size: .75rem; color: #5f5a55; padding: 10px 12px; border-bottom: 1px solid #e3e1dc; background: #f8f8f6; position: sticky; top: 0; }
  .tabella-pagine td { padding: 10px 12px; border-bottom: 1px solid #efeeeb; vertical-align: top; }
  .tabella-pagine :global(tr[data-url]) { cursor: pointer; }
  .tabella-pagine :global(tr[data-url]:hover), .tabella-pagine :global(tr.selezionata) { background: #efeeea; }
  .editor { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 80px; }
  .editor-testa { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .editor-testa h2 { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 1rem; }
  .editor-testa a { font-weight: 700; font-size: .88rem; }
  .campo { display: flex; flex-direction: column; gap: 6px; font-weight: 700; font-size: .88rem; }
  .campo input, .campo textarea, .campo select { font: inherit; font-weight: 400; font-size: .95rem; padding: 10px 12px; border: 1.5px solid #d1cec8; border-radius: 10px; background: #fff; color: var(--inchiostro); }
  .campo textarea { resize: vertical; line-height: 1.5; }
  .campo input:focus-visible, .campo textarea:focus-visible, .campo select:focus-visible { outline: 3px solid var(--inchiostro); outline-offset: 1px; border-color: var(--arancio); }
  .conta, .aiuto-campo { font-weight: 400; font-size: .78rem; color: #5f5a55; }
  .barra { height: 5px; background: #e9e8e4; border-radius: 99px; overflow: hidden; }
  .barra span { display: block; height: 100%; width: 0; background: #2f7a4f; } .barra span.troppo { background: #b3261e; }
  .anteprima { background: #f8f8f6; border-radius: 12px; padding: 14px 16px; display: flex; flex-direction: column; gap: 3px; font-family: Arial, sans-serif; }
  .anteprima-etichetta { font-family: var(--font-testo); font-size: .75rem; font-weight: 700; color: #5f5a55; margin-bottom: 4px; }
  .a-url { font-size: .8rem; color: #202124; } .a-titolo { font-size: 1.2rem; color: #1a0dab; line-height: 1.3; } .a-desc { font-size: .88rem; color: #4d5156; line-height: 1.45; }
  .azioni { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .salvato, .messaggio { font-size: .85rem; font-weight: 600; color: #1f5c38; margin: 0; }
  .titoletto { font-family: var(--font-titoli); font-size: 1.15rem; font-weight: 800; margin: 0 0 6px; }
  .nuovo-redirect { display: flex; flex-direction: column; gap: 10px; }
  .campi-riga { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; }
  .campi-riga .campo { flex: 1 1 220px; }
  .freccia { padding-bottom: 12px; font-weight: 800; }
  .piccolo { font: inherit; font-size: .8rem; font-weight: 700; padding: 6px 10px; border-radius: 8px; border: 1px solid #d1cec8; background: #fff; cursor: pointer; }
