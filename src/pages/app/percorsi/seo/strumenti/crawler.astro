---
// STRUMENTO · CRAWLER: ispirato a Screaming Frog SEO Spider
// Elenca tutti gli indirizzi trovati seguendo i link del sito, con stato, indicizzabilità, title (anche in pixel),
// description, H1, canonical, parole, link in entrata, LCP. I filtri raggruppano i problemi per tipo.
// Cliccando un indirizzo si vedono i dettagli: chi lo linka (per i 404) e la catena di redirect.
// Dati: src/data/app/seo-pro/crawl.json (generati da strumenti-dati/genera_negozio.py).
import Console from "../../../../../components/seopro/Console.astro";
import crawl from "../../../../../data/app/seo-pro/crawl.json";
import { num } from "../../../../../scripts/tabella";

const FILTRI = [
  ["tutti", "Tutti"], ["4xx", "Errori 4xx"], ["3xx", "Redirect 3xx"], ["noindex", "Non indicizzabili"], ["title-dup", "Title duplicati"],
  ["title-lungo", "Title oltre 580 px"], ["desc-manca", "Description mancante"], ["h1-manca", "H1 mancante"], ["poche-parole", "Meno di 200 parole"], ["lcp", "LCP oltre 2,5 s"],
];
---
<Console attivo="crawler" titolo="Crawler" ispirato="Screaming Frog SEO Spider">
  <div class="sp-pannello comandi">
    <span>Scansione di <strong class="url">https://cinquefoglie.example/</strong> · {crawl.data.split("-").reverse().join("/")} · {crawl.pagine.length} indirizzi</span>
    <input class="sp-cerca" type="search" placeholder="Filtra gli indirizzi…" data-testo />
  </div>
  <div class="filtri" role="group" aria-label="Filtra per problema">
    {FILTRI.map(([id, nome], i) => <button type="button" class="filtro" data-filtro={id} aria-pressed={i === 0 ? "true" : "false"}>{nome} <span class="conta" data-conta={id}></span></button>)}
  </div>

  <div class="sp-scorri">
    <table data-tabella id="t-crawl">
      <thead><tr>
        <th data-ordina="testo">Indirizzo</th><th data-ordina="testo">Tipo</th><th data-ordina="numero" class="n">Stato</th><th data-ordina="testo">Indicizzabile</th>
        <th data-ordina="testo">Title</th><th data-ordina="numero" class="n">Title px</th><th data-ordina="numero" class="n">Descr. car.</th><th data-ordina="testo">H1</th>
        <th data-ordina="numero" class="n">Parole</th><th data-ordina="numero" class="n">Link entrata</th><th data-ordina="numero" class="n">LCP</th>
      </tr></thead>
      <tbody>
        {crawl.pagine.map((p, i) => (
          <tr data-i={i} tabindex="0">
            <td class="url">{p.url}</td>
            <td>{p.tipo}</td>
            <td class="n" data-valore={p.stato}><span class:list={["sp-badge", p.stato === 200 ? "ok" : p.stato === 404 ? "no" : "medio"]}>{p.stato}</span></td>
            <td>{p.indicizzabile ? <span class="sp-badge ok">Sì</span> : <span class="sp-badge no">No · {p.motivo}</span>}</td>
            <td class="title" data-title={p.title}>{p.title || <em>—</em>}</td>
            <td class="n" data-px></td>
            <td class="n" data-valore={p.description.length}>{p.stato === 200 ? (p.description ? p.description.length : <span class="sp-badge no">manca</span>) : ""}</td>
            <td>{p.stato === 200 ? (p.h1 || <span class="sp-badge no">manca</span>) : ""}</td>
            <td class="n" data-valore={p.parole}>{p.parole ? num(p.parole) : ""}</td>
            <td class="n" data-valore={p.inlinks}>{p.inlinks}</td>
            <td class="n" data-valore={p.lcp ?? 0}>{p.lcp ? `${num(p.lcp, 1)} s` : ""}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="dettaglio sp-pannello" data-dettaglio hidden></div>

  <details class="sp-pannello aiuto">
    <summary>Come funziona un crawler</summary>
    <p>Un crawler fa quello che fa Google: parte dalla home e segue tutti i link, pagina dopo pagina, annotando cosa trova. <strong>Stato</strong>: 200 la pagina esiste, 301 reindirizza a un'altra, 404 non esiste. <strong>Indicizzabile</strong>: se Google può metterla nei risultati (non lo è se ha "noindex", se reindirizza o se il canonical indica un'altra pagina). <strong>Link in entrata</strong>: quante pagine del sito la linkano. I title si misurano in pixel: oltre circa 580 px Google li taglia.</p>
  </details>
</Console>

<script>
  import crawl from "../../../../../data/app/seo-pro/crawl.json";
  import { attivaTabelle, num } from "../../../../../scripts/tabella";
  import { pixel } from "../../../../../scripts/controlli-seo";

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const righe = [...document.querySelectorAll<HTMLTableRowElement>("#t-crawl tbody tr")];
  // Larghezza dei title in pixel (come nell'esercizio SEO) e title ripetuti su più pagine
  const contaTitle: Record<string, number> = {};
  crawl.pagine.forEach((p) => { if (p.stato === 200 && p.title) contaTitle[p.title] = (contaTitle[p.title] ?? 0) + 1; });
  righe.forEach((r) => {
    const p = crawl.pagine[Number(r.dataset.i)];
    const cella = r.querySelector<HTMLElement>("[data-px]")!;
    if (p.stato === 200 && p.title) {
      const px = pixel(p.title);
      cella.dataset.valore = String(px);
      cella.innerHTML = px > 580 ? `<span class="sp-badge no">${px}</span>` : String(px);
      r.dataset.px = String(px);
    } else cella.dataset.valore = "0";
    if (p.stato === 200 && contaTitle[p.title] > 1) r.querySelector<HTMLElement>(".title")!.insertAdjacentHTML("beforeend", ` <span class="sp-badge medio">${contaTitle[p.title]} uguali</span>`);
  });
  attivaTabelle();

  const prova: Record<string, (p: (typeof crawl.pagine)[number], r: HTMLTableRowElement) => boolean> = {
    tutti: () => true,
    "4xx": (p) => p.stato >= 400,
    "3xx": (p) => p.stato >= 300 && p.stato < 400,
    noindex: (p) => !p.indicizzabile,
    "title-dup": (p) => p.stato === 200 && contaTitle[p.title] > 1,
    "title-lungo": (_p, r) => Number(r.dataset.px ?? 0) > 580,
    "desc-manca": (p) => p.stato === 200 && !p.description,
    "h1-manca": (p) => p.stato === 200 && !p.h1,
    "poche-parole": (p) => p.stato === 200 && p.parole < 200,
    lcp: (p) => (p.lcp ?? 0) > 2.5,
  };
  let filtro = "tutti";
  function applica() {
    const t = $<HTMLInputElement>("[data-testo]").value.trim().toLowerCase();
    righe.forEach((r) => { const p = crawl.pagine[Number(r.dataset.i)]; r.hidden = !prova[filtro](p, r) || (!!t && !p.url.toLowerCase().includes(t)); });
  }
  document.querySelectorAll<HTMLButtonElement>("[data-filtro]").forEach((b) => {
    const id = b.dataset.filtro!;
    b.querySelector("[data-conta]")!.textContent = String(righe.filter((r) => prova[id](crawl.pagine[Number(r.dataset.i)], r)).length);
    b.addEventListener("click", () => {
      filtro = id;
      document.querySelectorAll("[data-filtro]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      applica();
    });
  });
  $("[data-testo]").addEventListener("input", applica);

  // Dettaglio di un indirizzo
  const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;");
  function catena(url: string) {
    const passi = [url];
    let p = crawl.pagine.find((x) => x.url === url);
    while (p && p.redirect && passi.length < 6) { passi.push(p.redirect); p = crawl.pagine.find((x) => x.url === p!.redirect); }
    return passi;
  }
  const dett = $("[data-dettaglio]");
  function apri(r: HTMLTableRowElement) {
    righe.forEach((x) => x.classList.remove("selezionata"));
    r.classList.add("selezionata");
    const p = crawl.pagine[Number(r.dataset.i)];
    const voci: [string, string][] = [
      ["Indirizzo", `<span class="url">${esc(p.url)}</span>`], ["Tipo", p.tipo], ["Stato", String(p.stato)],
      ["Indicizzabile", p.indicizzabile ? "Sì" : `No · ${p.motivo}`],
    ];
    if (p.stato === 200) voci.push(["Title", esc(p.title) + (r.dataset.px ? ` (${r.dataset.px} px)` : "")], ["Meta description", p.description ? `${esc(p.description)} (${p.description.length} caratteri)` : "manca"],
      ["H1", p.h1 ? esc(p.h1) : "manca"], ["Meta robots", p.robots], ["Canonical", p.canonical ? `<span class="url">${esc(p.canonical)}</span>` : "manca"], ["Parole", num(p.parole)],
      ["Profondità", `${p.profondita} clic dalla home`], ...(p.lcp ? [["LCP (laboratorio)", `${num(p.lcp, 1)} s · peso della pagina ${num(p.peso ?? 0)} KB`] as [string, string]] : []));
    if (p.redirect) voci.push(["Catena di redirect", catena(p.url).map((u) => `<span class="url">${esc(u)}</span>`).join(" → ") + ` (${catena(p.url).length - 1} salti)`]);
    const linkanti = (crawl.link404 as Record<string, string[]>)[p.url];
    if (linkanti) voci.push(["Linkata da", linkanti.map((u) => `<span class="url">${esc(u)}</span>`).join("<br>")]);
    if (p.note) voci.push(["Nota", esc(p.note)]);
    dett.hidden = false;
    dett.innerHTML = `<strong>Dettagli dell'indirizzo</strong><dl>${voci.map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`).join("")}</dl>` +
      (p.stato === 200 ? `<a href="/app/negozio${p.url.split("?")[0]}">Apri la pagina nel negozio →</a>` : "");
    dett.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }
  righe.forEach((r) => { r.addEventListener("click", () => apri(r)); r.addEventListener("keydown", (e) => { if (e.key === "Enter") apri(r); }); });
</script>

<style>
  .comandi { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; justify-content: space-between; font-size: .85rem; color: #55514c; }
  .filtri { display: flex; flex-wrap: wrap; gap: 6px; }
  .filtro { font: inherit; font-size: .82rem; font-weight: 700; padding: 7px 11px; border-radius: 999px; border: 1px solid #d1cec8; background: #fff; cursor: pointer; }
  .filtro[aria-pressed="true"] { background: var(--inchiostro); color: #fff; border-color: var(--inchiostro); }
  .conta { font-variant-numeric: tabular-nums; opacity: .75; }
  .sp-scorri { max-height: 560px; overflow: auto; }
  tr[data-i] { cursor: pointer; }
  .title { min-width: 220px; }
  #t-crawl td.url { white-space: nowrap; }
  .dettaglio { border: 2px solid var(--arancio); background: #f8f8f6; display: flex; flex-direction: column; gap: 10px; }
  .dettaglio :global(dl) { margin: 0; display: flex; flex-direction: column; gap: 6px; font-size: .85rem; }
  .dettaglio :global(dl div) { display: grid; grid-template-columns: 160px 1fr; gap: 10px; }
  .dettaglio :global(dt) { color: #5f5a55; font-weight: 700; }
  .dettaglio :global(dd) { margin: 0; overflow-wrap: anywhere; }
  .aiuto summary { cursor: pointer; font-weight: 700; }
  .aiuto p { margin: 10px 0 0; line-height: 1.6; font-size: .9rem; }
  @media (max-width: 700px) { .dettaglio :global(dl div) { grid-template-columns: 1fr; gap: 2px; } }
</style>
