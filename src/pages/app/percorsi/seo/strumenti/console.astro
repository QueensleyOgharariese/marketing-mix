---
// STRUMENTO · CONSOLE DI RICERCA (rendimento): ispirata al rapporto "Risultati di ricerca" di Google Search Console
// Grafico di 16 mesi (clic, impressioni, CTR, posizione), filtro per parte del sito, confronto con l'anno prima,
// tabelle di query e pagine. Cliccando una query si vedono le pagine che compaiono per quella ricerca.
// Dati: src/data/app/seo-pro/search-console.json (generati da strumenti-dati/genera_negozio.py).
import Console from "../../../../../components/seopro/Console.astro";
import sc from "../../../../../data/app/seo-pro/search-console.json";
import { num } from "../../../../../scripts/tabella";
const segmenti = Object.entries(sc.segmenti);
---
<Console attivo="console" titolo="Console di ricerca" sottotitolo="Come appare cinquefoglie.example nei risultati di Google" ispirato="Google Search Console (rapporto Risultati di ricerca)">
  <div class="sp-pannello comandi">
    <label>Proprietà <strong class="url">{sc.proprieta}</strong></label>
    <label>Parte del sito
      <select class="sp-scegli" data-segmento>
        <option value="tutto">Tutto il sito</option>
        {segmenti.map(([id, nome]) => <option value={id}>{nome}</option>)}
      </select>
    </label>
    <label>Periodo
      <select class="sp-scegli" data-periodo>
        <option value="3">Ultimi 3 mesi</option>
        <option value="6">Ultimi 6 mesi</option>
        <option value="12">Ultimi 12 mesi</option>
        <option value="16" selected>Ultimi 16 mesi</option>
      </select>
    </label>
    <label class="spunta"><input type="checkbox" data-confronta /> Confronta con l'anno prima</label>
  </div>

  <div class="sp-cifre" role="group" aria-label="Metriche da mostrare nel grafico">
    {[["clic", "Clic totali"], ["impressioni", "Impressioni totali"], ["ctr", "CTR medio"], ["posizione", "Posizione media"]].map(([id, nome], i) => (
      <button type="button" class:list={["metrica", `m-${id}`]} data-metrica={id} aria-pressed={i < 2 ? "true" : "false"}>
        <span>{nome}</span><strong data-valore={id}>–</strong><small data-variazione={id}></small>
      </button>
    ))}
  </div>

  <div class="sp-pannello">
    <svg class="sp-grafico" data-grafico viewBox="0 0 900 260" role="img" aria-label="Andamento mensile"></svg>
    <p class="evento" data-evento hidden><span class="evento-n" aria-hidden="true">1</span><span><strong>18 settembre 2026:</strong> il team web ha pubblicato il nuovo tema del negozio.</span></p>
    <p class="sp-nota" data-legenda></p>
  </div>

  <section class="sp-pannello controllo-url" aria-labelledby="t-controllo">
    <h2 id="t-controllo" class="titoletto">Controllo URL</h2>
    <p class="sp-nota">Scrivi un indirizzo per vedere com'è su Google e com'è sul sito adesso. Dopo una modifica puoi chiedere a Google di rileggere la pagina.</p>
    <form class="url-riga" data-controllo-url>
      <label for="url-da-controllare" class="sr">Indirizzo da controllare</label>
      <input id="url-da-controllare" class="sp-cerca" name="url" placeholder="/te-verdi/" autocomplete="off" />
      <button type="submit" class="bottone-app">Controlla</button>
    </form>
    <div class="url-esito" data-url-esito hidden></div>
  </section>

  <div class="sp-pannello tabelle">
    <div class="sp-riga">
      <div class="sp-schede" role="tablist">
        <button type="button" role="tab" aria-selected="true" data-scheda="query">Query</button>
        <button type="button" role="tab" aria-selected="false" data-scheda="pagine">Pagine</button>
      </div>
      <span class="sp-nota">Periodo delle tabelle: {sc.periodoQuery}</span>
    </div>
    <div data-pannello="query">
      <div class="sp-riga barra-tab"><input class="sp-cerca" type="search" placeholder="Filtra le query…" data-filtra="t-query" /><span class="sp-nota">Clicca una query per vedere quali pagine compaiono.</span></div>
      <div class="sp-scorri">
        <table data-tabella id="t-query">
          <thead><tr><th data-ordina="testo">Query</th><th data-ordina="numero" class="n">Clic</th><th data-ordina="numero" class="n">Impressioni</th><th data-ordina="numero" class="n">CTR</th><th data-ordina="numero" class="n">Posizione</th><th data-ordina="numero" class="n">Pagine</th></tr></thead>
          <tbody>
            {sc.query.map((q, i) => (
              <tr data-query={i} tabindex="0">
                <td>{q.query}</td>
                <td class="n" data-valore={q.clic}>{num(q.clic)}</td>
                <td class="n" data-valore={q.impressioni}>{num(q.impressioni)}</td>
                <td class="n" data-valore={q.ctr}>{num(q.ctr, 1)}%</td>
                <td class="n" data-valore={q.posizione}>{num(q.posizione, 1)}</td>
                <td class="n" data-valore={q.pagine.length}>{q.pagine.length > 1 ? <span class="sp-badge medio">{q.pagine.length} pagine</span> : "1"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="dettaglio" data-dettaglio hidden></div>
    </div>
    <div data-pannello="pagine" hidden>
      <div class="sp-riga barra-tab"><input class="sp-cerca" type="search" placeholder="Filtra le pagine…" data-filtra="t-pagine" /></div>
      <div class="sp-scorri">
        <table data-tabella id="t-pagine">
          <thead><tr><th data-ordina="testo">Pagina</th><th data-ordina="numero" class="n">Clic</th><th data-ordina="numero" class="n">Impressioni</th><th data-ordina="numero" class="n">CTR</th><th data-ordina="numero" class="n">Posizione</th></tr></thead>
          <tbody>
            {sc.pagine.map((p) => (
              <tr>
                <td class="url"><a href={`/app/negozio${p.url}`}>{p.url}</a></td>
                <td class="n" data-valore={p.clic}>{num(p.clic)}</td>
                <td class="n" data-valore={p.impressioni}>{num(p.impressioni)}</td>
                <td class="n" data-valore={p.ctr}>{num(p.ctr, 1)}%</td>
                <td class="n" data-valore={p.posizione}>{num(p.posizione, 1)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <details class="sp-pannello aiuto">
    <summary>Come si leggono questi numeri</summary>
    <p><strong>Impressioni</strong>: quante volte una pagina è comparsa nei risultati. <strong>Clic</strong>: quante volte qualcuno ci ha cliccato. <strong>CTR</strong>: clic ÷ impressioni. <strong>Posizione</strong>: la posizione media nei risultati (1 = primo). Una pagina con tante impressioni e un CTR basso spesso ha un titolo o una descrizione poco convincenti. Per capire se un calo è normale, confronta con lo stesso mese dell'anno prima: molti prodotti hanno una stagione.</p>
  </details>
</Console>

<script>
  import sc from "../../../../../data/app/seo-pro/search-console.json";
  import { attivaTabelle, num } from "../../../../../scripts/tabella";
  attivaTabelle();

  type Mese = (typeof sc.mesi)[number] & Record<string, any>;
  // CTR e posizione tipici di ogni parte del sito (dal file dei dati): servono per ricavare impressioni e posizione per segmento
  const BASI = sc.basi as Record<string, { ctr: number; posizione: number }>;
  const CTR = (seg: string) => BASI[seg].ctr;
  const POS = (seg: string) => BASI[seg].posizione;

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const MESI_NOMI = ["gen", "feb", "mar", "apr", "mag", "giu", "lug", "ago", "set", "ott", "nov", "dic"];
  const etichetta = (m: string) => `${MESI_NOMI[Number(m.slice(5)) - 1]} ${m.slice(2, 4)}`;

  // Valori di un mese per la parte del sito scelta
  function valori(m: Mese, seg: string) {
    if (seg === "tutto") return { clic: m.clic, impressioni: m.impressioni, ctr: m.ctr, posizione: m.posizione };
    const c = m[seg] as number;
    const imp = Math.round(c / CTR(seg));
    return { clic: c, impressioni: imp, ctr: Math.round((c / imp) * 1000) / 10, posizione: POS(seg) };
  }
  function somma(mesi: Mese[], seg: string) {
    const v = mesi.map((m) => valori(m, seg));
    const clic = v.reduce((s, x) => s + x.clic, 0), imp = v.reduce((s, x) => s + x.impressioni, 0);
    const pos = v.reduce((s, x) => s + x.posizione * x.impressioni, 0) / imp;
    return { clic, impressioni: imp, ctr: (clic / imp) * 100, posizione: pos };
  }

  const COLORI: Record<string, string> = { clic: "#2f6fd6", impressioni: "#7b4bd1", ctr: "#1f8a5b", posizione: "#d9822b" };
  // Eventi annotati sul grafico (come le annotazioni che i team SEO aggiungono negli strumenti veri)
  const EVENTI = [{ mese: "2026-09", giorno: 18, n: 1 }];
  function disegna() {
    const seg = $<HTMLSelectElement>("[data-segmento]").value;
    const n = Number($<HTMLSelectElement>("[data-periodo]").value);
    const confronta = $<HTMLInputElement>("[data-confronta]").checked && n <= 4;
    $<HTMLInputElement>("[data-confronta]").disabled = n > 4;
    const tutti = sc.mesi as Mese[];
    const mesi = tutti.slice(-n);
    const prima = confronta ? tutti.slice(-n - 12, -12) : [];
    // Cifre in alto
    const ora = somma(mesi, seg);
    const prec = confronta && prima.length === mesi.length ? somma(prima, seg) : null;
    const formato = { clic: (x: number) => num(x), impressioni: (x: number) => num(x), ctr: (x: number) => `${num(x, 1)}%`, posizione: (x: number) => num(x, 1) };
    for (const k of ["clic", "impressioni", "ctr", "posizione"] as const) {
      $(`[data-valore="${k}"]`).textContent = formato[k](ora[k]);
      const el = $(`[data-variazione="${k}"]`);
      if (prec) {
        const d = k === "posizione" ? ora[k] - prec[k] : (ora[k] / prec[k] - 1) * 100;
        const buono = k === "posizione" ? d < 0 : d > 0;
        el.textContent = k === "posizione" ? `${d > 0 ? "+" : ""}${num(d, 1)} rispetto all'anno prima` : `${d > 0 ? "+" : ""}${num(d, 0)}% rispetto all'anno prima`;
        el.className = buono ? "su" : "giu";
      } else el.textContent = "";
    }
    // Grafico: una linea per ogni metrica attiva, ognuna con la sua scala
    const attive = [...document.querySelectorAll<HTMLButtonElement>("[data-metrica][aria-pressed=true]")].map((b) => b.dataset.metrica as keyof ReturnType<typeof valori>);
    const W = 900, H = 260, sx = 40, dx = 20, su = 20, giu = 36;
    const x = (i: number) => sx + (i * (W - sx - dx)) / Math.max(1, mesi.length - 1);
    let svg = "";
    for (let g = 0; g <= 4; g++) { const y = su + (g * (H - su - giu)) / 4; svg += `<line x1="${sx}" x2="${W - dx}" y1="${y}" y2="${y}" stroke="#e9e8e4"/>`; }
    mesi.forEach((m, i) => { if (mesi.length <= 12 || i % 2 === 0) svg += `<text x="${x(i)}" y="${H - 12}" font-size="12" text-anchor="middle" fill="#6f6a64">${etichetta(m.mese)}</text>`; });
    for (const k of attive) {
      const serie = mesi.map((m) => valori(m, seg)[k]);
      const serieP = prima.map((m) => valori(m, seg)[k]);
      // scala tra il valore più basso e il più alto (con un po' di margine), così le variazioni si vedono
      const tuttiV = [...serie, ...serieP];
      const lo = Math.min(...tuttiV), hi = Math.max(...tuttiV);
      const pad = (hi - lo) * 0.15 || hi * 0.1 || 1;
      const min = Math.max(0, lo - pad), max = hi + pad;
      const frac = (v: number) => (v - min) / (max - min);
      const y = (v: number) => (k === "posizione" ? su + frac(v) * (H - su - giu) : H - giu - frac(v) * (H - su - giu));
      const linea = (s: number[]) => s.map((v, i) => `${i ? "L" : "M"}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(" ");
      if (serieP.length) svg += `<path d="${linea(serieP)}" fill="none" stroke="${COLORI[k]}" stroke-width="2" stroke-dasharray="5 5" opacity=".6"/>`;
      svg += `<path d="${linea(serie)}" fill="none" stroke="${COLORI[k]}" stroke-width="3" stroke-linejoin="round"/>`;
      serie.forEach((v, i) => { svg += `<circle cx="${x(i)}" cy="${y(v)}" r="3.5" fill="${COLORI[k]}"><title>${etichetta(mesi[i].mese)}: ${formato[k](v)}</title></circle>`; });
    }
    // Eventi: una linea tratteggiata arancione nel punto del mese in cui sono successi
    let eventiVisibili = 0;
    for (const ev of EVENTI) {
      const i = mesi.findIndex((m) => m.mese === ev.mese);
      if (i < 0) continue;
      eventiVisibili++;
      const passo = mesi.length > 1 ? (W - sx - dx) / (mesi.length - 1) : 0;
      const xe = x(i) + passo * ((ev.giorno - 15) / 30);
      svg += `<line x1="${xe}" x2="${xe}" y1="${su}" y2="${H - giu}" stroke="#ff7a1a" stroke-width="1.5" stroke-dasharray="4 4"/><circle cx="${xe}" cy="${su}" r="9" fill="#ff7a1a"/><text x="${xe}" y="${su + 4}" font-size="11" font-weight="700" text-anchor="middle" fill="#2a1d18">${ev.n}</text>`;
    }
    $("[data-evento]").hidden = eventiVisibili === 0;
    $("[data-grafico]").innerHTML = svg;
    $("[data-legenda]").textContent = (confronta ? "Linea continua: questo periodo. Linea tratteggiata: lo stesso periodo dell'anno prima. " : "") +
      (attive.includes("posizione") ? "Per la posizione, più in alto nel grafico è meglio (1 = primo risultato). " : "") +
      (seg !== "tutto" ? "Per una parte del sito, impressioni e posizione sono stime." : "");
  }

  document.querySelectorAll<HTMLButtonElement>("[data-metrica]").forEach((b) => b.addEventListener("click", () => {
    b.setAttribute("aria-pressed", b.getAttribute("aria-pressed") === "true" ? "false" : "true");
    if (!document.querySelector("[data-metrica][aria-pressed=true]")) b.setAttribute("aria-pressed", "true");
    disegna();
  }));
  ["[data-segmento]", "[data-periodo]", "[data-confronta]"].forEach((s) => $(s).addEventListener("change", disegna));
  disegna();

  // Schede Query / Pagine
  document.querySelectorAll<HTMLButtonElement>("[data-scheda]").forEach((b) => b.addEventListener("click", () => {
    document.querySelectorAll("[data-scheda]").forEach((x) => x.setAttribute("aria-selected", String(x === b)));
    document.querySelectorAll<HTMLElement>("[data-pannello]").forEach((p) => (p.hidden = p.dataset.pannello !== b.dataset.scheda));
  }));

  // ---- Controllo URL: Google (ultima scansione, 25/10) e sito di oggi (con le modifiche del pannello)
  import crawlDati from "../../../../../data/app/seo-pro/crawl.json";
  import { leggiModifiche, salvaModifiche, paginaEffettiva, pulisciUrl, OGGI } from "../../../../../scripts/cms";
  const escU = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;");
  function controllaUrl(u: string) {
    const box = $("[data-url-esito]");
    const url = pulisciUrl(u);
    const google = crawlDati.pagine.find((p) => p.url === url);
    const oggi = paginaEffettiva(url);
    box.hidden = false;
    if (!google && !oggi) { box.innerHTML = `<p>Google non conosce <span class="url">${escU(url)}</span>: controlla di averlo scritto bene.</p>`; return; }
    const m = leggiModifiche();
    const richiesta = m.richieste[url];
    const riga = (k: string, v: string) => `<div><dt>${k}</dt><dd>${v || "<em>—</em>"}</dd></div>`;
    const scheda = (titolo: string, p: any, nota: string) => `<div class="url-scheda"><strong>${titolo}</strong><span class="sp-nota">${nota}</span><dl>` +
      riga("Stato", p ? String(p.stato) : "–") + riga("Su Google", p ? (p.indicizzabile ? '<span class="sp-badge ok">Può comparire</span>' : `<span class="sp-badge no">No, ${escU((p.motivo || "").toLowerCase())}</span>`) : "") +
      riga("Title", p ? escU(p.title ?? "") : "") + riga("Description", p ? escU(p.description ?? "") : "") + riga("Meta robots", p ? escU(p.robots ?? "") : "") + `</dl></div>`;
    box.innerHTML = `<div class="url-schede">${scheda("Come l'ha vista Google", google, "Ultima scansione: 25/10/2026")}${scheda("Il sito adesso", oggi, oggi?.modificata ? "Contiene le tue modifiche" : "Uguale all'ultima scansione")}</div>
      <div class="url-azioni">${richiesta ? `<span class="sp-badge medio">Indicizzazione richiesta il ${richiesta}</span>` : `<button type="button" class="bottone-app" data-richiedi>Richiedi indicizzazione</button>`}<span class="url-msg" data-url-msg aria-live="polite"></span></div>`;
    box.querySelector("[data-richiedi]")?.addEventListener("click", () => {
      const msg = box.querySelector<HTMLElement>("[data-url-msg]")!;
      if (!oggi || oggi.stato !== 200) { msg.textContent = "Questa pagina non risponde 200: Google non la può indicizzare."; return; }
      if ((oggi.robots ?? "").includes("noindex")) { msg.textContent = "La pagina ha ancora il noindex: Google non la può indicizzare. Toglilo prima nel pannello."; return; }
      const m2 = leggiModifiche(); m2.richieste[url] = OGGI; salvaModifiche(m2);
      controllaUrl(url);
      box.querySelector<HTMLElement>("[data-url-msg]")!.textContent = "Richiesta inviata: Google rileggerà la pagina nei prossimi giorni.";
    });
  }
  $<HTMLFormElement>("[data-controllo-url]").addEventListener("submit", (e) => {
    e.preventDefault();
    controllaUrl(((e.currentTarget as HTMLFormElement).elements.namedItem("url") as HTMLInputElement).value);
  });

  // Dettaglio di una query: le pagine che compaiono per quella ricerca
  const dett = $("[data-dettaglio]");
  function apri(riga: HTMLTableRowElement) {
    document.querySelectorAll("tr.selezionata").forEach((r) => r.classList.remove("selezionata"));
    riga.classList.add("selezionata");
    const q = sc.query[Number(riga.dataset.query)];
    dett.hidden = false;
    dett.innerHTML = `<p class="d-testa"><strong>"${q.query}"</strong> · intento ${q.intento}</p><table class="mini"><thead><tr><th>Pagina</th><th>Clic</th><th>Impressioni</th><th>Posizione</th></tr></thead><tbody>` +
      q.pagine.map((p) => `<tr><td class="url"><a href="/app/negozio${p.url}">${p.url}</a></td><td>${num(p.clic)}</td><td>${num(p.impressioni)}</td><td>${num(p.posizione, 1)}</td></tr>`).join("") +
      `</tbody></table>` + (q.pagine.length > 1 ? `<p class="sp-nota">Per questa ricerca compaiono ${q.pagine.length} pagine diverse del sito.</p>` : "");
  }
  document.querySelectorAll<HTMLTableRowElement>("tr[data-query]").forEach((r) => {
    r.addEventListener("click", () => apri(r));
    r.addEventListener("keydown", (e) => { if (e.key === "Enter") apri(r); });
  });
</script>

<style>
  .comandi { display: flex; flex-wrap: wrap; gap: 12px 22px; align-items: center; font-size: .85rem; font-weight: 600; color: #55514c; }
  .comandi label { display: flex; align-items: center; gap: 8px; }
  .spunta input { accent-color: var(--arancio); width: 16px; height: 16px; }
  .metrica { font: inherit; text-align: left; cursor: pointer; background: #fff; border: 1px solid #e3e1dc; border-radius: 14px; padding: 16px 18px; display: flex; flex-direction: column; gap: 2px; color: var(--inchiostro); }
  .metrica span { font-size: .78rem; color: #5f5a55; font-weight: 600; }
  .metrica strong { font-family: var(--font-titoli); font-size: 1.7rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .metrica small { font-size: .75rem; font-weight: 700; min-height: 1em; }
  /* Metrica attiva: scheda piena del colore della sua linea nel grafico */
  .metrica[aria-pressed="true"] { color: #fff; border-color: transparent; }
  .metrica[aria-pressed="true"] span, .metrica[aria-pressed="true"] small { color: #fff !important; }
  .m-clic[aria-pressed="true"] { background: #2f5fd0; } .m-impressioni[aria-pressed="true"] { background: #6a3fc4; }
  .m-ctr[aria-pressed="true"] { background: #1a7a50; } .m-posizione[aria-pressed="true"] { background: #a85d14; }
  .metrica[aria-pressed="false"] strong { color: #55514c; }
  .metrica:focus-visible { outline: 3px solid var(--inchiostro); outline-offset: 2px; }
  .evento { display: flex; gap: 10px; align-items: center; margin: 8px 0 0; font-size: .85rem; background: #f4f4f2; border-radius: 10px; padding: 9px 12px; }
  .evento-n { flex: none; width: 20px; height: 20px; border-radius: 50%; background: #ff7a1a; display: grid; place-items: center; font-size: .72rem; font-weight: 800; }
  .tabelle { display: flex; flex-direction: column; gap: 12px; }
  .titoletto { font-family: var(--font-titoli); font-size: 1.15rem; font-weight: 800; margin: 0 0 4px; }
  .controllo-url { display: flex; flex-direction: column; gap: 12px; }
  .url-riga { display: flex; flex-wrap: wrap; gap: 10px; }
  .url-riga input { flex: 1 1 260px; }
  .url-esito :global(.url-schede) { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
  .url-esito :global(.url-scheda) { border: 1px solid #e3e1dc; border-radius: 12px; padding: 14px 16px; display: flex; flex-direction: column; gap: 6px; }
  .url-esito :global(dl) { margin: 4px 0 0; display: flex; flex-direction: column; gap: 6px; font-size: .85rem; }
  .url-esito :global(dl div) { display: grid; grid-template-columns: 100px 1fr; gap: 8px; }
  .url-esito :global(dt) { color: #5f5a55; font-weight: 700; } .url-esito :global(dd) { margin: 0; overflow-wrap: anywhere; }
  .url-esito :global(.url-azioni) { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 12px; }
  .url-esito :global(.url-msg) { font-size: .86rem; font-weight: 600; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .barra-tab { justify-content: flex-start; }
  .sp-scorri { max-height: 460px; overflow-y: auto; }
  tr[data-query] { cursor: pointer; }
