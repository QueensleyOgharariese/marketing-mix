---
// APP · 2. LA SCRIVANIA
// Menu dei ruoli e dei dati a sinistra, casella delle richieste al centro, consiglio di Pesca a destra.
// Lo stato dei ruoli (in corso / completato) viene letto dal browser con lo script in fondo.
import AppLayout from "../../layouts/AppLayout.astro";
import Progresso from "../../components/Progresso.astro";
import Pesca from "../../components/Pesca.astro";
import Icona from "../../components/Icona.astro";
import azienda from "../../data/app/cinque-foglie.json";
import esercizio from "../../data/app/seo-sencha.json";

const richiesta = esercizio.richiesta;
---
<AppLayout title="La tua scrivania" percorso={[{ etichetta: azienda.nome, link: "/app/" }, { etichetta: "Scrivania" }]}>
  <Progresso slot="barra" />
  <div class="layout">
    <nav class="menu" aria-label="Ruoli e dati">
      <div class="gruppo">
        <span class="gruppo-titolo">I tuoi pass</span>
        {azienda.ruoli.map((r) => (
          r.pronto ? (
            <a class="voce voce--attiva" href="/app/seo/esercizio/" data-ruolo={r.id}>
              <span class="voce-icona voce-icona--attiva"><Icona nome={r.icona} dimensione={14} /></span>
              <span class="voce-nome">{r.nome.replace(" specialist", "").replace(" manager", "")}</span>
              <span class="voce-stato" data-stato>da fare</span>
            </a>
          ) : (
            <span class="voce voce--presto">
              <span class="voce-icona"><Icona nome={r.icona} dimensione={14} /></span>
              <span class="voce-nome">{r.nome.replace(" specialist", "").replace(" manager", "")}</span>
              <span class="voce-stato">presto</span>
            </span>
          )
        ))}
      </div>
      <div class="gruppo">
        <span class="gruppo-titolo">Dati dell'azienda</span>
        <a class="voce" href="/app/dati/ricerche/">Ricerche su Google</a>
        <span class="voce voce--presto">Catalogo prodotti <span class="voce-stato">presto</span></span>
        <span class="voce voce--presto">Visite al sito <span class="voce-stato">presto</span></span>
        <span class="voce voce--presto">Clienti e ordini <span class="voce-stato">presto</span></span>
      </div>
      <a class="voce riepilogo" href="/app/riepilogo/">I tuoi risultati →</a>
    </nav>

    <main class="centro">
      <div>
        <h1 class="app-titolo">Buongiorno! Hai {azienda.richieste.length} richieste</h1>
        <p class="nota">Inizia da quella del tuo pass attivo: SEO specialist.</p>
      </div>

      <div class="posta">
        <ul class="lista" aria-label="Richieste">
          {azienda.richieste.map((m) => (
            <li>
              {m.link ? (
                <a class="mail mail--aperta" href={m.link}>
                  <span class="avatar avatar--nuovo">{m.da}</span>
                  <span class="mail-testi"><span class="mail-testa"><strong>{m.nome}</strong><span>{m.quando}</span></span><span class="mail-oggetto">{m.oggetto}</span><span class="mail-stato" data-stato-mail>SEO · da fare</span></span>
                </a>
              ) : (
                <span class="mail">
                  <span class="avatar avatar--spento">{m.da}</span>
                  <span class="mail-testi"><span class="mail-testa"><strong>{m.nome}</strong><span>{m.quando}</span></span><span class="mail-oggetto">{m.oggetto}</span><span class="mail-stato">In arrivo</span></span>
                </span>
              )}
            </li>
          ))}
        </ul>

        <article class="dettaglio" aria-labelledby="t-richiesta">
          <div class="dettaglio-testa">
            <span class="mittente"><span class="avatar">{richiesta.da}</span><span><strong>{richiesta.nome} · {richiesta.ruolo}</strong><span class="nota">{richiesta.quando}</span></span></span>
            <span class="tag">SEO · Esercizio 1</span>
          </div>
          <h2 id="t-richiesta" class="app-titolo">{richiesta.oggetto}</h2>
          <p>{richiesta.testo}</p>
          <ul class="info">
            <li>Circa {esercizio.minuti} minuti</li>
            <li>Dati: ricerche su Google</li>
            <li>Dati: pagina prodotto</li>
          </ul>

          <!-- Allegati della richiesta: cosa c'è oggi su Google e i dati da usare -->
          <div class="allegati">
            <section class="allegato">
              <span class="allegato-titolo">Come appare oggi su Google</span>
              <span class="a-url">{esercizio.attuale.url}</span>
              <span class="a-titolo">{esercizio.attuale.titolo}</span>
              <span class="a-desc">{esercizio.attuale.descrizione}</span>
              <span class="allegato-nota">Titolo corto e generico: chi cerca "tè verde Sencha" non lo trova.</span>
            </section>
            <section class="allegato">
              <span class="allegato-titolo">Ricerche su Google <span class="simulati">dati simulati</span></span>
              <table>
                <caption class="sr">Le ricerche più frequenti, numeri inventati</caption>
                <tbody>
                  {esercizio.ricerche.slice(0, 4).map((r) => (
                    <tr><td>{r.ricerca}</td><td>{r.mese}</td></tr>
                  ))}
                </tbody>
              </table>
              <a class="allegato-link" href="/app/dati/ricerche/">Vedi tutte le ricerche →</a>
            </section>
          </div>

          <div class="dettaglio-piede">
            <a class="bottone-app" href="/app/seo/esercizio/" data-apri>Apri l'esercizio →</a>
          </div>
        </article>
      </div>
    </main>

    <aside class="destra">
      <div class="consiglio">
        <Pesca dimensione={58} occhiali />
        <p>{esercizio.consiglio}</p>
      </div>
      <div class="pannello parole">
        <span class="gruppo-titolo">Parole da sapere oggi</span>
        <ul>{esercizio.parole.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div class="pannello avanzamento">
        <span class="gruppo-titolo">I tuoi progressi</span>
        <ul>
          {azienda.ruoli.map((r) => (
            <li data-avanzamento={r.id}><span class="pallino" aria-hidden="true"></span><span>{r.nome}</span><span class="av-stato">{r.pronto ? "da fare" : "in arrivo"}</span></li>
          ))}
        </ul>
        <a class="allegato-link" href="/app/riepilogo/">Vedi i risultati →</a>
      </div>
    </aside>
  </div>
</AppLayout>

<script>
  // Mostra lo stato del ruolo SEO salvato nel browser
  import { leggi } from "../../scripts/progressi";
  const seo = leggi().ruoli.seo;
  const stato = seo?.stato === "completato" ? "fatto" : seo?.stato === "in-corso" ? "in corso" : "da fare";
  document.querySelectorAll('[data-ruolo="seo"] [data-stato]').forEach((el) => (el.textContent = stato));
  document.querySelectorAll("[data-stato-mail]").forEach((el) => (el.textContent = `SEO · ${stato}`));
  const av = document.querySelector('[data-avanzamento="seo"]');
  if (av) { av.querySelector(".av-stato")!.textContent = stato; av.classList.toggle("fatto", seo?.stato === "completato"); av.classList.toggle("in-corso", seo?.stato === "in-corso"); }
  if (seo?.stato === "completato") {
    document.querySelectorAll<HTMLAnchorElement>("[data-apri]").forEach((a) => { a.textContent = "Rivedi l'esercizio →"; });
  }
</script>

<style>
  /* Tre colonne a tutta pagina: menu | richieste | Pesca e progressi. Occupano tutta l'altezza sotto la barra. */
  .layout { display: grid; grid-template-columns: 240px minmax(0, 1fr) 300px; min-height: calc(100vh - 61px); }
  .menu { background: #fff; border-right: 1px solid #eadfd6; padding: 20px 12px; display: flex; flex-direction: column; gap: 22px; }
  .gruppo { display: flex; flex-direction: column; gap: 2px; }
  .gruppo-titolo { font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #8a7b72; padding: 0 10px 8px; }
  .voce { display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 10px; color: #5c4a42; text-decoration: none; }
  a.voce:hover { background: #faf7f4; color: var(--inchiostro); }
  .voce--attiva { background: #fff1e6; color: var(--inchiostro); font-weight: 600; }
  .voce--presto { color: #a89a90; }
  .voce-icona { flex: none; width: 26px; height: 26px; border-radius: 50%; background: #f3eeea; display: grid; place-items: center; }
  .voce-icona--attiva { background: #ff8a3d; }
  .voce-nome { flex: 1; }
  .voce-stato { margin-left: auto; font-size: .7rem; font-weight: 700; color: #a24a0e; }
  .voce--presto .voce-stato { color: #a89a90; }
  .riepilogo { margin-top: auto; font-weight: 700; color: var(--inchiostro); }

  .centro { min-width: 0; padding: 28px; display: flex; flex-direction: column; gap: 18px; }
  h1 { font-size: 1.8rem; }
  .nota { font-size: .85rem; color: #6b5d55; }
  /* La casella occupa tutto lo spazio rimasto: lista a sinistra, richiesta aperta a destra */
  .posta { flex: 1; display: grid; grid-template-columns: minmax(240px, 320px) minmax(0, 1fr); gap: 16px; align-items: stretch; }
  .lista { list-style: none; margin: 0; padding: 6px; background: #fff; border: 1px solid #eadfd6; border-radius: 16px; display: flex; flex-direction: column; gap: 4px; }
  .mail { display: flex; gap: 12px; align-items: flex-start; padding: 12px; border-radius: 12px; text-decoration: none; color: #8a7b72; }
  .mail--aperta { background: #fff1e6; color: var(--inchiostro); box-shadow: inset 3px 0 0 var(--arancio); }
  .avatar--nuovo { background: var(--arancio); color: var(--inchiostro); }
  .avatar--spento { background: #e8ded6; color: #6b5d55; }
  .mail-testi { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .mail-testa { display: flex; justify-content: space-between; gap: 8px; font-size: .8rem; }
  .mail-oggetto { font-weight: 600; font-size: .9rem; }
  .mail-stato { font-size: .75rem; font-weight: 700; color: #a24a0e; }
  .mail:not(.mail--aperta) .mail-stato { color: #a89a90; }
  .dettaglio { min-width: 0; background: #fff; border: 1px solid #eadfd6; border-radius: 16px; padding: 24px 28px; display: flex; flex-direction: column; gap: 16px; }
  .dettaglio-testa { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; align-items: center; }
  .mittente { display: flex; align-items: center; gap: 10px; }
  .mittente > span:last-child { display: flex; flex-direction: column; }
  .dettaglio h2 { font-size: 1.6rem; }
  .dettaglio p { line-height: 1.6; font-size: 1.05rem; max-width: 70ch; }
  .info { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .info li { font-size: .8rem; background: #f3eeea; padding: 5px 10px; border-radius: 999px; }
  .allegati { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  .allegato { border: 1px solid #eadfd6; border-radius: 14px; padding: 16px 18px; display: flex; flex-direction: column; gap: 4px; background: #fffdfb; }
  .allegato-titolo { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; font-size: .7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #8a7b72; margin-bottom: 6px; }
  .simulati { font-size: .65rem; letter-spacing: 0; text-transform: none; background: #f3eeea; color: #6b5d55; padding: 2px 8px; border-radius: 999px; }
  .a-url { font-size: .8rem; color: #3d6b4a; }
  .a-titolo { font-size: 1.15rem; color: #1f45b8; line-height: 1.3; }
  .a-desc { font-size: .9rem; color: #4a4a4a; }
  .allegato-nota { margin-top: 8px; font-size: .8rem; color: #a12d1d; font-weight: 600; }
  table { width: 100%; border-collapse: collapse; font-size: .9rem; font-variant-numeric: tabular-nums; }
  td { padding: 6px 0; border-bottom: 1px solid #f3eeea; }
  td:last-child { text-align: right; color: #5c4a42; }
  .allegato-link { margin-top: 8px; font-size: .85rem; font-weight: 700; }
  .dettaglio-piede { margin-top: auto; padding-top: 16px; border-top: 1px solid #f3eeea; display: flex; justify-content: flex-end; }

  .destra { min-width: 0; padding: 28px 24px 28px 0; display: flex; flex-direction: column; gap: 14px; }
  .consiglio { background: #fff1e6; border-radius: 16px; padding: 16px; display: flex; gap: 12px; align-items: flex-start; line-height: 1.5; }
  .parole, .avanzamento { padding: 16px; }
  .parole .gruppo-titolo, .avanzamento .gruppo-titolo { padding: 0 0 10px; display: block; }
  .parole ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .parole li { font-size: .85rem; background: #f3eeea; padding: 5px 10px; border-radius: 999px; }
  .avanzamento { flex: 1; display: flex; flex-direction: column; }
  .avanzamento ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: .9rem; }
  .avanzamento li { display: flex; align-items: center; gap: 10px; color: #8a7b72; }
  .avanzamento li span:nth-child(2) { flex: 1; }
  .pallino { width: 10px; height: 10px; border-radius: 50%; border: 2px solid #d8c9bd; }
  .av-stato { font-size: .75rem; font-weight: 700; }
  .avanzamento li[data-avanzamento="seo"] { color: var(--inchiostro); }
  .avanzamento li.in-corso .pallino { border-color: var(--arancio); background: #fff1e6; }
  .avanzamento li.fatto .pallino { border-color: #2f7a4f; background: #2f7a4f; }
  .avanzamento .allegato-link { margin-top: auto; padding-top: 12px; }

  /* Schermi medi (fino a 1360 px): la colonna di Pesca va sotto, così la richiesta ha più spazio */
  @media (max-width: 1360px) {
    .layout { grid-template-columns: 220px minmax(0, 1fr); }
    .destra { grid-column: 2; padding: 0 28px 28px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  }
  /* Telefono: tutto in una colonna */
  @media (max-width: 760px) {
    .layout { grid-template-columns: 1fr; }
    .menu { border-right: 0; border-bottom: 1px solid #eadfd6; }
    .destra { grid-column: 1; padding: 0 20px 24px; }
    .centro { padding: 20px; }
    .posta { grid-template-columns: 1fr; }
  }
</style>
