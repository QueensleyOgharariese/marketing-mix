---
// STRUMENTO 3 · CALCOLATORE ENGAGEMENT RATE
// Engagement rate = interazioni ÷ base × 100. La base può essere la copertura (persone raggiunte)
// oppure i follower: i due numeri non si confrontano tra loro, quindi lo strumento dice quale stai usando.
// Non diamo "valori giusti" inventati: cambiano molto per piattaforma e dimensione del profilo.
import Strumento from "../../components/Strumento.astro";
const VOCI = [["like", "Mi piace"], ["commenti", "Commenti"], ["salvataggi", "Salvataggi"], ["condivisioni", "Condivisioni"]];
---
<Strumento id="engagement-rate" descrizione="Calcolatore gratuito di engagement rate: inserisci mi piace, commenti, salvataggi, condivisioni e copertura o follower, e scopri quanto il pubblico interagisce con un post.">
  <form class="attrezzo" data-er novalidate>
    <div class="attrezzo-pannello">
      <fieldset class="gruppo">
        <legend class="attrezzo-titolo">Interazioni del post</legend>
        <div class="griglia">
          {VOCI.map(([id, nome]) => (
            <label class="attrezzo-campo">{nome}<input type="number" name={id} min="0" step="1" inputmode="numeric" placeholder="0" /></label>
          ))}
        </div>
      </fieldset>
      <fieldset class="gruppo">
        <legend class="attrezzo-titolo">Su cosa lo calcoli?</legend>
        <label class="scelta"><input type="radio" name="base" value="copertura" checked /><span><strong>Copertura</strong> · quante persone hanno visto il post (consigliato)</span></label>
        <label class="scelta"><input type="radio" name="base" value="follower" /><span><strong>Follower</strong> · quante persone seguono il profilo</span></label>
        <label class="attrezzo-campo"><span data-etichetta-base>Persone raggiunte</span><input type="number" name="numero" min="0" step="1" inputmode="numeric" placeholder="0" /></label>
      </fieldset>
      <div class="attrezzo-azioni">
        <button type="button" class="bottone-piccolo" data-esempio>Usa l'esempio di Cinque Foglie</button>
        <button type="reset" class="bottone-piccolo">Svuota</button>
      </div>
    </div>

    <div class="attrezzo-pannello attrezzo-pannello--crema" aria-live="polite">
      <span class="attrezzo-titolo">Risultato</span>
      <div class="risultato">
        <span class="valore" data-valore>–</span>
        <span class="formula" data-formula>Inserisci le interazioni e la copertura.</span>
      </div>
      <dl class="dettagli">
        <div><dt>Interazioni totali</dt><dd data-totale>0</dd></div>
        <div><dt>Interazioni ogni 100 persone</dt><dd data-cento>–</dd></div>
      </dl>
      <p class="consiglio" data-consiglio>Il numero da solo dice poco: confrontalo con gli altri post dello stesso profilo, calcolati nello stesso modo.</p>
    </div>
  </form>

  <Fragment slot="spiega">
    <h2>Cos'è l'engagement rate</h2>
    <p>È la percentuale di persone che hanno interagito con un post: hanno messo mi piace, commentato, salvato o condiviso. Misura l'interesse meglio del numero di follower, perché dice se le persone reagiscono davvero.</p>
    <h2>Copertura o follower?</h2>
    <p>Con la copertura calcoli quante persone hanno interagito tra quelle che hanno visto il post. Con i follower calcoli rispetto a chi segue il profilo, anche se non ha visto il post. Sono due misure diverse: scegline una e usa sempre quella per confrontare.</p>
    <h2>Un esempio</h2>
    <p>Un post di Cinque Foglie con una ricetta al matcha: 180 mi piace, 25 commenti, 15 salvataggi e 5 condivisioni sono 225 interazioni. Visto da 5.000 persone, l'engagement rate è 225 ÷ 5.000 × 100 = <strong>4,5%</strong>.</p>
    <p><strong>Perché non diamo un "valore giusto":</strong> cambia molto tra Instagram, TikTok e LinkedIn, e tra profili piccoli e grandi. Il confronto più onesto è con i tuoi post precedenti.</p>
  </Fragment>
</Strumento>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-er]")!;
  const n = (nome: string) => Math.max(0, Number((form.elements.namedItem(nome) as HTMLInputElement).value) || 0);
  const $ = (s: string) => form.querySelector<HTMLElement>(s)!;
  const numero = (x: number, dec = 0) => x.toLocaleString("it-IT", { minimumFractionDigits: dec, maximumFractionDigits: dec });

  function aggiorna() {
    const base = (form.querySelector<HTMLInputElement>('input[name="base"]:checked')?.value ?? "copertura") as "copertura" | "follower";
    $("[data-etichetta-base]").textContent = base === "copertura" ? "Persone raggiunte" : "Follower del profilo";
    const tot = n("like") + n("commenti") + n("salvataggi") + n("condivisioni");
    const div = n("numero");
    $("[data-totale]").textContent = numero(tot);
    if (div > 0 && tot > 0) {
      const er = (tot / div) * 100;
      $("[data-valore]").textContent = `${numero(er, er < 10 ? 1 : 0)}%`;
      $("[data-formula]").textContent = `${numero(tot)} interazioni ÷ ${numero(div)} ${base === "copertura" ? "persone raggiunte" : "follower"} × 100`;
      $("[data-cento]").textContent = numero(er, 1);
      $("[data-consiglio]").textContent = tot > div
        ? "Le interazioni sono più delle persone: controlla i numeri (una persona può interagire più volte, ma è raro)."
        : `Engagement calcolato sulla ${base === "copertura" ? "copertura" : "base dei follower"}. Confrontalo con gli altri post dello stesso profilo, calcolati nello stesso modo.`;
    } else {
      $("[data-valore]").textContent = "–";
      $("[data-formula]").textContent = `Inserisci le interazioni e ${base === "copertura" ? "la copertura" : "i follower"}.`;
      $("[data-cento]").textContent = "–";
    }
  }

  form.addEventListener("input", aggiorna);
  form.addEventListener("change", aggiorna);
  form.addEventListener("reset", () => setTimeout(aggiorna));
  $("[data-esempio]").addEventListener("click", () => {
    const metti = (k: string, v: string) => ((form.elements.namedItem(k) as HTMLInputElement).value = v);
    metti("like", "180"); metti("commenti", "25"); metti("salvataggi", "15"); metti("condivisioni", "5"); metti("numero", "5000");
    form.querySelector<HTMLInputElement>('input[name="base"][value="copertura"]')!.checked = true;
    aggiorna();
  });
  aggiorna();
</script>

<style>
  .gruppo { border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .gruppo legend { margin-bottom: 10px; }
  .griglia { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .scelta { display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; border: 2px solid var(--linea); border-radius: 12px; cursor: pointer; line-height: 1.4; font-size: .95rem; }
  .scelta:has(input:checked) { border-color: var(--arancio); background: var(--crema-2); }
  .scelta input { margin-top: 3px; accent-color: var(--arancio); }
  .risultato { display: flex; flex-direction: column; gap: 4px; }
  .valore { font-family: var(--font-titoli); font-size: clamp(3rem, 9vw, 4.5rem); font-weight: 800; line-height: 1; color: var(--arancio-scuro); font-variant-numeric: tabular-nums; }
  .formula { font-size: .9rem; color: var(--testo-2); }
  .dettagli { margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .dettagli div { display: flex; justify-content: space-between; gap: 10px; border-bottom: 1px solid var(--linea); padding-bottom: 6px; font-size: .95rem; }
  .dettagli dd { margin: 0; font-weight: 700; font-variant-numeric: tabular-nums; }
  .consiglio { margin: 0; font-size: .9rem; line-height: 1.5; color: var(--testo-2); }
</style>
