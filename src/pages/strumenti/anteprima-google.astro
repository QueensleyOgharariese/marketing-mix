---
// STRUMENTO 2 · ANTEPRIMA RISULTATO GOOGLE
// Mostra come appaiono titolo e descrizione nei risultati. Il titolo si misura in pixel
// (come fa Google), la descrizione in caratteri. Riusa le funzioni dell'esercizio SEO
// (src/scripts/controlli-seo.ts): misura in pixel e controllo delle frasi sulla salute.
import Strumento from "../../components/Strumento.astro";
---
<Strumento id="anteprima-google" descrizione="Anteprima gratuita del risultato su Google: scrivi title e meta description e guarda se sono troppo lunghi, se c'è la parola chiave e come appariranno.">
  <form class="attrezzo" data-serp novalidate>
    <div class="attrezzo-pannello">
      <label class="attrezzo-campo">Indirizzo della pagina
        <input type="text" name="url" placeholder="www.tuosito.it/pagina" autocomplete="off" />
      </label>
      <label class="attrezzo-campo">
        <span class="attrezzo-riga"><span>Titolo (title)</span><span class="attrezzo-conta" data-conta-t>0 px</span></span>
        <input type="text" name="titolo" placeholder="La parola chiave all'inizio, il marchio alla fine" autocomplete="off" />
        <span class="attrezzo-barra" aria-hidden="true"><span data-barra-t></span></span>
      </label>
      <label class="attrezzo-campo">
        <span class="attrezzo-riga"><span>Descrizione (meta description)</span><span class="attrezzo-conta" data-conta-d>0 caratteri</span></span>
        <textarea name="descrizione" placeholder="Cosa trova la persona sulla pagina, in una o due frasi"></textarea>
        <span class="attrezzo-barra" aria-hidden="true"><span data-barra-d></span></span>
      </label>
      <label class="attrezzo-campo">Parola chiave (facoltativa)
        <input type="text" name="keyword" placeholder="es. tè verde sencha" autocomplete="off" />
      </label>
      <div class="attrezzo-azioni">
        <button type="button" class="bottone-piccolo" data-esempio>Usa l'esempio di Cinque Foglie</button>
        <button type="reset" class="bottone-piccolo">Svuota</button>
      </div>
    </div>

    <div class="attrezzo-pannello attrezzo-pannello--crema" aria-live="polite">
      <span class="attrezzo-titolo">Come apparirà</span>
      <div class="serp">
        <span class="s-url" data-a-url>www.tuosito.it › pagina</span>
        <span class="s-titolo" data-a-titolo>Il titolo comparirà qui</span>
        <span class="s-desc" data-a-desc>E qui la descrizione: se manca, Google ne sceglie una dal testo della pagina.</span>
      </div>
      <ul class="attrezzo-esiti" data-esiti></ul>
      <p class="nota">Stima per i risultati da computer: Google può mostrare o riscrivere titoli e descrizioni in modo diverso.</p>
    </div>
  </form>

  <Fragment slot="spiega">
    <h2>Perché il titolo si misura in pixel</h2>
    <p>Google non conta le lettere: guarda quanto spazio occupano. Una "m" è più larga di una "i", quindi due titoli con gli stessi caratteri possono avere larghezze diverse. Oltre circa 580 pixel, il titolo viene tagliato con "...".</p>
    <h2>Cosa rende buono un risultato</h2>
    <p>Il titolo dice subito di cosa parla la pagina, con la parola chiave all'inizio e il marchio alla fine. La descrizione non cambia la posizione su Google, ma convince a cliccare: tra 70 e 160 caratteri, concreta, senza promesse che non puoi mantenere.</p>
    <p><strong>Attenzione alle regole:</strong> per gli alimenti, nell'Unione europea le promesse sulla salute sono permesse solo se autorizzate (Regolamento CE 1924/2006). Lo strumento ti avvisa se trova parole come "dimagrire" o "detox".</p>
  </Fragment>
</Strumento>

<script>
  import { pixel, senzaSalute, normalizza, LIMITI } from "../../scripts/controlli-seo";
  const form = document.querySelector<HTMLFormElement>("[data-serp]")!;
  const campo = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
  const $ = (s: string) => form.querySelector<HTMLElement>(s)!;

  // Taglia un testo con "..." quando supera la larghezza massima, come fa Google
  function taglia(t: string, max: number) {
    if (pixel(t) <= max) return t;
    while (t.length > 1 && pixel(t + " ...") > max) t = t.slice(0, -1);
    return t.trimEnd() + " ...";
  }

  function aggiorna() {
    const t = campo("titolo").value.trim();
    const d = campo("descrizione").value.trim();
    const k = campo("keyword").value.trim();
    const u = campo("url").value.trim().replace(/^https?:\/\//, "").replace(/\/$/, "");
    const px = pixel(t);

    $("[data-conta-t]").textContent = `${px} / ${LIMITI.titoloPx} px · ${t.length} caratteri`;
    $("[data-conta-d]").textContent = `${d.length} caratteri`;
    const bt = $("[data-barra-t]"), bd = $("[data-barra-d]");
    bt.style.width = `${Math.min(100, (px / LIMITI.titoloPx) * 100)}%`;
    bt.style.background = px > LIMITI.titoloPx ? "#c0392b" : t.length >= LIMITI.titoloMin ? "#2f7a4f" : "#ff7a1a";
    bd.style.width = `${Math.min(100, (d.length / LIMITI.descrizione[1]) * 100)}%`;
    bd.style.background = d.length > LIMITI.descrizione[1] ? "#c0392b" : d.length >= LIMITI.descrizione[0] ? "#2f7a4f" : "#ff7a1a";

    $("[data-a-url]").textContent = u ? u.split("/").join(" › ") : "www.tuosito.it › pagina";
    $("[data-a-titolo]").textContent = t ? taglia(t, LIMITI.titoloPx) : "Il titolo comparirà qui";
    $("[data-a-desc]").textContent = d ? (d.length > 160 ? d.slice(0, 155).trimEnd() + " ..." : d) : "E qui la descrizione: se manca, Google ne sceglie una dal testo della pagina.";

    // Controlli: null = non ancora valutabile (grigio), true = verde, false = rosso
    const esiti: [string, boolean | null][] = [
      ["Titolo non troppo lungo", t ? px <= LIMITI.titoloPx : null],
      ["Titolo non troppo corto", t ? t.length >= LIMITI.titoloMin : null],
      ["Descrizione 70-160 caratteri", d ? d.length >= LIMITI.descrizione[0] && d.length <= LIMITI.descrizione[1] : null],
      ["Parola chiave nel titolo", k && t ? normalizza(t).includes(normalizza(k)) : null],
      ["Nessuna promessa sulla salute", t || d ? senzaSalute(t, d) : null],
    ];
    $("[data-esiti]").innerHTML = esiti.map(([n, ok]) => `<li class="${ok === true ? "ok" : ok === false ? "no" : ""}">${ok === true ? "✓ " : ok === false ? "✗ " : ""}${n}</li>`).join("");
  }

  form.addEventListener("input", aggiorna);
  form.addEventListener("reset", () => setTimeout(aggiorna));
  $("[data-esempio]").addEventListener("click", () => {
    campo("url").value = "cinquefoglie.example/te-verdi/sencha-bio";
    campo("titolo").value = "Tè verde Sencha biologico in foglie | Cinque Foglie";
    campo("descrizione").value = "Sencha bio giapponese a foglie intere, dal gusto fresco ed erbaceo. Ottimo anche freddo. Spedizione in 24 ore.";
    campo("keyword").value = "tè verde sencha";
    aggiorna();
  });
  aggiorna();
</script>

<style>
  .serp { background: #fff; border: 1px solid var(--linea); border-radius: 14px; padding: 16px 18px; display: flex; flex-direction: column; gap: 4px; }
  .s-url { font-size: .82rem; color: #3d6b4a; overflow-wrap: anywhere; }
  .s-titolo { font-family: Arial, sans-serif; font-size: 20px; line-height: 1.3; color: #1f45b8; overflow-wrap: anywhere; }
  .s-desc { font-size: .9rem; line-height: 1.5; color: #4a4a4a; overflow-wrap: anywhere; }
  .nota { margin: 0; font-size: .82rem; color: var(--testo-3); line-height: 1.5; }
</style>
