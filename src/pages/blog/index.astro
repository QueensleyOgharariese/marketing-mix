---
// ELENCO DEGLI ARTICOLI
// Prende tutti gli articoli dalla raccolta "blog" e li ordina dal più recente.
// Le bozze si vedono solo mentre lavori sul tuo computer (npm run dev),
// non sul sito pubblicato.
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const articoli = (await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.bozza))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base title="Blog" description="Le basi del marketing spiegate semplici, ruolo per ruolo.">
  <h1>Blog</h1>
  {articoli.length === 0 && <p class="vuoto">I primi articoli arrivano presto.</p>}
  <ul class="elenco">
    {articoli.map((a) => (
      <li>
        <a href={`/blog/${a.id}/`}>{a.data.title}</a>
        {a.data.bozza && <span class="bozza">bozza</span>}
        <p>{a.data.description}</p>
      </li>
    ))}
  </ul>
</Base>

<style>
  .elenco { list-style: none; padding: 0; display: grid; gap: var(--space-3); max-width: 65ch; }
  .elenco a { font-size: 1.25rem; font-weight: 700; }
  .elenco p, .vuoto { margin: 0.25rem 0 0; color: var(--muted); }
  .bozza { margin-left: var(--space-1); font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); border: 1px solid var(--line); padding: 0 0.4rem; border-radius: 4px; }
</style>
