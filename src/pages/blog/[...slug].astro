---
// PAGINA DI UN ARTICOLO IN ITALIANO
// Le parentesi quadre nel nome del file vogliono dire "pagina dinamica":
// Astro crea una pagina per ogni articolo, usando il nome del file come indirizzo.
// Esempio: cosa-fa-un-seo-specialist.md → /blog/cosa-fa-un-seo-specialist/
// Il contenuto sta nel componente Articolo; qui cerchiamo anche la versione inglese (se c'è).
import Articolo from "../../components/pagine/Articolo.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const articoli = await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.bozza);
  const inglesi = await getCollection("blogEn", ({ data }) => import.meta.env.DEV || !data.bozza);
  return articoli.map((articolo) => {
    const en = inglesi.find((x) => x.data.traduzione === articolo.id);
    return { params: { slug: articolo.id }, props: { articolo, tutti: articoli, traduzione: en ? `/en/blog/${en.id}/` : undefined } };
  });
}
const { articolo, tutti, traduzione } = Astro.props;
---
<Articolo lang="it" articolo={articolo} tutti={tutti} traduzione={traduzione} />
