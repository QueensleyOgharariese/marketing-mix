---
// PAGINA DI UN ARTICOLO
// Le parentesi quadre nel nome del file vogliono dire "pagina dinamica":
// Astro crea una pagina per ogni articolo, usando il nome del file come indirizzo.
// Esempio: cosa-fa-un-seo-specialist.md → /blog/cosa-fa-un-seo-specialist/
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const articoli = await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.bozza);
  return articoli.map((articolo) => ({ params: { slug: articolo.id }, props: { articolo } }));
}

const { articolo } = Astro.props;
const { Content } = await render(articolo);
const data = articolo.data.date.toLocaleDateString("it-IT", { day: "numeric", month: "long", year: "numeric" });
---
<Base title={articolo.data.title} description={articolo.data.description}>
  <article class="testo">
    <p class="meta">{articolo.data.ruolo} · {data}</p>
    <h1>{articolo.data.title}</h1>
    <Content />
    <p><a href="/blog/">← Tutti gli articoli</a></p>
  </article>
</Base>

<style>
  .meta { font-family: var(--font-mono); font-size: 0.8rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }
  h1 { font-size: clamp(2rem, 5vw, 2.75rem); margin-top: 0; }
</style>
