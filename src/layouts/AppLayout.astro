---
// LAYOUT DELL'APP (l'azienda finta)
// È diverso dal sito: barra in alto con il percorso (breadcrumb) e i progressi, sfondo neutro, niente footer.
// Le pagine dell'app non vanno su Google (noindex): sono esercizi, non articoli.
import "@fontsource/figtree/latin-400.css";
import "@fontsource/figtree/latin-600.css";
import "@fontsource/figtree/latin-700.css";
import "@fontsource/gabarito/latin-700.css";
import "@fontsource/gabarito/latin-800.css";
import "../styles/global.css";

interface Props {
  title: string;
  percorso: { etichetta: string; link?: string }[]; // es. [{etichetta:"Cinque Foglie", link:"/app/"}, {etichetta:"Scrivania"}]
  indietro?: { etichetta: string; link: string };
}
const { title, percorso, indietro } = Astro.props;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title} · Marketing Mix`}</title>
    <meta name="robots" content="noindex" />
    <meta name="description" content="Esercizi di marketing nell'azienda finta Cinque Foglie." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="app">
    <header class="app-barra">
      <div class="barra-sx">
        {indietro ? (
          <a class="indietro" href={indietro.link}>← {indietro.etichetta}</a>
        ) : (
          <a class="logo" href="/" aria-label="Marketing Mix, torna al sito">
            <svg width="26" height="27" viewBox="0 0 200 210" aria-hidden="true"><path d="M104 40 C120 10 160 8 172 20 C152 40 126 46 104 40Z" fill="#3a9d5d" /><path d="M100 52 C60 40 22 72 22 122 C22 170 58 202 100 202 C142 202 178 170 178 122 C178 72 140 40 100 52Z" fill="#ff8a3d" /></svg>
            <strong>Marketing Mix</strong>
          </a>
        )}
        <nav aria-label="Dove sei" class="briciole">
          {percorso.map((p, i) => (
            <>
              <span class="sep" aria-hidden="true">/</span>
              {p.link ? <a href={p.link}>{p.etichetta}</a> : <span aria-current={i === percorso.length - 1 ? "page" : undefined}>{p.etichetta}</span>}
            </>
          ))}
        </nav>
      </div>
      <div class="barra-dx">
        <slot name="barra" />
        <a class="esci" href="/">Esci dall'azienda</a>
      </div>
    </header>
    <slot />
  </body>
</html>

<style is:global>
  /* Stile comune a tutte le schermate dell'app */
  body.app { background: #f7f4f1; font-size: .95rem; }
  .app-barra { position: sticky; top: 0; z-index: 20; min-height: 60px; background: #fff; border-bottom: 1px solid #eadfd6; padding: 8px 24px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; }
  .barra-sx, .barra-dx { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .logo { display: flex; align-items: center; gap: 8px; text-decoration: none; }
  .logo strong { font-family: var(--font-titoli); font-size: 1.05rem; }
  .indietro { font-weight: 700; text-decoration: none; }
  .briciole { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; color: #6b5d55; }
  .briciole a { color: #6b5d55; }
  .briciole [aria-current] { color: var(--inchiostro); font-weight: 600; }
  .sep { color: #cbbdb2; }
  .esci { font-size: .85rem; font-weight: 700; color: #6b5d55; }
  .pannello { background: #fff; border: 1px solid #eadfd6; border-radius: 16px; }
  .app-titolo { font-family: var(--font-titoli); font-weight: 800; letter-spacing: -0.015em; }
  .tag { display: inline-block; font-size: .7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #8a3a06; background: #fff1e6; padding: 3px 9px; border-radius: 999px; }
  .avatar { flex: none; width: 34px; height: 34px; border-radius: 50%; background: var(--inchiostro); color: #fff; display: grid; place-items: center; font-weight: 700; font-size: .75rem; }
  .bottone-app { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; background: var(--arancio); color: var(--inchiostro); font: inherit; font-weight: 700; padding: 12px 18px; border-radius: 10px; border: 0; cursor: pointer; }
  .bottone-app:hover { color: var(--inchiostro); background: #ff8b38; }
  .bottone-app--chiaro { background: #fff; border: 1px solid #d8c9bd; }
  .bottone-app--chiaro:hover { background: #fff8f2; }
  .progresso { display: flex; align-items: center; gap: 8px; color: #6b5d55; font-size: .8rem; }
  .progresso-barra { width: 90px; height: 6px; border-radius: 99px; background: #f1e6dd; overflow: hidden; }
  .progresso-barra span { display: block; height: 100%; width: 0; background: var(--arancio); transition: width .4s; }
</style>
