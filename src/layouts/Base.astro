---
// LAYOUT DI BASE
// Un "layout" è la cornice comune a tutte le pagine: <head>, menu e footer.
// Si scrive una volta sola qui; ogni pagina ci mette dentro il suo contenuto.

// Font ospitati sul sito (licenza SIL OFL): solo i pesi e i caratteri latini che usiamo
import "@fontsource/figtree/latin-400.css";
import "@fontsource/figtree/latin-600.css";
import "@fontsource/figtree/latin-700.css";
import "@fontsource/gabarito/latin-700.css";
import "@fontsource/gabarito/latin-800.css";
import "../styles/global.css";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import impostazioni from "../data/impostazioni.json";
import { linguaDa, COMUNI, link } from "../i18n";

// "Props" = le informazioni che ogni pagina passa al layout.
// "traduzione" = l'indirizzo della stessa pagina nell'altra lingua (se esiste).
interface Props {
  title: string;
  description?: string;
  traduzione?: string;
}
const lang = linguaDa(Astro.url);
const t = COMUNI[lang];
const { title, description = t.descrizioneSito, traduzione } = Astro.props;
// Indirizzi delle due versioni: servono ai tag hreflang e al selettore di lingua
const altra = lang === "it" ? "en" : "it";
const versioni = traduzione ? { [lang]: Astro.url.pathname, [altra]: traduzione } : null;

// Titolo nella scheda del browser: "Titolo pagina · Nome sito"
const titoloCompleto =
  title === impostazioni.nomeSito ? title : `${title} · ${impostazioni.nomeSito}`;
// Link canonico: dice a Google qual è l'indirizzo ufficiale della pagina
const canonico = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloCompleto}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonico} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ff7a1a" />
    <meta property="og:title" content={titoloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonico} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "it" ? "it_IT" : "en_GB"} />
    {/* hreflang: dice a Google che questa pagina esiste anche nell'altra lingua */}
    {versioni && Object.entries(versioni).map(([l, u]) => <link rel="alternate" hreflang={l} href={new URL(u, Astro.site)} />)}
    {versioni && <link rel="alternate" hreflang="x-default" href={new URL(versioni.it, Astro.site)} />}
  </head>
  <body id="top">
    <a class="salta sr" href="#contenuto">{t.vaiAlContenuto}</a>
    <Navbar lang={lang} traduzione={traduzione ?? link(altra, "home")} />
    <main id="contenuto">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  /* Link "Vai al contenuto": invisibile finché non lo raggiungi con il tasto Tab */
  .salta:focus {
    position: fixed; left: 16px; top: 16px; z-index: 100;
    width: auto; height: auto; margin: 0; clip: auto;
    background: var(--inchiostro); color: #fff; padding: 10px 16px; border-radius: 12px;
  }
</style>
