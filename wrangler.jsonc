// Configurazione di Cloudflare Workers.
// Il sito è statico: Astro crea i file nella cartella "dist" e Cloudflare li pubblica così come sono.
// "name" deve essere uguale al nome del Worker creato nella dashboard di Cloudflare.
{
  "name": "marketing-mix",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    // Se un indirizzo non esiste, mostra la pagina 404.html con lo stato 404
    "not_found_handling": "404-page"
  }
}
